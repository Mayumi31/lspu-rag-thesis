lspuprog:Subj_BSBA_MM_MMELEC3 a lspuprog:Subject ;
    rdfs:label "MM Elec 3 — Franchising (BSBA - Major in Marketing Management, Year 3, 2nd Semester)" ;
    lspuprog:subjectCode "MM Elec 3" ;
    lspuprog:subjectTitle "Franchising" ;
    lspuprog:belongsToProgram lspuprog:Prog_BSBA_MM ;
    lspuprog:yearLevel 3 ;
    lspuprog:semester "2nd Semester" ;
    lspuprog:units 3 ;
    lspuprog:hasPrerequisite lspuprog:Subj_BSBA_MM_MMELEC2 ;
    lspuprog:subjectDescription "Examines franchise business models, agreements, and management practices. Students learn how franchising works as a growth and distribution strategy. This course extends strategic marketing concepts into a specific business expansion model." ;
    lspuprog:sourceDocument "campus_curriculum_clean.md (maintainer-supplied campus curriculum; not from the CHED CMO, Handbook or Citizen's Charter)." .

lspuprog:Subj_BSBA_MM_MM106 a lspuprog:Subject ;
    rdfs:label "MM 106 — Product Management (BSBA - Major in Marketing Management, Year 3, 2nd Semester)" ;
    lspuprog:subjectCode "MM 106" ;
    lspuprog:subjectTitle "Product Management" ;
    lspuprog:belongsToProgram lspuprog:Prog_BSBA_MM ;
    lspuprog:yearLevel 3 ;
    lspuprog:semester "2nd Semester" ;
    lspuprog:units 3 ;
    lspuprog:hasPrerequisite lspuprog:Subj_BSBA_MM_MM102 ;
    lspuprog:subjectDescription "Covers the product life cycle, product development, and product line strategy. Students learn to manage a product's positioning and performance in the market. This course connects sales knowledge from Professional Salesmanship to broader product strategy decisions." ;
    lspuprog:sourceDocument "campus_curriculum_clean.md (maintainer-supplied campus curriculum; not from the CHED CMO, Handbook or Citizen's Charter)." .

lspuprog:Subj_BSBA_MM_BAC108 a lspuprog:Subject ;
    rdfs:label "BAC 108 — Feasibility Study (BSBA - Major in Marketing Management, Year 4, 1st Semester)" ;
    lspuprog:subjectCode "BAC 108" ;
    lspuprog:subjectTitle "Feasibility Study" ;
    lspuprog:belongsToProgram lspuprog:Prog_BSBA_MM ;
    lspuprog:yearLevel 4 ;
    lspuprog:semester "1st Semester" ;
    lspuprog:units 3 ;
    lspuprog:hasPrerequisite lspuprog:Subj_BSBA_MM_BAC107 ;
    lspuprog:subjectDescription "Guides students through developing a comprehensive business feasibility study for a proposed venture. Students apply research, financial, and marketing analysis to assess project viability. This course serves as the culminating research-to-practice project of the program." ;
    lspuprog:sourceDocument "campus_curriculum_clean.md (maintainer-supplied campus curriculum; not from the CHED CMO, Handbook or Citizen's Charter)." .

lspuprog:Subj_BSBA_MM_MMELEC4 a lspuprog:Subject ;
    rdfs:label "MM Elec 4 — E-Commerce and Internet Marketing (BSBA - Major in Marketing Management, Year 4, 1st Semester)" ;
    lspuprog:subjectCode "MM Elec 4" ;
    lspuprog:subjectTitle "E-Commerce and Internet Marketing" ;
    lspuprog:belongsToProgram lspuprog:Prog_BSBA_MM ;
    lspuprog:yearLevel 4 ;
    lspuprog:semester "1st Semester" ;
    lspuprog:units 3 ;
    lspuprog:hasPrerequisite lspuprog:Subj_BSBA_MM_MMELEC3 ;
    lspuprog:subjectDescription "Covers digital marketing strategies, online sales platforms, and internet-based consumer engagement. Students learn to design marketing campaigns for e-commerce environments. This course extends franchising and distribution concepts into the digital marketplace." ;
    lspuprog:sourceDocument "campus_curriculum_clean.md (maintainer-supplied campus curriculum; not from the CHED CMO, Handbook or Citizen's Charter)." .

lspuprog:Subj_BSBA_MM_MM107 a lspuprog:Subject ;
    rdfs:label "MM 107 — Retail Management (BSBA - Major in Marketing Management, Year 4, 1st Semester)" ;
    lspuprog:subjectCode "MM 107" ;
    lspuprog:subjectTitle "Retail Management" ;
    lspuprog:belongsToProgram lspuprog:Prog_BSBA_MM ;
    lspuprog:yearLevel 4 ;
    lspuprog:semester "1st Semester" ;
    lspuprog:units 3 ;
    lspuprog:hasPrerequisite lspuprog:Subj_BSBA_MM_MM106 ;
    lspuprog:subjectDescription "Covers retail operations, store management, and merchandising strategy. Students learn how retail businesses manage inventory, layout, and customer experience. This course applies product management principles specifically to the retail environment." ;
    lspuprog:sourceDocument "campus_curriculum_clean.md (maintainer-supplied campus curriculum; not from the CHED CMO, Handbook or Citizen's Charter)." .

lspuprog:Subj_BSBA_MM_MM108 a lspuprog:Subject ;
    rdfs:label "MM 108 — Pricing Strategy (BSBA - Major in Marketing Management, Year 4, 1st Semester)" ;
    lspuprog:subjectCode "MM 108" ;
    lspuprog:subjectTitle "Pricing Strategy" ;
    lspuprog:belongsToProgram lspuprog:Prog_BSBA_MM ;
    lspuprog:yearLevel 4 ;
    lspuprog:semester "1st Semester" ;
    lspuprog:units 3 ;
    lspuprog:hasPrerequisite lspuprog:Subj_BSBA_MM_MM106 ;
    lspuprog:subjectDescription "Examines pricing models, competitive pricing strategies, and price elasticity concepts. Students learn to set prices that balance profitability with market competitiveness. This course completes the product-marketing sequence begun with Product Management." ;
    lspuprog:sourceDocument "campus_curriculum_clean.md (maintainer-supplied campus curriculum; not from the CHED CMO, Handbook or Citizen's Charter)." .

lspuprog:Subj_BSCS_IS_GEC101 a lspuprog:Subject ;
    rdfs:label "GEC 101 — Understanding the Self (BSCS - Major in Intelligent Systems, Year 1, 1st Semester)" ;
    lspuprog:subjectCode "GEC 101" ;
    lspuprog:subjectTitle "Understanding the Self" ;
    lspuprog:belongsToProgram lspuprog:Prog_BSCS_IS ;
    lspuprog:yearLevel 1 ;
    lspuprog:semester "1st Semester" ;
    lspuprog:units 3 ;
    lspuprog:subjectDescription "Examines the self through psychological, sociological, anthropological, and philosophical lenses. Students explore identity formation and how various disciplines frame human experience. The course encourages self-reflection as a foundation for personal growth throughout college life." ;
    lspuprog:sourceDocument "campus_curriculum_clean.md (maintainer-supplied campus curriculum; not from the CHED CMO, Handbook or Citizen's Charter)." .

lspuprog:Subj_BSCS_IS_GEC102 a lspuprog:Subject ;
    rdfs:label "GEC 102 — Readings in Philippine History (BSCS - Major in Intelligent Systems, Year 1, 1st Semester)" ;
    lspuprog:subjectCode "GEC 102" ;
    lspuprog:subjectTitle "Readings in Philippine History" ;
    lspuprog:belongsToProgram lspuprog:Prog_BSCS_IS ;
    lspuprog:yearLevel 1 ;
    lspuprog:semester "1st Semester" ;
    lspuprog:units 3 ;
    lspuprog:subjectDescription "Examines Philippine history through primary source documents. Students learn to read and interpret original historical texts. This approach builds critical thinking skills that go beyond memorizing dates and events." ;
    lspuprog:sourceDocument "campus_curriculum_clean.md (maintainer-supplied campus curriculum; not from the CHED CMO, Handbook or Citizen's Charter)." .

lspuprog:Subj_BSCS_IS_PI100 a lspuprog:Subject ;
    rdfs:label "P.I. 100 — The Life and Works of Jose Rizal (BSCS - Major in Intelligent Systems, Year 1, 1st Semester)" ;
    lspuprog:subjectCode "P.I. 100" ;
    lspuprog:subjectTitle "The Life and Works of Jose Rizal" ;
    lspuprog:belongsToProgram lspuprog:Prog_BSCS_IS ;
    lspuprog:yearLevel 1 ;
    lspuprog:semester "1st Semester" ;
    lspuprog:units 3 ;
    lspuprog:subjectDescription "Studies Rizal's life, writings (Noli Me Tangere, El Filibusterismo), and his role in Philippine nationalism. Students analyze his lasting legacy in shaping national identity. The course is mandated for all Philippine college students under Republic Act 1425." ;
    lspuprog:sourceDocument "campus_curriculum_clean.md (maintainer-supplied campus curriculum; not from the CHED CMO, Handbook or Citizen's Charter)." .

lspuprog:Subj_BSCS_IS_KOMFIL a lspuprog:Subject ;
    rdfs:label "KOMFIL — Kontekstwalisadong Komunikasyon sa Filipino (BSCS - Major in Intelligent Systems, Year 1, 1st Semester)" ;
    lspuprog:subjectCode "KOMFIL" ;
    lspuprog:subjectTitle "Kontekstwalisadong Komunikasyon sa Filipino" ;
    lspuprog:belongsToProgram lspuprog:Prog_BSCS_IS ;
    lspuprog:yearLevel 1 ;
    lspuprog:semester "1st Semester" ;
    lspuprog:units 3 ;
    lspuprog:subjectDescription "Develops Filipino communication skills in contextualized academic and professional settings. Students practice discipline-specific Filipino registers. The course strengthens the ability to express technical and academic ideas in the national language." ;
    lspuprog:sourceDocument "campus_curriculum_clean.md (maintainer-supplied campus curriculum; not from the CHED CMO, Handbook or Citizen's Charter)." .

lspuprog:Subj_BSCS_IS_NSTP1 a lspuprog:Subject ;
    rdfs:label "NSTP 1 — CWTS 1 (BSCS - Major in Intelligent Systems, Year 1, 1st Semester)" ;
    lspuprog:subjectCode "NSTP 1" ;
