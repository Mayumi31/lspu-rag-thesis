lspuadm:Serv_OfferingOfUnscheduledSubjects_S1 a lspuadm:ServiceStep ;
    rdfs:label "Step 1: Submit request and verification" ;
    lspuadm:clientAction "Submits letter request for the offering of unscheduled subject/s and copy of evaluation of grades from the Registrar to the Office of the Dean/Associate Dean." ;
    lspuadm:agencyAction "Receives the letter request and verifies the need for the offering of unscheduled subject/s." ;
