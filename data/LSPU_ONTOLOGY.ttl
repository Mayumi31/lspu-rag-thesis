    lspuprog:yearLevel 2 ;
    lspuprog:semester "2nd Semester" ;
    lspuprog:units 3 ;
    lspuprog:subjectDescription "Focuses on building real-world applications using current frameworks and tools. Students apply prior programming knowledge to practical projects. The course also introduces students to emerging technology trends relevant to industry." ;
    lspuprog:sourceDocument "campus_curriculum_clean.md (maintainer-supplied campus curriculum; not from the CHED CMO, Handbook or Citizen's Charter)." .

lspuprog:Subj_BSCS_IS_CSEL301 a lspuprog:Subject ;
    rdfs:label "CSEL 301 — Introduction to Graphics and Visual Computing (BSCS - Major in Intelligent Systems, Year 2, 2nd Semester)" ;
    lspuprog:subjectCode "CSEL 301" ;
    lspuprog:subjectTitle "Introduction to Graphics and Visual Computing" ;
    lspuprog:belongsToProgram lspuprog:Prog_BSCS_IS ;
    lspuprog:yearLevel 2 ;
    lspuprog:semester "2nd Semester" ;
    lspuprog:units 3 ;
    lspuprog:subjectDescription "Introduces computer graphics fundamentals, including rendering pipelines and geometric transformations. Students work with basic graphics APIs. This course provides a technical foundation useful for later visual computing topics." ;
    lspuprog:sourceDocument "campus_curriculum_clean.md (maintainer-supplied campus curriculum; not from the CHED CMO, Handbook or Citizen's Charter)." .

lspuprog:Subj_BSCS_IS_CSEL302 a lspuprog:Subject ;
    rdfs:label "CSEL 302 — Introduction to Intelligent Systems (BSCS - Major in Intelligent Systems, Year 2, 2nd Semester)" ;
    lspuprog:subjectCode "CSEL 302" ;
    lspuprog:subjectTitle "Introduction to Intelligent Systems" ;
    lspuprog:belongsToProgram lspuprog:Prog_BSCS_IS ;
    lspuprog:yearLevel 2 ;
    lspuprog:semester "2nd Semester" ;
    lspuprog:units 3 ;
    lspuprog:subjectDescription "Introduces foundational AI concepts including search algorithms and knowledge representation. Students get their first exposure to machine learning basics. This course marks the formal start of the Intelligent Systems specialization track." ;
    lspuprog:sourceDocument "campus_curriculum_clean.md (maintainer-supplied campus curriculum; not from the CHED CMO, Handbook or Citizen's Charter)." .

lspuprog:Subj_BSCS_IS_PATHFIT4 a lspuprog:Subject ;
