    lspuprog:semester "2nd Semester" ;
    lspuprog:units 2 ;
    lspuprog:subjectDescription "The culminating PATHFit course, continuing the student's chosen physical activity specialization. Emphasizes sustained fitness practice as a lifestyle habit. It completes the four-course PATHFit physical education requirement." ;
    lspuprog:sourceDocument "campus_curriculum_clean.md (maintainer-supplied campus curriculum; not from the CHED CMO, Handbook or Citizen's Charter)." .

lspuprog:Subj_BSCS_IS_CMSC305 a lspuprog:Subject ;
    rdfs:label "CMSC 305 — Automata Theory and Formal Languages (BSCS - Major in Intelligent Systems, Year 3, 1st Semester)" ;
    lspuprog:subjectCode "CMSC 305" ;
    lspuprog:subjectTitle "Automata Theory and Formal Languages" ;
    lspuprog:belongsToProgram lspuprog:Prog_BSCS_IS ;
    lspuprog:yearLevel 3 ;
    lspuprog:semester "1st Semester" ;
    lspuprog:units 3 ;
    lspuprog:lectureUnits 3 ; lspuprog:laboratoryUnits 0 ;
    lspuprog:hasPrerequisite lspuprog:Subj_BSCS_IS_CMSC204 ;
    lspuprog:subjectDescription "Covers formal language theory, finite automata, regular expressions, and Turing machines. Students learn the theoretical limits of what computers can compute. This theory underlies the design of compilers and language processors." ;
    lspuprog:sourceDocument "campus_curriculum_clean.md (maintainer-supplied campus curriculum; not from the CHED CMO, Handbook or Citizen's Charter)." .

lspuprog:Subj_BSCS_IS_CMSC306 a lspuprog:Subject ;
    rdfs:label "CMSC 306 — Computer Architecture and Organization (BSCS - Major in Intelligent Systems, Year 3, 1st Semester)" ;
    lspuprog:subjectCode "CMSC 306" ;
    lspuprog:subjectTitle "Computer Architecture and Organization" ;
