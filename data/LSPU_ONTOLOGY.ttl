    lspu:nextStep lspuadm:Serv_OfferingOfUnscheduledSubjects_S2 ;
    lspuadm:sourceSection "XXXI. Colleges, Service 1: Offering of Unscheduled Subject/s, Step 1, p. 85" .

lspuadm:Serv_OfferingOfUnscheduledSubjects_S2 a lspuadm:ServiceStep ;
    rdfs:label "Step 2: Forward to Registrar" ;
    lspuadm:agencyAction "Forwards the request to the Office of the Registrar." ;
    lspuadm:hasFeeText "N/A" ; lspuadm:hasProcessingTime "10 minutes" ;
    lspu:performedBy lspuadm:Role_DeanAssociateDean ;
    lspu:nextStep lspuadm:Serv_OfferingOfUnscheduledSubjects_S3 ;
    lspuadm:sourceSection "XXXI. Colleges, Service 1: Offering of Unscheduled Subject/s, Step 2, p. 85" .

