lspuadm:Serv_ProcessingOfStudentID a lspuadm:Service ;
    rdfs:label "Processing of Student ID" ;
    lspu:definition "ID processing for students, employees, and alumni." ;
    lspuadm:availedAt lspuadm:Office_BusinessAffairsOffice ;
    lspuadm:hasCategory lspuadm:Cat_Simple ; lspuadm:classificationText "Simple" ;
    lspuadm:hasTransactionType lspuadm:TT_G2C ;
    lspuadm:whoMayAvail "Students, Employees and Alumni" ;
    lspu:requiresDocument lspuadm:Doc_CORForID ;
    lspu:hasStep lspuadm:StudentID_Step1 ;
    lspuadm:totalFeeText "Php 100.00" ; lspuadm:totalProcessingTime "4 minutes" ;
    lspuadm:sourceDocument "LSPU Citizen's Charter, 2026 1st Edition (University-Wide)" ;
    lspuadm:sourceSection "V. Business Affairs, Marketing and Production Office, Service 1: Processing of Student ID, p. 13" ;
    lspu:alternateQuestion "What if I lose my ID, or I find someone else's ID?" ,
        "I found a student ID, where do I give it?" ,
        "Where do I return a found ID?" ,
        "I lost my school ID, what do I do?" ,
        "Where are lost IDs turned in?" ,
        "How do I replace a lost ID?" ,
        "Who keeps found IDs?" ,
        "How do I get my student ID and how much is it?" ,
        "Where do I process my school ID?" ,
        "How much does the LSPU ID cost?" ,
        "What do I need to get an ID?" ,
        "Where can I get my ID at LSPU?" ,
        "How much does the student ID cost?" ,
        "Is the student ID free for freshmen?" ,
        "How much is the ID lace?" ,
        "Where do I buy the ID lace?" ,
        "Do first-year students pay for the ID?" ;
    lspu:audience "All students" ,
        "New students" ;
    lspu:additionalInfo "If you FOUND an ID, hand it to the guard office (the Guard House at the main gate, on the left as you enter) or to the student council (the Supreme Student Council or your college's student council), who can return it to its owner." ,
        "If you LOST your ID, check the guard office and the student council first, because found IDs are turned in there." ,
        "If it is not found, go to the Business Affairs Office (BAO), which handles student ID processing; the Citizen's Charter lists Php 100.00 for ID processing and the ID lace costs Php 130, but the replacement fee and steps for a lost ID are not documented, so ask BAO." ,
        "The Handbook requires wearing the University ID at all times on campus (not doing so is a minor offense), so replace it as soon as you can." ,
        "The Citizen's Charter lists a fee of Php 100.00, while campus information says the official ID is free for first-year students; the sources do not say which students pay the Php 100.00, so confirm at BAO." ,
        "You bring your Certificate of Registration (COR), scan the QR code or fill out the Google Form, wait for your data to be encoded and the ID printed, then sign the logbook." ;
    rdfs:seeAlso lspu:Loc_GuardHouse ,
        lspu:Org_SupremeStudentCouncil ,
        lspu:Duty_WearIDAndUniform ,
        lspu:Price_IDLace ,
        lspu:Price_IDCardFirstYear ;
    lspu:verificationNote "The lost-ID replacement fee and process were not supplied; confirm at BAO." ,
        "The Citizen's Charter lists Php 100.00 for ID processing; the maintainer reports the ID card is free for first-year students and the lace costs Php 130. Confirm at BAO which students pay Php 100.00." ;
    lspu:sourceArticle "Found-ID hand-in points: Campus information supplied by the ontology maintainer (an LSPU-LB student), September 2026; not from the Handbook or Citizen's Charter. ID processing: Citizen's Charter 2026, Business Affairs Office, Service 1, p. 13. Wearing the ID: Handbook Chapter 6, Article 3, Sec. 4" ,
        "Citizen's Charter 2026, Business Affairs, Marketing and Production Office, Service 1, p. 13" .

