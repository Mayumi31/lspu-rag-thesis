lspuadm:GoodMoralUG_Step1 a lspuadm:ServiceStep ;
    rdfs:label "Step 1: Present Certificate of Registration" ;
    lspuadm:clientAction "Presents the Certificate of Registration." ;
    lspuadm:agencyAction "Receives and checks submitted documents; issues Good Moral payment slip." ;
    lspuadm:hasFeeText "None" ; lspuadm:hasProcessingTime "5 minutes" ;
    lspu:performedBy lspuadm:Role_OSASDirectorStaff ;
    lspu:nextStep lspuadm:GoodMoralUG_Step2 ;
