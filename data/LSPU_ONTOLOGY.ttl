    lspuprog:semester "1st Semester" ;
    lspuprog:units 3 ;
    lspuprog:subjectDescription "Studies how individuals think, feel, and behave in social contexts, including group dynamics, conformity, and attitudes. Students examine classic social psychology experiments and their real-world implications. This course complements the specialized Group Dynamics elective." ;
    lspuprog:sourceDocument "campus_curriculum_clean.md (maintainer-supplied campus curriculum; not from the CHED CMO, Handbook or Citizen's Charter)." .

lspuprog:Subj_BSPsych_PSYELEC3 a lspuprog:Subject ;
