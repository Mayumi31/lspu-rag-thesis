    lspuprog:subjectTitle "Living in the IT Era" ;
    lspuprog:belongsToProgram lspuprog:Prog_BSPsych ;
    lspuprog:yearLevel 1 ;
    lspuprog:semester "1st Semester" ;
    lspuprog:units 3 ;
    lspuprog:subjectDescription "Introduces students to digital literacy, information technology tools, and their impact on modern life. Students explore online safety, digital communication, and technology's role in society. The course builds practical tech competency for academic and everyday use." ;
    lspuprog:sourceDocument "campus_curriculum_clean.md (maintainer-supplied campus curriculum; not from the CHED CMO, Handbook or Citizen's Charter)." .

