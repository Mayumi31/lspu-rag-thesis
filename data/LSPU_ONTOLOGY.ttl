lspuprog:Subj_BSPsych_PSY5 a lspuprog:Subject ;
    rdfs:label "PSY 5 — Physiological/Biological Psychology (BS Psychology, Year 3, 1st Semester)" ;
    lspuprog:subjectCode "PSY 5" ;
    lspuprog:subjectTitle "Physiological/Biological Psychology" ;
    lspuprog:belongsToProgram lspuprog:Prog_BSPsych ;
    lspuprog:yearLevel 3 ;
    lspuprog:semester "1st Semester" ;
    lspuprog:units 3 ;
    lspuprog:subjectDescription "Examines the biological bases of behavior, including brain structure, neurotransmission, and the nervous system. Students learn how physiological processes underlie cognition and emotion. This course draws on the biology and chemistry foundation from earlier science electives." ;
    lspuprog:sourceDocument "campus_curriculum_clean.md (maintainer-supplied campus curriculum; not from the CHED CMO, Handbook or Citizen's Charter)." .

lspuprog:Subj_BSPsych_PSY6 a lspuprog:Subject ;
    rdfs:label "PSY 6 — Abnormal Psychology (BS Psychology, Year 3, 1st Semester)" ;
    lspuprog:subjectCode "PSY 6" ;
    lspuprog:subjectTitle "Abnormal Psychology" ;
