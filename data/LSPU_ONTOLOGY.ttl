    lspuprog:subjectDescription "The second Civic Welfare Training Service course, continuing community engagement from NSTP 1. Students typically implement a community project. This course completes the two-part NSTP civic service requirement." ;
    lspuprog:sourceDocument "campus_curriculum_clean.md (maintainer-supplied campus curriculum; not from the CHED CMO, Handbook or Citizen's Charter)." .

lspuprog:Subj_BSCS_IS_ITEC103 a lspuprog:Subject ;
    rdfs:label "ITEC 103 — Intermediate Programming (BSCS - Major in Intelligent Systems, Year 1, 2nd Semester)" ;
    lspuprog:subjectCode "ITEC 103" ;
    lspuprog:subjectTitle "Intermediate Programming" ;
