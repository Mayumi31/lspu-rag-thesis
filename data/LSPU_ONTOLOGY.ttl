lspuprog:Subj_BSPsych_PSY11 a lspuprog:Subject ;
    rdfs:label "PSY 11 — Cognitive Psychology (BS Psychology, Year 4, 1st Semester)" ;
    lspuprog:subjectCode "PSY 11" ;
    lspuprog:subjectTitle "Cognitive Psychology" ;
