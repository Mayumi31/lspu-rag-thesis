    lspuprog:yearLevel 1 ;
    lspuprog:semester "2nd Semester" ;
    lspuprog:units 2 ;
    lspuprog:subjectDescription "Continues the PATHFit series with structured exercise routines. Students track and improve personal fitness metrics. It builds directly on the movement foundations established in PATHFit 1." ;
    lspuprog:sourceDocument "campus_curriculum_clean.md (maintainer-supplied campus curriculum; not from the CHED CMO, Handbook or Citizen's Charter)." .

lspuprog:Subj_BSCS_IS_NSTP2 a lspuprog:Subject ;
    rdfs:label "NSTP 2 — CWTS 2 (BSCS - Major in Intelligent Systems, Year 1, 2nd Semester)" ;
    lspuprog:subjectCode "NSTP 2" ;
    lspuprog:subjectTitle "CWTS 2" ;
