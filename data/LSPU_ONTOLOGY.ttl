lspu:hasCollege a owl:ObjectProperty ; rdfs:domain lspu:Campus ; rdfs:range lspuprog:College ; owl:inverseOf lspu:collegeOfCampus ;
    rdfs:comment "Links the campus to a college that operates on it. Replaces the old lspu:summarizes link from Summary_ProgramCatalog." .
lspu:collegeOfCampus a owl:ObjectProperty ; rdfs:domain lspuprog:College ; rdfs:range lspu:Campus .
lspu:hasEvent a owl:ObjectProperty ; rdfs:domain lspu:Campus ; rdfs:range lspu:CampusEvent ; owl:inverseOf lspu:eventOfCampus ;
    rdfs:comment "Links the campus to an event held there or run by it." .
lspu:eventOfCampus a owl:ObjectProperty ; rdfs:domain lspu:CampusEvent ; rdfs:range lspu:Campus .
lspu:hasEmergencyContact a owl:ObjectProperty ; rdfs:domain lspu:Campus ; rdfs:range lspu:EmergencyContact ; owl:inverseOf lspu:emergencyContactOfCampus ;
    rdfs:comment "Links the campus to an emergency contact students can use." .
lspu:emergencyContactOfCampus a owl:ObjectProperty ; rdfs:domain lspu:EmergencyContact ; rdfs:range lspu:Campus .
lspu:hasCampusOrganization a owl:ObjectProperty ; rdfs:domain lspu:Campus ; rdfs:range lspu:StudentOrganization ; owl:inverseOf lspu:organizationOfCampus ;
    rdfs:comment "Links the campus to a campus-wide student organization or council that does not belong to a single college (college-level ones use lspu:hasStudentOrganization)." .
lspu:organizationOfCampus a owl:ObjectProperty ; rdfs:range lspu:Campus .

