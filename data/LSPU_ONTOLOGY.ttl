    lspuadm:clientAction "Presents the Evaluated Grades/Report of Grades to the Registration Adviser/Program Coordinator/College Dean." ;
    lspuadm:agencyAction "Checks the client's adherence to the prescribed curriculum." ;
    lspuadm:hasFeeText "None" ; lspuadm:hasProcessingTime "7 minutes" ;
