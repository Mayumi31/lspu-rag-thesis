lspuprog:Subj_BSPsych_PSY2 a lspuprog:Subject ;
    rdfs:label "PSY 2 — Experimental Psychology (BS Psychology, Year 2, 1st Semester)" ;
    lspuprog:subjectCode "PSY 2" ;
