    lspuprog:yearLevel 1 ;
    lspuprog:semester "1st Semester" ;
    lspuprog:units 3 ;
    lspuprog:subjectDescription "Introduces foundational concepts of computing, computer systems, and IT's role in society. Covers number systems, hardware/software basics, and the history of computing. This course establishes the baseline vocabulary used throughout the rest of the program." ;
    lspuprog:sourceDocument "campus_curriculum_clean.md (maintainer-supplied campus curriculum; not from the CHED CMO, Handbook or Citizen's Charter)." .

lspuprog:Subj_BSCS_IS_ITEC102 a lspuprog:Subject ;
    rdfs:label "ITEC 102 — Fundamentals of Programming (BSCS - Major in Intelligent Systems, Year 1, 1st Semester)" ;
    lspuprog:subjectCode "ITEC 102" ;
    lspuprog:subjectTitle "Fundamentals of Programming" ;
    lspuprog:belongsToProgram lspuprog:Prog_BSCS_IS ;
    lspuprog:yearLevel 1 ;
    lspuprog:semester "1st Semester" ;
    lspuprog:units 3 ;
    lspuprog:subjectDescription "Introduces programming logic and basic constructs such as variables, control structures, and loops. Students learn algorithmic thinking through hands-on coding. It serves as the entry point into the program's entire programming sequence." ;
    lspuprog:sourceDocument "campus_curriculum_clean.md (maintainer-supplied campus curriculum; not from the CHED CMO, Handbook or Citizen's Charter)." .

lspuprog:Subj_BSCS_IS_PATHFIT1 a lspuprog:Subject ;
    rdfs:label "PATHFit 1 — Movement Competency Training (MCT) (BSCS - Major in Intelligent Systems, Year 1, 1st Semester)" ;
