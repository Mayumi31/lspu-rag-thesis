    lspuprog:hasPrerequisite lspuprog:Subj_BSCS_IS_ITEC105 ;
    lspuprog:subjectDescription "Introduces cryptography basics, network security, and risk management principles. Students learn to identify and mitigate common security vulnerabilities. It builds directly on the database concepts covered in Information Management." ;
    lspuprog:sourceDocument "campus_curriculum_clean.md (maintainer-supplied campus curriculum; not from the CHED CMO, Handbook or Citizen's Charter)." .

lspuprog:Subj_BSCS_IS_CMSC309 a lspuprog:Subject ;
