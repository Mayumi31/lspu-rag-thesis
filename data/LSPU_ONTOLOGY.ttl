    lspuprog:unitsNote "The source curriculum shows this unit value in parentheses, i.e. \"(3)\"; the meaning of the parentheses is not stated in the source." ;
    lspuprog:subjectDescription "The Civic Welfare Training Service component of the National Service Training Program. Students engage in community-based service projects. It fulfills part of the mandatory national service requirement for college students." ;
    lspuprog:sourceDocument "campus_curriculum_clean.md (maintainer-supplied campus curriculum; not from the CHED CMO, Handbook or Citizen's Charter)." .

lspuprog:Subj_BSCS_IS_ITEC101 a lspuprog:Subject ;
    rdfs:label "ITEC 101 — Introduction to Computing (BSCS - Major in Intelligent Systems, Year 1, 1st Semester)" ;
    lspuprog:subjectCode "ITEC 101" ;
    lspuprog:subjectTitle "Introduction to Computing" ;
