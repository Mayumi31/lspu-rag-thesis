lspuadm:Serv_CompletionOfINCRemovalOnlineSystem_S2 a lspuadm:ServiceStep ;
    rdfs:label "Step 2: Pay completion fee" ;
    lspuadm:clientAction "Pays the corresponding completion fee to the Cashier's Office through the online system." ;
    lspuadm:agencyAction "After receiving the student's payment, the cashier puts the OR number on the completion form of the student through the online system." ;
    lspuadm:hasFeeText "P30.00 per unit" ; lspuadm:hasProcessingTime "5 minutes" ;
    lspu:performedBy lspuadm:Role_CashiersOfficeUnit ;
