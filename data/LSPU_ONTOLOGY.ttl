lspuprog:Prog_BSCS_IS a lspuprog:Program ;
    lspuprog:programName "Bachelor of Science in Computer Science - Major in Intelligent Systems" ;
    lspuprog:alias "BSCS", "BSCS-IS", "BSCS IS", "BS CS", "CS", "Computer Science", "BS Computer Science", "Comp Sci", "Intelligent Systems" ;
    lspuprog:hasDegree lspuprog:Degree_BSCS ; lspuprog:hasMajor lspuprog:Major_IntelligentSystems ;
    lspuprog:offeredByCollege lspuprog:CCS ;
    lspuprog:programDurationYears 4 ;
    lspuprog:programOverview "Covers theoretical/mathematical computer science foundations (algorithms, computation theory, systems) and a standard software-engineering core (programming, databases, networks, security), with an artificial-intelligence specialization (machine learning, natural language processing, computer vision, robotics)." ;
    lspuprog:teachesSkill lspuprog:Skill_Programming, lspuprog:Skill_DataStructuresAlgorithms, lspuprog:Skill_DatabaseManagement, lspuprog:Skill_SoftwareEngineering, lspuprog:Skill_NetworksSecurity, lspuprog:Skill_MachineLearning, lspuprog:Skill_NaturalLanguageProcessing, lspuprog:Skill_ComputerVision, lspuprog:Skill_Robotics ;
    lspuprog:preparesForOutcome lspuprog:Job_MLEngineer, lspuprog:Job_SoftwareDeveloper, lspuprog:Job_AIResearchAssistant ;
    lspuprog:hasAdmissionRequirement lspuprog:AdmReq_BSCS_IS ;
    lspuprog:hasLegalBasis lspuprog:CMO_25_s2015 ;
    lspuprog:boardProgram false .

