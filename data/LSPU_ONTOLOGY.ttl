    lspuprog:semester "1st Semester" ;
    lspuprog:units 3 ;
    lspuprog:subjectDescription "Examines the self through psychological, sociological, anthropological, and philosophical lenses. Students explore identity formation and how various disciplines frame human experience. The course encourages self-reflection as a foundation for personal growth throughout college life." ;
    lspuprog:sourceDocument "campus_curriculum_clean.md (maintainer-supplied campus curriculum; not from the CHED CMO, Handbook or Citizen's Charter)." .

lspuprog:Subj_BSPsych_GEC104 a lspuprog:Subject ;
    rdfs:label "GEC 104 — Mathematics in the Modern World (BS Psychology, Year 1, 1st Semester)" ;
    lspuprog:subjectCode "GEC 104" ;
    lspuprog:subjectTitle "Mathematics in the Modern World" ;
    lspuprog:belongsToProgram lspuprog:Prog_BSPsych ;
    lspuprog:yearLevel 1 ;
    lspuprog:semester "1st Semester" ;
    lspuprog:units 3 ;
    lspuprog:subjectDescription "Presents mathematics as a tool for understanding patterns, reasoning, and decision-making. Covers statistics, logic, and applied mathematical reasoning. The course is designed to make math relevant to everyday and professional situations rather than purely abstract computation." ;
    lspuprog:sourceDocument "campus_curriculum_clean.md (maintainer-supplied campus curriculum; not from the CHED CMO, Handbook or Citizen's Charter)." .

lspuprog:Subj_BSPsych_PI100 a lspuprog:Subject ;
    rdfs:label "P.I. 100 — The Life and Works of Jose Rizal (BS Psychology, Year 1, 1st Semester)" ;
    lspuprog:subjectCode "P.I. 100" ;
    lspuprog:subjectTitle "The Life and Works of Jose Rizal" ;
    lspuprog:belongsToProgram lspuprog:Prog_BSPsych ;
    lspuprog:yearLevel 1 ;
    lspuprog:semester "1st Semester" ;
    lspuprog:units 3 ;
    lspuprog:subjectDescription "Studies Rizal's life, writings (Noli Me Tangere, El Filibusterismo), and his role in Philippine nationalism. Students analyze his lasting legacy in shaping national identity. The course is mandated for all Philippine college students under Republic Act 1425." ;
    lspuprog:sourceDocument "campus_curriculum_clean.md (maintainer-supplied campus curriculum; not from the CHED CMO, Handbook or Citizen's Charter)." .

lspuprog:Subj_BSPsych_GECELEC1 a lspuprog:Subject ;
    rdfs:label "GEC ELEC 1 — Living in the IT Era (BS Psychology, Year 1, 1st Semester)" ;
