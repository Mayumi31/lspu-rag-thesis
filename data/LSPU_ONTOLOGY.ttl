    lspu:nextStep lspuadm:Serv_CompletionOfINCRemovalOnlineSystem_S4 ;
    lspuadm:sourceSection "XXXI. Colleges, Service 3: Completion of INC/Removal – Online System (College, Registrar, Cashier), Step 3, p. 87" .

