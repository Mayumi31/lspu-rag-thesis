    lspuprog:semester "1st Semester" ;
    lspuprog:units 3 ;
    lspuprog:subjectDescription "Examines mental processes including perception, memory, language, and problem-solving. Students learn cognitive models and how they explain everyday thinking and decision-making. This course adds a cognitive science dimension to the psychology curriculum." ;
    lspuprog:sourceDocument "campus_curriculum_clean.md (maintainer-supplied campus curriculum; not from the CHED CMO, Handbook or Citizen's Charter)." .

lspuprog:Subj_BSPsych_PSY12 a lspuprog:Subject ;
    rdfs:label "PSY 12 — Industrial/Organizational Psychology (BS Psychology, Year 4, 1st Semester)" ;
    lspuprog:subjectCode "PSY 12" ;
    lspuprog:subjectTitle "Industrial/Organizational Psychology" ;
