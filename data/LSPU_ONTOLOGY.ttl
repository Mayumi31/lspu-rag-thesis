    lspuprog:subjectDescription "Covers major theoretical frameworks for understanding human personality, including psychodynamic, humanistic, and trait-based approaches. Students learn to apply these theories to real behavioral case studies. This course builds directly on the developmental psychology foundation." ;
    lspuprog:sourceDocument "campus_curriculum_clean.md (maintainer-supplied campus curriculum; not from the CHED CMO, Handbook or Citizen's Charter)." .

lspuprog:Subj_BSPsych_PSY4 a lspuprog:Subject ;
