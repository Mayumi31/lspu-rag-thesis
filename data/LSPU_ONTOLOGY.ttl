    lspuprog:semester "1st Semester" ;
    lspuprog:units 3 ;
    lspuprog:subjectDescription "Covers differential and integral calculus with applications to rates of change and accumulation. Builds quantitative reasoning for later technical coursework. It supports later math-heavy topics in algorithms and machine learning." ;
    lspuprog:sourceDocument "campus_curriculum_clean.md (maintainer-supplied campus curriculum; not from the CHED CMO, Handbook or Citizen's Charter)." .

lspuprog:Subj_BSCS_IS_GEC107 a lspuprog:Subject ;
    rdfs:label "GEC 107 — Science, Technology and Society (BSCS - Major in Intelligent Systems, Year 2, 2nd Semester)" ;
    lspuprog:subjectCode "GEC 107" ;
    lspuprog:subjectTitle "Science, Technology and Society" ;
    lspuprog:belongsToProgram lspuprog:Prog_BSCS_IS ;
    lspuprog:yearLevel 2 ;
    lspuprog:semester "2nd Semester" ;
    lspuprog:units 3 ;
    lspuprog:subjectDescription "Examines the interplay between scientific advancement, technology, and societal change. Students critically assess technology's ethical and social implications. The course situates computing within a broader societal context." ;
    lspuprog:sourceDocument "campus_curriculum_clean.md (maintainer-supplied campus curriculum; not from the CHED CMO, Handbook or Citizen's Charter)." .

lspuprog:Subj_BSCS_IS_GEC108 a lspuprog:Subject ;
    rdfs:label "GEC 108 — Ethics (BSCS - Major in Intelligent Systems, Year 2, 2nd Semester)" ;
    lspuprog:subjectCode "GEC 108" ;
    lspuprog:subjectTitle "Ethics" ;
    lspuprog:belongsToProgram lspuprog:Prog_BSCS_IS ;
    lspuprog:yearLevel 2 ;
    lspuprog:semester "2nd Semester" ;
    lspuprog:units 3 ;
    lspuprog:subjectDescription "Introduces ethical theories and frameworks for moral reasoning. Students apply ethical analysis to real-world dilemmas. It provides groundwork for later coursework on professional ethics in computing." ;
    lspuprog:sourceDocument "campus_curriculum_clean.md (maintainer-supplied campus curriculum; not from the CHED CMO, Handbook or Citizen's Charter)." .

lspuprog:Subj_BSCS_IS_CMSC204 a lspuprog:Subject ;
    rdfs:label "CMSC 204 — Algorithms and Complexity (BSCS - Major in Intelligent Systems, Year 2, 2nd Semester)" ;
    lspuprog:subjectCode "CMSC 204" ;
    lspuprog:subjectTitle "Algorithms and Complexity" ;
    lspuprog:belongsToProgram lspuprog:Prog_BSCS_IS ;
    lspuprog:yearLevel 2 ;
    lspuprog:semester "2nd Semester" ;
    lspuprog:units 3 ;
    lspuprog:hasPrerequisite lspuprog:Subj_BSCS_IS_CMSC202 ;
    lspuprog:subjectDescription "Covers algorithm design paradigms (divide-and-conquer, dynamic programming, greedy methods) and complexity analysis via Big-O notation. Students learn to evaluate algorithmic efficiency and basic NP-completeness concepts. It is a gateway course for several advanced subjects later in the curriculum." ;
    lspuprog:sourceDocument "campus_curriculum_clean.md (maintainer-supplied campus curriculum; not from the CHED CMO, Handbook or Citizen's Charter)." .

lspuprog:Subj_BSCS_IS_ITEC106 a lspuprog:Subject ;
    rdfs:label "ITEC 106 — Applications Development and Emerging Technologies (BSCS - Major in Intelligent Systems, Year 2, 2nd Semester)" ;
    lspuprog:subjectCode "ITEC 106" ;
    lspuprog:subjectTitle "Applications Development and Emerging Technologies" ;
