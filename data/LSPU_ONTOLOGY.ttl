    lspuprog:yearLevel 1 ;
    lspuprog:semester "1st Semester" ;
    lspuprog:units 2 ;
    lspuprog:subjectDescription "Basic movement competency and fitness training. Students learn proper form and baseline fitness assessment. This course lays the groundwork for the subsequent PATHFit courses." ;
    lspuprog:sourceDocument "campus_curriculum_clean.md (maintainer-supplied campus curriculum; not from the CHED CMO, Handbook or Citizen's Charter)." .

lspuprog:Subj_BSCS_IS_GEC104 a lspuprog:Subject ;
    rdfs:label "GEC 104 — Mathematics in the Modern World (BSCS - Major in Intelligent Systems, Year 1, 2nd Semester)" ;
    lspuprog:subjectCode "GEC 104" ;
    lspuprog:subjectTitle "Mathematics in the Modern World" ;
    lspuprog:belongsToProgram lspuprog:Prog_BSCS_IS ;
    lspuprog:yearLevel 1 ;
    lspuprog:semester "2nd Semester" ;
    lspuprog:units 3 ;
    lspuprog:subjectDescription "Presents mathematics as a tool for understanding patterns, reasoning, and decision-making. Covers statistics, logic, and applied mathematical reasoning. The course is designed to make math relevant to everyday and professional situations rather than purely abstract computation." ;
    lspuprog:sourceDocument "campus_curriculum_clean.md (maintainer-supplied campus curriculum; not from the CHED CMO, Handbook or Citizen's Charter)." .

lspuprog:Subj_BSCS_IS_GEC103 a lspuprog:Subject ;
    rdfs:label "GEC 103 — The Contemporary World (BSCS - Major in Intelligent Systems, Year 1, 2nd Semester)" ;
    lspuprog:subjectCode "GEC 103" ;
    lspuprog:subjectTitle "The Contemporary World" ;
    lspuprog:belongsToProgram lspuprog:Prog_BSCS_IS ;
    lspuprog:yearLevel 1 ;
    lspuprog:semester "2nd Semester" ;
    lspuprog:units 3 ;
    lspuprog:subjectDescription "Examines globalization and its economic, political, and cultural dimensions. Students analyze how global interconnectedness shapes local realities. The course encourages a broader, more critical view of current world affairs." ;
    lspuprog:sourceDocument "campus_curriculum_clean.md (maintainer-supplied campus curriculum; not from the CHED CMO, Handbook or Citizen's Charter)." .

lspuprog:Subj_BSCS_IS_GEC105 a lspuprog:Subject ;
    rdfs:label "GEC 105 — Purposive Communication (BSCS - Major in Intelligent Systems, Year 1, 2nd Semester)" ;
    lspuprog:subjectCode "GEC 105" ;
    lspuprog:subjectTitle "Purposive Communication" ;
    lspuprog:belongsToProgram lspuprog:Prog_BSCS_IS ;
    lspuprog:yearLevel 1 ;
    lspuprog:semester "2nd Semester" ;
    lspuprog:units 3 ;
    lspuprog:subjectDescription "Develops writing and speaking skills for academic and professional purposes. Students practice communication across varied genres and contexts. It prepares students for the kinds of writing and presentations expected in the workplace." ;
    lspuprog:sourceDocument "campus_curriculum_clean.md (maintainer-supplied campus curriculum; not from the CHED CMO, Handbook or Citizen's Charter)." .

lspuprog:Subj_BSCS_IS_FILDIS a lspuprog:Subject ;
