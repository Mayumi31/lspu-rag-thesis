    lspuadm:hasFeeText "None" ; lspuadm:hasProcessingTime "5 minutes" ;
    lspu:performedBy lspuadm:Role_OSASDirectorStaff ;
    lspu:nextStep lspuadm:GoodMoralUG_Step5 ;
    lspuadm:sourceSection "VIII. Office of the Student Affairs and Services, Service 5: Issuance of Good Moral Certificate (Undergraduate), Step 4, p. 19" .

lspuadm:GoodMoralUG_Step5 a lspuadm:ServiceStep ;
