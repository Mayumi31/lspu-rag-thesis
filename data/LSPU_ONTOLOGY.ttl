    lspuprog:sourceDocument "campus_curriculum_clean.md (maintainer-supplied campus curriculum; not from the CHED CMO, Handbook or Citizen's Charter)." .

lspuprog:Subj_BSCS_IS_ITEC105 a lspuprog:Subject ;
    rdfs:label "ITEC 105 — Information Management (BSCS - Major in Intelligent Systems, Year 2, 1st Semester)" ;
    lspuprog:subjectCode "ITEC 105" ;
    lspuprog:subjectTitle "Information Management" ;
