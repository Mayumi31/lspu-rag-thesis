lspuadm:Serv_OfferingOfUnscheduledSubjects_S4 a lspuadm:ServiceStep ;
    rdfs:label "Step 4: Inform the student" ;
    lspuadm:agencyAction "Informs the student that the subject requested has been offered (or not) upon receipt of the approved request." ;
    lspuadm:hasFeeText "N/A" ; lspuadm:hasProcessingTime "5 minutes" ;
