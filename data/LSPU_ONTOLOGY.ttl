    lspuadm:clientAction "Informs the subject teacher that he/she already applied for online completion of the INC/4.0 grade." ;
    lspuadm:agencyAction "The subject teacher gives the corresponding grades through the online system." ;
    lspuadm:hasFeeText "N/A" ; lspuadm:hasProcessingTime "5 minutes" ;
