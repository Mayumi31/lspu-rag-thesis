lspu:Price_Laboratory a lspu:CampusItemPrice ;
    rdfs:label "Laboratory costs" ;
    lspu:priceMinPHP "0"^^xsd:decimal ;
    lspu:priceMaxPHP "0"^^xsd:decimal ;
    lspu:priceNote "Laboratory costs are already included in the tuition, which is free for students covered by free higher education." ;
    lspu:priceAsOf "2026-09" ;
    lspu:definition "There is no separate laboratory fee: laboratory costs are already included in the tuition, and tuition is free for students covered by free higher education." ;
    lspu:verificationNote "Applies to students covered by free higher education. Students who are not covered (see lspu:Right_FreeHigherEducation) are assessed by the Accounting Office; no laboratory-fee amount is documented for them. Consumable materials or supplies for a subject, if any, are not documented." ;
    lspu:sourceArticle "Campus information supplied by the ontology maintainer (an LSPU-LB student), September 2026; not from the Handbook or Citizen's Charter" ;
    lspu:alternateQuestion "Do I pay separate laboratory fees?" ,
        "How much is the laboratory fee?" ,
        "Are laboratory costs free?" ,
        "Is the lab fee included in tuition?" ,
        "Do I need to pay for laboratory subjects?" ,
        "Are lab fees covered by free tuition?" ;
    lspu:audience "New students" ;
    rdfs:seeAlso lspu:Right_FreeHigherEducation .

