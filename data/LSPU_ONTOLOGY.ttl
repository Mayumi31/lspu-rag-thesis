    rdfs:subClassOf lspu:Office ;
    rdfs:label "Digital Platform" ;
    rdfs:comment "An online system or software service students use for school activities (e.g. the LSPU Student Portal, Google Workspace). A subclass of lspu:Office so existing queries on offices/service points still find it." .

lspu:PlatformFunction a owl:Class ;
    rdfs:label "Platform Function" ;
    rdfs:comment "One specific thing a DigitalPlatform lets a student do (e.g. view grades, enlist subjects, join an online class)." .

lspu:hasFunction a owl:ObjectProperty ;
    rdfs:domain lspu:DigitalPlatform ; rdfs:range lspu:PlatformFunction ; owl:inverseOf lspu:functionOf ;
    rdfs:comment "Links a digital platform to something a student can do on it." .
lspu:functionOf a owl:ObjectProperty ;
    rdfs:domain lspu:PlatformFunction ; rdfs:range lspu:DigitalPlatform .

lspu:alternateQuestion a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:comment "Another natural-language phrasing of a question this entity answers (for example \"How much is the ID lace?\" on the ID-lace price), to improve retrieval matching. Merged onto the entities themselves in v18 when the separate FAQ layer was removed." .
lspu:audience a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:comment "Who this information is mainly for (for example \"New students, applicants\"). Merged onto the entities themselves in v18." .
lspu:additionalInfo a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:comment "Supplementary detail (a step, condition, caveat or clarification) that was stated in a former FAQ answer but not yet in this entity. Merged in v18 when the separate FAQ layer was removed." .
lspu:accessUrl a owl:DatatypeProperty ; rdfs:domain lspu:DigitalPlatform ; rdfs:range xsd:string .
lspu:accountRequirement a owl:DatatypeProperty ; rdfs:domain lspu:DigitalPlatform ; rdfs:range xsd:string .
lspu:verificationNote a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:comment "Flags information that should be confirmed with the responsible LSPU-LB office before being treated as authoritative." .
lspu:programCount a owl:DatatypeProperty ; rdfs:range xsd:integer ;
    rdfs:comment "Number of programs counted; used on lspu:Campus and on lspuprog:College individuals (v19: moved off the removed CampusSummary class)." .
lspu:collegeCount a owl:DatatypeProperty ; rdfs:range xsd:integer ;
    rdfs:comment "Number of colleges counted; used on lspu:Campus and on lspuprog:College individuals (v19: moved off the removed CampusSummary class)." .

lspu:LSPUPortal a lspu:DigitalPlatform ;
    rdfs:comment "LSPU Student Portal, also called myaccount.lspu.edu.ph, the Student Web Portal, or the student portal. It is the university's online student account system for enrollment tasks and academic records." ;
    lspu:definition "The LSPU Student Portal (myaccount.lspu.edu.ph) is the university's online student account system. Students use it to view grades and enrollment status, enlist subjects during enrollment (old students), view their Certificate of Registration (COR), apply online to complete an INC or 4.0 grade, and check that grades match the Registrar's report. The Citizen's Charter calls it the Student Web Portal or student portal." ;
    lspu:accessUrl "myaccount.lspu.edu.ph" ;
    lspu:accountRequirement "Official LSPU student account. It is activated after the student is officially enrolled: visit the ICT office inside the College of Computer Studies (CCS) building and have your email and password verified." ;
    lspu:hasFunction lspu:PortalFn_ViewGrades, lspu:PortalFn_EnrollmentStatus, lspu:PortalFn_EnlistSubjects,
        lspu:PortalFn_ViewCOR, lspu:PortalFn_INCCompletion, lspu:PortalFn_VerifyGrades ;
    lspu:sourceArticle "Handbook Chapter 3, Article 5, Sec. 8.1.2; Citizen's Charter 2026: Enrollment (Registrar) p. 2-3, Completion of INC/Removal (Colleges, Service 3) p. 86-87, Enrollment Advising (Colleges, Service 9) p. 90" ;
    lspu:verificationNote "The new-student activation steps come from the ontology maintainer (ICT office inside the CCS building), not from the Handbook or Charter. Confirm the ICT office hours and any requirements before relying on them." .

lspu:PortalFn_ViewGrades a lspu:PlatformFunction ;
    rdfs:label "Portal function: view grades" ;
    lspu:definition "Students see their semester grades on the LSPU Portal, which reflects the same information as the Copy of Grades (COG), subject to the data privacy policy." ;
    lspu:sourceArticle "Handbook Chapter 3, Article 5, Sec. 8.1.1-8.1.2" .

lspu:PortalFn_EnrollmentStatus a lspu:PlatformFunction ;
    rdfs:label "Portal function: check enrollment status" ;
    lspu:definition "The portal shows a student's enrollment status and academic standing flags (such as Warning, Probation, INC) that also appear on the COG." ;
    lspu:sourceArticle "Handbook Chapter 3, Article 5, Sec. 8.1.2" .

lspu:PortalFn_EnlistSubjects a lspu:PlatformFunction ;
    rdfs:label "Portal function: enlist subjects for enrollment" ;
    lspu:definition "Old (continuing) college students log in to the Student Web Portal to enlist the subjects they will enroll in; the Registrar then evaluates and finalizes the enlisted subjects on the portal. New students and transferees instead submit hard-copy requirements to the Office of the Registrar on their scheduled appointment date." ;
    lspu:sourceArticle "Citizen's Charter 2026, Registrar, Service 1: Enrollment, Step 1, p. 2" .

lspu:PortalFn_ViewCOR a lspu:PlatformFunction ;
    rdfs:label "Portal function: view Certificate of Registration (COR)" ;
    lspu:definition "After enrollment, students log in to the student portal to view their COR (about 3 minutes). Students who paid at the Cashier may instead claim a printed COR at the Office of the Registrar (about 20 minutes)." ;
    lspu:sourceArticle "Citizen's Charter 2026, Registrar, Service 1: Enrollment, Step 4, p. 3" .

lspu:PortalFn_INCCompletion a lspu:PlatformFunction ;
    rdfs:label "Portal function: apply online for completion of INC or 4.0 grade" ;
    lspu:definition "After submitting the complete requirements to the subject teacher, the student logs in to the portal in the LSPU online system to apply online for completion of the INC or 4.0 grade." ;
    lspu:sourceArticle "Citizen's Charter 2026, Colleges, Service 3: Completion of INC/Removal - Online System, p. 86" .

lspu:PortalFn_VerifyGrades a lspu:PlatformFunction ;
    rdfs:label "Portal function: verify grades against the Registrar's report" ;
    lspu:definition "When claiming Evaluated Grades or the Report of Grades from the Registrar, the student checks that the printed grades are complete compared with the grades shown in the student portal." ;
    lspu:sourceArticle "Citizen's Charter 2026, Colleges, Service 9: Enrollment Advising, Step 2, p. 90" .

lspu:GoogleWorkspace a lspu:DigitalPlatform ;
    rdfs:label "Google Workspace (school Google account for classes and school activities)" ;
    rdfs:comment "Google's suite of online tools (Gmail, Classroom, Meet, Drive, Docs, Sheets, Slides, Forms, Calendar) used mainly for school-related activities at LSPU-LB." ;
    lspu:definition "Google Workspace is mainly used at LSPU-LB for school-related activities: official school email, online classes and meetings, sharing and submitting coursework, group projects, forms and surveys, and schedules. Students use their school Google account to access these tools." ;
    lspu:sourceArticle "Basis: information from the project team that LSPU-LB mainly uses Google Workspace (e.g. Google Classroom) for study. Handbook and Citizen's Charter do not describe it, except the Google Form in Student ID processing (Citizen's Charter 2026, Business Affairs, Service 1, p. 13)" ;
    lspu:accountRequirement "A school-issued Google account. Students request it inside the LSPU Student Portal once their portal account is active. The exact account format is not stated in the source files." ;
    lspu:hasFunction lspu:GWFn_Email, lspu:GWFn_Classroom, lspu:GWFn_Meet, lspu:GWFn_DriveDocs,
        lspu:GWFn_Forms, lspu:GWFn_Calendar ;
    lspu:verificationNote "Only the Google Form used in Student ID processing is cited in the Citizen's Charter (Business Affairs, Service 1, p. 13). The other tool descriptions state what each Google tool generally does and how the campus mainly uses it; confirm the exact tools enabled and the account format with the university ICT office." ;
    lspu:alternateQuestion "How do I get my school Google account?" ,
        "How do I request an LSPU Google account?" ,
        "Where do I create my school email?" ,
        "Do I need the portal to get a school Google account?" ,
        "How do I get my Google Classroom account?" ,
        "How do I get my LSPU email address?" ,
        "Who creates the school Google account?" ,
        "What is Google Workspace used for at LSPU-LB?" ,
        "Which Google apps do students use for school?" ,
        "Do we use Google Classroom or Google Meet?" ,
        "What do we use Gmail and Google Drive for in school?" ,
        "What online tools are used for classes?" ,
        "What is the LSPU Google account for?" ,
        "What is Google Workspace used for in school?" ,
        "What is the difference between the LSPU Portal and Google Workspace?" ,
        "Which one do I use for grades and which for classes?" ,
        "Do I need both the portal and a Google account?" ,
        "Portal or Google account, which do I use?" ,
        "Is the LSPU portal the same as my Google account?" ,
        "What is the difference between the student portal and Gmail?" ;
    lspu:audience "New students" ;
    lspu:additionalInfo "Because it is requested through the portal, activate your portal account first at the ICT office inside the CCS building." ,
        "Confirm with your college which tools your instructors use." ;
    rdfs:seeAlso lspu:LSPUPortal ,
        lspu:ICTOffice ;
    lspu:verificationNote "Steps supplied by the maintainer, not the Handbook or Charter. The account format is not documented." ;
    lspu:sourceArticle "Campus information supplied by the ontology maintainer (an LSPU-LB student), September 2026; not from the Handbook or Citizen's Charter" ,
        "Basis: information from the project team that LSPU-LB mainly uses Google Workspace for study (e.g. Google Classroom). Not described in the Handbook or Citizen's Charter, except the Google Form used in Student ID processing (Citizen's Charter 2026, Business Affairs, Service 1, p. 13). No LSPU website page has been cited yet" .

lspu:GWFn_Email a lspu:PlatformFunction ;
    rdfs:label "Google Workspace function: school email (Gmail)" ;
    lspu:definition "Receive announcements from teachers, offices, and the college, and send school-related messages using the school Google account." .

lspu:GWFn_Classroom a lspu:PlatformFunction ;
    rdfs:label "Google Workspace function: online class management (Google Classroom)" ;
    lspu:definition "Join a class with a class code, read posted lessons and announcements, receive assignments, and submit outputs online." .

lspu:GWFn_Meet a lspu:PlatformFunction ;
    rdfs:label "Google Workspace function: online meetings and classes (Google Meet)" ;
    lspu:definition "Attend online lectures, consultations, and group meetings by video call." .

lspu:GWFn_DriveDocs a lspu:PlatformFunction ;
    rdfs:label "Google Workspace function: file storage and collaborative documents (Drive, Docs, Sheets, Slides)" ;
    lspu:definition "Store files in the cloud and write reports, spreadsheets, and presentations, alone or with groupmates, with shared editing." .

lspu:GWFn_Forms a lspu:PlatformFunction ;
    rdfs:label "Google Workspace function: forms and surveys (Google Forms)" ;
    lspu:definition "Fill out online forms, quizzes, surveys, and registrations. Example cited in the Citizen's Charter: Student ID processing starts by scanning a QR code or filling out a Google Form." ;
    lspu:sourceArticle "Citizen's Charter 2026, Business Affairs, Marketing and Production Office, Service 1: Processing of Student ID, Step 1, p. 13" .

lspu:GWFn_Calendar a lspu:PlatformFunction ;
    rdfs:label "Google Workspace function: schedules and reminders (Google Calendar)" ;
    lspu:definition "Keep track of class schedules, deadlines, and school events, and receive reminders." .

lspu:Campus a owl:Class ;
    rdfs:label "Campus" ;
    rdfs:comment "A university campus, with its address and the places found on it." .

lspu:CampusPlace a owl:Class ;
    rdfs:label "Campus Place" ;
    rdfs:comment "A building, office, facility or landmark on the LSPU-LB campus, with directions from the main gate." .

lspu:hasPlace a owl:ObjectProperty ; rdfs:domain lspu:Campus ; rdfs:range lspu:CampusPlace ; owl:inverseOf lspu:placeOfCampus .
lspu:placeOfCampus a owl:ObjectProperty ; rdfs:domain lspu:CampusPlace ; rdfs:range lspu:Campus .
lspu:housesOffice a owl:ObjectProperty ; rdfs:domain lspu:CampusPlace ; rdfs:range lspu:Office ; owl:inverseOf lspu:locatedAtPlace ;
    rdfs:comment "Links a campus place to an office or service point found there." .
lspu:locatedAtPlace a owl:ObjectProperty ; rdfs:domain lspu:Office ; rdfs:range lspu:CampusPlace .
lspu:housesCollege a owl:ObjectProperty ; rdfs:domain lspu:CampusPlace ; rdfs:range lspuprog:College ;
    rdfs:comment "Links a college building to the college it belongs to." .
lspu:nearPlace a owl:ObjectProperty ; rdfs:domain lspu:CampusPlace ; rdfs:range lspu:CampusPlace ;
    rdfs:comment "A nearby or adjacent campus place, as described in the campus directions." .
lspu:directionsFromGate a owl:DatatypeProperty ; rdfs:domain lspu:CampusPlace ; rdfs:range xsd:string ;
    rdfs:comment "Walking directions from the main gate." .
lspu:placeType a owl:DatatypeProperty ; rdfs:domain lspu:CampusPlace ; rdfs:range xsd:string .
lspu:alsoKnownAs a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:comment "Other names, abbreviations or phrases students use for the same place." .
lspu:barangay a owl:DatatypeProperty ; rdfs:domain lspu:Campus ; rdfs:range xsd:string .
lspu:municipality a owl:DatatypeProperty ; rdfs:domain lspu:Campus ; rdfs:range xsd:string .
lspu:province a owl:DatatypeProperty ; rdfs:domain lspu:Campus ; rdfs:range xsd:string .
lspu:addressText a owl:DatatypeProperty ; rdfs:domain lspu:Campus ; rdfs:range xsd:string .

lspu:Campus_LSPULB a lspu:Campus ;
    rdfs:label "LSPU Los Baños Campus (LSPU-LB)" ;
    lspu:alsoKnownAs "LSPU Los Baños", "LSPU Los Banos", "Los Banos campus", "Los Baños campus", "LSPU-LB", "Laguna State Polytechnic University Los Baños Campus" ;
    lspu:barangay "Malinta" ; lspu:municipality "Los Baños" ; lspu:province "Laguna" ;
    lspu:addressText "Malinta, Los Baños, Laguna" ;
    lspu:definition "The LSPU Los Baños campus (LSPU-LB) is located in Malinta, Los Baños, Laguna." ;
    lspu:sourceArticle "Map of LSPU-LB (campus map, walking directions from the main gate); not from the Handbook or Citizen's Charter" ;
    lspu:hasPlace lspu:Loc_MainGate, lspu:Loc_GuardHouse, lspu:Loc_Hall, lspu:Loc_CCS, lspu:Loc_CAS, lspu:Loc_CTE, lspu:Loc_CBAA, lspu:Loc_CFND, lspu:Loc_CHMT, lspu:Loc_COF, lspu:Loc_CCJE, lspu:Loc_Cafeteria, lspu:Loc_LacsonGym, lspu:Loc_JoeyLinaGym, lspu:Loc_OSAS, lspu:Loc_BAO, lspu:Loc_SFA, lspu:Loc_Registrar, lspu:Loc_Library, lspu:Loc_CashierAccounting, lspu:Loc_Clinic, lspu:Loc_AdminBuilding, lspu:Loc_UniversityPresident, lspu:Loc_AlumniBuilding, lspu:Loc_GenderAndDevelopment, lspu:Loc_Parking, lspu:Loc_ComfortRooms, lspu:Loc_Transportation, lspu:Loc_NSTP ;
    lspu:alternateQuestion "Where is LSPU Los Baños located?" ,
        "Where is the LSPU-LB campus?" ,
        "What is the address of LSPU Los Banos?" ,
        "Which barangay is LSPU-LB in?" ,
        "Which town and province is LSPU Los Banos in?" ,
        "What is the address of LSPU Los Baños?" ,
        "Which town and province is LSPU Los Baños in?" ,
        "Where is the LSPU campus in Los Baños?" ,
        "What barangay is LSPU-LB in?" ,
        "What is the contact number, email and address of LSPU-LB?" ,
        "What is the phone number of LSPU Los Baños?" ,
        "How can I contact LSPU-LB?" ,
        "What is the email address of LSPU?" ,
        "What is the telephone number of the campus?" ,
        "How do I call the school?" ,
        "What is the address of LSPU-LB?" ,
        "What are the office hours at LSPU-LB?" ,
        "What time do offices open and close?" ,
        "Are the offices open on Saturday?" ,
        "What are the office hours of the Registrar?" ,
        "Is the campus open on weekends?" ,
        "What time does the school office close?" ,
        "When can I go to the Registrar or Cashier?" ;
    lspu:audience "New students, applicants, visitors" ,
        "Applicants, students, parents, visitors" ,
        "All students, applicants" ;
    lspu:verificationNote "General contact details only; no office-specific numbers supplied." ;
    lspu:sourceArticle "Campus information supplied by the ontology maintainer (an LSPU-LB student), September 2026; not from the Handbook or Citizen's Charter" .

lspu:Loc_MainGate a lspu:CampusPlace ;
    rdfs:label "Location of Campus Main Gate and Entrance" ;
    lspu:placeType "Entrance" ;
    lspu:placeOfCampus lspu:Campus_LSPULB ;
    lspu:definition "The campus entrance is the main gate. The Guard House is right beside the gate, on the left as you enter. Just inside the gate, the Hall (the open roofed space) is on your right. All directions in this ontology start from the main gate. Located in the LSPU Los Baños campus, Malinta, Los Baños, Laguna." ;
    lspu:directionsFromGate "The campus entrance is the main gate. The Guard House is right beside the gate, on the left as you enter. Just inside the gate, the Hall (the open roofed space) is on your right. All directions in this ontology start from the main gate." ;
    lspu:alsoKnownAs "main gate", "campus entrance" ;
    lspu:nearPlace lspu:Loc_GuardHouse, lspu:Loc_Hall ;
    lspu:sourceArticle "Map of LSPU-LB (campus map, walking directions from the main gate); not from the Handbook or Citizen's Charter" .

lspu:Loc_GuardHouse a lspu:CampusPlace ;
    rdfs:label "Location of Guard House" ;
    lspu:placeType "Security post" ;
    lspu:placeOfCampus lspu:Campus_LSPULB ;
    lspu:definition "The Guard House is right at the main gate, on the left as you enter. It sits beside the CFND rooms. Located in the LSPU Los Baños campus, Malinta, Los Baños, Laguna." ;
    lspu:directionsFromGate "The Guard House is right at the main gate, on the left as you enter. It sits beside the CFND rooms." ;
    lspu:alsoKnownAs "guard house", "gate guard" ;
    lspu:nearPlace lspu:Loc_MainGate, lspu:Loc_CFND ;
    lspu:sourceArticle "Map of LSPU-LB (campus map, walking directions from the main gate); not from the Handbook or Citizen's Charter" .

lspu:Loc_Hall a lspu:CampusPlace ;
    rdfs:label "Location of the Hall" ;
    lspu:placeType "Open covered space" ;
    lspu:placeOfCampus lspu:Campus_LSPULB ;
    lspu:definition "The Hall is the open space with a roof that you see when you enter the main gate. It is just inside the gate, on your right. Located in the LSPU Los Baños campus, Malinta, Los Baños, Laguna." ;
    lspu:directionsFromGate "The Hall is the open space with a roof that you see when you enter the main gate. It is just inside the gate, on your right." ;
    lspu:alsoKnownAs "Hall", "the Hall", "open hall", "covered open space", "roofed open space" ;
    lspu:nearPlace lspu:Loc_MainGate, lspu:Loc_GenderAndDevelopment, lspu:Loc_AlumniBuilding, lspu:Loc_Clinic ;
    rdfs:comment "Landmark used in many directions (e.g. 'walk past the Hall'). Description of the Hall as an open roofed space was confirmed by the project team." ;
    lspu:sourceArticle "Map of LSPU-LB (campus map, walking directions from the main gate); not from the Handbook or Citizen's Charter" .

lspu:Loc_CCS a lspu:CampusPlace ;
    rdfs:label "Location of CCS Building (College of Computer Studies)" ;
    lspu:placeType "College building" ;
    lspu:placeOfCampus lspu:Campus_LSPULB ;
    lspu:definition "From the main gate, turn right and walk toward Lacson Gym. CCS is the long red building running beside the gym, on the inner side. The Computer Laboratories and the CCS Dean's Office are at the gym end. The CCS Faculty Room, ITSO, TSL Room and the Psychology Lab/Logistics Office are at the gate end. Located in the LSPU Los Baños campus, Malinta, Los Baños, Laguna." ;
    lspu:directionsFromGate "From the main gate, turn right and walk toward Lacson Gym. CCS is the long red building running beside the gym, on the inner side. The Computer Laboratories and the CCS Dean's Office are at the gym end. The CCS Faculty Room, ITSO, TSL Room and the Psychology Lab/Logistics Office are at the gate end." ;
    lspu:alsoKnownAs "CCS", "College of Computer Studies building", "computer laboratories", "CCS dean's office" ;
    lspu:housesCollege lspuprog:CCS ;
    lspu:nearPlace lspu:Loc_LacsonGym ;
    lspu:sourceArticle "Map of LSPU-LB (campus map, walking directions from the main gate); not from the Handbook or Citizen's Charter" .

lspu:Loc_CAS a lspu:CampusPlace ;
    rdfs:label "Location of CAS Building (College of Arts and Sciences)" ;
    lspu:placeType "College building" ;
    lspu:placeOfCampus lspu:Campus_LSPULB ;
    lspu:definition "From the main gate, turn right and walk past CBAA. CAS is the long purple building parallel to CCS, set back from the road. The CAS Dean's Office, the Faculty Room and the classrooms are inside. Located in the LSPU Los Baños campus, Malinta, Los Baños, Laguna." ;
    lspu:directionsFromGate "From the main gate, turn right and walk past CBAA. CAS is the long purple building parallel to CCS, set back from the road. The CAS Dean's Office, the Faculty Room and the classrooms are inside." ;
    lspu:alsoKnownAs "CAS", "College of Arts and Sciences building" ;
    lspu:housesCollege lspuprog:CAS ;
    lspu:nearPlace lspu:Loc_CBAA, lspu:Loc_CCS ;
    lspu:sourceArticle "Map of LSPU-LB (campus map, walking directions from the main gate); not from the Handbook or Citizen's Charter" .

lspu:Loc_CTE a lspu:CampusPlace ;
    rdfs:label "Location of CTE Building (College of Teacher Education)" ;
    lspu:placeType "College building" ;
    lspu:placeOfCampus lspu:Campus_LSPULB ;
    lspu:definition "From the main gate, turn right and walk past Lacson Gym and CCS to the far end of the campus. CTE is the dark blue building group. The CTE Dean's Office, Faculty Room, GSAE Office and classrooms are inside. Located in the LSPU Los Baños campus, Malinta, Los Baños, Laguna." ;
    lspu:directionsFromGate "From the main gate, turn right and walk past Lacson Gym and CCS to the far end of the campus. CTE is the dark blue building group. The CTE Dean's Office, Faculty Room, GSAE Office and classrooms are inside." ;
    lspu:alsoKnownAs "CTE", "College of Teacher Education building", "GSAE office" ;
    lspu:housesCollege lspuprog:CTE ;
    lspu:nearPlace lspu:Loc_LacsonGym, lspu:Loc_CCS ;
    lspu:sourceArticle "Map of LSPU-LB (campus map, walking directions from the main gate); not from the Handbook or Citizen's Charter" .

lspu:Loc_CBAA a lspu:CampusPlace ;
    rdfs:label "Location of CBAA Building (College of Business Administration and Accountancy)" ;
    lspu:placeType "College building" ;
    lspu:placeOfCampus lspu:Campus_LSPULB ;
    lspu:definition "From the main gate, turn right and walk past the Hall and Gender and Development. CBAA is the long orange building whose hallway runs away from the road. The CBAA Function Hall, the Faculty Room and the Supreme Student Council are inside. Located in the LSPU Los Baños campus, Malinta, Los Baños, Laguna." ;
    lspu:directionsFromGate "From the main gate, turn right and walk past the Hall and Gender and Development. CBAA is the long orange building whose hallway runs away from the road. The CBAA Function Hall, the Faculty Room and the Supreme Student Council are inside." ;
    lspu:alsoKnownAs "CBAA", "College of Business Administration and Accountancy building", "Supreme Student Council office", "SSC office", "CBAA function hall" ;
    lspu:housesCollege lspuprog:CBAA ;
    lspu:nearPlace lspu:Loc_GenderAndDevelopment ;
    lspu:sourceArticle "Map of LSPU-LB (campus map, walking directions from the main gate); not from the Handbook or Citizen's Charter" .

lspu:Loc_CFND a lspu:CampusPlace ;
    rdfs:label "Location of CFND Faculty (College of Food Nutrition and Dietetics)" ;
    lspu:placeType "College building" ;
    lspu:placeOfCampus lspu:Campus_LSPULB ;
    lspu:definition "From the main gate, turn left. The CFND rooms are beside the Guard House, on the gate side of the Administration Building. The CFND Faculty Room, Room 1, the Empty Room and the CFND Sensory Lab are in this row; the NSTP room is the next room over, between CFND and the Administration Building. Located in the LSPU Los Baños campus, Malinta, Los Baños, Laguna." ;
    lspu:directionsFromGate "From the main gate, turn left. The CFND rooms are beside the Guard House, on the gate side of the Administration Building. The CFND Faculty Room, Room 1, the Empty Room and the CFND Sensory Lab are in this row." ;
    lspu:alsoKnownAs "CFND", "College of Food Nutrition and Dietetics building", "CFND sensory lab" ;
    lspu:housesCollege lspuprog:CFND ;
    lspu:nearPlace lspu:Loc_GuardHouse, lspu:Loc_AdminBuilding, lspu:Loc_NSTP ;
    lspu:sourceArticle "Map of LSPU-LB (campus map, walking directions from the main gate); not from the Handbook or Citizen's Charter" .

lspu:Loc_NSTP a lspu:CampusPlace ;
    rdfs:label "Location of NSTP Room" ;
    lspu:placeType "Office" ;
    lspu:placeOfCampus lspu:Campus_LSPULB ;
    lspu:definition "From the main gate, turn left. The NSTP room sits between the CFND row and the Administration Building -- CFND itself is right beside the Guard House, and the NSTP room is the next room over, closer to the Administration Building. Located in the LSPU Los Baños campus, Malinta, Los Baños, Laguna." ;
    lspu:directionsFromGate "From the main gate, turn left. The NSTP room sits between the CFND row and the Administration Building -- CFND itself is right beside the Guard House, and the NSTP room is the next room over, closer to the Administration Building." ;
    lspu:alsoKnownAs "NSTP room", "NSTP office" ;
    lspu:nearPlace lspu:Loc_CFND, lspu:Loc_GuardHouse, lspu:Loc_AdminBuilding ;
    lspu:sourceArticle "Map of LSPU-LB (campus map, walking directions from the main gate); not from the Handbook or Citizen's Charter" .

lspu:Loc_CHMT a lspu:CampusPlace ;
    rdfs:label "Location of CHMT Building (College of Hospitality Management and Tourism)" ;
    lspu:placeType "College building" ;
    lspu:placeOfCampus lspu:Campus_LSPULB ;
    lspu:definition "From the main gate, turn left and walk to Joey Lina Gym. The CHMT classrooms surround the gym. The Dean's Office and the CHMT Faculty Room are on the inner side. The Chmt Cafe By The Bay and the Guest House are at the back. Located in the LSPU Los Baños campus, Malinta, Los Baños, Laguna." ;
    lspu:directionsFromGate "From the main gate, turn left and walk to Joey Lina Gym. The CHMT classrooms surround the gym. The Dean's Office and the CHMT Faculty Room are on the inner side. The Chmt Cafe By The Bay and the Guest House are at the back." ;
    lspu:alsoKnownAs "CHMT", "CIHT", "College of Hospitality Management and Tourism building", "Cafe By The Bay", "Guest House" ;
    lspu:housesCollege lspuprog:CIHT ;
    lspu:nearPlace lspu:Loc_JoeyLinaGym ;
    rdfs:comment "The campus guide calls this college CHMT; the program data in this ontology uses the abbreviation CIHT for the same college." ;
    lspu:sourceArticle "Map of LSPU-LB (campus map, walking directions from the main gate); not from the Handbook or Citizen's Charter" .

lspu:Loc_COF a lspu:CampusPlace ;
    rdfs:label "Location of COF Building (College of Fisheries)" ;
    lspu:placeType "College building" ;
    lspu:placeOfCampus lspu:Campus_LSPULB ;
    lspu:definition "From the main gate, turn left and walk past Joey Lina Gym along the road. The COF rooms are the last buildings on the left, along the road. The fish ponds and the COF Faculty Room building are behind them. Located in the LSPU Los Baños campus, Malinta, Los Baños, Laguna." ;
    lspu:directionsFromGate "From the main gate, turn left and walk past Joey Lina Gym along the road. The COF rooms are the last buildings on the left, along the road. The fish ponds and the COF Faculty Room building are behind them." ;
    lspu:alsoKnownAs "COF", "CF", "College of Fisheries building", "fish ponds" ;
    lspu:housesCollege lspuprog:CF ;
    lspu:nearPlace lspu:Loc_JoeyLinaGym ;
    rdfs:comment "The campus guide calls this college COF; the program data in this ontology uses the abbreviation CF for the same college." ;
    lspu:sourceArticle "Map of LSPU-LB (campus map, walking directions from the main gate); not from the Handbook or Citizen's Charter" .

lspu:Loc_CCJE a lspu:CampusPlace ;
    rdfs:label "Location of CCJE Building (College of Criminal Justice Education)" ;
    lspu:placeType "College building" ;
    lspu:placeOfCampus lspu:Campus_LSPULB ;
    lspu:definition "Exit the main gate and follow the road to the right (northeast) until it bends. CCJE is on the right side of the road, with parking along its front. The rooms, Open Rooms and the CCJE Faculty Room are inside. Located in the LSPU Los Baños campus, Malinta, Los Baños, Laguna." ;
    lspu:directionsFromGate "Exit the main gate and follow the road to the right (northeast) until it bends. CCJE is on the right side of the road, with parking along its front. The rooms, Open Rooms and the CCJE Faculty Room are inside." ;
    lspu:alsoKnownAs "CCJE", "College of Criminal Justice Education building" ;
    lspu:housesCollege lspuprog:CCJE ;
    lspu:sourceArticle "Map of LSPU-LB (campus map, walking directions from the main gate); not from the Handbook or Citizen's Charter" .

lspu:Loc_Cafeteria a lspu:CampusPlace ;
    rdfs:label "Location of Cafeteria" ;
    lspu:placeType "Campus facility" ;
    lspu:placeOfCampus lspu:Campus_LSPULB ;
    lspu:definition "From the main gate, walk straight in. The Cafeteria is in the first long building on your right, next to the Clinic. Located in the LSPU Los Baños campus, Malinta, Los Baños, Laguna." ;
    lspu:directionsFromGate "From the main gate, walk straight in. The Cafeteria is in the first long building on your right, next to the Clinic." ;
    lspu:alsoKnownAs "canteen", "where to eat" ;
    lspu:nearPlace lspu:Loc_Clinic, lspu:Loc_BAO ;
    lspu:sourceArticle "Map of LSPU-LB (campus map, walking directions from the main gate); not from the Handbook or Citizen's Charter" .

lspu:Loc_LacsonGym a lspu:CampusPlace ;
    rdfs:label "Location of Lacson Gymnasium" ;
    lspu:placeType "Gymnasium" ;
    lspu:placeOfCampus lspu:Campus_LSPULB ;
    lspu:definition "From the main gate, turn right and keep going along the road-side path. Pass the Alumni Building. Lacson Gym is the large building beside the road. Located in the LSPU Los Baños campus, Malinta, Los Baños, Laguna." ;
    lspu:directionsFromGate "From the main gate, turn right and keep going along the road-side path. Pass the Alumni Building. Lacson Gym is the large building beside the road." ;
    lspu:alsoKnownAs "Lacson Gym" ;
    lspu:nearPlace lspu:Loc_AlumniBuilding, lspu:Loc_CCS ;
    lspu:sourceArticle "Map of LSPU-LB (campus map, walking directions from the main gate); not from the Handbook or Citizen's Charter" .

lspu:Loc_JoeyLinaGym a lspu:CampusPlace ;
    rdfs:label "Location of Joey Lina Gymnasium" ;
    lspu:placeType "Gymnasium" ;
    lspu:placeOfCampus lspu:Campus_LSPULB ;
    lspu:definition "From the main gate, turn left and walk past the Administration Building. Joey Lina Gym is the big gym beside the road. The Stage, Men's and Women's rooms, Sports Faculty Office and Sports and Cultural Office are around it. Located in the LSPU Los Baños campus, Malinta, Los Baños, Laguna." ;
    lspu:directionsFromGate "From the main gate, turn left and walk past the Administration Building. Joey Lina Gym is the big gym beside the road. The Stage, Men's and Women's rooms, Sports Faculty Office and Sports and Cultural Office are around it." ;
    lspu:alsoKnownAs "Joey Lina Gym", "sports office", "sports and cultural office" ;
    lspu:nearPlace lspu:Loc_AdminBuilding, lspu:Loc_CHMT ;
    lspu:sourceArticle "Map of LSPU-LB (campus map, walking directions from the main gate); not from the Handbook or Citizen's Charter" .

lspu:Loc_OSAS a lspu:CampusPlace ;
    rdfs:label "Location of Office of Student Affairs and Services (OSAS) Building" ;
    lspu:placeType "Office" ;
    lspu:placeOfCampus lspu:Campus_LSPULB ;
    lspu:definition "From the main gate, turn right and walk past the Hall and Gender and Development. Follow the CBAA hallway to the end. The OSAS building is there. Located in the LSPU Los Baños campus, Malinta, Los Baños, Laguna." ;
    lspu:directionsFromGate "From the main gate, turn right and walk past the Hall and Gender and Development. Follow the CBAA hallway to the end. The OSAS building is there." ;
    lspu:alsoKnownAs "OSAS", "student affairs office" ;
    lspu:housesOffice lspu:OSAS ;
    lspu:nearPlace lspu:Loc_CBAA, lspu:Loc_UniversityPresident ;
    lspu:sourceArticle "Map of LSPU-LB (campus map, walking directions from the main gate); not from the Handbook or Citizen's Charter" .

lspu:Loc_BAO a lspu:CampusPlace ;
    rdfs:label "Location of Business Affairs Office (BAO)" ;
    lspu:placeType "Office" ;
    lspu:placeOfCampus lspu:Campus_LSPULB ;
    lspu:definition "From the main gate, walk straight in. The BAO is in the same building as the Clinic and Cafeteria, on the left side. Student ID processing is handled by this office. The BAO also sells the ID lace, the uniform fabric, the University shirt, the NSTP shirt and the PE uniform. Located in the LSPU Los Baños campus, Malinta, Los Baños, Laguna." ;
    lspu:directionsFromGate "From the main gate, walk straight in. The BAO is in the same building as the Clinic and Cafeteria, on the left side. Student ID processing is handled by this office." ;
    lspu:alsoKnownAs "BAO", "Business Affairs", "where to process student ID" ;
    lspu:housesOffice lspuadm:Office_BusinessAffairsOffice ;
    lspu:nearPlace lspu:Loc_Clinic, lspu:Loc_Cafeteria, lspu:Loc_SFA ;
    lspu:sourceArticle "Map of LSPU-LB (campus map, walking directions from the main gate); not from the Handbook or Citizen's Charter" .

lspu:Loc_SFA a lspu:CampusPlace ;
    rdfs:label "Location of Scholarship and Financial Assistance (SFA) Office" ;
    lspu:placeType "Office" ;
    lspu:placeOfCampus lspu:Campus_LSPULB ;
    lspu:definition "From the main gate, walk straight in. The Scholarship and Financial Assistance office is inside the BAO, in the same building as the Clinic and Cafeteria, on the left side. Located in the LSPU Los Baños campus, Malinta, Los Baños, Laguna." ;
    lspu:directionsFromGate "From the main gate, walk straight in. The Scholarship and Financial Assistance office is inside the BAO, in the same building as the Clinic and Cafeteria, on the left side." ;
    lspu:alsoKnownAs "SFA", "scholarship office", "financial assistance office" ;
    lspu:housesOffice lspuadm:Office_ScholarshipAndFinancialAssistanceUnit ;
    lspu:nearPlace lspu:Loc_BAO ;
    lspu:sourceArticle "Map of LSPU-LB (campus map, walking directions from the main gate); not from the Handbook or Citizen's Charter" .

lspu:Loc_Registrar a lspu:CampusPlace ;
    rdfs:label "Location of Office of the Registrar" ;
    lspu:placeType "Office" ;
    lspu:placeOfCampus lspu:Campus_LSPULB ;
    lspu:definition "From the main gate, turn left and follow the road-side path to the Administration Building. Go up to the second floor. The Registrar's Office is on that floor. Located in the LSPU Los Baños campus, Malinta, Los Baños, Laguna." ;
    lspu:directionsFromGate "From the main gate, turn left and follow the road-side path to the Administration Building. Go up to the second floor. The Registrar's Office is on that floor." ;
    lspu:alsoKnownAs "Registrar", "registrar's office", "where to get COR TOR" ;
    lspu:housesOffice lspu:OfficeOfTheRegistrar ;
    lspu:nearPlace lspu:Loc_CashierAccounting, lspu:Loc_AdminBuilding ;
    rdfs:comment "Second floor of the Administration Building." ;
    lspu:sourceArticle "Map of LSPU-LB (campus map, walking directions from the main gate); not from the Handbook or Citizen's Charter" .

lspu:Loc_Library a lspu:CampusPlace ;
    rdfs:label "Location of Campus Library" ;
    lspu:placeType "Library" ;
    lspu:placeOfCampus lspu:Campus_LSPULB ;
    lspu:definition "Exit the main gate and follow the road to the left (southwest) all the way to its end. The Library compound is there, with its own gate and parking. Located in the LSPU Los Baños campus, Malinta, Los Baños, Laguna." ;
    lspu:directionsFromGate "Exit the main gate and follow the road to the left (southwest) all the way to its end. The Library compound is there, with its own gate and parking." ;
    lspu:alsoKnownAs "library", "LSPU library" ;
    lspu:housesOffice lspuadm:Office_Library ;
    rdfs:comment "The Library is outside the main campus gate, at the end of the road to the left." ;
    lspu:sourceArticle "Map of LSPU-LB (campus map, walking directions from the main gate); not from the Handbook or Citizen's Charter" .

lspu:Loc_CashierAccounting a lspu:CampusPlace ;
    rdfs:label "Location of Cashier and Accounting Office" ;
    lspu:placeType "Office" ;
    lspu:placeOfCampus lspu:Campus_LSPULB ;
    lspu:definition "From the main gate, turn left and follow the road-side path to the Administration Building. Go up to the second floor. The Cashier and Accounting Office is the room beside the Registrar. Located in the LSPU Los Baños campus, Malinta, Los Baños, Laguna." ;
    lspu:directionsFromGate "From the main gate, turn left and follow the road-side path to the Administration Building. Go up to the second floor. The Cashier and Accounting Office is the room beside the Registrar." ;
    lspu:alsoKnownAs "Cashier", "Accounting", "where to pay", "payment office" ;
    lspu:housesOffice lspuadm:Office_Cashier, lspuadm:Office_Accounting ;
    lspu:nearPlace lspu:Loc_Registrar ;
    rdfs:comment "Second floor of the Administration Building." ;
    lspu:sourceArticle "Map of LSPU-LB (campus map, walking directions from the main gate); not from the Handbook or Citizen's Charter" .

lspu:Loc_Clinic a lspu:CampusPlace ;
    rdfs:label "Location of University Health Service / Clinic" ;
    lspu:placeType "Office" ;
    lspu:placeOfCampus lspu:Campus_LSPULB ;
    lspu:definition "From the main gate, walk straight in. Look for the first long building on your right, just past the Hall. The Clinic is beside the Cafeteria. Located in the LSPU Los Baños campus, Malinta, Los Baños, Laguna." ;
    lspu:directionsFromGate "From the main gate, walk straight in. Look for the first long building on your right, just past the Hall. The Clinic is beside the Cafeteria." ;
    lspu:alsoKnownAs "Clinic", "health service", "medical clinic", "dental clinic" ;
    lspu:housesOffice lspuadm:Office_UniversityHealthService ;
    lspu:nearPlace lspu:Loc_Cafeteria, lspu:Loc_BAO ;
    lspu:sourceArticle "Map of LSPU-LB (campus map, walking directions from the main gate); not from the Handbook or Citizen's Charter" .

lspu:Loc_AdminBuilding a lspu:CampusPlace ;
    rdfs:label "Location of Administration Building and Campus Director's Office" ;
    lspu:placeType "Administrative building" ;
    lspu:placeOfCampus lspu:Campus_LSPULB ;
    lspu:definition "From the main gate, turn left and follow the road-side path. The Administration Building is the long building beside the road. The Campus Director's Office (Deputy Campus Director) is inside this building. The Auditor, MIS, Records and Management, Supply and Property, and the Alumni Office are also here. The Registrar and the Cashier and Accounting Office are on the second floor. Located in the LSPU Los Baños campus, Malinta, Los Baños, Laguna." ;
    lspu:directionsFromGate "From the main gate, turn left and follow the road-side path. The Administration Building is the long building beside the road. The Campus Director's Office (Deputy Campus Director) is inside this building. The Auditor, MIS, Records and Management, Supply and Property, and the Alumni Office are also here. The Registrar and the Cashier and Accounting Office are on the second floor." ;
    lspu:alsoKnownAs "Admin Building", "Campus Director's office", "Deputy Campus Director", "MIS office", "records office", "supply and property office", "alumni office", "auditor" ;
    lspu:housesOffice lspuadm:Office_OfficeOfTheCampusDirector, lspuadm:Office_ManagementInformationSystem, lspuadm:Office_RecordsManagementOffice, lspuadm:Office_SupplyAndPropertyManagementUnit, lspuadm:Office_AlumniAffairsAndPlacementServices, lspuadm:Office_InternalAuditUnit ;
    lspu:nearPlace lspu:Loc_Registrar, lspu:Loc_CashierAccounting ;
    rdfs:comment "Whether the Alumni Office here is the same unit as Alumni Affairs and Placement Services should be confirmed; the Auditor is linked to Internal Audit Unit on the assumption they are the same office." ;
    lspu:sourceArticle "Map of LSPU-LB (campus map, walking directions from the main gate); not from the Handbook or Citizen's Charter" .

lspu:Loc_UniversityPresident a lspu:CampusPlace ;
    rdfs:label "Location of Office of the University President" ;
    lspu:placeType "Office" ;
    lspu:placeOfCampus lspu:Campus_LSPULB ;
    lspu:definition "From the main gate, turn right and walk past the Hall and Gender and Development. Follow the CBAA hallway. The Office of the University President is the building on your left, just before the OSAS building. Located in the LSPU Los Baños campus, Malinta, Los Baños, Laguna." ;
    lspu:directionsFromGate "From the main gate, turn right and walk past the Hall and Gender and Development. Follow the CBAA hallway. The Office of the University President is the building on your left, just before the OSAS building." ;
    lspu:alsoKnownAs "University President's office", "president's office" ;
    lspu:housesOffice lspuadm:Office_OfficeOfTheUniversityPresident ;
    lspu:nearPlace lspu:Loc_OSAS ;
    lspu:sourceArticle "Map of LSPU-LB (campus map, walking directions from the main gate); not from the Handbook or Citizen's Charter" .

lspu:Loc_AlumniBuilding a lspu:CampusPlace ;
    rdfs:label "Location of Alumni Building" ;
    lspu:placeType "Building" ;
    lspu:placeOfCampus lspu:Campus_LSPULB ;
    lspu:definition "From the main gate, turn right and walk along the road-side path. The Alumni Building is just past the Hall. Located in the LSPU Los Baños campus, Malinta, Los Baños, Laguna." ;
    lspu:directionsFromGate "From the main gate, turn right and walk along the road-side path. The Alumni Building is just past the Hall." ;
    lspu:alsoKnownAs "alumni building" ;
    lspu:nearPlace lspu:Loc_LacsonGym ;
    lspu:sourceArticle "Map of LSPU-LB (campus map, walking directions from the main gate); not from the Handbook or Citizen's Charter" .

lspu:Loc_GenderAndDevelopment a lspu:CampusPlace ;
    rdfs:label "Location of Gender and Development (GAD) Building" ;
    lspu:placeType "Office" ;
    lspu:placeOfCampus lspu:Campus_LSPULB ;
    lspu:definition "From the main gate, turn right and walk past the Hall. It is the building at the start of the long CBAA building. A comfort room is beside it. Located in the LSPU Los Baños campus, Malinta, Los Baños, Laguna." ;
    lspu:directionsFromGate "From the main gate, turn right and walk past the Hall. It is the building at the start of the long CBAA building. A comfort room is beside it." ;
    lspu:alsoKnownAs "GAD", "Gender and Development office" ;
    lspu:housesOffice lspuadm:Office_GenderAndDevelopment ;
    lspu:nearPlace lspu:Loc_CBAA ;
    lspu:sourceArticle "Map of LSPU-LB (campus map, walking directions from the main gate); not from the Handbook or Citizen's Charter" .

lspu:Loc_Parking a lspu:CampusPlace ;
    rdfs:label "Location of Parking Areas" ;
    lspu:placeType "Parking" ;
    lspu:placeOfCampus lspu:Campus_LSPULB ;
    lspu:definition "Parking spots are along the walkways inside the campus, in front of the Administration Building and beside the CBAA and CAS buildings. More parking is near the Alumni Building, along the road-side path on the right. The CCJE building also has parking along its front, and the Library has its own parking. Located in the LSPU Los Baños campus, Malinta, Los Baños, Laguna." ;
    lspu:directionsFromGate "Parking spots are along the walkways inside the campus, in front of the Administration Building and beside the CBAA and CAS buildings. More parking is near the Alumni Building, along the road-side path on the right. The CCJE building also has parking along its front, and the Library has its own parking." ;
    lspu:alsoKnownAs "where to park", "parking lot" ;
    lspu:sourceArticle "Map of LSPU-LB (campus map, walking directions from the main gate); not from the Handbook or Citizen's Charter" ;
    lspu:alternateQuestion "Where are the comfort rooms and parking areas?" ,
        "Where is the CR?" ,
        "Where can I park?" ,
        "Where is the nearest restroom?" ,
        "Where is the restroom?" ,
        "Where can I park on campus?" ;
    lspu:audience "New students, visitors" .

lspu:Loc_ComfortRooms a lspu:CampusPlace ;
    rdfs:label "Location of Comfort Rooms" ;
    lspu:placeType "Campus facility" ;
    lspu:placeOfCampus lspu:Campus_LSPULB ;
    lspu:definition "From the main gate, the nearest comfort room is beside Gender and Development, at the CBAA end. There are also comfort rooms in the CBAA, CCS and CTE buildings. There is a comfort room in the Administration Building. There is one near the CHMT rooms, beside the Guest House. There are Men's and Women's rooms by the stage of Joey Lina Gym. There is one in the COF building behind the fish ponds. Located in the LSPU Los Baños campus, Malinta, Los Baños, Laguna." ;
    lspu:directionsFromGate "From the main gate, the nearest comfort room is beside Gender and Development, at the CBAA end. There are also comfort rooms in the CBAA, CCS and CTE buildings. There is a comfort room in the Administration Building. There is one near the CHMT rooms, beside the Guest House. There are Men's and Women's rooms by the stage of Joey Lina Gym. There is one in the COF building behind the fish ponds." ;
    lspu:alsoKnownAs "restroom", "CR", "toilet", "bathroom" ;
    lspu:nearPlace lspu:Loc_GenderAndDevelopment ;
    lspu:sourceArticle "Map of LSPU-LB (campus map, walking directions from the main gate); not from the Handbook or Citizen's Charter" ;
    lspu:alternateQuestion "Where are the comfort rooms and parking areas?" ,
        "Where is the CR?" ,
        "Where can I park?" ,
        "Where is the nearest restroom?" ,
        "Where is the restroom?" ,
        "Where can I park on campus?" ;
    lspu:audience "New students, visitors" .

lspu:Loc_Transportation a lspu:CampusPlace ;
    rdfs:label "Location of Transportation to the Campus (Tricycles)" ;
    lspu:placeType "Transport" ;
    lspu:placeOfCampus lspu:Campus_LSPULB ;
    lspu:definition "Tricycles are waiting outside the main gate, nearby along the road. The fare is about 20 pesos from nearby barangays; it costs more if you come from farther away, and you may need to take 2 rides. Located in the LSPU Los Baños campus, Malinta, Los Baños, Laguna." ;
    lspu:directionsFromGate "Tricycles are waiting outside the main gate, nearby along the road. The fare is about 20 pesos from nearby barangays; it costs more if you come from farther away, and you may need to take 2 rides." ;
    lspu:alsoKnownAs "tricycle", "fare", "how to commute", "tricycle fare" ;
    lspu:nearPlace lspu:Loc_MainGate ;
    rdfs:comment "The 20-peso fare is as reported by the project team and the maintainer, applies to nearby barangays, and may change. Jeepney and bus routes and fares are not documented." ;
    lspu:sourceArticle "Map of LSPU-LB (campus map, walking directions from the main gate); not from the Handbook or Citizen's Charter" ;
    lspu:alternateQuestion "How do I get to LSPU-LB from a nearby city or town?" ,
        "How do I commute to LSPU from another city?" ,
        "How do I get to LSPU from Calamba?" ,
        "Where do I ride a tricycle to LSPU-LB?" ,
        "Where do I get off to reach LSPU Los Baños?" ,
        "How do I get to LSPU-LB from UPLB?" ,
        "How do I get to the campus gate and how much is the fare?" ,
        "Are there tricycles outside LSPU?" ,
        "How much is the tricycle fare to LSPU-LB?" ,
        "How do I commute to LSPU Los Banos?" ,
        "How do I commute to LSPU Los Baños?" ,
        "How do I get to LSPU-LB?" ,
        "How much is the tricycle fare to LSPU?" ,
        "How much is the fare from a nearby barangay?" ,
        "Do I need two rides to reach LSPU-LB?" ;
    lspu:audience "New students, visitors" ;
    lspu:verificationNote "Specific jeepney or bus routes and fares from Calamba, the Los Baños poblacion or UPLB are not documented here." ,
        "Fare and route information come from the project team and the maintainer. Jeepney and bus routes and fares from specific places are NOT documented." ;
    lspu:sourceArticle "Campus information supplied by the ontology maintainer (an LSPU-LB student), September 2026; not from the Handbook or Citizen's Charter" .

