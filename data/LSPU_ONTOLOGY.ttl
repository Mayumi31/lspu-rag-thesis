    lspuprog:subjectDescription "Studies psychological disorders, their classification, causes, and treatment approaches. Students learn diagnostic criteria and explore case studies of various mental health conditions. This course builds on personality theory and developmental psychology foundations." ;
    lspuprog:sourceDocument "campus_curriculum_clean.md (maintainer-supplied campus curriculum; not from the CHED CMO, Handbook or Citizen's Charter)." .

lspuprog:Subj_BSPsych_PSY7 a lspuprog:Subject ;
    rdfs:label "PSY 7 — Research in Psychology 1 (BS Psychology, Year 3, 1st Semester)" ;
    lspuprog:subjectCode "PSY 7" ;
    lspuprog:subjectTitle "Research in Psychology 1" ;
