    lspuprog:semester "1st Semester" ;
    lspuprog:units 3 ;
    lspuprog:lectureUnits 2 ; lspuprog:laboratoryUnits 1 ;
    lspuprog:subjectDescription "Covers CPU design, memory hierarchy, and instruction set architecture. Students gain a low-level understanding of how hardware executes software. The course bridges software-level concepts with the physical computing systems that run them." ;
    lspuprog:sourceDocument "campus_curriculum_clean.md (maintainer-supplied campus curriculum; not from the CHED CMO, Handbook or Citizen's Charter)." .

lspuprog:Subj_BSCS_IS_CMSC307 a lspuprog:Subject ;
