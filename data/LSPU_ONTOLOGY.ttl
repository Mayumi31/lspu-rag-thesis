@prefix lspu:     <http://lspu.edu.ph/ontology/handbook#> .
@prefix lspuprog: <http://lspu.edu.ph/ontology/program#> .
@prefix lspuadm:  <http://lspu.edu.ph/ontology/admission#> .
@prefix owl:      <http://www.w3.org/2002/07/owl#> .
@prefix rdf:      <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:     <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:      <http://www.w3.org/2001/XMLSchema#> .

lspu:CampusItemPrice a owl:Class ;
    rdfs:label "Campus Item Price" ;
    rdfs:comment "A real out-of-pocket cost a student meets at LSPU-LB (uniform, shirts, ID lace, OJT). Prices are as reported by the maintainer and can change; see lspu:priceAsOf." .
lspu:CampusEvent a owl:Class ;
    rdfs:label "Campus Event" ;
    rdfs:comment "A campus or university-wide event students take part in (sports fest, arts festival, founding anniversary, college weeks)." .
lspu:AnnouncementChannel a owl:Class ;
    rdfs:subClassOf lspu:DigitalPlatform ;
    rdfs:label "Announcement Channel" ;
    rdfs:comment "An online place where class suspensions, cancellations and announcements are posted." .

lspu:priceMinPHP a owl:DatatypeProperty ; rdfs:domain lspu:CampusItemPrice ; rdfs:range xsd:decimal ;
    rdfs:comment "Lowest price in Philippine pesos. 0 means free." .
lspu:priceMaxPHP a owl:DatatypeProperty ; rdfs:domain lspu:CampusItemPrice ; rdfs:range xsd:decimal ;
    rdfs:comment "Highest price in Philippine pesos; equal to priceMinPHP for a fixed price. Absent when the cost has no fixed amount." .
lspu:priceNote a owl:DatatypeProperty ; rdfs:domain lspu:CampusItemPrice ; rdfs:range xsd:string .
lspu:priceAsOf a owl:DatatypeProperty ; rdfs:domain lspu:CampusItemPrice ; rdfs:range xsd:string ;
    rdfs:comment "Month the price was reported (YYYY-MM). Prices change; treat older values with care." .
lspu:soldAt a owl:ObjectProperty ; rdfs:domain lspu:CampusItemPrice ; rdfs:range lspu:Office .

lspu:eventStartDate a owl:DatatypeProperty ; rdfs:domain lspu:CampusEvent ; rdfs:range xsd:date .
lspu:eventEndDate a owl:DatatypeProperty ; rdfs:domain lspu:CampusEvent ; rdfs:range xsd:date .
lspu:eventVenue a owl:DatatypeProperty ; rdfs:domain lspu:CampusEvent ; rdfs:range xsd:string .
lspu:editionOf a owl:ObjectProperty ; rdfs:domain lspu:CampusEvent ; rdfs:range lspu:CampusEvent ;
    rdfs:comment "Links a dated edition (e.g. ICAC-CAF 2026) to the recurring event it belongs to." .

lspu:affiliatedCollege a owl:ObjectProperty ;
    rdfs:domain lspu:StudentOrganization ; rdfs:range lspuprog:College ;
    rdfs:label "affiliatedCollege" .
lspu:hasStudentOrganization a owl:ObjectProperty ;
    owl:inverseOf lspu:affiliatedCollege ;
    rdfs:domain lspuprog:College ; rdfs:range lspu:StudentOrganization ;
    rdfs:label "hasStudentOrganization" .
lspu:partOfOrganization a owl:ObjectProperty ;
    rdfs:domain lspu:StudentOrganization ; rdfs:range lspu:StudentOrganization ;
    rdfs:comment "A group or club that belongs to a larger student organization (e.g. Ritmo EsKultura within EsKultura)." .
lspu:worksWithOffice a owl:ObjectProperty ;
    rdfs:domain lspu:StudentOrganization ; rdfs:range lspu:Office .

lspu:officeHours a owl:DatatypeProperty ; rdfs:domain lspu:Office ; rdfs:range xsd:string ;
    rdfs:comment "Office-specific opening hours. NOT YET POPULATED for any office. General campus hours (Mon-Fri 8:00 AM-5:00 PM) are stored on lspu:Campus_LSPULB via lspu:campusHours." .
lspu:contactPhone a owl:DatatypeProperty ; rdfs:domain lspu:Office ; rdfs:range xsd:string ;
    rdfs:comment "Office-specific phone number. NOT YET POPULATED. The campus main line is stored on lspu:Campus_LSPULB via lspu:mainPhone." .
lspu:contactEmail a owl:DatatypeProperty ; rdfs:domain lspu:Office ; rdfs:range xsd:string ;
    rdfs:comment "Office-specific email address. NOT YET POPULATED. The general email is stored on lspu:Campus_LSPULB via lspu:mainEmail." .

lspu:ICTOffice a lspu:Office ;
    rdfs:label "ICT Office (inside the CCS building)" ;
    lspu:alsoKnownAs "ICT office", "ITSO", "portal account activation office", "where to activate portal account" ;
    lspu:contactNote "Activates new students' LSPU portal accounts: after you are officially enrolled, visit this office, inside the College of Computer Studies (CCS) building, to verify your email and password. For hours and contact use the campus main line (see lspu:Campus_LSPULB); office-specific phone and email are not documented." ;
    rdfs:comment "The campus map lists an 'ITSO' at the gate end of the CCS building; it is ASSUMED to be this same office but that has not been confirmed." ;
    lspu:sourceArticle "Campus information supplied by the ontology maintainer (an LSPU-LB student), September 2026; not from the Handbook or Citizen's Charter" ;
    lspu:verificationNote "Confirm that the ICT office and the ITSO on the campus map are the same office, and confirm its hours." ;
    lspu:alternateQuestion "How do I activate my LSPU portal account?" ,
        "How do I get my portal account?" ,
        "I just enrolled. How do I log in to the portal?" ,
        "Where do I verify my portal email and password?" ,
        "Where is the ICT office?" ,
        "How do I create an LSPU student portal account?" ,
        "When can I use the student portal?" ;
    lspu:audience "New students" ;
    rdfs:seeAlso lspu:LSPUPortal ;
    lspu:verificationNote "Steps supplied by the maintainer, not the Handbook or Charter. Confirm the ICT office hours." .
lspu:PortalFn_RequestGoogleAccount a lspu:PlatformFunction ;
    rdfs:label "Portal function: request the school Google account" ;
    lspu:definition "Once your portal account is active, you request your school Google account inside the LSPU Student Portal; the account is created from there." ;
    lspu:sourceArticle "Campus information supplied by the ontology maintainer (an LSPU-LB student), September 2026; not from the Handbook or Citizen's Charter" .

lspu:LSPUPortal lspu:hasFunction lspu:PortalFn_RequestGoogleAccount .
lspu:PortalFn_RequestGoogleAccount lspu:functionOf lspu:LSPUPortal .
lspu:ICTOffice lspu:locatedAtPlace lspu:Loc_CCS .
lspu:Loc_CCS lspu:housesOffice lspu:ICTOffice .

lspu:Channel_OfficialFacebookPage a lspu:AnnouncementChannel ;
    rdfs:label "LSPU-LB official Facebook page (campus-wide announcements and class suspensions)" ;
    lspu:alsoKnownAs "LSPU Los Baños Campus Facebook page", "LSPU-LBC Facebook", "official Facebook page" ;
    lspu:definition "Class suspensions and announcements that apply to the entire campus are posted on the official Facebook page of LSPU Los Baños Campus." ;
    lspu:accessUrl "facebook.com/LSPULBCOfficial" ;
    lspu:verificationNote "The page name and address come from a public web search result, not from the maintainer; check that it is the page the campus currently uses." ;
    lspu:sourceArticle "Campus information supplied by the ontology maintainer (an LSPU-LB student), September 2026; not from the Handbook or Citizen's Charter" ;
    lspu:alternateQuestion "Where are class suspensions announced?" ,
        "How do I know if classes are suspended?" ,
        "Where can I check for class cancellation?" ,
        "Where are campus-wide announcements posted?" ,
        "Is there a Facebook page for LSPU-LB announcements?" ,
        "Where do I see class suspension notices?" ;
    lspu:audience "Students" ;
    rdfs:seeAlso lspu:Channel_ClassMessengerGroups ,
        lspu:GWFn_Classroom .
lspu:Channel_ClassMessengerGroups a lspu:AnnouncementChannel ;
    rdfs:label "Class Messenger groups (created by each professor)" ;
    lspu:alsoKnownAs "Messenger group chat", "class group chat", "GC" ;
    lspu:definition "Professors usually create a Messenger group for their class. It is the most frequently used way for students and professors to communicate: class cancellations, quiz announcements and other class information are posted there." ;
    lspu:sourceArticle "Campus information supplied by the ontology maintainer (an LSPU-LB student), September 2026; not from the Handbook or Citizen's Charter" ;
    lspu:alternateQuestion "How do professors announce quizzes and class cancellations?" ,
        "Where do professors announce quizzes?" ,
        "Does LSPU use Messenger group chats for classes?" ,
        "How will my professor contact the class?" ,
        "Do we use Google Classroom or Messenger?" ,
        "How do I find out my class is cancelled?" ;
    lspu:audience "New students" ;
    rdfs:seeAlso lspu:GWFn_Classroom .

lspu:Price_IDLace a lspu:CampusItemPrice ;
    rdfs:label "ID lace (lanyard)" ;
    lspu:priceMinPHP "130"^^xsd:decimal ;
    lspu:priceMaxPHP "130"^^xsd:decimal ;
    lspu:soldAt lspuadm:Office_BusinessAffairsOffice ;
    lspu:priceNote "Sold at BAO." ;
    lspu:priceAsOf "2026-09" ;
    lspu:definition "The ID lace costs Php 130 and is sold at the Business Affairs Office (BAO)." ;
    lspu:sourceArticle "Campus information supplied by the ontology maintainer (an LSPU-LB student), September 2026; not from the Handbook or Citizen's Charter" .
lspu:Price_IDCardFirstYear a lspu:CampusItemPrice ;
    rdfs:label "Official student ID card for first-year students" ;
    lspu:priceMinPHP "0"^^xsd:decimal ;
    lspu:priceMaxPHP "0"^^xsd:decimal ;
    lspu:soldAt lspuadm:Office_BusinessAffairsOffice ;
    lspu:priceNote "The Citizen's Charter lists Php 100.00 for ID processing without saying who pays it; confirm at BAO." ;
    lspu:priceAsOf "2026-09" ;
    lspu:definition "The official ID card is free for first-year students and is obtained at the Business Affairs Office (BAO)." ;
    lspu:sourceArticle "Campus information supplied by the ontology maintainer (an LSPU-LB student), September 2026; not from the Handbook or Citizen's Charter" .
lspu:Price_UniformFabric a lspu:CampusItemPrice ;
    rdfs:label "Official uniform (fabric only)" ;
    lspu:priceMinPHP "600"^^xsd:decimal ;
    lspu:priceMaxPHP "800"^^xsd:decimal ;
    lspu:soldAt lspuadm:Office_BusinessAffairsOffice ;
    lspu:priceNote "Fabric only; tailoring not included." ;
    lspu:priceAsOf "2026-09" ;
    lspu:definition "The official uniform costs about Php 600 to 800, depending on the fabric. The campus sells only the fabric, so you must find a tailor to sew the polo and pants; the tailoring cost is extra and is not included." ;
    lspu:sourceArticle "Campus information supplied by the ontology maintainer (an LSPU-LB student), September 2026; not from the Handbook or Citizen's Charter" .
lspu:Price_UniversityShirt a lspu:CampusItemPrice ;
    rdfs:label "University shirt" ;
    lspu:priceMinPHP "400"^^xsd:decimal ;
    lspu:priceMaxPHP "400"^^xsd:decimal ;
    lspu:soldAt lspuadm:Office_BusinessAffairsOffice ;
    lspu:priceNote "Sold at BAO." ;
    lspu:priceAsOf "2026-09" ;
    lspu:definition "The University shirt costs Php 400 and is sold at the Business Affairs Office (BAO). It is worn every Wednesday." ;
    lspu:sourceArticle "Campus information supplied by the ontology maintainer (an LSPU-LB student), September 2026; not from the Handbook or Citizen's Charter" .
lspu:Price_NSTPShirt a lspu:CampusItemPrice ;
    rdfs:label "NSTP shirt" ;
    lspu:priceMinPHP "350"^^xsd:decimal ;
    lspu:priceMaxPHP "350"^^xsd:decimal ;
    lspu:soldAt lspuadm:Office_BusinessAffairsOffice ;
    lspu:priceNote "Sold at BAO." ;
    lspu:priceAsOf "2026-09" ;
    lspu:definition "The NSTP shirt costs Php 350 and is sold at the Business Affairs Office (BAO)." ;
    lspu:sourceArticle "Campus information supplied by the ontology maintainer (an LSPU-LB student), September 2026; not from the Handbook or Citizen's Charter" .
lspu:Price_PEUniform a lspu:CampusItemPrice ;
    rdfs:label "PE uniform (PE T-shirt and shorts)" ;
    lspu:priceMinPHP "500"^^xsd:decimal ;
    lspu:priceMaxPHP "500"^^xsd:decimal ;
    lspu:soldAt lspuadm:Office_BusinessAffairsOffice ;
    lspu:priceNote "Reported as one price for the PE T-shirt and shorts; confirm whether Php 500 is per set." ;
    lspu:priceAsOf "2026-09" ;
    lspu:definition "The PE T-shirt and shorts cost Php 500 and are sold at the Business Affairs Office (BAO)." ;
    lspu:sourceArticle "Campus information supplied by the ontology maintainer (an LSPU-LB student), September 2026; not from the Handbook or Citizen's Charter" .
lspu:Price_OJT a lspu:CampusItemPrice ;
    rdfs:label "On-the-job training (OJT) cost" ;
    lspu:priceNote "No fixed amount." ;
    lspu:priceAsOf "2026-09" ;
    lspu:definition "The OJT cost depends on where the student does OJT. Students choose their own OJT place, but the campus can also give students a list of companies it has connections with." ;
    lspu:sourceArticle "Campus information supplied by the ontology maintainer (an LSPU-LB student), September 2026; not from the Handbook or Citizen's Charter" ;
    lspu:alternateQuestion "How much does OJT cost and who chooses where I do it?" ,
        "How much do I need for OJT?" ,
        "Who chooses where I do OJT?" ,
        "Does the school help find OJT companies?" ,
        "Can I choose my own OJT company?" ,
        "Does the campus have partner companies for OJT?" ;
    lspu:audience "Students" .
lspuadm:Office_BusinessAffairsOffice
    lspu:contactNote "Student ID processing. Also sells the ID lace (Php 130), the uniform fabric (about Php 600-800), the University shirt (Php 400), the NSTP shirt (Php 350) and the PE T-shirt and shorts (Php 500). For hours and contact use the campus main line (see lspu:Campus_LSPULB); office-specific phone and email are not documented." .

lspu:Loc_BAO lspu:alsoKnownAs "where to buy uniform", "where to buy ID lace", "where to buy University shirt", "where to buy PE uniform", "where to buy NSTP shirt" .

lspu:Loc_Transportation lspu:alsoKnownAs "Los Baños Junction", "Batong Malake public market", "Batong Malake market", "commute from a nearby city", "2 rides to campus" .

lspu:Svc_HousingResidential rdfs:comment "Local information (maintainer): there is no dormitory inside the LSPU-LB campus; there are dormitories around the campus and their prices vary. Specific dorm names, addresses and prices are not documented." .

lspu:Event_ICACCAF a lspu:CampusEvent ;
    rdfs:label "ICAC-CAF (Intercollegiate Athletic Competition and Culture and the Arts Festival)" ;
    lspu:alsoKnownAs "ICAC-CAF", "ICAC CAF", "Sportsfest", "sports fest", "intercollegiate athletic competition", "culture and the arts festival" ;
    lspu:definition "ICAC-CAF is the Intercollegiate Athletic Competition and Culture and the Arts Festival: mainly an athletic and cultural competition among the colleges. Sports include basketball, volleyball, chess, e-sports and swimming, among others, plus cultural competitions. Campus winners become the campus's representatives in the university-wide ICAC-CAF." ;
    lspu:sourceArticle "Campus information supplied by the ontology maintainer (an LSPU-LB student), September 2026; not from the Handbook or Citizen's Charter" ;
    lspu:alternateQuestion "What is ICAC-CAF and when is it?" ,
        "When is the LSPU sportsfest?" ,
        "What sports are in ICAC-CAF?" ,
        "When is the university-wide ICAC-CAF?" ,
        "Where is the university-wide ICAC-CAF held?" ,
        "Who represents LSPU-LB in the university-wide ICAC-CAF?" ,
        "What does ICAC-CAF stand for?" ;
    lspu:audience "New students" ;
    lspu:additionalInfo "The 2026 LSPU-LBC edition was held September 15-18, 2026; the winning colleges became LSPU-LBC's representatives in the university-wide ICAC-CAF, scheduled for October 20-23, 2026 at the LSPU Santa Cruz Campus." ;
    lspu:verificationNote "Dates were supplied by the maintainer and not independently confirmed; the campus-level dates could not be matched to a Los Baños report." .
lspu:Event_ICACCAF_LBC_2026 a lspu:CampusEvent ;
    rdfs:label "LSPU-LBC ICAC-CAF 2026 (campus level)" ;
    lspu:editionOf lspu:Event_ICACCAF ;
    lspu:eventStartDate "2026-09-15"^^xsd:date ;
    lspu:eventEndDate "2026-09-18"^^xsd:date ;
    lspu:definition "The 2026 LSPU-LBC ICAC-CAF was held September 15-18, 2026. The colleges competed against each other in basketball, volleyball, chess, e-sports, swimming and other sports, plus cultural competitions. Afterward, the winners became LSPU-LBC's representatives in the university-wide ICAC-CAF. As of September 29, 2026 this campus-level event has already been held." ;
    lspu:verificationNote "Dates supplied by the maintainer. An LSPU-LBC ICAC-CAF 2026 is announced on the university website, but the dates were not independently confirmed; the only September 15-18 report found was for the San Pablo City campus's own ICAC-CAF." ;
    lspu:sourceArticle "Campus information supplied by the ontology maintainer (an LSPU-LB student), September 2026; not from the Handbook or Citizen's Charter" .
lspu:Event_ICACCAF_University_2026 a lspu:CampusEvent ;
    rdfs:label "University-wide ICAC-CAF 2026" ;
    lspu:editionOf lspu:Event_ICACCAF ;
    lspu:eventStartDate "2026-10-20"^^xsd:date ;
    lspu:eventEndDate "2026-10-23"^^xsd:date ;
    lspu:eventVenue "LSPU Santa Cruz Campus" ;
    lspu:definition "The university-wide ICAC-CAF 2026 is scheduled for October 20-23, 2026 at the LSPU Santa Cruz Campus. Each campus sends the winners of its own campus-level ICAC-CAF. As of September 29, 2026 this event has not happened yet." ;
    lspu:verificationNote "Dates and venue supplied by the maintainer; not independently confirmed. Schedules can change." ;
    lspu:sourceArticle "Campus information supplied by the ontology maintainer (an LSPU-LB student), September 2026; not from the Handbook or Citizen's Charter" .
