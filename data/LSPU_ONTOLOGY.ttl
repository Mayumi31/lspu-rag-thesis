    lspuprog:semester "1st Semester" ;
    lspuprog:units 3 ;
    lspuprog:lectureUnits 2 ; lspuprog:laboratoryUnits 1 ;
    lspuprog:subjectDescription "Covers the software development lifecycle, requirements engineering, and UML modeling. Students learn structured approaches to planning software systems. It is the first of a two-course sequence in formal software engineering practice." ;
    lspuprog:sourceDocument "campus_curriculum_clean.md (maintainer-supplied campus curriculum; not from the CHED CMO, Handbook or Citizen's Charter)." .

lspuprog:Subj_BSCS_IS_CMSC310 a lspuprog:Subject ;
