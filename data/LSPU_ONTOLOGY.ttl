    lspuprog:sourceDocument "campus_curriculum_clean.md (maintainer-supplied campus curriculum; not from the CHED CMO, Handbook or Citizen's Charter)." .

lspuprog:Subj_BSCS_IS_CMSC202 a lspuprog:Subject ;
    rdfs:label "CMSC 202 — Discrete Structures 2 (BSCS - Major in Intelligent Systems, Year 2, 1st Semester)" ;
    lspuprog:subjectCode "CMSC 202" ;
    lspuprog:subjectTitle "Discrete Structures 2" ;
