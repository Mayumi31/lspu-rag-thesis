lspuadm:Serv_RoutineMedicalAndDentalServices a lspuadm:Service ;
    rdfs:label "Routine Medical and Dental Services" ;
    lspuadm:availedAt lspuadm:Office_UniversityHealthService ;
    lspuadm:hasCategory lspuadm:Cat_Simple ; lspuadm:classificationText "Simple" ;
    lspuadm:hasTransactionType lspuadm:TT_G2G, lspuadm:TT_G2C ;
