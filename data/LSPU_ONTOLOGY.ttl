    lspuprog:semester "1st Semester" ;
    lspuprog:units 3 ;
    lspuprog:subjectDescription "Applies psychological principles to workplace settings, covering topics like employee motivation, organizational behavior, and personnel selection. Students learn how psychology informs human resource practices. This course opens career pathways into I/O psychology roles." ;
    lspuprog:sourceDocument "campus_curriculum_clean.md (maintainer-supplied campus curriculum; not from the CHED CMO, Handbook or Citizen's Charter)." .

lspuprog:Subj_BSPsych_PSY13 a lspuprog:Subject ;
    rdfs:label "PSY 13 — Social Psychology (BS Psychology, Year 4, 1st Semester)" ;
    lspuprog:subjectCode "PSY 13" ;
    lspuprog:subjectTitle "Social Psychology" ;
