@prefix lspu:     <http://lspu.edu.ph/ontology/handbook#> .
@prefix lspuprog: <http://lspu.edu.ph/ontology/program#> .
@prefix lspuadm:  <http://lspu.edu.ph/ontology/admission#> .
@prefix owl:      <http://www.w3.org/2002/07/owl#> .
@prefix rdf:      <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:     <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:      <http://www.w3.org/2001/XMLSchema#> .

lspu:EmergencyContact a owl:Class ;
    rdfs:label "Emergency Contact" ;
    rdfs:comment "A person, office or hotline a student can turn to in an emergency, with what it is for. contactNumber is left empty when no number has been verified." .
lspu:SafetyGuide a owl:Class ;
    rdfs:label "Safety Guide" ;
    rdfs:comment "Short what-to-do guidance for a hazard (typhoon, earthquake). Marked as general guidance unless an LSPU document is cited." .

lspu:contactNumber a owl:DatatypeProperty ; rdfs:domain lspu:EmergencyContact ; rdfs:range xsd:string ;
    rdfs:comment "Phone number or hotline. Absent when no number was supplied." .
lspu:contactFor a owl:DatatypeProperty ; rdfs:domain lspu:EmergencyContact ; rdfs:range xsd:string ;
    rdfs:comment "What this contact should be used for." .
lspu:contactOffice a owl:ObjectProperty ; rdfs:domain lspu:EmergencyContact ; rdfs:range lspu:Office ;
    rdfs:comment "The campus office behind this emergency contact, if any." .

lspu:relatedChannel a owl:ObjectProperty ; rdfs:domain lspu:SafetyGuide ; rdfs:range lspu:AnnouncementChannel ;
    rdfs:comment "Where students find announcements relevant to this hazard (e.g. class suspensions during a typhoon)." .

lspu:EC_National911 a lspu:EmergencyContact ;
    rdfs:label "National Emergency Hotline 911" ;
    lspu:alsoKnownAs "911", "emergency hotline", "police fire ambulance hotline" ;
    lspu:contactNumber "911" ;
    lspu:contactFor "Police, fire, ambulance and other urgent emergencies anywhere in the Philippines, including on or near the campus." ;
    lspu:definition "911 is the Philippine national emergency hotline. Call it for a crime in progress, fire, serious injury or any life-threatening situation, then inform the campus guard as soon as you can." ;
    lspu:sourceArticle "General national information (not an LSPU document)" .
lspu:EC_GuardHouse a lspu:EmergencyContact ;
    rdfs:label "Campus guards and Guard House (Safety and Security)" ;
    lspu:alsoKnownAs "guard house", "campus security", "security guard", "guard office" ;
    lspu:contactOffice lspu:SafetyAndSecurityManagementOffice ;
    lspu:contactFor "Any emergency or safety concern on campus: fights, threats, suspicious persons, fire, accidents, lost and found items." ;
    lspu:definition "For an emergency on campus, tell the nearest guard or go to the Guard House at the main gate (on the left as you enter). The Safety and Security Management Office handles security concerns. No campus phone number has been documented." ;
    lspu:verificationNote "No direct security phone number was supplied. The campus main line (049) 308-4530 (Mon-Fri, 8:00 AM-5:00 PM) is general, not an emergency line; for emergencies use 911 or go to the Guard House." ;
    lspu:sourceArticle "Location: Map of LSPU-LB. Office role: Student Handbook (Safety and Security Management Office). No phone number available" .
lspu:EC_UniversityHealthService a lspu:EmergencyContact ;
    rdfs:label "University Health Service (campus clinic)" ;
    lspu:alsoKnownAs "clinic", "school nurse", "campus clinic", "medical clinic" ;
    lspu:contactOffice lspuadm:Office_UniversityHealthService ;
    lspu:contactFor "Feeling sick, minor injuries, and first medical assessment on campus." ;
    lspu:definition "The University Health Service (campus clinic) gives routine medical and dental consultation at no fee. For a serious injury or life-threatening condition, call 911 and tell a guard rather than waiting for a clinic visit." ;
    lspu:verificationNote "No direct clinic phone number was supplied. The campus main line is (049) 308-4530 (Mon-Fri, 8:00 AM-5:00 PM); confirm the clinic's own hours." ;
    lspu:sourceArticle "Citizen's Charter 2026, University Health Service, Service 1, p. 14; the 911 advice is general safety information" .
lspu:EC_GuidanceOffice a lspu:EmergencyContact ;
    rdfs:label "Guidance Office (emotional or mental health crisis)" ;
    lspu:alsoKnownAs "guidance counselor", "guidance and counseling", "GCU" ;
    lspu:contactOffice lspu:GuidanceOffice ;
    lspu:contactFor "Emotional distress, mental health concerns, and support after a bullying or harassment incident." ;
    lspu:definition "The Guidance Office (inside the OSAS building) offers counseling and mental health support to enrolled students. If you or someone else is in immediate danger, call 911 first." ;
    lspu:verificationNote "No direct Guidance Office phone number was supplied. The campus main line is (049) 308-4530 (Mon-Fri, 8:00 AM-5:00 PM)." ;
    lspu:sourceArticle "Handbook Chapter 5, Article 1, Sec. 2; Mental Health Services, Art. 6-8; the 911 advice is general safety information" .
lspu:EC_CollegeDean a lspu:EmergencyContact ;
    rdfs:label "College Dean (for bullying, harassment and student welfare concerns)" ;
    lspu:alsoKnownAs "dean", "dean's office" ;
    lspu:contactFor "Reporting bullying or harassment quickly so it can be noted and acted on by your college." ;
    lspu:definition "Your College Dean should be told about bullying or harassment so it can be noted and solved quickly. See the bullying and harassment reporting procedure." ;
    lspu:sourceArticle "Campus information supplied by the ontology maintainer (an LSPU-LB student), September 2026; not from the Handbook or Citizen's Charter" .

lspu:Guide_Typhoon a lspu:SafetyGuide ;
    rdfs:label "What to do in a typhoon" ;
    lspu:alsoKnownAs "typhoon", "bagyo", "storm", "flood", "heavy rain", "signal number" ;
    lspu:definition "Before: check the official LSPU-LB Facebook page for campus-wide class suspensions, and your professor's Messenger group and Google Classroom for class-level announcements, before you travel. Keep your phone charged. If you are already on campus in strong wind or heavy rain: stay indoors, keep away from windows and glass doors, stay out of open areas and away from trees, posts and loose signs, and follow the guards and faculty. Do not travel through flooded roads or walk under fallen wires. Go home only when it is safe, and check announcements before coming back to campus." ;
    lspu:relatedChannel lspu:Channel_OfficialFacebookPage, lspu:Channel_ClassMessengerGroups ;
    lspu:verificationNote "General safety guidance, not an LSPU-LB protocol. Who decides suspensions and the campus's own typhoon procedure were not supplied." ;
    lspu:sourceArticle "Announcement channels: Campus information supplied by the ontology maintainer (an LSPU-LB student), September 2026; not from the Handbook or Citizen's Charter. Safety steps: general disaster-safety guidance (G), not an LSPU document" ;
    lspu:alternateQuestion "What should I do during a typhoon?" ,
        "What if there is a typhoon on a school day?" ,
        "Will classes be suspended when there is a typhoon?" ,
        "What do I do in heavy rain or flooding near campus?" ,
        "How do I know if classes are cancelled because of a storm?" ,
        "Is it safe to go to school during a typhoon?" ;
    lspu:audience "All students" ;
    lspu:sourceArticle "Announcement channels: Campus information supplied by the ontology maintainer (an LSPU-LB student), September 2026; not from the Handbook or Citizen's Charter. Safety steps: general guidance (G)" .
lspu:Guide_Earthquake a lspu:SafetyGuide ;
    rdfs:label "What to do in an earthquake" ;
    lspu:alsoKnownAs "earthquake", "lindol", "quake", "aftershock", "drop cover hold", "evacuation" ;
    lspu:definition "During shaking: DROP to your hands and knees, take COVER under a sturdy desk or table (or protect your head and neck with your arms next to an inside wall), and HOLD ON until the shaking stops. Stay away from windows, glass, shelves and heavy objects. If outdoors, move away from buildings, posts and wires. Do not run out during the shaking. After it stops: leave the building calmly by the stairs (not the elevator) to an open area, expect aftershocks, and follow the guards and faculty. Help others only if it is safe, and report injuries to a guard or the campus clinic. Call 911 for serious injuries or fire." ;
    lspu:verificationNote "General safety guidance, not an LSPU-LB protocol. The campus's official evacuation areas and drill procedure were not supplied, so none are stated. Ask the Safety and Security Management Office." ;
    lspu:sourceArticle "General earthquake-safety guidance (G), not an LSPU document" ;
    lspu:alternateQuestion "What should I do during an earthquake?" ,
        "What if there is an earthquake in class?" ,
        "Where do we evacuate during an earthquake?" ,
        "What is drop, cover and hold?" ,
        "Is there an earthquake drill at LSPU?" ,
        "What do I do after the shaking stops?" ;
    lspu:audience "All students" ;
    rdfs:seeAlso lspu:EC_National911 ,
        lspu:EC_GuardHouse .

lspu:Proc_ReportBullyingHarassment a lspu:Procedure ;
    rdfs:label "How to report bullying or harassment" ;
    lspu:alsoKnownAs "report bullying", "report harassment", "report cyberbullying", "bullying complaint", "harassment complaint" ;
    lspu:definition "Bullying or harassment must be reported to your College Dean so it is noted and can be solved quickly. Four steps: (1) write down what happened; (2) tell your College Dean; (3) file the written complaint with OSAS if formal action is needed; (4) get support from the Guidance Office." ;
    lspu:handledByCommittee lspu:StudentDisciplineCommittee ;
    lspu:hasStep lspu:ReportStep1_Record ;
    lspu:verificationNote "Step 2 (College Dean) comes from the maintainer. Steps 3 and the committee come from the Handbook. Steps 1 and 4 and the hints are practical advice. Dean office hours and contacts were not supplied." ;
    lspu:sourceArticle "Reporting to the College Dean: Campus information supplied by the ontology maintainer (an LSPU-LB student), September 2026; not from the Handbook or Citizen's Charter. Written complaint to OSAS and committee: Handbook Chapter 6, Article 6. Anti-Bullying Act of 2013 (RA 10627) is the legal basis of the bullying offenses" ;
    lspu:alternateQuestion "How do I report bullying or harassment?" ,
        "Where do I report bullying at LSPU?" ,
        "Who do I tell if I am being harassed?" ,
        "What should I do if I am bullied online?" ,
        "How do I report cyberbullying?" ,
        "Who handles bullying complaints?" ,
        "Do I report bullying to the dean?" ,
        "What happens after I report harassment?" ;
    lspu:audience "All students" ;
    lspu:additionalInfo "The Guidance Office can support you, and if you are in immediate danger tell a guard or call 911." ;
    rdfs:seeAlso lspu:Role_CollegeDean ,
        lspu:OSAS ,
        lspu:GuidanceOffice ,
        lspu:CyberBullying ,
        lspu:Bullying_SevereRepeated ,
        lspu:Bullying_HostileEnvironment ,
        lspu:Bullying_PhysicalContact ,
        lspu:Bullying_SlanderousStatement ;
    lspu:sourceArticle "Reporting to the College Dean: Campus information supplied by the ontology maintainer (an LSPU-LB student), September 2026; not from the Handbook or Citizen's Charter. OSAS complaint and committee: Handbook Chapter 6, Articles 2 and 6" .
lspu:ReportStep1_Record a lspu:ProcedureStep ;
    rdfs:label "Step 1: Write down what happened" ;
    lspu:definition "Note who was involved, what happened, when and where, and who saw it. For online bullying, keep screenshots and links. Do this while the details are fresh; it makes the report faster to act on." ;
    lspu:nextStep lspu:ReportStep2_Dean .
lspu:ReportStep2_Dean a lspu:ProcedureStep ;
    rdfs:label "Step 2: Tell your College Dean" ;
    lspu:definition "Report the bullying or harassment to your College Dean as soon as possible. The Dean notes the case and acts on it quickly at the college level; the Dean is also a member of the Student Discipline Committee for students of that college." ;
    lspu:performedBy lspu:Role_CollegeDean ;
    lspu:nextStep lspu:ReportStep3_OSAS .
lspu:ReportStep3_OSAS a lspu:ProcedureStep ;
    rdfs:label "Step 3: File a signed written complaint with OSAS when formal action is needed" ;
    lspu:definition "OSAS handles all complaints against alleged violators of the Code of Conduct. Complaints are made in writing to OSAS through the Coordinator of Student Discipline and must be signed by the complainant. Bullying is a Major Offense under the Code of Conduct." ;
    lspu:performedBy lspu:OSAS ;
    lspu:nextStep lspu:ReportStep4_Support .
lspu:ReportStep4_Support a lspu:ProcedureStep ;
    rdfs:label "Step 4: Get support" ;
    lspu:definition "The Guidance Office offers counseling and mental health support to students affected by bullying or harassment. If anyone is in immediate danger, tell a guard or call 911 first. For gender-based or sexual harassment, the Gender and Development Office may also be approached." ;
    lspu:performedBy lspu:GuidanceOffice ;
    lspu:verificationNote "The Gender and Development Office referral is a suggestion based on its existence in the Citizen's Charter; confirm with the office that it takes harassment reports." .

lspu:AdmReq_FreshmanDocuments a lspu:AdmissionRequirement ;
    rdfs:label "Freshman admission documents (LSPU website list)" ;
    lspu:appliesToStudentType lspu:StudentType_Freshman ;
    lspu:eligibilityCriteria "Report Card (DepEd Form 138) or its equivalent (Form 137), and NCAE results; physical and medical examination certified by a government physician (fitness to do University work); certificate of good moral character from the school last attended; three latest 2x2 pictures; photocopy of authenticated birth certificate (NSO)." ;
    lspu:verificationNote "This is the older website wording. It says NSO (now PSA), asks for a government physician's medical certificate and 3 pictures, whereas the 2026 Citizen's Charter enrollment list says PSA, medical slip from the LSPU Medical Clinic and 2 pictures. For enrollment-day documents prefer the Charter list in lspuadm:Serv_Enrollment." ;
    lspu:sourceArticle "LSPU official website admission pages, text supplied by the ontology maintainer, September 2026; not from the Handbook or Citizen's Charter (Admission Requirements: Freshmen)" ;
    lspu:alternateQuestion "Can ALS (Alternative Learning System) graduates apply to LSPU-LB?" ,
        "I am an ALS passer, how do I apply?" ,
        "What documents do ALS applicants submit?" ,
        "Is there a separate process for ALS applicants?" ,
        "Can I apply without a report card?" ,
        "What is the GWA requirement for ALS graduates?" ;
    lspu:audience "Applicants" ;
    lspu:additionalInfo "The sources used for this assistant do not describe a separate route, document list or GWA rule for ALS applicants, so no ALS-specific rules can be stated." ,
        "What is documented for new freshmen: a report card (DepEd Form 138) or its equivalent (Form 137), good moral certificate, medical and other documents, the entrance examination and the interview, and the program's minimum GWA." ,
        "Ask the Guidance Office (entrance exam) or the Office of the Registrar which document takes the place of the report card for ALS applicants." ;
    rdfs:seeAlso lspu:AdmReq_ExamAndInterview ,
        lspu:GuidanceOffice ,
        lspu:OfficeOfTheRegistrar ;
    lspu:verificationNote "ALS information has not been supplied. Do not add ALS rules until they are confirmed with the Guidance Office or Registrar." .
lspu:AdmReq_TransfereeDocuments a lspu:AdmissionRequirement ;
    rdfs:label "Student transferee admission documents (LSPU website list)" ;
    lspu:appliesToStudentType lspu:StudentType_Transferee ;
    lspu:eligibilityCriteria "Transfer credential or honorable dismissal from the school last attended; transcript of records or a copy of academic records for evaluation; physical and medical examination certified by a government physician; certificate of good moral character from the school last attended; three latest 2x2 pictures; photocopy of authenticated birth certificate (NSO)." ;
    lspu:verificationNote "Older website wording; see the note on lspu:AdmReq_FreshmanDocuments. The Charter's enrollment list for transferees also asks for an original certificate of transfer and TOR or copy of grades." ;
    lspu:sourceArticle "LSPU official website admission pages, text supplied by the ontology maintainer, September 2026; not from the Handbook or Citizen's Charter (Admission Requirements: Student Transferees)" ;
    lspu:alternateQuestion "How do I apply as a transferee to LSPU-LB and what documents do I need?" ,
        "I am a transferee, what are the admission requirements?" ,
        "What documents do transferees submit?" ,
        "Can I transfer to LSPU from another school?" ,
        "Do transferees take the entrance exam?" ,
        "What is the honorable dismissal for?" ,
        "Is there an interview for transferees?" ;
    lspu:audience "Transferees" ;
    rdfs:seeAlso lspu:AdmReq_ExamAndInterview ,
        lspu:Policy_TransferFromLSPUCampus ,
        lspuadm:Serv_Enrollment ;
    lspu:verificationNote "Website list is older wording (NSO, government physician). Prefer the Charter list for enrollment day. No rule about a minimum number of units was supplied for transferees from schools outside LSPU." .
lspu:AdmReq_ExamAndInterview a lspu:AdmissionRequirement ;
    rdfs:label "Entrance examination and interview (new freshmen and transferees)" ;
    lspu:appliesToStudentType lspu:StudentType_Freshman, lspu:StudentType_Transferee ;
    lspu:eligibilityCriteria "New freshmen and student transferees must pass the entrance examination and the interview." ;
    lspu:sourceArticle "LSPU official website admission pages, text supplied by the ontology maintainer, September 2026; not from the Handbook or Citizen's Charter (Admission Requirements)" .
lspu:StudentType_Freshman lspu:mustSatisfy lspu:AdmReq_FreshmanDocuments, lspu:AdmReq_ExamAndInterview .
lspu:StudentType_Transferee lspu:mustSatisfy lspu:AdmReq_TransfereeDocuments, lspu:AdmReq_ExamAndInterview .

lspu:Policy_ShiftingWithinLSPU a lspu:Policy ;
    rdfs:label "Transfer within LSPU / shifting of course (website rules)" ;
    lspu:alsoKnownAs "shifting", "change of course", "change of program", "transfer to another course", "shifter" ;
    lspu:definition "A student who has earned at least 30 collegiate academic units and wants to move from one course to another files an application for transfer or shifting in the current college. It is referred to the accepting college together with a true copy of grades. If the accepting college approves, the student receives a permit to transfer and a copy of grades. Shifting is not allowed without a valid reason. The student must qualify for the grade requirements of the department being entered. The application uses the prescribed form stating the reasons, with a copy of grades certified by the registrar. The College Dean must approve it, and it goes to the VPAA/Campus Director for approval, before 12% of the regular class meetings of the term have been held. A request submitted or received later is not considered for the following semester." ;
    lspu:appliesToStudentType lspu:StudentType_Undergraduate ;
    lspu:verificationNote "Compare with lspu:Policy_ShiftingOfCourse and lspu:Policy_Transferring (Handbook): the Handbook asks for no failure above 6 units, the Registrar's shifting form, a recommendation letter from the previous Dean, Dean and Registrar approval, and completion of 60% of units at LSPU (75% for honors). The website adds the 30-unit minimum and VPAA/Campus Director approval. Both are kept; confirm with the Registrar which applies." ;
    lspu:sourceArticle "LSPU official website admission pages, text supplied by the ontology maintainer, September 2026; not from the Handbook or Citizen's Charter (Transfer Admission: Transfer within LSPU / Shifting of Course)" ;
    lspu:alternateQuestion "What are the rules for shifting to another course within LSPU?" ,
        "How many units do I need before I can shift?" ,
        "Who approves shifting of course?" ,
        "When is the deadline for shifting?" ,
        "Do I need a reason to shift courses?" ,
        "What if I file my shifting request late?" ,
        "What form do I use to shift?" ;
    lspu:audience "Current students" ;
    rdfs:seeAlso lspu:Policy_ShiftingOfCourse ,
        lspu:Policy_Transferring ;
    lspu:verificationNote "The website and Handbook rules overlap but are not identical; confirm the current requirements with the Registrar." ;
    lspu:sourceArticle "LSPU official website admission pages, text supplied by the ontology maintainer, September 2026; not from the Handbook or Citizen's Charter (Transfer within LSPU / Shifting of Course); Handbook Chapter 3, Article 2, Sec. 2.9-2.10" .
lspu:Policy_TransferFromLSPUCampus a lspu:Policy ;
    rdfs:label "Transfer from another LSPU campus (within the LSPU System)" ;
    lspu:alsoKnownAs "transfer from another campus", "transfer from San Pablo campus", "transfer from Santa Cruz campus", "transfer from Siniloan campus", "constituent campus transfer" ;
    lspu:definition "Students from another LSPU constituent campus who have earned at least 30 collegiate academic units may be admitted as transferees, subject to the rules of the admitting college. The student must present honorable dismissal from the college or university last attended; must complete in LSPU at least 50% of the units required for the program (75% if running for honors); and the University's quota must not yet be filled. An admitted transferee may not enroll in a subject whose prerequisite, taken elsewhere, has not been validated or repeated in LSPU. All courses for which advanced credit is sought must be validated at the time stated in the validation requirements." ;
    lspu:appliesToStudentType lspu:StudentType_Transferee ;
    lspu:verificationNote "The validation schedule (VALIDATION REQUIREMENTS) was not supplied. The source says the transferee 'must have completed' the 50% or 75% of units in LSPU; this is read as a residency requirement. Confirm with the Registrar. The 50% here differs from the 60% in the Handbook's college-to-college transfer rule (lspu:Policy_Transferring), which covers a different situation." ;
    lspu:sourceArticle "LSPU official website admission pages, text supplied by the ontology maintainer, September 2026; not from the Handbook or Citizen's Charter (Transfer Admission: Transfer within LSPU System)" ;
    lspu:alternateQuestion "Can I transfer from another LSPU campus to LSPU Los Baños?" ,
        "How do I transfer from LSPU San Pablo to Los Baños?" ,
        "What are the rules for transferring within the LSPU system?" ,
        "How many units must I have to transfer campuses?" ,
        "What percent of units must I finish in LSPU?" ,
        "Is there a quota for transferees?" ,
        "Do I need honorable dismissal to transfer campuses?" ;
    lspu:audience "Transferees" ;
    lspu:additionalInfo "You cannot enroll in a subject whose prerequisite you took elsewhere until it is validated or repeated in LSPU, and courses you want credited must be validated at the time set in the validation requirements." ;
    rdfs:seeAlso lspu:Policy_AdvancedCredits ;
    lspu:verificationNote "The validation schedule was not supplied. See the note on lspu:Policy_TransferFromLSPUCampus." .
lspu:Policy_AdvancedCredits a lspu:Policy ;
    rdfs:label "Advanced credits for work done in another school" ;
    lspu:alsoKnownAs "credit subjects", "crediting of subjects", "credit units from previous school", "validation of subjects" ;
    lspu:definition "A student whose application for admission has already been approved may apply for advanced credits for work done in another college or university. The student presents credentials showing the subjects taken and passed there, which must be fully equivalent to the LSPU subjects for which credit is sought, and must pass or comply with the validation requirements." ;
    lspu:appliesToStudentType lspu:StudentType_Transferee ;
    lspu:sourceArticle "LSPU official website admission pages, text supplied by the ontology maintainer, September 2026; not from the Handbook or Citizen's Charter (Transfer Admission: Advanced Credits)" ;
    lspu:alternateQuestion "Can my subjects from my previous school be credited?" ,
        "What are advanced credits?" ,
        "Can I get credit for subjects I passed in another school?" ,
        "Do I need to validate my subjects as a transferee?" ,
        "How do I credit my subjects?" ,
        "Will all my units be accepted?" ;
    lspu:audience "Transferees" ;
    lspu:additionalInfo "Subjects whose prerequisites were taken elsewhere may need to be validated or repeated before you can enroll in the next subject." ;
    rdfs:seeAlso lspu:Policy_TransferFromLSPUCampus .
lspu:Policy_ForeignFreshmanAdmission a lspu:Policy ;
    rdfs:label "Admission of foreign students and Filipinos who graduated from high school abroad" ;
    lspu:alsoKnownAs "foreign student admission", "international student admission", "TOEFL requirement", "SAT requirement", "GCE requirement", "IB diploma" ;
    lspu:definition "A foreign applicant who graduated from a high school abroad and has not enrolled in the University may be admitted to the freshman class if they (1) submit complete secondary-school academic documents; (2) qualify in an accepted national or international examination: GCE with 3 ordinary-level and 2 advanced-level passes, or SAT with a minimum total score of 1200, or an International Baccalaureate Diploma, or an equivalent examination; and (3) if their native language or medium of instruction in secondary school is not English, score at least 500 (paper-based) or 173 (computer-based) on the TOEFL. Filipinos who graduated from a secondary school abroad and apply for freshman admission must meet the same requirements. An applicant transferring from another Philippine school should secure a permit to transfer from the Commission on Higher Education (CHED)." ;
    lspu:appliesToStudentType lspu:StudentType_Foreign ;
    lspu:verificationNote "The source calls the TOEFL the 'Test of English or Foreign Language'; the standard name is Test of English as a Foreign Language. Exam requirements are transcribed from the website as supplied." ;
    lspu:sourceArticle "LSPU official website admission pages, text supplied by the ontology maintainer, September 2026; not from the Handbook or Citizen's Charter (Foreign Students Admission: Requirements for Beginning Freshmen)" ;
    lspu:alternateQuestion "What are the admission requirements for foreign students?" ,
        "Can foreign students study at LSPU?" ,
        "Do foreign students need TOEFL?" ,
        "What is the SAT or GCE requirement?" ,
        "I graduated from high school abroad, how do I apply?" ,
        "Do foreign students need a study permit?" ,
        "What are the requirements for Filipinos who studied abroad?" ;
    lspu:audience "Foreign applicants, Filipinos who studied abroad" ;
    rdfs:seeAlso lspu:Policy_StudyPermit ;
    lspu:verificationNote "'ISS office' is not defined in the source; confirm with the Registrar." ;
    lspu:sourceArticle "LSPU official website admission pages, text supplied by the ontology maintainer, September 2026; not from the Handbook or Citizen's Charter (Foreign Students Admission)" .
lspu:Policy_StudyPermit a lspu:Policy ;
    rdfs:label "Temporary study permit for foreign students" ;
    lspu:alsoKnownAs "study permit", "student visa permit", "ISS office" ;
    lspu:definition "All foreign students must secure a temporary study permit from the ISS office before registering." ;
    lspu:appliesToStudentType lspu:StudentType_Foreign ;
    lspu:verificationNote "The source does not spell out 'ISS' and no LSPU-LB office by that name appears in the Citizen's Charter data here. Confirm the office with the Registrar." ;
    lspu:sourceArticle "LSPU official website admission pages, text supplied by the ontology maintainer, September 2026; not from the Handbook or Citizen's Charter (Foreign Students Admission: Study Permit)" .
lspu:Policy_NonDegreeStudent a lspu:Policy ;
    rdfs:label "Non-degree student admission" ;
    lspu:alsoKnownAs "non-degree", "non degree student", "cross-taker", "taking subjects only" ;
    lspu:definition "A degree holder or an undergraduate who is not enrolled in any other institution of higher learning may be allowed to take credit courses at the graduate or undergraduate level respectively, if they satisfy the college's admission requirements. A non-degree student may not enroll for more than one semester unless the College Dean and the University Registrar give special permission. Because a non-degree student does not follow an organized program of study, they are not a candidate for graduation for any degree in the University." ;
    lspu:appliesToStudentType lspu:StudentType_NonDegree ;
    lspu:sourceArticle "LSPU official website admission pages, text supplied by the ontology maintainer, September 2026; not from the Handbook or Citizen's Charter (Non-Regular Admission: Non-Degree Students)" ;
    lspu:alternateQuestion "What is a non-degree student or a special student?" ,
        "Can I take subjects without enrolling in a degree program?" ,
        "What is a special student?" ,
        "Can a mature student be admitted without meeting the entrance requirements?" ,
        "How many units can a special student take?" ,
        "Can a non-degree student graduate?" ,
        "How long can I stay as a non-degree student?" ;
    lspu:audience "Non-regular students" ;
    rdfs:seeAlso lspu:StudentType_Special ;
    lspu:sourceArticle "LSPU official website admission pages, text supplied by the ontology maintainer, September 2026; not from the Handbook or Citizen's Charter (Non-Regular Admission)" .
lspu:Policy_SpecialStudentAdmission a lspu:Policy ;
    rdfs:label "Special student admission" ;
    lspu:alsoKnownAs "special student", "mature student", "special student status" ;
    lspu:definition "A mature student who does not fully meet the entrance requirements may be admitted as a special student and may enroll in subjects that, in the opinion of the instructor and the Dean, they have the information and ability to pursue profitably. A special student may not enroll for more than 9 units unless the VPAA gives special permission. Subjects taken are non-credit, although the work may be reported each semester as satisfactory or unsatisfactory. A special student may register at any time without paying the late-registration fine, subject to other college regulations." ;
    lspu:appliesToStudentType lspu:StudentType_Special ;
    lspu:sourceArticle "LSPU official website admission pages, text supplied by the ontology maintainer, September 2026; not from the Handbook or Citizen's Charter (Non-Regular Admission: Special Student)" ;
    lspu:alternateQuestion "What is a non-degree student or a special student?" ,
        "Can I take subjects without enrolling in a degree program?" ,
        "What is a special student?" ,
        "Can a mature student be admitted without meeting the entrance requirements?" ,
        "How many units can a special student take?" ,
        "Can a non-degree student graduate?" ,
        "How long can I stay as a non-degree student?" ;
    lspu:audience "Non-regular students" .
lspu:StudentType_NonDegree lspu:definition "A degree holder or undergraduate not enrolled elsewhere who takes credit courses without following an organized program of study; not a candidate for graduation. Limited to one semester unless the College Dean and Registrar give special permission." .
lspu:StudentType_Transferee lspu:definition "A student coming from another school or another LSPU campus. Needs honorable dismissal or transfer credential, a transcript of records for evaluation, and must pass the entrance examination and interview." .

lspu:Loc_GuardHouse lspu:alsoKnownAs "guard office", "where to return a found ID", "lost and found", "security office" .
lspu:StudentDisciplineCommittee lspu:handles lspu:Proc_ReportBullyingHarassment .

