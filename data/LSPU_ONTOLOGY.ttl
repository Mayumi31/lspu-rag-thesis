    lspuprog:yearLevel 1 ;
    lspuprog:semester "2nd Semester" ;
    lspuprog:units 3 ;
    lspuprog:hasPrerequisite lspuprog:Subj_BSCS_IS_ITEC102 ;
    lspuprog:subjectDescription "Builds on programming fundamentals with data structures basics and modular programming. Covers arrays, functions, and file I/O. Students move from writing simple scripts toward more organized, reusable code." ;
    lspuprog:sourceDocument "campus_curriculum_clean.md (maintainer-supplied campus curriculum; not from the CHED CMO, Handbook or Citizen's Charter)." .

lspuprog:Subj_BSCS_IS_CMSC101 a lspuprog:Subject ;
    rdfs:label "CMSC 101 — Discrete Structures 1 (BSCS - Major in Intelligent Systems, Year 1, 2nd Semester)" ;
    lspuprog:subjectCode "CMSC 101" ;
    lspuprog:subjectTitle "Discrete Structures 1" ;
    lspuprog:belongsToProgram lspuprog:Prog_BSCS_IS ;
    lspuprog:yearLevel 1 ;
    lspuprog:semester "2nd Semester" ;
    lspuprog:units 3 ;
    lspuprog:subjectDescription "Covers mathematical foundations for computer science, including set theory, logic, and relations. Students learn to construct and evaluate formal proofs. These concepts underlie later coursework in algorithms and automata theory." ;
    lspuprog:sourceDocument "campus_curriculum_clean.md (maintainer-supplied campus curriculum; not from the CHED CMO, Handbook or Citizen's Charter)." .

lspuprog:Subj_BSCS_IS_PATHFIT3 a lspuprog:Subject ;
    rdfs:label "PATHFit 3 — Choice of Dance, Sports, Martial Arts, Group Exercise, Outdoor and Adventure Activities (BSCS - Major in Intelligent Systems, Year 2, 1st Semester)" ;
    lspuprog:subjectCode "PATHFit 3" ;
    lspuprog:subjectTitle "Choice of Dance, Sports, Martial Arts, Group Exercise, Outdoor and Adventure Activities" ;
    lspuprog:belongsToProgram lspuprog:Prog_BSCS_IS ;
    lspuprog:yearLevel 2 ;
    lspuprog:semester "1st Semester" ;
    lspuprog:units 2 ;
    lspuprog:subjectDescription "Lets students choose a specialized physical activity track based on personal interest. Emphasizes sustained engagement in a chosen discipline. It gives students more autonomy in shaping their physical education path." ;
    lspuprog:sourceDocument "campus_curriculum_clean.md (maintainer-supplied campus curriculum; not from the CHED CMO, Handbook or Citizen's Charter)." .

lspuprog:Subj_BSCS_IS_ITEC104 a lspuprog:Subject ;
    rdfs:label "ITEC 104 — Data Structures and Algorithms (BSCS - Major in Intelligent Systems, Year 2, 1st Semester)" ;
    lspuprog:subjectCode "ITEC 104" ;
    lspuprog:subjectTitle "Data Structures and Algorithms" ;
    lspuprog:belongsToProgram lspuprog:Prog_BSCS_IS ;
    lspuprog:yearLevel 2 ;
    lspuprog:semester "1st Semester" ;
    lspuprog:units 3 ;
    lspuprog:subjectDescription "Covers core data structures (stacks, queues, linked lists, trees) and fundamental sorting/searching algorithms. Students learn to select appropriate structures for computational problems. This course forms the backbone of algorithmic problem-solving for the rest of the program." ;
    lspuprog:sourceDocument "campus_curriculum_clean.md (maintainer-supplied campus curriculum; not from the CHED CMO, Handbook or Citizen's Charter)." .

lspuprog:Subj_BSCS_IS_GEC106 a lspuprog:Subject ;
    rdfs:label "GEC 106 — Art Appreciation (BSCS - Major in Intelligent Systems, Year 2, 1st Semester)" ;
    lspuprog:subjectCode "GEC 106" ;
    lspuprog:subjectTitle "Art Appreciation" ;
    lspuprog:belongsToProgram lspuprog:Prog_BSCS_IS ;
    lspuprog:yearLevel 2 ;
    lspuprog:semester "1st Semester" ;
    lspuprog:units 3 ;
    lspuprog:subjectDescription "Introduces students to visual, performing, and literary arts. Students explore art across historical periods and cultural contexts. The course cultivates aesthetic awareness alongside technical studies." ;
    lspuprog:sourceDocument "campus_curriculum_clean.md (maintainer-supplied campus curriculum; not from the CHED CMO, Handbook or Citizen's Charter)." .

lspuprog:Subj_BSCS_IS_SOSLIT a lspuprog:Subject ;
    rdfs:label "SOSLIT — Sosyedad at Literatura / Panitikang Panlipunan (BSCS - Major in Intelligent Systems, Year 2, 1st Semester)" ;
    lspuprog:subjectCode "SOSLIT" ;
