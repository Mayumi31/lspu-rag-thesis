lspu:Doc_CertificateOfRegistration
    lspu:alsoKnownAs "COR" ,
        "Certificate of Registration" ;
    lspu:additionalInfo "COR (Certificate of Registration): Document certifying you are officially enrolled for the semester; required for admission to classes and for processing a student ID. View it on the portal or claim a printed copy from the Registrar." .

lspu:Doc_COG
    lspu:alsoKnownAs "COG" ,
        "Copy of Grades" ;
    lspu:additionalInfo "COG (Copy of Grades): Official record of your grades for a semester issued by the Registrar; its information is also shown on the LSPU Portal." .

lspu:Policy_INCAndRemovalGrades
    lspu:alsoKnownAs "INC" ,
        "Incomplete" ;
    lspu:additionalInfo "INC (Incomplete): A temporary grade for unfinished requirements or a missed final exam for a valid reason; it becomes 5.00 if not completed within one year." .

lspuadm:Serv_LSPUEntranceExamination
    lspu:alsoKnownAs "LSPUCET" ,
        "LSPU college entrance examination" ;
    lspu:additionalInfo "LSPUCET (LSPU college entrance examination): The college entrance exam given by the Guidance Office to student-applicants; free of charge." .

lspuadm:Doc_TranscriptofRecordsCopyofGrades
    lspu:alsoKnownAs "TOR" ,
        "Transcript of Records" ;
    lspu:additionalInfo "TOR (Transcript of Records): Official record of all subjects and grades, issued by the Office of the Registrar; transferees submit their previous school's TOR for evaluation." .

lspuadm:Doc_Form137
    lspu:alsoKnownAs "Form 137" ,
        "SF10" ;
    lspu:additionalInfo "Form 137 / SF10: Your permanent academic record from your previous school. New students submit the original or authenticated Form 137 when enrolling; the Registrar requests it from the previous school (SF10/F137)." .

lspu:Policy_HonorableDismissal
    lspu:alsoKnownAs "Honorable Dismissal" ;
    lspu:additionalInfo "Honorable Dismissal: A document from the school last attended showing you left in good standing. Transferees must present it (also called transfer credential)." .

lspu:Policy_ShiftingOfCourse
    lspu:alsoKnownAs "Shifting" ;
    lspu:additionalInfo "Shifting: Changing from one course or program to another within LSPU. Needs a valid reason and approval of the College Dean and the VPAA/Campus Director before 12% of class meetings have been held." .

lspu:Policy_AdvancedCredits
    lspu:alsoKnownAs "Advanced Credits" ;
    lspu:additionalInfo "Advanced Credits: Credit for subjects you passed in another school, granted when they are fully equivalent to LSPU subjects and you pass the validation requirements." .

lspuprog:AdmissionRequirement
    rdfs:comment "GWA (General Weighted Average): The weighted average of your grades. LSPU-LB admission sets a minimum GWA (85 to 90) depending on the program." .


# Retrieval clarifications derived from existing assertions; no reference answers added.
lspu:tardinessInstancesPerAbsence a owl:DatatypeProperty ;
    rdfs:label "Number of class tardiness instances equivalent to one absence" .
lspu:unexcusedAbsenceThresholdPercent a owl:DatatypeProperty ;
    rdfs:label "Unexcused absence threshold percentage" .
lspu:Tardiness
    lspu:tardinessInstancesPerAbsence 3 ;
    lspu:unexcusedAbsenceThresholdPercent 17 ;
    lspu:verificationNote "Chapter 6 Article 3 Section 1 states 17%; other attendance/dropping sections state 25%. Preserve section scope and disclose conflicting thresholds rather than treating one as universally controlling." .
lspu:Doc_ExcuseSlip
    lspu:sourceArticle "Chapter 3, Article 8, Section 1" ;
    lspu:verificationNote "The attendance policy allows obtaining an excuse slip from OSAS or the Guidance Office; issuedBy links represent alternatives, not a requirement to visit both." .
lspuadm:Enroll_Step2
    lspu:alsoKnownAs "Fee assessment during enrollment" ;
    lspu:verificationNote "This enrollment step records 3 minutes. It is distinct from the Accounting Office fee-assessment service step, which records 1 minute per client type." .
lspuadm:AssessFees_Step2
    lspu:alsoKnownAs "Assessment step within Accounting Office fee-assessment service" ;
    lspu:verificationNote "This Accounting Office service step records 1 minute per client type; do not substitute it for the enrollment procedure step based on their former shared label." .


# Acronym aliases improve entity resolution without adding new campus facts.
lspu:Doc_COG lspu:alsoKnownAs "COG", "Copy of Grades" .
lspu:Doc_CertificateOfRegistration lspu:alsoKnownAs "COR", "Certificate of Registration" .
lspu:LSPUPortal lspu:alsoKnownAs "LSPU Portal", "student portal" .
lspu:StudentDisciplineCommittee lspu:alsoKnownAs "Student Discipline Committee" .
lspu:GuidanceOffice lspu:alsoKnownAs "Guidance Office" .
lspu:OSAS lspu:alsoKnownAs "OSAS", "Office of Student Affairs and Services" .
lspuprog:Prog_BSPsych lspuprog:alias "BS Psychology" .
lspuprog:CTE lspuprog:alias "CTE", "College of Teacher Education" .


# Cross-references preserve conflicting published thresholds for joint retrieval.
lspu:conflictsWithPolicy a owl:ObjectProperty ; rdfs:label "Has a conflicting source policy" .
lspu:Policy_AttendanceDropping lspu:conflictsWithPolicy lspu:Tardiness .
lspu:Tardiness lspu:conflictsWithPolicy lspu:Policy_AttendanceDropping .
# These aliases name existing services; they do not add eligibility or service claims.
lspu:Svc_GuidanceCounseling lspu:alsoKnownAs "mental health counseling services", "guidance counseling" .


# OC-RAG 3.6: schema guidance and normalized values derived from existing facts.
# Existing facts, source qualifications and unverified event dates are preserved.
lspuprog:semesterNumber a owl:DatatypeProperty ;
    rdfs:domain lspuprog:Subject ; rdfs:range xsd:integer ;
    rdfs:label "semester number" ;
    rdfs:comment "Numeric normalization of the existing semester string: 1st Semester is 1; 2nd Semester is 2. Combine with yearLevel and belongsToProgram. Does not encode summer terms." .
lspuprog:semester rdfs:comment "Human-readable semester string. Use semesterNumber for numeric semester filters where available." .
lspuprog:Program rdfs:comment "An academic program with curriculum and admission relationships. Resolve this class for subject lists, rather than a similarly named Degree instance." .
lspuprog:belongsToProgram rdfs:comment "Links each curriculum Subject to its academic Program. Combine this relationship with yearLevel and semesterNumber to enumerate a complete term; subject codes alone are not unique across programs." .
lspu:eventScope a owl:DatatypeProperty ;
    rdfs:domain lspu:CampusEvent ; rdfs:range xsd:string ;
    rdfs:label "event scope" ;
    rdfs:comment "Scope of an event instance: campus or university. Distinguishes campus-level competitions from university-wide editions. Dates and verification notes must come from the same instance." .
lspu:eventYear a owl:DatatypeProperty ;
    rdfs:domain lspu:CampusEvent ; rdfs:range xsd:integer ;
    rdfs:label "event year" ;
    rdfs:comment "Year of this event edition, derived from its existing dated record. This field does not independently verify the schedule." .
lspu:Event_ICACCAF_LBC_2026 lspu:eventScope "campus" ; lspu:eventYear 2026 .
lspu:Event_ICACCAF_University_2026 lspu:eventScope "university" ; lspu:eventYear 2026 .
