lspuadm:Serv_CurriculumReviewAndEnhancement a lspuadm:Service ;
    rdfs:comment "Steps 8 and 9 are printed identically in the source Charter (both: presenting the draft to the Board of Regents); transcribed as printed." ;
    rdfs:label "Curriculum Review and Enhancement" ;
    lspu:definition "Defined procedure for the review and enhancement of curricular programs in accordance with the most recent CHED Memorandum Orders." ;
    lspuadm:availedAt lspuadm:Office_CurriculumAndInstructionDevelopment ;
    lspuadm:hasCategory lspuadm:Cat_Academic ; lspuadm:classificationText "Academic" ;
    lspuadm:hasTransactionType lspuadm:TT_Internal ;
    lspuadm:whoMayAvail "Deans/Associate Deans, Program Coordinators" ;
    lspu:requiresDocument lspuadm:Doc_CIDSF001 ;
    lspu:hasStep lspuadm:Serv_CurriculumReviewAndEnhancement_S1 ;
    lspuadm:totalFeeText "None" ; lspuadm:totalProcessingTime "6-12 months" ;
    lspuadm:sourceDocument "LSPU Citizen's Charter, 2026 1st Edition (University-Wide)" ;
    lspuadm:sourceSection "XXIX. Curriculum Instruction Development, Service 1: Curriculum Review and Enhancement, p. 78" .

lspuadm:Serv_CurriculumReviewAndEnhancement_S1 a lspuadm:ServiceStep ;
    rdfs:label "Step 1: Receive the CMO and check congruency" ;
    lspuadm:clientAction "Receives the CMO and checks the congruency of the current curriculum to the CHED guidelines as stipulated in the new CMO." ;
    lspuadm:agencyAction "Assists the academic units/colleges." ;
    lspuadm:hasFeeText "n/a" ; lspuadm:hasProcessingTime "6-12 months (whole process)" ;
    lspu:performedBy lspuadm:Role_DeansAssociateDeansProgramCoordinatorsFacultyotherstakeholders ;
    lspu:nextStep lspuadm:Serv_CurriculumReviewAndEnhancement_S2 ;
    lspuadm:sourceSection "XXIX. Curriculum Instruction Development, Service 1: Curriculum Review and Enhancement, Step 1, p. 78" .

lspuadm:Serv_CurriculumReviewAndEnhancement_S2 a lspuadm:ServiceStep ;
    rdfs:label "Step 2: Initial assessment" ;
    lspuadm:clientAction "Reviews the existing curriculum and conducts an initial assessment of its compliance with the new CMO." ;
    lspuadm:agencyAction "Assists the academic units/colleges." ;
    lspuadm:hasFeeText "n/a" ; lspuadm:hasProcessingTime "(within 6-12 months)" ;
    lspu:performedBy lspuadm:Role_DeansAssociateDeansProgramCoordinatorsFacultyotherstakeholders ;
    lspu:nextStep lspuadm:Serv_CurriculumReviewAndEnhancement_S3 ;
    lspuadm:sourceSection "XXIX. Curriculum Instruction Development, Service 1: Curriculum Review and Enhancement, Step 2, p. 78" .

lspuadm:Serv_CurriculumReviewAndEnhancement_S3 a lspuadm:ServiceStep ;
    rdfs:label "Step 3: Review observations; notify Curriculum Review Committee" ;
    lspuadm:clientAction "Reviews the observations noted during the initial assessment; notifies the Curriculum Review Committee and guides the process of Curriculum Enhancement." ;
    lspuadm:agencyAction "Assists the academic units/colleges." ;
    lspuadm:hasFeeText "n/a" ; lspuadm:hasProcessingTime "(within 6-12 months)" ;
    lspu:performedBy lspuadm:Role_DeansAssociateDeansProgramCoordinatorsFacultyotherstakeholders ;
    lspu:nextStep lspuadm:Serv_CurriculumReviewAndEnhancement_S4 ;
    lspuadm:sourceSection "XXIX. Curriculum Instruction Development, Service 1: Curriculum Review and Enhancement, Step 3, p. 79" .

lspuadm:Serv_CurriculumReviewAndEnhancement_S4 a lspuadm:ServiceStep ;
    rdfs:label "Step 4: Convene for enhancement" ;
    lspuadm:clientAction "Convenes for the enhancement of the existing curriculum." ;
    lspuadm:agencyAction "Assists the academic units/colleges." ;
    lspuadm:hasFeeText "n/a" ; lspuadm:hasProcessingTime "(within 6-12 months)" ;
    lspu:performedBy lspuadm:Role_DeansAssociateDeansProgramCoordinatorsFacultyotherstakeholders ;
    lspu:nextStep lspuadm:Serv_CurriculumReviewAndEnhancement_S5 ;
    lspuadm:sourceSection "XXIX. Curriculum Instruction Development, Service 1: Curriculum Review and Enhancement, Step 4, p. 79" .

lspuadm:Serv_CurriculumReviewAndEnhancement_S5 a lspuadm:ServiceStep ;
    rdfs:label "Step 5: Present draft to stakeholders" ;
    lspuadm:clientAction "Presents the draft of the proposed curriculum enhancement to the internal and external stakeholders." ;
    lspuadm:agencyAction "Assists the academic units/colleges; participates in the consultative meetings." ;
    lspuadm:hasFeeText "n/a" ; lspuadm:hasProcessingTime "(within 6-12 months)" ;
    lspu:performedBy lspuadm:Role_DeansAssociateDeansProgramCoordinatorsFacultyotherstakeholders ;
    lspu:nextStep lspuadm:Serv_CurriculumReviewAndEnhancement_S6 ;
    lspuadm:sourceSection "XXIX. Curriculum Instruction Development, Service 1: Curriculum Review and Enhancement, Step 5, p. 79" .

lspuadm:Serv_CurriculumReviewAndEnhancement_S6 a lspuadm:ServiceStep ;
    rdfs:label "Step 6: Revise based on feedback" ;
    lspuadm:clientAction "Makes further revisions on the proposed curriculum based on the assessment, comments, suggestions, and recommendations of the stakeholders." ;
    lspuadm:agencyAction "Assists the academic units/colleges; monitors progress." ;
    lspuadm:hasFeeText "n/a" ; lspuadm:hasProcessingTime "(within 6-12 months)" ;
    lspu:performedBy lspuadm:Role_DeansAssociateDeansProgramCoordinatorsFacultyotherstakeholders ;
    lspu:nextStep lspuadm:Serv_CurriculumReviewAndEnhancement_S7 ;
    lspuadm:sourceSection "XXIX. Curriculum Instruction Development, Service 1: Curriculum Review and Enhancement, Step 6, p. 79" .

lspuadm:Serv_CurriculumReviewAndEnhancement_S7 a lspuadm:ServiceStep ;
    rdfs:label "Step 7: Present to Academic Council" ;
    lspuadm:clientAction "Presents the draft of the proposed curriculum enhancement to the Academic Council for endorsement to the Academic Board Committee." ;
    lspuadm:agencyAction "Provides support to the academic units/colleges." ;
    lspuadm:hasFeeText "n/a" ; lspuadm:hasProcessingTime "(within 6-12 months)" ;
    lspu:performedBy lspuadm:Role_DeansAssociateDeansProgramCoordinatorsFacultyotherstakeholders ;
    lspu:nextStep lspuadm:Serv_CurriculumReviewAndEnhancement_S8 ;
    lspuadm:sourceSection "XXIX. Curriculum Instruction Development, Service 1: Curriculum Review and Enhancement, Step 7, p. 79" .

lspuadm:Serv_CurriculumReviewAndEnhancement_S8 a lspuadm:ServiceStep ;
    rdfs:label "Step 8: Present to Board of Regents" ;
    lspuadm:clientAction "Presents the draft of the proposed curriculum enhancement to the Board of Regents for approval." ;
    lspuadm:agencyAction "Provides support to the academic units/colleges." ;
    lspuadm:hasFeeText "n/a" ; lspuadm:hasProcessingTime "(within 6-12 months)" ;
    lspu:performedBy lspuadm:Role_DeansAssociateDeansProgramCoordinatorsFacultyotherstakeholders ;
    lspu:nextStep lspuadm:Serv_CurriculumReviewAndEnhancement_S9 ;
    lspuadm:sourceSection "XXIX. Curriculum Instruction Development, Service 1: Curriculum Review and Enhancement, Step 8, p. 80" .

lspuadm:Serv_CurriculumReviewAndEnhancement_S9 a lspuadm:ServiceStep ;
    rdfs:label "Step 9: Present to Board of Regents (repeated in source)" ;
    lspuadm:clientAction "Presents the draft of the proposed curriculum enhancement to the Board of Regents for approval." ;
    lspuadm:agencyAction "Provides support to the academic units/colleges." ;
    lspuadm:hasFeeText "n/a" ; lspuadm:hasProcessingTime "(within 6-12 months)" ;
    lspu:performedBy lspuadm:Role_DeansAssociateDeansProgramCoordinatorsFacultyotherstakeholders ;
    lspu:nextStep lspuadm:Serv_CurriculumReviewAndEnhancement_S10 ;
    lspuadm:sourceSection "XXIX. Curriculum Instruction Development, Service 1: Curriculum Review and Enhancement, Step 9, p. 80" .

lspuadm:Serv_CurriculumReviewAndEnhancement_S10 a lspuadm:ServiceStep ;
    rdfs:label "Step 10: Submit completed staff work; orientation" ;
    lspuadm:clientAction "Submits completed staff work to the CID Unit and the OVPAA, and conducts orientation on the enhanced curriculum." ;
    lspuadm:agencyAction "Ensures the completeness and correctness of documents submitted; provides support to the academic units/colleges." ;
    lspuadm:hasFeeText "n/a" ; lspuadm:hasProcessingTime "(within 6-12 months)" ;
    lspu:performedBy lspuadm:Role_DeansAssociateDeansProgramCoordinatorsFacultyotherstakeholders ;
    lspuadm:sourceSection "XXIX. Curriculum Instruction Development, Service 1: Curriculum Review and Enhancement, Step 10, p. 80" .

lspuadm:Serv_EvaluationOfInstructionalMaterials a lspuadm:Service ;
    rdfs:label "Evaluation of Instructional Materials" ;
    lspu:definition "Defined procedure for the evaluation of instructional materials in consonance with other academic processes." ;
    lspuadm:availedAt lspuadm:Office_CurriculumAndInstructionDevelopment ;
    lspuadm:hasCategory lspuadm:Cat_Academic ; lspuadm:classificationText "Academic" ;
    lspuadm:hasTransactionType lspuadm:TT_Internal ;
    lspuadm:whoMayAvail "Faculty" ;
    lspu:requiresDocument lspuadm:Doc_DulyaccomplishedCIDSF002to006 ;
    lspu:hasStep lspuadm:Serv_EvaluationOfInstructionalMaterials_S1 ;
    lspuadm:totalFeeText "None" ; lspuadm:totalProcessingTime "Approx. 3 months" ;
    lspuadm:sourceDocument "LSPU Citizen's Charter, 2026 1st Edition (University-Wide)" ;
    lspuadm:sourceSection "XXIX. Curriculum Instruction Development, Service 2: Evaluation of Instructional Materials, p. 80" .

lspuadm:Serv_EvaluationOfInstructionalMaterials_S1 a lspuadm:ServiceStep ;
    rdfs:label "Step 1: Submit developed IMs for evaluation" ;
    lspuadm:clientAction "Submits the developed IMs to the UCCRC (Subject Matter Experts, Program Coordinator, GAD Director/Chairperson, ITSO Manager/Coordinator) for evaluation." ;
    lspuadm:agencyAction "Monitors the IMs evaluation process upon receipt from the faculty (with complete attachments)." ;
    lspuadm:hasFeeText "n/a" ; lspuadm:hasProcessingTime "Approx. 3 months (whole process)" ;
    lspu:performedBy lspuadm:Role_Faculty, lspuadm:Role_ProgramCoordinator, lspuadm:Role_SubjectMatterExpert, lspuadm:Role_GADChairpersonDirector, lspuadm:Role_ITSOChairpersonDirector, lspuadm:Role_CIDDirector, lspuadm:Role_VPAA ;
    lspu:nextStep lspuadm:Serv_EvaluationOfInstructionalMaterials_S2 ;
    lspuadm:sourceSection "XXIX. Curriculum Instruction Development, Service 2: Evaluation of Instructional Materials, Step 1, p. 80" .

lspuadm:Serv_EvaluationOfInstructionalMaterials_S2 a lspuadm:ServiceStep ;
    rdfs:label "Step 2: Revise the IMs" ;
    lspuadm:clientAction "Revises the IMs following the comments and suggestions given by the UCCRC." ;
    lspuadm:agencyAction "Monitors progress." ;
    lspuadm:hasFeeText "n/a" ; lspuadm:hasProcessingTime "(within approx. 3 months)" ;
    lspu:performedBy lspuadm:Role_Faculty ;
    lspu:nextStep lspuadm:Serv_EvaluationOfInstructionalMaterials_S3 ;
    lspuadm:sourceSection "XXIX. Curriculum Instruction Development, Service 2: Evaluation of Instructional Materials, Step 2, p. 80" .

lspuadm:Serv_EvaluationOfInstructionalMaterials_S3 a lspuadm:ServiceStep ;
    rdfs:label "Step 3: Submit to Dean/Associate Dean" ;
    lspuadm:clientAction "Submits the evaluated IMs to the College Dean/Associate Dean for endorsement to the CID." ;
    lspuadm:agencyAction "Receives, reviews, and validates the evaluated IMs." ;
    lspuadm:hasFeeText "n/a" ; lspuadm:hasProcessingTime "(within approx. 3 months)" ;
    lspu:performedBy lspuadm:Role_CollegeDeanAssociateDean ;
    lspu:nextStep lspuadm:Serv_EvaluationOfInstructionalMaterials_S4 ;
    lspuadm:sourceSection "XXIX. Curriculum Instruction Development, Service 2: Evaluation of Instructional Materials, Step 3, p. 80" .

lspuadm:Serv_EvaluationOfInstructionalMaterials_S4 a lspuadm:ServiceStep ;
    rdfs:label "Step 4: Endorse to VPAA" ;
    lspuadm:clientAction "Endorses the evaluated IMs to the VPAA for approval." ;
    lspuadm:hasFeeText "n/a" ; lspuadm:hasProcessingTime "(within approx. 3 months)" ;
    lspu:performedBy lspuadm:Role_CIDDirector, lspuadm:Role_VPAA ;
    lspu:nextStep lspuadm:Serv_EvaluationOfInstructionalMaterials_S5 ;
    lspuadm:sourceSection "XXIX. Curriculum Instruction Development, Service 2: Evaluation of Instructional Materials, Step 4, p. 80" .

lspuadm:Serv_EvaluationOfInstructionalMaterials_S5 a lspuadm:ServiceStep ;
    rdfs:label "Step 5: Return approved IMs" ;
    lspuadm:clientAction "Returns the approved IMs to the faculty with the Certificate of Utilization." ;
    lspuadm:hasFeeText "n/a" ; lspuadm:hasProcessingTime "(within approx. 3 months)" ;
    lspu:performedBy lspuadm:Role_CIDDirector ;
    lspu:nextStep lspuadm:Serv_EvaluationOfInstructionalMaterials_S6 ;
    lspuadm:sourceSection "XXIX. Curriculum Instruction Development, Service 2: Evaluation of Instructional Materials, Step 5, p. 80" .

lspuadm:Serv_EvaluationOfInstructionalMaterials_S6 a lspuadm:ServiceStep ;
    rdfs:label "Step 6: Utilize the approved IMs" ;
    lspuadm:clientAction "Utilizes the approved IMs in their respective classes." ;
    lspuadm:agencyAction "Monitors the evaluation of the effectiveness of the IMs by the end-user." ;
    lspuadm:hasFeeText "n/a" ; lspuadm:hasProcessingTime "(within approx. 3 months)" ;
    lspu:performedBy lspuadm:Role_Faculty, lspuadm:Role_CIDDirector ;
    lspuadm:sourceSection "XXIX. Curriculum Instruction Development, Service 2: Evaluation of Instructional Materials, Step 6, p. 80" .

