#  FLAGSHIP SERVICES -- BATCH 4: Research & Development (6),
#  Extension & Training (2), Procurement PPMP Consolidation (1),
#  Curriculum & Instruction Development (3). Services 5-6 of R&D,
#  both Extension services, PPMP and all 3 CID services were MISSING
#  from earlier batches (not even catalog-level) and are added here.
#################################################################

lspuadm:Serv_ResearchProgramProjectImplementationOfLSPUFundedResearch a lspuadm:Service ;
    rdfs:label "Research Program/Project Implementation of LSPU Funded Research" ;
    lspu:definition "Implementation of research programs and projects of LSPU-funded research." ;
    lspuadm:availedAt lspuadm:Office_ResearchAndDevelopment ;
    lspuadm:hasCategory lspuadm:Cat_Simple ; lspuadm:classificationText "Simple" ;
    lspuadm:hasTransactionType lspuadm:TT_G2C, lspuadm:TT_G2G, lspuadm:TT_G2B ;
    lspuadm:whoMayAvail "All" ;
    lspu:requiresDocument lspuadm:Doc_Researchproposals ;
    lspu:hasStep lspuadm:Serv_ResearchProgramProjectImplementationOfLSPUFundedResearch_S1 ;
    lspuadm:totalFeeText "None" ; lspuadm:totalProcessingTime "Depends on the project duration" ;
    lspuadm:sourceDocument "LSPU Citizen's Charter, 2026 1st Edition (University-Wide)" ;
    lspuadm:sourceSection "X. Research and Development Services, Service 1: Research Program/Project Implementation of LSPU Funded Research, p. 23" .

