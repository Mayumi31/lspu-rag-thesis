    lspuadm:hasFeeText "None" ; lspuadm:hasProcessingTime "1 minute" ;
    lspu:performedBy lspuadm:Role_RegistrationAdviserProgramCoordinatorCollegeDean ;
    lspuadm:sourceSection "XXXI. Colleges, Service 9: Enrollment Advising, Step 5, p. 91" .

