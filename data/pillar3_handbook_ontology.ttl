    lspu:performedBy lspuadm:Role_ExtensionOffice, lspuadm:Role_FacultyExtensionists, lspuadm:Role_ETSDirectorChairperson ;
    lspuadm:sourceSection "XI. Extension and Training Services, Service 2: Request for Training Services, Step 1, p. 29" .

lspuadm:Serv_ConsolidationOfApprovedPPMP a lspuadm:Service ;
    rdfs:label "Consolidation of Approved Project Procurement Management Plan (PPMP)" ;
    lspu:definition "Consolidation of approved PPMPs from various Offices and Colleges into the Annual Procurement Plan (APP)." ;
