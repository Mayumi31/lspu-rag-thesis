lspuprog:Job_ClinicalPsychTrack a lspuprog:JobOutcome ;
    lspuprog:jobOutcomeName "Clinical Psychology Track (Psychometrician / further studies toward licensure)" ;
    lspuprog:jobOutcomeDescription "Works as a psychometrician or pursues graduate study and supervised practice toward psychologist licensure under Philippine psychology practice law." ;
    lspuprog:requiresSkill lspuprog:Skill_ClinicalCaseFormulation, lspuprog:Skill_PsychAssessment ;
