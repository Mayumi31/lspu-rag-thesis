#-----------------------------------------------------------------
#  VIII. OSAS -- 5/6/7. Issuance of Good Moral Certificate
#  (Undergraduate / LSPU Alumni / Transferee) -- identical step
#  structure, different required documents
#-----------------------------------------------------------------

lspuadm:Serv_IssuanceOfGoodMoralCertificateUndergraduate a lspuadm:Service ;
    rdfs:label "Issuance of Good Moral Certificate (Undergraduate)" ;
    lspuadm:availedAt lspu:OSAS ;
    lspuadm:hasCategory lspuadm:Cat_Simple ; lspuadm:classificationText "Simple" ;
    lspuadm:hasTransactionType lspuadm:TT_G2C ;
    lspuadm:whoMayAvail "All" ;
    lspu:requiresDocument lspuadm:Doc_CORForGoodMoral, lspuadm:Doc_ORGoodMoralDocStamp, lspuadm:Doc_StudentIDForGoodMoral ;
    lspu:hasStep lspuadm:GoodMoralUG_Step1 ;
    lspuadm:totalFeeText "Certification Fee and Documentary Stamp (if applicable)" ; lspuadm:totalProcessingTime "1 hour and 15 minutes" ;
    lspuadm:sourceDocument "LSPU Citizen's Charter, 2026 1st Edition (University-Wide)" ;
    lspuadm:sourceSection "VIII. Office of the Student Affairs and Services, Service 5: Issuance of Good Moral Certificate (Undergraduate), p. 19" .

lspuadm:Doc_CORForGoodMoral a lspu:Document ; rdfs:label "Certificate of Registration" ; lspu:definition "Secured from the Registrar's Office." .
lspuadm:Doc_ORGoodMoralDocStamp a lspu:Document ; rdfs:label "Official Receipt for Good Moral / Documentary Stamp" ; lspu:definition "Secured from the Cashier's Office." .
lspuadm:Doc_StudentIDForGoodMoral a lspu:Document ; rdfs:label "Student ID" ; lspu:definition "Secured from the Business Affairs Office." .

lspuadm:GoodMoralUG_Step1 a lspuadm:ServiceStep ;
    rdfs:label "Step 1: Present Certificate of Registration" ;
    lspuadm:clientAction "Presents the Certificate of Registration." ;
    lspuadm:agencyAction "Receives and checks submitted documents; issues Good Moral payment slip." ;
    lspuadm:hasFeeText "None" ; lspuadm:hasProcessingTime "5 minutes" ;
    lspu:performedBy lspuadm:Role_OSASDirectorStaff ;
    lspu:nextStep lspuadm:GoodMoralUG_Step2 ;
    lspuadm:sourceSection "VIII. Office of the Student Affairs and Services, Service 5: Issuance of Good Moral Certificate (Undergraduate), Step 1, p. 19" .

lspuadm:GoodMoralUG_Step2 a lspuadm:ServiceStep ;
    rdfs:label "Step 2: Payment of fees; submit Official Receipt" ;
    lspuadm:clientAction "Pays the Certification Fee and Documentary Stamp (if applicable); submits the Official Receipt." ;
    lspuadm:agencyAction "Checks the Official Receipt." ;
    lspuadm:hasFeeText "Certification Fee and Documentary Stamp (if applicable)" ; lspuadm:hasProcessingTime "40 minutes" ;
    lspu:performedBy lspuadm:Role_CollectionOfficer ;
    lspu:nextStep lspuadm:GoodMoralUG_Step3 ;
    lspuadm:sourceSection "VIII. Office of the Student Affairs and Services, Service 5: Issuance of Good Moral Certificate (Undergraduate), Step 2, p. 19" .

lspuadm:GoodMoralUG_Step3 a lspuadm:ServiceStep ;
    rdfs:label "Step 3: Processing of Good Moral Certificate" ;
    lspuadm:agencyAction "Checks correctness of documents submitted; checks disciplinary records; prepares Good Moral Certificate; affixes documentary stamp; affixes signature on the certification." ;
    lspuadm:hasFeeText "None" ; lspuadm:hasProcessingTime "20 minutes" ;
    lspu:performedBy lspuadm:Role_OSASDirectorStaff ;
    lspu:nextStep lspuadm:GoodMoralUG_Step4 ;
    lspuadm:sourceSection "VIII. Office of the Student Affairs and Services, Service 5: Issuance of Good Moral Certificate (Undergraduate), Step 3, p. 19" .

lspuadm:GoodMoralUG_Step4 a lspuadm:ServiceStep ;
    rdfs:label "Step 4: Evaluate the services rendered by OSAS" ;
    lspuadm:agencyAction "Issues/confirms fulfillment of evaluation." ;
    lspuadm:hasFeeText "None" ; lspuadm:hasProcessingTime "5 minutes" ;
    lspu:performedBy lspuadm:Role_OSASDirectorStaff ;
    lspu:nextStep lspuadm:GoodMoralUG_Step5 ;
    lspuadm:sourceSection "VIII. Office of the Student Affairs and Services, Service 5: Issuance of Good Moral Certificate (Undergraduate), Step 4, p. 19" .

lspuadm:GoodMoralUG_Step5 a lspuadm:ServiceStep ;
    rdfs:label "Step 5: Accept the Good Moral Certificate; sign the logbook" ;
    lspuadm:clientAction "Accepts the Good Moral Certificate; signs the logbook." ;
    lspuadm:agencyAction "Releases the Good Moral Certificate." ;
    lspuadm:hasFeeText "None" ; lspuadm:hasProcessingTime "5 minutes" ;
    lspu:performedBy lspuadm:Role_OSASDirectorStaff ;
    lspuadm:sourceSection "VIII. Office of the Student Affairs and Services, Service 5: Issuance of Good Moral Certificate (Undergraduate), Step 5, p. 19" .

lspuadm:Serv_IssuanceOfGoodMoralCertificateLSPUAlumni a lspuadm:Service ;
    rdfs:label "Issuance of Good Moral Certificate (LSPU Alumni)" ;
    lspuadm:availedAt lspu:OSAS ;
    lspuadm:hasCategory lspuadm:Cat_Simple ; lspuadm:classificationText "Simple" ;
    lspuadm:hasTransactionType lspuadm:TT_G2C ;
    lspuadm:whoMayAvail "All" ;
    lspu:requiresDocument lspuadm:Doc_TORDiplomaOrAlumniID, lspuadm:Doc_ORGoodMoralDocStamp, lspuadm:Doc_StudentIDForGoodMoral ;
    lspu:hasStep lspuadm:GoodMoralUG_Step1 ;
    lspuadm:totalFeeText "Certification Fee and Documentary Stamp (if applicable)" ; lspuadm:totalProcessingTime "1 hour and 15 minutes" ;
    lspuadm:sourceDocument "LSPU Citizen's Charter, 2026 1st Edition (University-Wide)" ;
    lspuadm:sourceSection "VIII. Office of the Student Affairs and Services, Service 6: Issuance of Good Moral Certificate (LSPU Alumni), p. 21" ;
    rdfs:comment "Follows the same 5-step process as the Undergraduate Good Moral Certificate (GoodMoralUG_Step1-5); the client presents an original Transcript of Records, Diploma, or Alumni ID instead of a Certificate of Registration at Step 1." .

lspuadm:Doc_TORDiplomaOrAlumniID a lspu:Document ; rdfs:label "Original Transcript of Records, Diploma, or Alumni ID" ; lspu:definition "Secured from the Registrar's Office." .

lspuadm:Serv_IssuanceOfGoodMoralCertificateTransferee a lspuadm:Service ;
    rdfs:label "Issuance of Good Moral Certificate (Transferee)" ;
    lspuadm:availedAt lspu:OSAS ;
    lspuadm:hasCategory lspuadm:Cat_Simple ; lspuadm:classificationText "Simple" ;
    lspuadm:hasTransactionType lspuadm:TT_G2C ;
    lspuadm:whoMayAvail "All" ;
    lspu:requiresDocument lspuadm:Doc_CertificateOfTransferGoodMoral, lspuadm:Doc_ORGoodMoralDocStamp, lspuadm:Doc_StudentIDForGoodMoral ;
    lspu:hasStep lspuadm:GoodMoralUG_Step1 ;
    lspuadm:totalFeeText "Certification Fee and Documentary Stamp (if applicable)" ; lspuadm:totalProcessingTime "1 hour and 15 minutes" ;
    lspuadm:sourceDocument "LSPU Citizen's Charter, 2026 1st Edition (University-Wide)" ;
    lspuadm:sourceSection "VIII. Office of the Student Affairs and Services, Service 7: Issuance of Good Moral Certificate (Transferee), p. 21" ;
    rdfs:comment "Follows the same 5-step process as the Undergraduate Good Moral Certificate (GoodMoralUG_Step1-5); the client presents a Certificate of Transfer instead of a Certificate of Registration at Step 1." .

lspuadm:Doc_CertificateOfTransferGoodMoral a lspu:Document ; rdfs:label "Certificate of Transfer" ; lspu:definition "Secured from the Registrar's Office." .

#-----------------------------------------------------------------
#  IX. SCHOLARSHIP AND FINANCIAL ASSISTANCE -- 1. Processing of
#  Scholarship and Financial Assistance
#-----------------------------------------------------------------

lspuadm:Serv_ProcessingOfScholarshipAndFinancialAssistance a lspuadm:Service ;
    rdfs:label "Processing of Scholarship and Financial Assistance" ;
    lspuadm:availedAt lspuadm:Office_ScholarshipAndFinancialAssistanceUnit ;
    lspuadm:hasCategory lspuadm:Cat_Simple ; lspuadm:classificationText "Simple" ;
    lspuadm:hasTransactionType lspuadm:TT_G2C, lspuadm:TT_G2G, lspuadm:TT_G2B ;
    lspuadm:whoMayAvail "All" ;
    lspu:requiresDocument lspuadm:Doc_SFAApplicationForm, lspuadm:Doc_CHEDForm, lspuadm:Doc_CTCGrades,
        lspuadm:Doc_CTCCOR, lspuadm:Doc_FinancialDocuments, lspuadm:Doc_NotarizedNoEmploymentCert,
        lspuadm:Doc_IDWith3Signatures ;
    lspu:hasStep lspuadm:Scholarship_Step1 ;
    lspuadm:totalFeeText "None" ; lspuadm:totalProcessingTime "9 minutes" ;
    lspuadm:sourceDocument "LSPU Citizen's Charter, 2026 1st Edition (University-Wide)" ;
    lspuadm:sourceSection "IX. Scholarship and Financial Assistance, Service 1: Processing of Scholarship and Financial Assistance, p. 22" .

lspuadm:Doc_SFAApplicationForm a lspu:Document ; rdfs:label "Application Form for Scholarship and Financial Assistance" ; lspu:definition "Secured from the Scholarship and Financial Assistance Office / SFA page (online)." .
lspuadm:Doc_CHEDForm a lspu:Document ; rdfs:label "Application Form (CHED Form)" ; lspu:definition "Secured from the CHED official page / SFA Office / SFA page (online)." .
lspuadm:Doc_CTCGrades a lspu:Document ; rdfs:label "Certified True Copy of Grades" ; lspu:definition "Secured from the Registrar." .
lspuadm:Doc_CTCCOR a lspu:Document ; rdfs:label "Certified True Copy of Certificate of Registration" ; lspu:definition "Secured from the Registrar." .
lspuadm:Doc_FinancialDocuments a lspu:Document ; rdfs:label "Financial Documents" ; lspu:definition "Secured from the DSWD and BIR Office." .
lspuadm:Doc_NotarizedNoEmploymentCert a lspu:Document ; rdfs:label "Notarized Certificate of No Employment and No Scholarship" ; lspu:definition "Secured from a Law Office." .
lspuadm:Doc_IDWith3Signatures a lspu:Document ; rdfs:label "Copy of ID with 3 Specimen Signatures" ; lspu:definition "Secured from the Business Affairs Office / Student." .

lspuadm:Scholarship_Step1 a lspuadm:ServiceStep ;
    rdfs:label "Step 1: Apply for scholarship" ;
    lspuadm:clientAction "Applies for scholarship through online or actual application." ;
    lspuadm:agencyAction "Verifies the qualification of the applicant." ;
    lspuadm:hasFeeText "None" ; lspuadm:hasProcessingTime "2 minutes" ;
    lspu:performedBy lspuadm:Role_SFADirectorStaff ;
    lspu:nextStep lspuadm:Scholarship_Step2 ;
    lspuadm:sourceSection "IX. Scholarship and Financial Assistance, Service 1: Processing of Scholarship and Financial Assistance, Step 1, p. 22" .

lspuadm:Scholarship_Step2 a lspuadm:ServiceStep ;
    rdfs:label "Step 2: Fill out application form" ;
    lspuadm:clientAction "Fills out the application form (SFA Form/CHED Form/other forms)." ;
    lspuadm:agencyAction "Issues the application form through online or actual application based on the scholarship program applied for." ;
    lspuadm:hasFeeText "None" ; lspuadm:hasProcessingTime "2 minutes" ;
    lspu:performedBy lspuadm:Role_SFADirectorStaff ;
    lspu:nextStep lspuadm:Scholarship_Step3 ;
    lspuadm:sourceSection "IX. Scholarship and Financial Assistance, Service 1: Processing of Scholarship and Financial Assistance, Step 2, p. 22" .

lspuadm:Scholarship_Step3 a lspuadm:ServiceStep ;
    rdfs:label "Step 3: Submit scholarship/CHED form and documentary requirements" ;
    lspuadm:clientAction "Submits the scholarship and/or CHED form and other documentary requirements." ;
    lspuadm:agencyAction "Checks the filled-out form and the requirements for approval of the scholarship or financial assistance." ;
    lspuadm:hasFeeText "None" ; lspuadm:hasProcessingTime "3 minutes" ;
    lspu:performedBy lspuadm:Role_SFADirectorStaff ;
    lspu:nextStep lspuadm:Scholarship_Step4 ;
    lspuadm:sourceSection "IX. Scholarship and Financial Assistance, Service 1: Processing of Scholarship and Financial Assistance, Step 3, p. 22" .

lspuadm:Scholarship_Step4 a lspuadm:ServiceStep ;
    rdfs:label "Step 4: Request for certification" ;
    lspuadm:clientAction "Requests certification for scholars." ;
    lspuadm:agencyAction "Issues certification for scholars." ;
    lspuadm:hasFeeText "None" ; lspuadm:hasProcessingTime "2 minutes" ;
    lspu:performedBy lspuadm:Role_SFADirectorStaff ;
    lspuadm:sourceSection "IX. Scholarship and Financial Assistance, Service 1: Processing of Scholarship and Financial Assistance, Step 4, p. 23" .

lspuadm:Role_SFADirectorStaff a lspu:UniversityRole ; rdfs:label "Scholarship and Financial Assistance Director/Chairperson and Technical Staff" .


#################################################################
#  FLAGSHIP SERVICES -- BATCH 3: Colleges (9 services) + Guidance
#  Counseling + Feedback and Complaints Mechanism. Fully populated
