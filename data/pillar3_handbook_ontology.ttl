#################################################################
#  PILLAR 3 — STUDENT LIFE & CONDUCT POLICY / HANDBOOK (source: pillar3_handbook_ontology.ttl)
#################################################################

@prefix lspu:  <http://lspu.edu.ph/ontology/handbook#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

#################################################################
#  LSPU-LB STUDENT HANDBOOK ONTOLOGY (2021 Edition)
#  Scope: student-facing knowledge only — rights, duties, rules
#  of conduct, sanctions, academic standing, procedures, offices,
#  and forms that a currently-enrolled student needs to know or
#  use. Purely internal/administrative content (e.g. Board of
#  Regents composition, historical founding, faculty HR matters,
#  the handbook's own editorial committee) is intentionally
#  OUT OF SCOPE and excluded from this schema and its instances.
#################################################################

<http://lspu.edu.ph/ontology/handbook> a owl:Ontology ;
    rdfs:label "LSPU-LB Student Handbook Ontology" ;
    rdfs:comment "Domain ontology for a student-facing RAG knowledge graph built from the LSPU Student Handbook, 2021 Edition. Covers the Code of Conduct (offenses & sanctions), student rights and duties, academic standing rules, disciplinary procedure, offices/committees a student interacts with, and forms a student may need." .

#################################################################
#  CLASSES
#################################################################

lspu:Offense a owl:Class ;
    rdfs:label "Offense" ;
    rdfs:comment "A defined act of student misconduct prohibited by the LSPU Code of Conduct. Unifies the handbook's interchangeable use of 'offense', 'violation', 'misconduct', and 'infraction' under one class." .

lspu:MajorOffense a owl:Class ;
    rdfs:subClassOf lspu:Offense ;
    rdfs:label "Major Offense" ;
    rdfs:comment "An offense involving serious deviation from expected student conduct (Code of Conduct, Article 2), sanctioned by suspension up to expulsion." .

lspu:MinorOffense a owl:Class ;
    rdfs:subClassOf lspu:Offense ;
    rdfs:label "Minor Offense" ;
    rdfs:comment "A lesser offense (Code of Conduct, Article 3), typically sanctioned by reprimand, community service, or short suspension." .

lspu:SanctionTier a owl:Class ;
    rdfs:label "Sanction Tier" ;
    rdfs:comment "The disciplinary consequence attached to a specific occurrence count (1st, 2nd, 3rd/subsequent) of a given Offense." .

lspu:Sanction a owl:Class ;
    rdfs:label "Sanction" ;
    rdfs:comment "A specific disciplinary consequence type that may be imposed on a student, e.g. reprimand, suspension, expulsion, community service, payment of damages, letter of apology." .

lspu:AcademicStatus a owl:Class ;
    rdfs:label "Academic Status" ;
    rdfs:comment "A formally defined academic standing a student may be placed in based on scholastic performance (e.g. Warning, Probation, Dismissal, Disqualification)." .

lspu:Right a owl:Class ;
    rdfs:label "Student Right" ;
    rdfs:comment "An entitlement a student enjoys under the handbook and existing law." .

lspu:Duty a owl:Class ;
    rdfs:label "Student Duty" ;
    rdfs:comment "An obligation or expected standard of conduct imposed on every student." .

lspu:Policy a owl:Class ;
    rdfs:label "Policy" ;
    rdfs:comment "A university rule, regulation, or procedural requirement that a student must follow or may invoke (unifies the handbook's interchangeable 'rule' / 'regulation' / 'policy' wording)." .

lspu:Procedure a owl:Class ;
    rdfs:label "Procedure" ;
    rdfs:comment "A defined, ordered sequence of steps a student or the university follows to resolve a case or complete a process (e.g. the disciplinary process, withdrawal, grade rectification)." .

lspu:ProcedureStep a owl:Class ;
    rdfs:label "Procedure Step" ;
    rdfs:comment "One ordered step within a Procedure." .

lspu:Office a owl:Class ;
    rdfs:label "Office" ;
    rdfs:comment "An administrative unit or digital service point a student can approach or use for a service, complaint, or document (e.g. OSAS, Office of the Registrar, Guidance Office, or the LSPU Student Portal)." .

lspu:Committee a owl:Class ;
    rdfs:label "Committee" ;
    rdfs:comment "A formally constituted decision-making or advisory body relevant to student cases, with defined composition (e.g. Student Discipline Committee)." .

lspu:UniversityRole a owl:Class ;
    rdfs:label "University Role" ;
    rdfs:comment "A university official role a student may need to approach, petition, or be evaluated by (e.g. Dean, Registrar, Guidance Counselor, Student Discipline Coordinator, Campus Director, University President). Represents the role, not a named individual." .

lspu:Document a owl:Class ;
    rdfs:label "Document/Form" ;
    rdfs:comment "A prescribed form, slip, or certificate a student fills out, signs, or receives (e.g. Excuse Slip, Promissory Note, LOA Form)." .

lspu:LegalBasis a owl:Class ;
    rdfs:label "Legal Basis" ;
    rdfs:comment "An external law, act, memorandum order, or board resolution cited as the authority for an offense definition or policy." .

lspu:StudentType a owl:Class ;
    rdfs:label "Student Type" ;
    rdfs:comment "A category of student status referenced by the handbook's rules (e.g. undergraduate, graduate, special student, transferee)." .

#################################################################
#  OBJECT PROPERTIES
#################################################################

lspu:hasSanctionTier a owl:ObjectProperty ;
    rdfs:domain lspu:Offense ; rdfs:range lspu:SanctionTier ;
    rdfs:label "hasSanctionTier" ;
    rdfs:comment "Links an Offense to one of its occurrence-based sanction tiers (1st/2nd/3rd offense)." .

lspu:imposesSanction a owl:ObjectProperty ;
    rdfs:domain lspu:SanctionTier ; rdfs:range lspu:Sanction ;
    rdfs:label "imposesSanction" ;
    rdfs:comment "Links a Sanction Tier to the type(s) of Sanction it imposes." .

lspu:reportedTo a owl:ObjectProperty ;
    rdfs:domain lspu:Offense ; rdfs:range lspu:Office ;
    rdfs:label "reportedTo" ;
    rdfs:comment "The office a student should report an occurrence of this offense to, or that handles it." .

lspu:receivesReportOf a owl:ObjectProperty ;
    owl:inverseOf lspu:reportedTo ;
    rdfs:domain lspu:Office ; rdfs:range lspu:Offense ;
    rdfs:label "receivesReportOf" .

lspu:handledByCommittee a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf (lspu:Offense lspu:Procedure) ] ; rdfs:range lspu:Committee ;
    rdfs:label "handledByCommittee" ;
    rdfs:comment "The committee responsible for investigating/deciding a matter." .

lspu:handles a owl:ObjectProperty ;
    owl:inverseOf lspu:handledByCommittee ;
    rdfs:domain lspu:Committee ; rdfs:range [ a owl:Class ; owl:unionOf (lspu:Offense lspu:Procedure) ] ;
    rdfs:label "handles" .

lspu:hasCommitteeRole a owl:ObjectProperty ;
    rdfs:domain lspu:Committee ; rdfs:range lspu:UniversityRole ;
    rdfs:label "hasCommitteeRole" ;
    rdfs:comment "A university role that sits on this committee (e.g. as chair or member)." .

lspu:hasStep a owl:ObjectProperty ;
    rdfs:domain lspu:Procedure ; rdfs:range lspu:ProcedureStep ;
    rdfs:label "hasStep" .

lspu:nextStep a owl:ObjectProperty ;
    rdfs:domain lspu:ProcedureStep ; rdfs:range lspu:ProcedureStep ;
    rdfs:label "nextStep" ;
    rdfs:comment "Orders one procedure step after another." .

lspu:performedBy a owl:ObjectProperty ;
    rdfs:domain lspu:ProcedureStep ; rdfs:range [ a owl:Class ; owl:unionOf (lspu:UniversityRole lspu:Office lspu:Committee) ] ;
    rdfs:label "performedBy" .

lspu:issuedBy a owl:ObjectProperty ;
    rdfs:domain lspu:Document ; rdfs:range lspu:Office ;
    rdfs:label "issuedBy" .

lspu:issues a owl:ObjectProperty ;
    owl:inverseOf lspu:issuedBy ;
    rdfs:domain lspu:Office ; rdfs:range lspu:Document ;
    rdfs:label "issues" .

lspu:resultsInStatus a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf (lspu:Offense lspu:Policy) ] ; rdfs:range lspu:AcademicStatus ;
    rdfs:label "resultsInStatus" ;
    rdfs:comment "Links a scholastic-delinquency rule or repeated-offense clause to the resulting Academic Status." .

lspu:administeredBy a owl:ObjectProperty ;
    rdfs:domain lspu:Policy ; rdfs:range lspu:Office ;
    rdfs:label "administeredBy" .

lspu:administers a owl:ObjectProperty ;
    owl:inverseOf lspu:administeredBy ;
    rdfs:domain lspu:Office ; rdfs:range lspu:Policy ;
    rdfs:label "administers" .

lspu:relatedRight a owl:ObjectProperty ;
    rdfs:domain lspu:Offense ; rdfs:range lspu:Right ;
    rdfs:label "relatedRight" ;
    rdfs:comment "A student right that is relevant to or limited by this offense/procedure (e.g. due process)." .

#################################################################
#  DATA PROPERTIES
#################################################################

lspu:sourceArticle a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:label "sourceArticle" ; rdfs:comment "Article/Section citation in the handbook, e.g. 'Chapter 6, Article 2, Sec. 1.1'." .

lspu:occurrenceOrdinal a owl:DatatypeProperty ; rdfs:domain lspu:SanctionTier ; rdfs:range xsd:string ;
    rdfs:label "occurrenceOrdinal" ; rdfs:comment "e.g. '1st Offense', '2nd Offense', '3rd Offense / Subsequent Offense'." .

lspu:sanctionType a owl:DatatypeProperty ; rdfs:domain lspu:Sanction ; rdfs:range xsd:string ;
    rdfs:label "sanctionType" ; rdfs:comment "Category of sanction: Reprimand | CommunityService | Suspension | Expulsion | Dismissal | PaymentOfDamages | LetterOfApology | PromissoryNote | Warning." .

lspu:durationText a owl:DatatypeProperty ; rdfs:domain lspu:Sanction ; rdfs:range xsd:string ;
    rdfs:label "durationText" ; rdfs:comment "Free-text duration as stated in the handbook, e.g. 'one (1) semester'." .

lspu:definition a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:label "definition" ; rdfs:comment "The handbook's own definition/description text for this instance." .

lspu:actName a owl:DatatypeProperty ; rdfs:domain lspu:LegalBasis ; rdfs:range xsd:string .

lspu:contactNote a owl:DatatypeProperty ; rdfs:domain lspu:Office ; rdfs:range xsd:string ;
    rdfs:comment "Practical note on when/why a student would go to this office." .

#################################################################
#  LEGAL BASES
#################################################################

lspu:RA10175 a lspu:LegalBasis ; rdfs:label "RA 10175" ;
    lspu:actName "Cybercrime Prevention Act of 2012" .

lspu:RA10627 a lspu:LegalBasis ; rdfs:label "RA 10627" ;
    lspu:actName "Anti-Bullying Act of 2013" .

lspu:RA9165 a lspu:LegalBasis ; rdfs:label "RA 9165" ;
    lspu:actName "Comprehensive Dangerous Drugs Act of 2002" .

lspu:RA9775 a lspu:LegalBasis ; rdfs:label "RA 9775" ;
    lspu:actName "Anti-Child Pornography Act of 2009" .

lspu:RPCArt355 a lspu:LegalBasis ; rdfs:label "Revised Penal Code, Art. 355" ;
    lspu:actName "Libel, as defined under the Revised Penal Code" .

lspu:PD960_969 a lspu:LegalBasis ; rdfs:label "PD 960 as amended by PD 969" ;
    lspu:actName "Presidential Decree governing indecency/obscenity" .

lspu:RA8491 a lspu:LegalBasis ; rdfs:label "RA 8491, Sec. 18 & 50" ;
    lspu:actName "Philippine Flag Law" .

#################################################################
#  OFFICES
#################################################################

lspu:OSAS a lspu:Office ; rdfs:label "Office of Student Affairs and Services (OSAS)" ;
    lspu:contactNote "Handles all complaints against alleged violators of the Code of Conduct; issues promissory notes, excuse-slip referrals, and coordinates the Student Discipline Coordinator." .

lspu:OfficeOfTheRegistrar a lspu:Office ; rdfs:label "Office of the Registrar" ;
    lspu:contactNote "Issues Copy of Grades (COG), handles enrollment, dropping, withdrawal, Honorable Dismissal, and change/rectification of grades requests." .

lspu:GuidanceOffice a lspu:Office ; rdfs:label "Guidance Office" ;
    lspu:contactNote "Issues excuse slips for absences; does follow-up counseling for students who violated a rule (except expulsion cases)." .

lspu:SafetyAndSecurityManagementOffice a lspu:Office ; rdfs:label "Safety and Security Management Office" ;
    lspu:contactNote "Receives reports of unauthorized possession of firearms/deadly weapons and narcotics-related concerns." .

#################################################################
#  COMMITTEE
#################################################################

lspu:StudentDisciplineCommittee a lspu:Committee ; rdfs:label "Student Discipline Committee" ;
    lspu:definition "Handles investigation and recommendation on all Code of Conduct violation complaints; composed of the OSAS Director/Chairperson (Chair), Student Discipline Coordinator (Vice Chair), VPAA/Campus Director, the student's College Dean, Chief Security Officer, President of the Supreme Student Council, and the University Legal Consultant." ;
    lspu:sourceArticle "Chapter 6, Article 7, Sec. 2" ;
    lspu:hasCommitteeRole lspu:Role_OSASDirector, lspu:Role_StudentDisciplineCoordinator,
        lspu:Role_VPAA_CampusDirector, lspu:Role_CollegeDean, lspu:Role_ChiefSecurityOfficer,
        lspu:Role_SSCPresident, lspu:Role_UniversityLegalConsultant .

lspu:Committee_AwardsAndRecognition a lspu:Committee ; rdfs:label "Committee on Awards and Recognition" ;
    lspu:definition "Finalizes recipients of University awards; typically composed of a Committee Chair, Co-chair, and three (3) members, working with the relevant adviser, Program Chair, Dean, or office head depending on the award." ;
    lspu:sourceArticle "Appendix B, various (e.g. Article 2 Sec.2, Article 3 Sec.1.3, Article 4 Sec.1.4)" .

#################################################################
#  UNIVERSITY ROLES (relevant contact points for students)
#################################################################

lspu:Role_UniversityPresident a lspu:UniversityRole ; rdfs:label "University President" ;
    lspu:definition "Has final say in all major disciplinary cases; final authority to suspend classes; approves graduacion in absencia." .

lspu:Role_CampusDirector a lspu:UniversityRole ; rdfs:label "Campus Director" .

lspu:Role_VPAA_CampusDirector a lspu:UniversityRole ; rdfs:label "Vice President for Academic Affairs / Campus Director" .

lspu:Role_CollegeDean a lspu:UniversityRole ; rdfs:label "College Dean" ;
    lspu:definition "Approves petitions (substitution, cross-registration, dropping, LOA), evaluates transferees, member of the Student Discipline Committee for the enrolled student's college." .

lspu:Role_OSASDirector a lspu:UniversityRole ; rdfs:label "OSAS Director/Chairperson" .

lspu:Role_StudentDisciplineCoordinator a lspu:UniversityRole ; rdfs:label "Student Discipline Coordinator" ;
    lspu:definition "First point of contact for filing a written, signed complaint under Code of Conduct procedure." .

lspu:Role_GuidanceCounselor a lspu:UniversityRole ; rdfs:label "Guidance Counselor" .

lspu:Role_ChiefSecurityOfficer a lspu:UniversityRole ; rdfs:label "Chief Security Officer" .

lspu:Role_SSCPresident a lspu:UniversityRole ; rdfs:label "President, Supreme Student Council" .

lspu:Role_UniversityLegalConsultant a lspu:UniversityRole ; rdfs:label "University Legal Consultant" .

lspu:Role_UniversityRegistrar a lspu:UniversityRole ; rdfs:label "University/Campus Registrar" .

#################################################################
#  ACADEMIC STATUS
#################################################################

lspu:Status_Warning a lspu:AcademicStatus ; rdfs:label "Warning" ;
    lspu:definition "Given by the Dean at end of semester to a student who fails 25%-49% of total registered academic units; advised to improve performance." ;
    lspu:sourceArticle "Sec. 4.1, Scholastic Delinquency" .

lspu:Status_Probation a lspu:AcademicStatus ; rdfs:label "Probation" ;
    lspu:definition "Placed on a student who fails 50%-74% of total registered academic units at end of semester; load is reduced by the Dean; lifted upon passing all subjects carried during the probation term." ;
    lspu:sourceArticle "Sec. 4.2, Scholastic Delinquency" .

lspu:Status_Dismissal a lspu:AcademicStatus ; rdfs:label "Dismissal (from the College)" ;
    lspu:definition "Applied to a student who fails more than 75% of total enrolled academic units (with stated exceptions for incomplete grades and students with only 9 units)." ;
    lspu:sourceArticle "Sec. 4.3, Scholastic Delinquency" .

lspu:Status_Disqualification a lspu:AcademicStatus ; rdfs:label "Disqualification" ;
    lspu:definition "Enrollment-status flag that may appear on a student's Copy of Grades (COG) alongside warning, probation, or dismissal." ;
    lspu:sourceArticle "Sec. 8.1.1.1" .

#################################################################
#  STUDENT RIGHTS (Appendix A, Article 1)
#################################################################

lspu:Right_QualityEducation a lspu:Right ; rdfs:label "Right to relevant quality education" ;
    lspu:definition "The right to receive, primarily through competent instruction, relevant quality education in line with national goals and conducive to full development as a person with human dignity." ;
    lspu:sourceArticle "Appendix A, Article 1(a)" .

lspu:Right_ChooseFieldOfStudy a lspu:Right ; rdfs:label "Right to freely choose field of study" ;
    lspu:definition "The right to freely choose one's field of study, subject to existing curricula, and to continue the course therein up to graduation, except in cases of academic deficiency or violation of disciplinary regulations." ;
    lspu:sourceArticle "Appendix A, Article 1(b)" .

lspu:Right_GuidanceCounseling a lspu:Right ; rdfs:label "Right to guidance and counseling services" ;
    lspu:definition "The right to guidance and counseling services for making decisions and selecting alternatives in fields of work suited to one's potentialities." ;
    lspu:sourceArticle "Appendix A, Article 1(c)" .

lspu:Right_AccessRecords a lspu:Right ; rdfs:label "Right to access own academic records" ;
    lspu:definition "The right to access one's own academic records, the confidentiality of which the University shall maintain and preserve." ;
    lspu:sourceArticle "Appendix A, Article 1(d)" .

lspu:Right_IssuanceOfDocuments a lspu:Right ; rdfs:label "Right to issuance of official documents within 30 days" ;
    lspu:definition "The right to the issuance of official certificates, diplomas, transcript of records, grades, transfer credentials, and other similar documents within thirty (30) days from request." ;
    lspu:sourceArticle "Appendix A, Article 1(e)" .

lspu:Right_PublishAndInvite a lspu:Right ; rdfs:label "Right to publish and invite resource persons" ;
    lspu:definition "The right to publish a student newspaper and similar publications, and the right to invite resource persons during assemblies, symposia, and other activities of a similar nature." ;
    lspu:sourceArticle "Appendix A, Article 1(f)" .

lspu:Right_FreeExpression a lspu:Right ; rdfs:label "Right to free expression and communication channels" ;
    lspu:definition "The right to have free expression of opinions and suggestions, and access to particular channels of communication with the appropriate academic and administrative bodies of the University." ;
    lspu:sourceArticle "Appendix A, Article 1(g)" .

lspu:Right_JoinOrganizations a lspu:Right ; rdfs:label "Right to form/join recognized organizations" ;
    lspu:definition "The right to form, establish, join, or participate in organizations and societies recognized by the University to foster intellectual, cultural, spiritual, and physical growth and development, or to form, establish, join, and maintain organizations and societies for purposes not contrary to law." ;
    lspu:sourceArticle "Appendix A, Article 1(h)" .

lspu:Right_FreeFromInvoluntaryContributions a lspu:Right ; rdfs:label "Right to be free from involuntary contributions" ;
    lspu:definition "The right to be free from involuntary contributions, except those approved by one's own organizations and societies." ;
    lspu:sourceArticle "Appendix A, Article 1(i)" .

lspu:Right_DueProcess a lspu:Right ; rdfs:label "Right to due process in disciplinary proceedings" ;
    lspu:definition "All parties concerned in a major disciplinary case shall be afforded due process." ;
    lspu:sourceArticle "Chapter 6, Article 6, Sec. 3" .

#################################################################
#  STUDENT DUTIES (Appendix A, Article 2)
#################################################################

lspu:Duty_DevelopPotential a lspu:Duty ; rdfs:label "Exert effort to develop one's potential for service" ;
    lspu:definition "Every student shall exert utmost effort to develop his/her potentialities for service, particularly by being an asset to his/her family and to society." ;
    lspu:sourceArticle "Appendix A, Article 2(a)" .

lspu:Duty_AcademicIntegrity a lspu:Duty ; rdfs:label "Uphold academic integrity and abide by academic rules" ;
    lspu:definition "Every student shall uphold the academic integrity of the University, endeavor to achieve academic excellence, and abide by the rules and regulations governing his/her academic responsibilities and moral integrity." ;
    lspu:sourceArticle "Appendix A, Article 2(b)" .

lspu:Duty_MaintainPeace a lspu:Duty ; rdfs:label "Promote peace and tranquility, observe rules of discipline" ;
    lspu:definition "Every student shall promote and maintain the peace and tranquility of the University by observing the rules of discipline, and by exerting effort to attain a harmonious relationship with fellow students, the teaching and academic staff, and other university personnel." ;
    lspu:sourceArticle "Appendix A, Article 2(c)" .

lspu:Duty_CivicParticipation a lspu:Duty ; rdfs:label "Participate actively in civic affairs and general welfare" ;
    lspu:definition "Every student shall participate actively in civic affairs and in the promotion of the general welfare, particularly in the social, economic, and cultural development of his/her community, and in the attainment of a just, compassionate, and orderly society." ;
    lspu:sourceArticle "Appendix A, Article 2(d)" .

lspu:Duty_ResponsibleRights a lspu:Duty ; rdfs:label "Exercise rights responsibly, answerable for infringement of others' rights" ;
    lspu:definition "Every student shall exercise his/her rights responsibly, in the knowledge that he/she is answerable for any infringement or violation of the public welfare and of the rights of others." ;
    lspu:sourceArticle "Appendix A, Article 2(e)" .

#################################################################
#  DOCUMENTS / FORMS
#################################################################

lspu:Doc_ExcuseSlip a lspu:Document ; rdfs:label "Excuse Slip" ;
    lspu:definition "Requested for readmission to class after an absence/tardiness; must be presented to the instructor not later than the second class session following return." ;
    lspu:issuedBy lspu:GuidanceOffice, lspu:OSAS .

lspu:Doc_PromissoryNote a lspu:Document ; rdfs:label "Promissory Note" ;
    lspu:definition "Signed by the student (and parent/guardian) agreeing to comply with university conditions; further misconduct bars re-enrollment. Filed with OSAS Discipline Committee." ;
    lspu:issuedBy lspu:OSAS .

lspu:Doc_LOAForm a lspu:Document ; rdfs:label "Leave of Absence (LOA) Form" ;
    lspu:definition "Filed by a graduate student intending to take a leave of absence, stating reason and length (max 2 years); failure to file results in Absence Without Official Leave (AWOL)." ;
    lspu:issuedBy lspu:OfficeOfTheRegistrar .

lspu:Doc_PledgeOfCompliance a lspu:Document ; rdfs:label "Pledge of Compliance" ;
    lspu:definition "Signed by the student and parent/guardian at admission, pledging to abide by all university rules and regulations; refusal or violation of its terms is sufficient for summary dismissal or denial of admission." .

lspu:Doc_InformedConsentMinor a lspu:Document ; rdfs:label "Informed Consent Form (for minor clients)" ;
    lspu:definition "Signed by a parent/guardian granting or declining permission for a minor student to receive a specified service, activity, or program." .

lspu:Doc_InformedConsentAdult a lspu:Document ; rdfs:label "Informed Consent Form (for adult clients)" ;
    lspu:definition "Signed by an adult student giving full consent to participate in a specified service, activity, or program." .


#################################################################
#  MAJOR OFFENSES (Code of Conduct, Chapter 6, Article 2)
#################################################################

lspu:CyberBullying a lspu:MajorOffense ;
    rdfs:label "Cyber Bullying" ;
    lspu:definition "Bullying done through the use of technology or any electronic means." ;
    lspu:sourceArticle "Ch.6 Art.2 Sec.1.1" ;
    lspu:isBasedOn lspu:RA10175 ;
    lspu:hasSanctionTier lspu:Tier_CyberBullying_1, lspu:Tier_CyberBullying_2, lspu:Tier_CyberBullying_3 .

lspu:Sanc_Tier_CyberBullying_1_1 a lspu:Sanction ;
    lspu:sanctionType "Suspension" ;
    lspu:durationText "one (1) month" .

lspu:Tier_CyberBullying_1 a lspu:SanctionTier ;
    lspu:occurrenceOrdinal "1st Offense" ;
    lspu:imposesSanction lspu:Sanc_Tier_CyberBullying_1_1 .

lspu:Sanc_Tier_CyberBullying_2_1 a lspu:Sanction ;
    lspu:sanctionType "Suspension" ;
    lspu:durationText "one (1) semester" .

lspu:Tier_CyberBullying_2 a lspu:SanctionTier ;
    lspu:occurrenceOrdinal "2nd Offense" ;
    lspu:imposesSanction lspu:Sanc_Tier_CyberBullying_2_1 .

lspu:Sanc_Tier_CyberBullying_3_1 a lspu:Sanction ;
    lspu:sanctionType "Expulsion" ;
    lspu:durationText "from the University" .

lspu:Tier_CyberBullying_3 a lspu:SanctionTier ;
    lspu:occurrenceOrdinal "3rd Offense" ;
    lspu:imposesSanction lspu:Sanc_Tier_CyberBullying_3_1 .


lspu:IllegalAccessHacking a lspu:MajorOffense ;
    rdfs:label "Illegal Access or Hacking" ;
    lspu:definition "Illegal access or hacking to the whole or any part of one's online accounts including e-mail, social media profiles, etc." ;
    lspu:sourceArticle "Ch.6 Art.2 Sec.1.2" ;
    lspu:isBasedOn lspu:RA10175 ;
    lspu:hasSanctionTier lspu:Tier_IllegalAccessHacking_1, lspu:Tier_IllegalAccessHacking_2, lspu:Tier_IllegalAccessHacking_3 .

lspu:Sanc_Tier_IllegalAccessHacking_1_1 a lspu:Sanction ;
    lspu:sanctionType "Suspension" ;
    lspu:durationText "one (1) month" .

lspu:Tier_IllegalAccessHacking_1 a lspu:SanctionTier ;
    lspu:occurrenceOrdinal "1st Offense" ;
    lspu:imposesSanction lspu:Sanc_Tier_IllegalAccessHacking_1_1 .

lspu:Sanc_Tier_IllegalAccessHacking_2_1 a lspu:Sanction ;
    lspu:sanctionType "Suspension" ;
    lspu:durationText "one (1) semester" .

lspu:Tier_IllegalAccessHacking_2 a lspu:SanctionTier ;
    lspu:occurrenceOrdinal "2nd Offense" ;
    lspu:imposesSanction lspu:Sanc_Tier_IllegalAccessHacking_2_1 .

lspu:Sanc_Tier_IllegalAccessHacking_3_1 a lspu:Sanction ;
    lspu:sanctionType "Expulsion" ;
    lspu:durationText "from the University" .

lspu:Tier_IllegalAccessHacking_3 a lspu:SanctionTier ;
    lspu:occurrenceOrdinal "3rd Offense" ;
    lspu:imposesSanction lspu:Sanc_Tier_IllegalAccessHacking_3_1 .


lspu:IllegalInterception a lspu:MajorOffense ;
    rdfs:label "Illegal Interception" ;
