    rdfs:label "Step 1: Present complete requirements to OSAS" ;
    lspuadm:clientAction "Presents complete requirements to OSAS." ;
    lspuadm:agencyAction "Checks papers for details; reviews constitution and by-laws, program of activities, and consolidated accomplishment reports for previous year (for renewal only)." ;
    lspuadm:hasFeeText "None" ; lspuadm:hasProcessingTime "10 days" ;
    lspu:performedBy lspuadm:Role_StudentOrgUnitHead ;
    lspu:nextStep lspuadm:StudentOrg_Step2 ;
