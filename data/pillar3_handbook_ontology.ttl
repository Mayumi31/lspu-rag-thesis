    lspuadm:hasCategory lspuadm:Cat_HighlyTechnical ; lspuadm:classificationText "Highly Technical" ;
    lspuadm:hasTransactionType lspuadm:TT_G2G ;
    lspuadm:whoMayAvail "End Users" ;
    lspu:requiresDocument lspuadm:Doc_ApprovedProjectProcurementManagementPlanPPMP, lspuadm:Doc_ApprovedAnnualProcurementPlanAPP ;
    lspu:hasStep lspuadm:Serv_ConsolidationOfApprovedPPMP_S1 ;
    lspuadm:totalFeeText "None" ; lspuadm:totalProcessingTime "11 days and 15 minutes" ;
    lspuadm:sourceDocument "LSPU Citizen's Charter, 2026 1st Edition (University-Wide)" ;
    lspuadm:sourceSection "VIII. Procurement Office, Service 1: Consolidation of Approved PPMP, p. 40" .

lspuadm:Serv_ConsolidationOfApprovedPPMP_S1 a lspuadm:ServiceStep ;
