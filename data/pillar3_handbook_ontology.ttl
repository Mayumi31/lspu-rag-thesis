#################################################################
#  REGULATORY BASIS — CHED MEMORANDUM ORDERS (CMOs)
#  Gathered from the respective CMO. Items 1-11 below were supplied
#  directly by the user; the last 3 (BTLEd/BTVTEd/BPEd) were not in
#  that list and are sourced from their respective CMO instead — each
#  is flagged via sourceDataGap since only the CMO number is well
#  corroborated,
#  not the exact title wording. A CMO shared by several majors of one
#  Degree (BSEd's five majors; BSIT's three majors; BSTM + BSHM under
#  CMO 62) is a single individual pointed to by each of those Programs.
#
#  PEO CAVEAT: every ProgramEducationalObjective below (hung off a CMO
#  via hasProgramObjective) is a general reconstruction of the kind of
#  objective a CHED PSG for that field typically states, based on
#  common patterns across published PSGs for similar programs — NOT
#  copied or paraphrased from the specific text of that CMO's actual
#  PEO section, which this file does not have access to. Treat these
#  as illustrative of the field, not as an authoritative quote of any
#  CMO's official wording; verify against the primary CMO PDF before
#  presenting one to a student as LSPU's or CHED's exact language.
#################################################################

lspuprog:CMO_25_s2015 a lspuprog:CMO ;
    lspuprog:cmoNumber "25" ; lspuprog:cmoSeriesYear 2015 ;
    lspuprog:cmoCitation "CMO No. 25, s. 2015" ;
    lspuprog:cmoTitle "Revised Policies, Standards, and Guidelines for Bachelor of Science in Computer Science (BSCS), Bachelor of Science in Information Systems (BSIS), and Bachelor of Science in Information Technology (BSIT) Programs" ;
    lspuprog:hasProgramObjective lspuprog:PEO_CS_IT_1, lspuprog:PEO_CS_IT_2 ;
    lspuprog:sourceDocument "Supplied directly by the user's CMO list (batch of 11)." .
lspuprog:PEO_CS_IT_1 a lspuprog:ProgramEducationalObjective ;
    lspuprog:peoText "Design, develop, and evaluate computing solutions using appropriate current techniques, skills, and tools to meet the requirements of a specific computing or IT problem." .
lspuprog:PEO_CS_IT_2 a lspuprog:ProgramEducationalObjective ;
    lspuprog:peoText "Function effectively as part of a development team, communicating technical work clearly to both technical and non-technical stakeholders." .

