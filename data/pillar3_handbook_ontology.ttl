lspuadm:Serv_EnrollmentAdvising_S2 a lspuadm:ServiceStep ;
    rdfs:label "Step 2: Claim evaluated grades" ;
    lspuadm:clientAction "Presents the official receipt to the Registrar's Office, claims the Evaluated Grades/Report of Grades, and verifies completeness of grades versus grades in the student portal." ;
    lspuadm:agencyAction "Provides the client with the Evaluated Grades/Report of Grades." ;
    lspuadm:hasFeeText "None" ; lspuadm:hasProcessingTime "5 minutes" ;
    lspu:performedBy lspuadm:Role_RegistrarsOfficeStaff ;
    lspu:nextStep lspuadm:Serv_EnrollmentAdvising_S3 ;
    lspuadm:sourceSection "XXXI. Colleges, Service 9: Enrollment Advising, Step 2, p. 90" .

lspuadm:Serv_EnrollmentAdvising_S3 a lspuadm:ServiceStep ;
    rdfs:label "Step 3: Present to college secretary" ;
    lspuadm:clientAction "Presents the copy of Official Receipt and Evaluated Grades/Report of Grades to the respective college secretary." ;
    lspuadm:agencyAction "Checks the OR and copy of Evaluated Grades/Report of Grades; endorses to enrollment advising." ;
    lspuadm:hasFeeText "None" ; lspuadm:hasProcessingTime "1 minute" ;
    lspu:performedBy lspuadm:Role_CollegeSecretary ;
    lspu:nextStep lspuadm:Serv_EnrollmentAdvising_S4 ;
    lspuadm:sourceSection "XXXI. Colleges, Service 9: Enrollment Advising, Step 3, p. 91" .

lspuadm:Serv_EnrollmentAdvising_S4 a lspuadm:ServiceStep ;
    rdfs:label "Step 4: Curriculum check" ;
    lspuadm:clientAction "Presents the Evaluated Grades/Report of Grades to the Registration Adviser/Program Coordinator/College Dean." ;
    lspuadm:agencyAction "Checks the client's adherence to the prescribed curriculum." ;
    lspuadm:hasFeeText "None" ; lspuadm:hasProcessingTime "7 minutes" ;
    lspu:performedBy lspuadm:Role_RegistrationAdviserProgramCoordinatorCollegeDean ;
    lspu:nextStep lspuadm:Serv_EnrollmentAdvising_S5 ;
    lspuadm:sourceSection "XXXI. Colleges, Service 9: Enrollment Advising, Step 4, p. 91" .

