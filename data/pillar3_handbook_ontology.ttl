lspuadm:Serv_OfferingOfUnscheduledSubjects a lspuadm:Service ;
    rdfs:label "Offering of Unscheduled Subject/s" ;
    lspu:definition "Offered to irregular students including transferees and returnees." ;
    lspuadm:availedAt lspuadm:Office_Colleges ;
    lspuadm:hasCategory lspuadm:Cat_Simple ; lspuadm:classificationText "Simple" ;
    lspuadm:hasTransactionType lspuadm:TT_G2C ;
    lspuadm:whoMayAvail "Irregular Students" ;
    lspu:requiresDocument lspuadm:Doc_RequestLetter, lspuadm:Doc_CopyofEvaluationofGrades ;
    lspu:hasStep lspuadm:Serv_OfferingOfUnscheduledSubjects_S1 ;
    lspuadm:totalFeeText "None" ; lspuadm:totalProcessingTime "30 minutes" ;
    lspuadm:sourceDocument "LSPU Citizen's Charter, 2026 1st Edition (University-Wide)" ;
    lspuadm:sourceSection "XXXI. Colleges, Service 1: Offering of Unscheduled Subject/s, p. 85" .

lspuadm:Serv_OfferingOfUnscheduledSubjects_S1 a lspuadm:ServiceStep ;
    rdfs:label "Step 1: Submit request and verification" ;
    lspuadm:clientAction "Submits letter request for the offering of unscheduled subject/s and copy of evaluation of grades from the Registrar to the Office of the Dean/Associate Dean." ;
    lspuadm:agencyAction "Receives the letter request and verifies the need for the offering of unscheduled subject/s." ;
    lspuadm:hasFeeText "N/A" ; lspuadm:hasProcessingTime "5 minutes" ;
    lspu:performedBy lspuadm:Role_DeanAssociateDeanProgramCoordinator ;
    lspu:nextStep lspuadm:Serv_OfferingOfUnscheduledSubjects_S2 ;
    lspuadm:sourceSection "XXXI. Colleges, Service 1: Offering of Unscheduled Subject/s, Step 1, p. 85" .

lspuadm:Serv_OfferingOfUnscheduledSubjects_S2 a lspuadm:ServiceStep ;
    rdfs:label "Step 2: Forward to Registrar" ;
    lspuadm:agencyAction "Forwards the request to the Office of the Registrar." ;
    lspuadm:hasFeeText "N/A" ; lspuadm:hasProcessingTime "10 minutes" ;
    lspu:performedBy lspuadm:Role_DeanAssociateDean ;
    lspu:nextStep lspuadm:Serv_OfferingOfUnscheduledSubjects_S3 ;
    lspuadm:sourceSection "XXXI. Colleges, Service 1: Offering of Unscheduled Subject/s, Step 2, p. 85" .

lspuadm:Serv_OfferingOfUnscheduledSubjects_S3 a lspuadm:ServiceStep ;
    rdfs:label "Step 3: Forward to OVPAA for approval" ;
    lspuadm:agencyAction "Forwards the request to the OVPAA for approval." ;
    lspuadm:hasFeeText "N/A" ; lspuadm:hasProcessingTime "10 minutes" ;
    lspu:performedBy lspuadm:Role_DocumentController ;
    lspu:nextStep lspuadm:Serv_OfferingOfUnscheduledSubjects_S4 ;
    lspuadm:sourceSection "XXXI. Colleges, Service 1: Offering of Unscheduled Subject/s, Step 3, p. 85" .

lspuadm:Serv_OfferingOfUnscheduledSubjects_S4 a lspuadm:ServiceStep ;
    rdfs:label "Step 4: Inform the student" ;
    lspuadm:agencyAction "Informs the student that the subject requested has been offered (or not) upon receipt of the approved request." ;
    lspuadm:hasFeeText "N/A" ; lspuadm:hasProcessingTime "5 minutes" ;
    lspu:performedBy lspuadm:Role_DeanAssociateDeanProgramCoordinator ;
    lspu:nextStep lspuadm:Serv_OfferingOfUnscheduledSubjects_S5 ;
    lspuadm:sourceSection "XXXI. Colleges, Service 1: Offering of Unscheduled Subject/s, Step 4, p. 85" .

lspuadm:Serv_OfferingOfUnscheduledSubjects_S5 a lspuadm:ServiceStep ;
    rdfs:label "Step 5: Proceed to enrolment/adding of subject" ;
    lspuadm:clientAction "Proceeds to enrolment/adding of subject." ;
    lspuadm:hasFeeText "None" ; lspuadm:hasProcessingTime "N/A" ;
    lspu:performedBy lspuadm:Role_Client ;
    lspuadm:sourceSection "XXXI. Colleges, Service 1: Offering of Unscheduled Subject/s, Step 5, p. 85" .

lspuadm:Serv_RequestForOverloadSubject a lspuadm:Service ;
    rdfs:label "Request for Overload Subject" ;
    lspu:definition "Offered to graduating students." ;
    lspuadm:availedAt lspuadm:Office_Colleges ;
    lspuadm:hasCategory lspuadm:Cat_Simple ; lspuadm:classificationText "Simple" ;
    lspuadm:hasTransactionType lspuadm:TT_G2C ;
    lspuadm:whoMayAvail "Graduating Students" ;
    lspu:requiresDocument lspuadm:Doc_RequestLetter, lspuadm:Doc_CopyofEvaluationofGrades ;
    lspu:hasStep lspuadm:Serv_RequestForOverloadSubject_S1 ;
    lspuadm:totalFeeText "None" ; lspuadm:totalProcessingTime "1 hour and 20 minutes" ;
    lspuadm:sourceDocument "LSPU Citizen's Charter, 2026 1st Edition (University-Wide)" ;
    lspuadm:sourceSection "XXXI. Colleges, Service 2: Request for Overload Subject, p. 85" .

lspuadm:Serv_RequestForOverloadSubject_S1 a lspuadm:ServiceStep ;
    rdfs:label "Step 1: Submit evaluation of grades" ;
    lspuadm:clientAction "Submits the evaluation of grades to the Dean/Associate Dean." ;
    lspuadm:agencyAction "Evaluates the grades of the student to determine whether he/she is qualified to enroll an overload subject." ;
    lspuadm:hasFeeText "N/A" ; lspuadm:hasProcessingTime "5 minutes" ;
    lspu:performedBy lspuadm:Role_DeanAssociateDeanProgramCoordinator ;
    lspu:nextStep lspuadm:Serv_RequestForOverloadSubject_S2 ;
    lspuadm:sourceSection "XXXI. Colleges, Service 2: Request for Overload Subject, Step 1, p. 86" .

lspuadm:Serv_RequestForOverloadSubject_S2 a lspuadm:ServiceStep ;
    rdfs:label "Step 2: Assessment of subject availability" ;
    lspuadm:clientAction "Assessment and evaluation of the availability of subjects." ;
    lspuadm:agencyAction "Assessment of subject availability and class size." ;
    lspuadm:hasFeeText "N/A" ; lspuadm:hasProcessingTime "45 minutes" ;
    lspu:performedBy lspuadm:Role_DeanAssociateDean ;
    lspu:nextStep lspuadm:Serv_RequestForOverloadSubject_S3 ;
    lspuadm:sourceSection "XXXI. Colleges, Service 2: Request for Overload Subject, Step 2, p. 86" .

lspuadm:Serv_RequestForOverloadSubject_S3 a lspuadm:ServiceStep ;
    rdfs:label "Step 3: Submit letter request" ;
    lspuadm:clientAction "Submits letter request for the offering of unscheduled subject/s and copy of evaluation of grades to the Office of the Dean/Associate Dean." ;
    lspuadm:agencyAction "Receives the letter request and verifies the need; forwards to the Office of the Registrar; the Document Controller forwards the request to the OVPAA for approval; the student is informed whether the subject requested has been offered." ;
    lspuadm:hasFeeText "N/A" ; lspuadm:hasProcessingTime "30 minutes (receive/verify); 5 minutes (forward to Registrar); 10 minutes (forward to OVPAA); 5 minutes (inform student)" ;
    lspu:performedBy lspuadm:Role_DeanAssociateDeanProgramCoordinator, lspuadm:Role_DocumentController ;
    lspu:nextStep lspuadm:Serv_RequestForOverloadSubject_S4 ;
    lspuadm:sourceSection "XXXI. Colleges, Service 2: Request for Overload Subject, Step 3, p. 86" .

lspuadm:Serv_RequestForOverloadSubject_S4 a lspuadm:ServiceStep ;
    rdfs:label "Step 4: Proceed to enrolment/adding of subject" ;
    lspuadm:clientAction "Proceeds to enrolment/adding of subject." ;
    lspuadm:hasFeeText "None" ; lspuadm:hasProcessingTime "N/A" ;
    lspu:performedBy lspuadm:Role_Client ;
    lspuadm:sourceSection "XXXI. Colleges, Service 2: Request for Overload Subject, Step 4, p. 86" .

lspuadm:Serv_CompletionOfINCRemovalOnlineSystem a lspuadm:Service ;
    rdfs:label "Completion of INC/Removal – Online System" ;
    lspu:definition "For students with a grade of INC or 4.0 requesting completion/removal of grades." ;
    lspuadm:availedAt lspuadm:Office_Colleges ;
    lspuadm:hasCategory lspuadm:Cat_Simple ; lspuadm:classificationText "Simple" ;
    lspuadm:hasTransactionType lspuadm:TT_G2C ;
    lspuadm:whoMayAvail "Students" ;
    lspu:requiresDocument lspuadm:Doc_Completionform, lspuadm:Doc_ProofofpaymentforcompletionremovalofficialCashierreceipt ;
    lspu:hasStep lspuadm:Serv_CompletionOfINCRemovalOnlineSystem_S1 ;
    lspuadm:totalFeeText "P30.00 per unit" ; lspuadm:totalProcessingTime "25 minutes" ;
    lspuadm:sourceDocument "LSPU Citizen's Charter, 2026 1st Edition (University-Wide)" ;
    lspuadm:sourceSection "XXXI. Colleges, Service 3: Completion of INC/Removal – Online System (College, Registrar, Cashier), p. 86" .

lspuadm:Serv_CompletionOfINCRemovalOnlineSystem_S1 a lspuadm:ServiceStep ;
    rdfs:label "Step 1: Apply online for completion" ;
    lspuadm:clientAction "After submitting the complete requirements to the subject teacher, the student logs in to the portal in the LSPU online system to apply online for completion of the INC or 4.0 grade." ;
    lspuadm:hasFeeText "N/A" ; lspuadm:hasProcessingTime "5 minutes" ;
    lspu:performedBy lspuadm:Role_StudentClient ;
    lspu:nextStep lspuadm:Serv_CompletionOfINCRemovalOnlineSystem_S2 ;
    lspuadm:sourceSection "XXXI. Colleges, Service 3: Completion of INC/Removal – Online System (College, Registrar, Cashier), Step 1, p. 87" .

lspuadm:Serv_CompletionOfINCRemovalOnlineSystem_S2 a lspuadm:ServiceStep ;
    rdfs:label "Step 2: Pay completion fee" ;
    lspuadm:clientAction "Pays the corresponding completion fee to the Cashier's Office through the online system." ;
    lspuadm:agencyAction "After receiving the student's payment, the cashier puts the OR number on the completion form of the student through the online system." ;
    lspuadm:hasFeeText "P30.00 per unit" ; lspuadm:hasProcessingTime "5 minutes" ;
    lspu:performedBy lspuadm:Role_CashiersOfficeUnit ;
    lspu:nextStep lspuadm:Serv_CompletionOfINCRemovalOnlineSystem_S3 ;
    lspuadm:sourceSection "XXXI. Colleges, Service 3: Completion of INC/Removal – Online System (College, Registrar, Cashier), Step 2, p. 87" .

lspuadm:Serv_CompletionOfINCRemovalOnlineSystem_S3 a lspuadm:ServiceStep ;
    rdfs:label "Step 3: Inform subject teacher" ;
    lspuadm:clientAction "Informs the subject teacher that he/she already applied for online completion of the INC/4.0 grade." ;
    lspuadm:agencyAction "The subject teacher gives the corresponding grades through the online system." ;
    lspuadm:hasFeeText "N/A" ; lspuadm:hasProcessingTime "5 minutes" ;
    lspu:performedBy lspuadm:Role_SubjectTeacher ;
    lspu:nextStep lspuadm:Serv_CompletionOfINCRemovalOnlineSystem_S4 ;
    lspuadm:sourceSection "XXXI. Colleges, Service 3: Completion of INC/Removal – Online System (College, Registrar, Cashier), Step 3, p. 87" .

lspuadm:Serv_CompletionOfINCRemovalOnlineSystem_S4 a lspuadm:ServiceStep ;
    rdfs:label "Step 4: Dean approval" ;
    lspuadm:clientAction "—" ;
    lspuadm:agencyAction "Upon checking the completion grade given by the subject faculty, the college dean or associate dean approves the request for completion/removal." ;
    lspuadm:hasFeeText "N/A" ; lspuadm:hasProcessingTime "5 minutes" ;
    lspu:performedBy lspuadm:Role_CollegeDeanAssociateDean ;
    lspu:nextStep lspuadm:Serv_CompletionOfINCRemovalOnlineSystem_S5 ;
    lspuadm:sourceSection "XXXI. Colleges, Service 3: Completion of INC/Removal – Online System (College, Registrar, Cashier), Step 4, p. 87" .

lspuadm:Serv_CompletionOfINCRemovalOnlineSystem_S5 a lspuadm:ServiceStep ;
    rdfs:label "Step 5: Registrar confirmation" ;
    lspuadm:clientAction "—" ;
    lspuadm:agencyAction "The Registrar checks if the INC or 4.0 grade is changed." ;
    lspuadm:hasFeeText "N/A" ; lspuadm:hasProcessingTime "5 minutes" ;
    lspu:performedBy lspuadm:Role_Registrar ;
    lspuadm:sourceSection "XXXI. Colleges, Service 3: Completion of INC/Removal – Online System (College, Registrar, Cashier), Step 5, p. 87" .

