#  NOTE: The 2021 Student Handbook (Ch.6 Art.2 Sec.1.5) defines this offense
#  but does not specify a sanction for it anywhere in the text — unlike its
#  neighbors 1.4 (tiered 1st/2nd/3rd) and 1.6 (flat "all offenses"). No
#  hasSanctionTier value is asserted here since none exists in the source;
#  this is a genuine gap in the handbook, not a data-entry omission.
lspu:ComputerFraudForgeryIdentityTheft a lspu:MajorOffense ;
    rdfs:label "Computer-related Fraud, Forgery and Identity Theft" ;
    lspu:definition "Computer-related fraud, forgery and identity theft: the intentional acquisition, use, misuse, transfer, possession, alteration, or deletion of identifying information belonging to another person. NOTE: The 2021 Student Handbook (Ch.6 Art.2 Sec.1.5) defines this offense but lists no sanction tier for it (unlike neighboring sub-offenses 1.4 and 1.6) — this is a confirmed gap in the source document, verified against the handbook text, not an omission in this ontology." ;
    lspu:sourceArticle "Ch.6 Art.2 Sec.1.5" ;
    lspu:isBasedOn lspu:RA10175 .


lspu:Cybersex a lspu:MajorOffense ;
    rdfs:label "Cybersex" ;
    lspu:definition "Willful engagement, maintenance, control or operation, directly or indirectly, of any lascivious exhibition of sexual organs or sexual activity, with the aid of a computer system, for favor or consideration." ;
    lspu:sourceArticle "Ch.6 Art.2 Sec.1.6" ;
    lspu:isBasedOn lspu:RA10175 ;
    lspu:hasSanctionTier lspu:Tier_Cybersex_1 .

lspu:Sanc_Tier_Cybersex_1_1 a lspu:Sanction ;
    lspu:sanctionType "Expulsion" ;
    lspu:durationText "from the University" .

lspu:Tier_Cybersex_1 a lspu:SanctionTier ;
    lspu:occurrenceOrdinal "All Offenses" ;
    lspu:imposesSanction lspu:Sanc_Tier_Cybersex_1_1 .


