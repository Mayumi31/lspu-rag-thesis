lspuadm:Doc_LetterOfApplicationOrgs a lspu:Document ; rdfs:label "Letter of Application for Renewal and Recognition" ; lspu:definition "Secured from OSAS." .
lspuadm:Doc_UpdatedConstitutionByLaws a lspu:Document ; rdfs:label "Updated/Modified Constitution and By-Laws" ; lspu:definition "Supplied by the applicant." .
lspuadm:Doc_RenewalForm a lspu:Document ; rdfs:label "Renewal Form (for renewal only)" ; lspu:definition "Secured from OSAS." .
