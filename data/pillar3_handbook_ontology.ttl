lspuadm:Doc_CertificationOfOfficers a lspu:Document ; rdfs:label "Certification of Officers" ; lspu:definition "Secured from OSAS." .
lspuadm:Doc_ListOfOfficersMembers a lspu:Document ; rdfs:label "List of Officers and Members with Signature and 1x1 Picture" ; lspu:definition "Secured from OSAS." .
lspuadm:Doc_AccomplishmentReport a lspu:Document ; rdfs:label "Accomplishment Report for Previous Year (for renewal only)" ; lspu:definition "Secured from OSAS." .

