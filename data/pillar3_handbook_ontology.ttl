    lspu:performedBy lspuadm:Role_OSASDirectorStaff ;
    lspuadm:sourceSection "VIII. Office of the Student Affairs and Services, Service 3: Application, Renewal and Recognition of Student Organizations, Step 2, p. 17" .

lspuadm:Role_StudentOrgUnitHead a lspu:UniversityRole ; rdfs:label "Student Organization Unit Head/Coordinator" .

