#################################################################
#  PROGRAMS (all 23 LSPU-LB programs; all 4-year programs)
#################################################################

lspuprog:Prog_BSCS_IS a lspuprog:Program ;
    lspuprog:programName "Bachelor of Science in Computer Science - Major in Intelligent Systems" ;
    lspuprog:hasDegree lspuprog:Degree_BSCS ; lspuprog:hasMajor lspuprog:Major_IntelligentSystems ;
    lspuprog:offeredByCollege lspuprog:CCS ;
    lspuprog:programDurationYears 4 ;
    lspuprog:programOverview "Covers theoretical/mathematical computer science foundations (algorithms, computation theory, systems) and a standard software-engineering core (programming, databases, networks, security), with an artificial-intelligence specialization (machine learning, natural language processing, computer vision, robotics)." ;
    lspuprog:teachesSkill lspuprog:Skill_Programming, lspuprog:Skill_DataStructuresAlgorithms, lspuprog:Skill_DatabaseManagement, lspuprog:Skill_SoftwareEngineering, lspuprog:Skill_NetworksSecurity, lspuprog:Skill_MachineLearning, lspuprog:Skill_NaturalLanguageProcessing, lspuprog:Skill_ComputerVision, lspuprog:Skill_Robotics ;
    lspuprog:preparesForOutcome lspuprog:Job_MLEngineer, lspuprog:Job_SoftwareDeveloper, lspuprog:Job_AIResearchAssistant ;
    lspuprog:hasAdmissionRequirement lspuprog:AdmReq_BSCS_IS ;
    lspuprog:hasLegalBasis lspuprog:CMO_25_s2015 ;
    lspuprog:boardProgram false .

lspuprog:Prog_BSBA_MM a lspuprog:Program ;
    lspuprog:programName "Bachelor of Science in Business Administration - Major in Marketing Management" ;
    lspuprog:hasDegree lspuprog:Degree_BSBA ; lspuprog:hasMajor lspuprog:Major_MarketingManagement ;
    lspuprog:offeredByCollege lspuprog:CBAA ;
    lspuprog:programDurationYears 4 ;
    lspuprog:programOverview "Trains students in core business principles (economics, management, business law, taxation, strategy) alongside specialized marketing coursework (consumer behavior, sales, distribution, advertising, product/pricing strategy, market research)." ;
    lspuprog:teachesSkill lspuprog:Skill_MarketingStrategy, lspuprog:Skill_SalesNegotiation, lspuprog:Skill_MarketResearch, lspuprog:Skill_AdvertisingCampaigns ;
    lspuprog:preparesForOutcome lspuprog:Job_MarketingAssociate, lspuprog:Job_SalesExecutive, lspuprog:Job_MarketResearcher ;
    lspuprog:hasAdmissionRequirement lspuprog:AdmReq_BSBA_MM ;
    lspuprog:hasLegalBasis lspuprog:CMO_17_s2017 ;
    lspuprog:boardProgram false .

lspuprog:Prog_BSPsych a lspuprog:Program ;
    lspuprog:programName "Bachelor of Science in Psychology" ;
    lspuprog:hasDegree lspuprog:Degree_BSPsychology ;
    lspuprog:offeredByCollege lspuprog:CAS ;
    lspuprog:programDurationYears 4 ;
    lspuprog:programOverview "Trains students in the scientific study of behavior and mental processes (developmental, abnormal, social, physiological psychology) alongside research methods and psychological assessment, preparing graduates for further specialization in clinical, industrial/organizational, or counseling psychology." ;
    lspuprog:teachesSkill lspuprog:Skill_PsychAssessment, lspuprog:Skill_ResearchMethodsPsych, lspuprog:Skill_CounselingSkills, lspuprog:Skill_ClinicalCaseFormulation ;
    lspuprog:preparesForOutcome lspuprog:Job_ClinicalPsychTrack, lspuprog:Job_IOPsychTrack, lspuprog:Job_CounselingPsychTrack ;
    lspuprog:hasAdmissionRequirement lspuprog:AdmReq_BSPsych ;
    lspuprog:hasLegalBasis lspuprog:CMO_34_s2017 ;
    lspuprog:boardProgram true ;
    lspuprog:licensureExamination "Psychometrician Licensure Examination" .

lspuprog:Prog_BSA a lspuprog:Program ;
    lspuprog:programName "Bachelor of Science in Accountancy" ;
    lspuprog:hasDegree lspuprog:Degree_BSAccountancy ;
    lspuprog:offeredByCollege lspuprog:CBAA ;
    lspuprog:programDurationYears 4 ;
    lspuprog:programOverview "Covers financial and management accounting, auditing, taxation, and business law, preparing graduates for the CPA Licensure Examination." ;
    lspuprog:teachesSkill lspuprog:Skill_FinancialAccounting, lspuprog:Skill_Auditing, lspuprog:Skill_Taxation, lspuprog:Skill_ManagementAccounting ;
    lspuprog:preparesForOutcome lspuprog:Job_CertifiedPublicAccountant, lspuprog:Job_InternalAuditor ;
    lspuprog:hasAdmissionRequirement lspuprog:AdmReq_BSA ;
    lspuprog:hasLegalBasis lspuprog:CMO_27_s2017 ;
    lspuprog:boardProgram true ;
    lspuprog:licensureExamination "CPA (Certified Public Accountant) Licensure Examination" .

lspuprog:Prog_BSBA_FM a lspuprog:Program ;
    lspuprog:programName "Bachelor of Science in Business Administration - Major in Financial Management" ;
    lspuprog:hasDegree lspuprog:Degree_BSBA ; lspuprog:hasMajor lspuprog:Major_FinancialManagement ;
    lspuprog:offeredByCollege lspuprog:CBAA ;
    lspuprog:programDurationYears 4 ;
    lspuprog:programOverview "Trains students in core business principles alongside specialized finance coursework: financial analysis, investments, corporate finance, and budgeting." ;
    lspuprog:teachesSkill lspuprog:Skill_FinancialAnalysis, lspuprog:Skill_InvestmentManagement, lspuprog:Skill_CorporateFinance ;
    lspuprog:preparesForOutcome lspuprog:Job_FinancialAnalyst, lspuprog:Job_BudgetOfficer ;
    lspuprog:hasAdmissionRequirement lspuprog:AdmReq_BSBA_FM ;
    lspuprog:hasLegalBasis lspuprog:CMO_17_s2017 ;
    lspuprog:boardProgram false .

lspuprog:Prog_BSIT_AMG a lspuprog:Program ;
    lspuprog:programName "Bachelor of Science in Information Technology - Major in Animation and Motion Graphics" ;
    lspuprog:hasDegree lspuprog:Degree_BSIT ; lspuprog:hasMajor lspuprog:Major_AnimationMotionGraphics ;
    lspuprog:offeredByCollege lspuprog:CCS ;
    lspuprog:programDurationYears 4 ;
    lspuprog:programOverview "Combines core IT fundamentals with specialized training in 2D/3D animation, digital illustration, and motion graphics design for media, advertising, and game production." ;
    lspuprog:teachesSkill lspuprog:Skill_2DAnimation, lspuprog:Skill_MotionGraphics ;
    lspuprog:preparesForOutcome lspuprog:Job_AnimatorMotionDesigner ;
    lspuprog:hasAdmissionRequirement lspuprog:AdmReq_BSIT_AMG ;
    lspuprog:hasLegalBasis lspuprog:CMO_25_s2015 ;
    lspuprog:boardProgram false .

lspuprog:Prog_BSIT_WMAD a lspuprog:Program ;
    lspuprog:programName "Bachelor of Science in Information Technology - Major in Web and Mobile Application Development" ;
    lspuprog:hasDegree lspuprog:Degree_BSIT ; lspuprog:hasMajor lspuprog:Major_WebMobileAppDev ;
    lspuprog:offeredByCollege lspuprog:CCS ;
    lspuprog:programDurationYears 4 ;
    lspuprog:programOverview "Combines core IT fundamentals with specialized training in building websites and mobile applications, including UI/UX design." ;
    lspuprog:teachesSkill lspuprog:Skill_WebDevelopment, lspuprog:Skill_MobileAppDevelopment, lspuprog:Skill_UIUXDesign ;
    lspuprog:preparesForOutcome lspuprog:Job_WebMobileDeveloper ;
    lspuprog:hasAdmissionRequirement lspuprog:AdmReq_BSIT_WMAD ;
