    lspu:occurrenceOrdinal "1st Offense" ;
    lspu:imposesSanction lspu:Sanc_Tier_DataInterference_1_1 .

lspu:Sanc_Tier_DataInterference_2_1 a lspu:Sanction ;
    lspu:sanctionType "Suspension" ;
    lspu:durationText "one (1) semester" .

lspu:Tier_DataInterference_2 a lspu:SanctionTier ;
    lspu:occurrenceOrdinal "2nd Offense" ;
    lspu:imposesSanction lspu:Sanc_Tier_DataInterference_2_1 .

lspu:Sanc_Tier_DataInterference_3_1 a lspu:Sanction ;
    lspu:sanctionType "Expulsion" ;
