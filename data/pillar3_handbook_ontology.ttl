    lspu:durationText "one (1) month" .

lspu:Tier_IllegalInterception_1 a lspu:SanctionTier ;
    lspu:occurrenceOrdinal "1st Offense" ;
    lspu:imposesSanction lspu:Sanc_Tier_IllegalInterception_1_1 .

lspu:Sanc_Tier_IllegalInterception_2_1 a lspu:Sanction ;
    lspu:sanctionType "Suspension" ;
    lspu:durationText "one (1) semester" .

lspu:Tier_IllegalInterception_2 a lspu:SanctionTier ;
    lspu:occurrenceOrdinal "2nd Offense" ;
    lspu:imposesSanction lspu:Sanc_Tier_IllegalInterception_2_1 .

lspu:Sanc_Tier_IllegalInterception_3_1 a lspu:Sanction ;
    lspu:sanctionType "Expulsion" ;
    lspu:durationText "from the University" .

lspu:Tier_IllegalInterception_3 a lspu:SanctionTier ;
    lspu:occurrenceOrdinal "3rd Offense" ;
    lspu:imposesSanction lspu:Sanc_Tier_IllegalInterception_3_1 .


lspu:DataInterference a lspu:MajorOffense ;
