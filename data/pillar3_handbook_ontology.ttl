    lspu:definition "Leading, instigating and participating in the formulation and operation of unauthorized organizations (CHED Memo No. 9, s.2013, Art. VIII, Sec. 19)." ;
    lspu:sourceArticle "Ch.6 Art.2 Sec.14.1" ;
    lspu:hasSanctionTier lspu:Tier_UnauthorizedOrgLeadingParticipating_1, lspu:Tier_UnauthorizedOrgLeadingParticipating_2 .

lspu:Sanc_Tier_UnauthorizedOrgLeadingParticipating_1_1 a lspu:Sanction ;
    lspu:sanctionType "Suspension" ;
    lspu:durationText "one (1) month" .

lspu:Tier_UnauthorizedOrgLeadingParticipating_1 a lspu:SanctionTier ;
    lspu:occurrenceOrdinal "1st Offense" ;
    lspu:imposesSanction lspu:Sanc_Tier_UnauthorizedOrgLeadingParticipating_1_1 .

lspu:Sanc_Tier_UnauthorizedOrgLeadingParticipating_2_1 a lspu:Sanction ;
    lspu:sanctionType "Suspension" ;
    lspu:durationText "one (1) semester" .

lspu:Tier_UnauthorizedOrgLeadingParticipating_2 a lspu:SanctionTier ;
    lspu:occurrenceOrdinal "2nd Offense" ;
    lspu:imposesSanction lspu:Sanc_Tier_UnauthorizedOrgLeadingParticipating_2_1 .


lspu:UnrecognizedOrgOperating a lspu:MajorOffense ;
    rdfs:label "Unrecognized Organization Operating Without Application" ;
    lspu:definition "Unrecognized organizations operating and conducting activities without applying for recognition and operation." ;
    lspu:sourceArticle "Ch.6 Art.2 Sec.14.2" ;
    lspu:hasSanctionTier lspu:Tier_UnrecognizedOrgOperating_1, lspu:Tier_UnrecognizedOrgOperating_2, lspu:Tier_UnrecognizedOrgOperating_3 .

lspu:Sanc_Tier_UnrecognizedOrgOperating_1_1 a lspu:Sanction ;
    lspu:sanctionType "Warning" ;
    lspu:durationText "" .

lspu:Tier_UnrecognizedOrgOperating_1 a lspu:SanctionTier ;
    lspu:occurrenceOrdinal "1st Offense" ;
    lspu:imposesSanction lspu:Sanc_Tier_UnrecognizedOrgOperating_1_1 .

lspu:Sanc_Tier_UnrecognizedOrgOperating_2_1 a lspu:Sanction ;
    lspu:sanctionType "OrganizationBan" ;
    lspu:durationText "banned to operate for one (1) semester" .

lspu:Tier_UnrecognizedOrgOperating_2 a lspu:SanctionTier ;
    lspu:occurrenceOrdinal "2nd Offense" ;
    lspu:imposesSanction lspu:Sanc_Tier_UnrecognizedOrgOperating_2_1 .

lspu:Sanc_Tier_UnrecognizedOrgOperating_3_1 a lspu:Sanction ;
    lspu:sanctionType "Expulsion" ;
    lspu:durationText "from the University" .

lspu:Tier_UnrecognizedOrgOperating_3 a lspu:SanctionTier ;
    lspu:occurrenceOrdinal "3rd Offense" ;
    lspu:imposesSanction lspu:Sanc_Tier_UnrecognizedOrgOperating_3_1 .


lspu:RecruitmentPromotingHazing a lspu:MajorOffense ;
    rdfs:label "Recruitment by Unauthorized Org Promoting Hazing/Harm" ;
    lspu:definition "Recruitment for an unauthorized and unrecognized organization that promotes hazing and physical or psychological harm to students." ;
    lspu:sourceArticle "Ch.6 Art.2 Sec.14.3" ;
    lspu:hasSanctionTier lspu:Tier_RecruitmentPromotingHazing_1, lspu:Tier_RecruitmentPromotingHazing_2, lspu:Tier_RecruitmentPromotingHazing_3 .

lspu:Sanc_Tier_RecruitmentPromotingHazing_1_1 a lspu:Sanction ;
    lspu:sanctionType "Suspension" ;
    lspu:durationText "one (1) semester" .

lspu:Tier_RecruitmentPromotingHazing_1 a lspu:SanctionTier ;
    lspu:occurrenceOrdinal "1st Offense" ;
    lspu:imposesSanction lspu:Sanc_Tier_RecruitmentPromotingHazing_1_1 .

lspu:Sanc_Tier_RecruitmentPromotingHazing_2_1 a lspu:Sanction ;
    lspu:sanctionType "Suspension" ;
    lspu:durationText "one (1) year" .

lspu:Tier_RecruitmentPromotingHazing_2 a lspu:SanctionTier ;
    lspu:occurrenceOrdinal "2nd Offense" ;
    lspu:imposesSanction lspu:Sanc_Tier_RecruitmentPromotingHazing_2_1 .

lspu:Sanc_Tier_RecruitmentPromotingHazing_3_1 a lspu:Sanction ;
    lspu:sanctionType "Expulsion" ;
    lspu:durationText "from the University" .

lspu:Tier_RecruitmentPromotingHazing_3 a lspu:SanctionTier ;
    lspu:occurrenceOrdinal "3rd Offense" ;
    lspu:imposesSanction lspu:Sanc_Tier_RecruitmentPromotingHazing_3_1 .


lspu:VandalismDestructionOfProperty a lspu:MajorOffense ;
    rdfs:label "Vandalism or Destruction of Public Properties" ;
    lspu:definition "Destroying property, including breakage of glass windows, dragging chairs, misuse of tools/equipment, drawing on walls/furniture, tearing/defacing library materials, posting illegal notices, picking fruits, uprooting/cutting plants, arson and other forms of destruction." ;
    lspu:sourceArticle "Ch.6 Art.2 Sec.15" ;
    lspu:hasSanctionTier lspu:Tier_VandalismDestructionOfProperty_1, lspu:Tier_VandalismDestructionOfProperty_2, lspu:Tier_VandalismDestructionOfProperty_3 .

lspu:Sanc_Tier_VandalismDestructionOfProperty_1_1 a lspu:Sanction ;
    lspu:sanctionType "Suspension" ;
    lspu:durationText "one (1) month" .

lspu:Sanc_Tier_VandalismDestructionOfProperty_1_2 a lspu:Sanction ;
    lspu:sanctionType "PaymentOfDamages" ;
    lspu:durationText "required" .

lspu:Tier_VandalismDestructionOfProperty_1 a lspu:SanctionTier ;
    lspu:occurrenceOrdinal "1st Offense" ;
    lspu:imposesSanction lspu:Sanc_Tier_VandalismDestructionOfProperty_1_1, lspu:Sanc_Tier_VandalismDestructionOfProperty_1_2 .

lspu:Sanc_Tier_VandalismDestructionOfProperty_2_1 a lspu:Sanction ;
    lspu:sanctionType "Suspension" ;
    lspu:durationText "one (1) semester" .

lspu:Sanc_Tier_VandalismDestructionOfProperty_2_2 a lspu:Sanction ;
    lspu:sanctionType "PaymentOfDamages" ;
    lspu:durationText "required" .

lspu:Tier_VandalismDestructionOfProperty_2 a lspu:SanctionTier ;
    lspu:occurrenceOrdinal "2nd Offense" ;
    lspu:imposesSanction lspu:Sanc_Tier_VandalismDestructionOfProperty_2_1, lspu:Sanc_Tier_VandalismDestructionOfProperty_2_2 .

lspu:Sanc_Tier_VandalismDestructionOfProperty_3_1 a lspu:Sanction ;
    lspu:sanctionType "Expulsion" ;
    lspu:durationText "from the University" .

lspu:Sanc_Tier_VandalismDestructionOfProperty_3_2 a lspu:Sanction ;
    lspu:sanctionType "PaymentOfDamages" ;
    lspu:durationText "required" .

lspu:Tier_VandalismDestructionOfProperty_3 a lspu:SanctionTier ;
    lspu:occurrenceOrdinal "3rd Offense" ;
    lspu:imposesSanction lspu:Sanc_Tier_VandalismDestructionOfProperty_3_1, lspu:Sanc_Tier_VandalismDestructionOfProperty_3_2 .


#  NOTE: Ch.6 Art.2 Sec.16 leaves the sanction to case-by-case judgment of
#  OSAS rather than specifying a fixed penalty, so no hasSanctionTier is
#  asserted — this is a discretionary offense by design, not a data gap.
lspu:OtherActsMajor a lspu:MajorOffense ;
    rdfs:label "Other Acts Requiring Disciplinary/Corrective Action" ;
    lspu:definition "Other acts which, in the judgment of the Office of Student Affairs and Services, require disciplinary or corrective action." ;
    lspu:sourceArticle "Ch.6 Art.2 Sec.16" ;
    lspu:reportedTo lspu:OSAS .


lspu:HabitualOffenders a lspu:MajorOffense ;
    rdfs:label "Habitual Offenders" ;
    lspu:definition "A student who persists in disregarding any provision of the Code of Conduct after counseling and repeated warnings shall withdraw from the University and be dropped from the roll, or be denied admission the succeeding semester/school year." ;
    lspu:sourceArticle "Ch.6 Art.2 Sec.17" ;
    lspu:hasSanctionTier lspu:Tier_HabitualOffenders_1 .

lspu:Sanc_Tier_HabitualOffenders_1_1 a lspu:Sanction ;
    lspu:sanctionType "Dismissal" ;
    lspu:durationText "withdrawal from the University and dropped from the roll" .

lspu:Sanc_Tier_HabitualOffenders_1_2 a lspu:Sanction ;
    lspu:sanctionType "EntryDenial" ;
    lspu:durationText "denied admission the succeeding semester/school year" .

lspu:Tier_HabitualOffenders_1 a lspu:SanctionTier ;
    lspu:occurrenceOrdinal "All Offenses" ;
    lspu:imposesSanction lspu:Sanc_Tier_HabitualOffenders_1_1, lspu:Sanc_Tier_HabitualOffenders_1_2 .


#################################################################
#  MINOR OFFENSES (Code of Conduct, Chapter 6, Article 3)
#################################################################

lspu:Tardiness a lspu:MinorOffense ;
    lspu:isBasedOn lspu:RA8491 ;
    rdfs:label "Tardiness/Unexcused Absences" ;
    lspu:definition "Tardiness in required activities is considered one (1) absence; three (3) tardiness instances in a class count as one (1) absence. Unexcused absences equal to 17% of total class hours/semester result in being dropped from the roll (excused absences may be removed through makeup)." ;
    lspu:sourceArticle "Ch.6 Art.3 Sec.1" ;
    lspu:reportedTo lspu:GuidanceOffice ;
    lspu:hasSanctionTier lspu:Tier_Tardiness_1, lspu:Tier_Tardiness_2, lspu:Tier_Tardiness_3 .

lspu:Sanc_Tier_Tardiness_1_1 a lspu:Sanction ;
    lspu:sanctionType "CommunityService" ;
    lspu:durationText "One (1) day absent plus community service" .

lspu:Tier_Tardiness_1 a lspu:SanctionTier ;
    lspu:occurrenceOrdinal "1st Offense" ;
    lspu:imposesSanction lspu:Sanc_Tier_Tardiness_1_1 .

lspu:Sanc_Tier_Tardiness_2_1 a lspu:Sanction ;
    lspu:sanctionType "Suspension" ;
    lspu:durationText "three (3) days" .

lspu:Sanc_Tier_Tardiness_2_2 a lspu:Sanction ;
    lspu:sanctionType "ParentNotification" ;
    lspu:durationText "parents/guardians informed" .

lspu:Tier_Tardiness_2 a lspu:SanctionTier ;
    lspu:occurrenceOrdinal "2nd Offense" ;
    lspu:imposesSanction lspu:Sanc_Tier_Tardiness_2_1, lspu:Sanc_Tier_Tardiness_2_2 .

lspu:Sanc_Tier_Tardiness_3_1 a lspu:Sanction ;
    lspu:sanctionType "Suspension" ;
    lspu:durationText "one (1) week" .

lspu:Tier_Tardiness_3 a lspu:SanctionTier ;
    lspu:occurrenceOrdinal "3rd Offense" ;
    lspu:imposesSanction lspu:Sanc_Tier_Tardiness_3_1 .


lspu:DishonestyCheating a lspu:MinorOffense ;
    rdfs:label "Dishonesty — Cheating in Examinations" ;
    lspu:definition "Any form of cheating in examinations." ;
    lspu:sourceArticle "Ch.6 Art.3 Sec.2" ;
    lspu:hasSanctionTier lspu:Tier_DishonestyCheating_1, lspu:Tier_DishonestyCheating_2, lspu:Tier_DishonestyCheating_3 .

lspu:Sanc_Tier_DishonestyCheating_1_1 a lspu:Sanction ;
    lspu:sanctionType "AcademicPenalty" ;
    lspu:durationText "Automatically failed in the examination" .

lspu:Tier_DishonestyCheating_1 a lspu:SanctionTier ;
    lspu:occurrenceOrdinal "1st Offense" ;
    lspu:imposesSanction lspu:Sanc_Tier_DishonestyCheating_1_1 .

lspu:Sanc_Tier_DishonestyCheating_2_1 a lspu:Sanction ;
    lspu:sanctionType "AcademicProbation" ;
    lspu:durationText "Academic probation and automatic grade of 5.0" .

lspu:Tier_DishonestyCheating_2 a lspu:SanctionTier ;
    lspu:occurrenceOrdinal "2nd Offense" ;
    lspu:imposesSanction lspu:Sanc_Tier_DishonestyCheating_2_1 .

lspu:Sanc_Tier_DishonestyCheating_3_1 a lspu:Sanction ;
    lspu:sanctionType "Dismissal" ;
    lspu:durationText "Dismissal from the University" .

lspu:Tier_DishonestyCheating_3 a lspu:SanctionTier ;
    lspu:occurrenceOrdinal "3rd Offense" ;
    lspu:imposesSanction lspu:Sanc_Tier_DishonestyCheating_3_1 .


lspu:OtherDishonesty a lspu:MinorOffense ;
    rdfs:label "Other Forms of Dishonesty" ;
    lspu:definition "Any act of dishonesty in relation to one's studies and any other forms of dishonesty." ;
    lspu:sourceArticle "Ch.6 Art.3 Sec.2.1" ;
    lspu:requiresDocument lspu:Doc_PromissoryNote ;
    lspu:hasSanctionTier lspu:Tier_OtherDishonesty_1, lspu:Tier_OtherDishonesty_2, lspu:Tier_OtherDishonesty_3 .

lspu:Sanc_Tier_OtherDishonesty_1_1 a lspu:Sanction ;
    lspu:sanctionType "Reprimand" ;
    lspu:durationText "with community service" .

lspu:Tier_OtherDishonesty_1 a lspu:SanctionTier ;
    lspu:occurrenceOrdinal "1st Offense" ;
    lspu:imposesSanction lspu:Sanc_Tier_OtherDishonesty_1_1 .

lspu:Sanc_Tier_OtherDishonesty_2_1 a lspu:Sanction ;
    lspu:sanctionType "PromissoryNote" ;
    lspu:durationText "duly signed by the Guidance Counselor/Student Discipline Coordinator" .

lspu:Sanc_Tier_OtherDishonesty_2_2 a lspu:Sanction ;
    lspu:sanctionType "CommunityService" ;
    lspu:durationText "two (2) days community service" .

lspu:Tier_OtherDishonesty_2 a lspu:SanctionTier ;
    lspu:occurrenceOrdinal "2nd Offense" ;
    lspu:imposesSanction lspu:Sanc_Tier_OtherDishonesty_2_1, lspu:Sanc_Tier_OtherDishonesty_2_2 .

lspu:Sanc_Tier_OtherDishonesty_3_1 a lspu:Sanction ;
    lspu:sanctionType "Suspension" ;
    lspu:durationText "two (2) weeks" .

lspu:Tier_OtherDishonesty_3 a lspu:SanctionTier ;
    lspu:occurrenceOrdinal "3rd Offense" ;
    lspu:imposesSanction lspu:Sanc_Tier_OtherDishonesty_3_1 .


lspu:LitteringScattering a lspu:MinorOffense ;
    rdfs:label "Littering/Scattering of Trash in Public Places" ;
    lspu:definition "Failure to properly dispose of waste, trash, or garbage using the comfort rooms, trash cans, containers, and garbage pit-piles provided. Violators are required to clean a portion of the University without pay for a specific period." ;
    lspu:sourceArticle "Ch.6 Art.3 Sec.3" ;
    lspu:hasSanctionTier lspu:Tier_LitteringScattering_1, lspu:Tier_LitteringScattering_2, lspu:Tier_LitteringScattering_3 .

lspu:Sanc_Tier_LitteringScattering_1_1 a lspu:Sanction ;
    lspu:sanctionType "CommunityService" ;
    lspu:durationText "Required to clean the area" .

lspu:Tier_LitteringScattering_1 a lspu:SanctionTier ;
    lspu:occurrenceOrdinal "1st Offense" ;
    lspu:imposesSanction lspu:Sanc_Tier_LitteringScattering_1_1 .

lspu:Sanc_Tier_LitteringScattering_2_1 a lspu:Sanction ;
    lspu:sanctionType "Suspension" ;
    lspu:durationText "one (1) week" .

lspu:Sanc_Tier_LitteringScattering_2_2 a lspu:Sanction ;
    lspu:sanctionType "CommunityService" ;
    lspu:durationText "40 hours service; required to clean the area" .

lspu:Tier_LitteringScattering_2 a lspu:SanctionTier ;
    lspu:occurrenceOrdinal "2nd Offense" ;
    lspu:imposesSanction lspu:Sanc_Tier_LitteringScattering_2_1, lspu:Sanc_Tier_LitteringScattering_2_2 .

lspu:Sanc_Tier_LitteringScattering_3_1 a lspu:Sanction ;
    lspu:sanctionType "Suspension" ;
    lspu:durationText "two (2) weeks" .

lspu:Sanc_Tier_LitteringScattering_3_2 a lspu:Sanction ;
    lspu:sanctionType "CommunityService" ;
    lspu:durationText "required to clean the area" .

lspu:Tier_LitteringScattering_3 a lspu:SanctionTier ;
    lspu:occurrenceOrdinal "3rd Offense" ;
    lspu:imposesSanction lspu:Sanc_Tier_LitteringScattering_3_1, lspu:Sanc_Tier_LitteringScattering_3_2 .


lspu:NonWearingIDUniform a lspu:MinorOffense ;
    rdfs:label "Non-wearing of I.D. and School Uniform" ;
    lspu:definition "The University ID with lace and school uniform must be worn at all times, subject to exceptions during field activities." ;
    lspu:sourceArticle "Ch.6 Art.3 Sec.4" ;
    lspu:reportedTo lspu:OSAS ;
    lspu:hasSanctionTier lspu:Tier_NonWearingIDUniform_1, lspu:Tier_NonWearingIDUniform_2, lspu:Tier_NonWearingIDUniform_3 .

lspu:Sanc_Tier_NonWearingIDUniform_1_1 a lspu:Sanction ;
    lspu:sanctionType "EntryDenial" ;
    lspu:durationText "Not allowed to enter University gates/class unless an excuse slip from OSAS through the Guidance Counselor is presented" .

lspu:Tier_NonWearingIDUniform_1 a lspu:SanctionTier ;
    lspu:occurrenceOrdinal "1st Offense" ;
    lspu:imposesSanction lspu:Sanc_Tier_NonWearingIDUniform_1_1 .

lspu:Sanc_Tier_NonWearingIDUniform_2_1 a lspu:Sanction ;
    lspu:sanctionType "PromissoryNote" ;
    lspu:durationText "Submit filled-out Promissory Note Form before written suspension" .

lspu:Tier_NonWearingIDUniform_2 a lspu:SanctionTier ;
    lspu:occurrenceOrdinal "2nd Offense" ;
    lspu:imposesSanction lspu:Sanc_Tier_NonWearingIDUniform_2_1 .

lspu:Sanc_Tier_NonWearingIDUniform_3_1 a lspu:Sanction ;
    lspu:sanctionType "Suspension" ;
    lspu:durationText "one (1) week" .

lspu:Sanc_Tier_NonWearingIDUniform_3_2 a lspu:Sanction ;
    lspu:sanctionType "CommunityService" ;
    lspu:durationText "40 hours service to be rendered in the institution" .

lspu:Tier_NonWearingIDUniform_3 a lspu:SanctionTier ;
    lspu:occurrenceOrdinal "Subsequent Offense" ;
    lspu:imposesSanction lspu:Sanc_Tier_NonWearingIDUniform_3_1, lspu:Sanc_Tier_NonWearingIDUniform_3_2 .


lspu:SignboardLittering a lspu:MinorOffense ;
    rdfs:label "Signboard Littering" ;
    lspu:definition "Removing or damaging signboards, notices, or provisions posted within University premises." ;
    lspu:sourceArticle "Ch.6 Art.3 Sec.5" ;
    lspu:hasSanctionTier lspu:Tier_SignboardLittering_1, lspu:Tier_SignboardLittering_2, lspu:Tier_SignboardLittering_3 .

lspu:Sanc_Tier_SignboardLittering_1_1 a lspu:Sanction ;
    lspu:sanctionType "Suspension" ;
    lspu:durationText "three (3) days" .

lspu:Sanc_Tier_SignboardLittering_1_2 a lspu:Sanction ;
    lspu:sanctionType "Restoration" ;
    lspu:durationText "restoration of damaged signs/notices with community service" .

lspu:Tier_SignboardLittering_1 a lspu:SanctionTier ;
    lspu:occurrenceOrdinal "1st Offense" ;
    lspu:imposesSanction lspu:Sanc_Tier_SignboardLittering_1_1, lspu:Sanc_Tier_SignboardLittering_1_2 .

lspu:Sanc_Tier_SignboardLittering_2_1 a lspu:Sanction ;
    lspu:sanctionType "Suspension" ;
    lspu:durationText "one (1) week" .

lspu:Sanc_Tier_SignboardLittering_2_2 a lspu:Sanction ;
    lspu:sanctionType "Restoration" ;
    lspu:durationText "restoration of damaged signs/notices" .

lspu:Sanc_Tier_SignboardLittering_2_3 a lspu:Sanction ;
    lspu:sanctionType "CommunityService" ;
    lspu:durationText "40 hours service to be rendered in the institution" .

lspu:Tier_SignboardLittering_2 a lspu:SanctionTier ;
    lspu:occurrenceOrdinal "2nd Offense" ;
    lspu:imposesSanction lspu:Sanc_Tier_SignboardLittering_2_1, lspu:Sanc_Tier_SignboardLittering_2_2, lspu:Sanc_Tier_SignboardLittering_2_3 .

lspu:Sanc_Tier_SignboardLittering_3_1 a lspu:Sanction ;
    lspu:sanctionType "Suspension" ;
    lspu:durationText "one (1) month or one (1) semester" .

lspu:Sanc_Tier_SignboardLittering_3_2 a lspu:Sanction ;
    lspu:sanctionType "Restoration" ;
    lspu:durationText "restoration of damaged signs/notices" .

lspu:Tier_SignboardLittering_3 a lspu:SanctionTier ;
    lspu:occurrenceOrdinal "3rd Offense" ;
    lspu:imposesSanction lspu:Sanc_Tier_SignboardLittering_3_1, lspu:Sanc_Tier_SignboardLittering_3_2 .


lspu:Smoking a lspu:MinorOffense ;
    rdfs:label "Smoking" ;
    lspu:definition "Smoking within University premises is strictly prohibited to all students." ;
    lspu:sourceArticle "Ch.6 Art.3 Sec.6" ;
    lspu:hasSanctionTier lspu:Tier_Smoking_1, lspu:Tier_Smoking_2, lspu:Tier_Smoking_3 .

lspu:Sanc_Tier_Smoking_1_1 a lspu:Sanction ;
    lspu:sanctionType "Reprimand" ;
    lspu:durationText "with community service" .

lspu:Tier_Smoking_1 a lspu:SanctionTier ;
    lspu:occurrenceOrdinal "1st Offense" ;
    lspu:imposesSanction lspu:Sanc_Tier_Smoking_1_1 .

lspu:Sanc_Tier_Smoking_2_1 a lspu:Sanction ;
    lspu:sanctionType "PromissoryNote" ;
    lspu:durationText "duly signed by the Guidance Counselor/Student Discipline Coordinator" .

lspu:Sanc_Tier_Smoking_2_2 a lspu:Sanction ;
    lspu:sanctionType "CommunityService" ;
    lspu:durationText "two (2) days community service" .

lspu:Tier_Smoking_2 a lspu:SanctionTier ;
    lspu:occurrenceOrdinal "2nd Offense" ;
    lspu:imposesSanction lspu:Sanc_Tier_Smoking_2_1, lspu:Sanc_Tier_Smoking_2_2 .

lspu:Sanc_Tier_Smoking_3_1 a lspu:Sanction ;
    lspu:sanctionType "Suspension" ;
    lspu:durationText "two (2) weeks" .

lspu:Tier_Smoking_3 a lspu:SanctionTier ;
    lspu:occurrenceOrdinal "3rd Offense" ;
    lspu:imposesSanction lspu:Sanc_Tier_Smoking_3_1 .


lspu:Trespassing a lspu:MinorOffense ;
    rdfs:label "Trespassing" ;
    lspu:definition "Staying inside University premises after class hours in the afternoon, or entering campus during off-school days without authorization from Campus Director/Deans/OSAS Director/Chief of Security (exceptions for makeup classes, practice, field activities, official business, or regular activities like ROTC/CWTS/Band)." ;
    lspu:sourceArticle "Ch.6 Art.3 Sec.7" ;
    lspu:hasSanctionTier lspu:Tier_Trespassing_1, lspu:Tier_Trespassing_2, lspu:Tier_Trespassing_3 .

lspu:Sanc_Tier_Trespassing_1_1 a lspu:Sanction ;
    lspu:sanctionType "Reprimand" ;
    lspu:durationText "promissory note duly signed by the College Dean/Associate Dean and Student Discipline Coordinator" .

lspu:Tier_Trespassing_1 a lspu:SanctionTier ;
    lspu:occurrenceOrdinal "1st Offense" ;
    lspu:imposesSanction lspu:Sanc_Tier_Trespassing_1_1 .

lspu:Sanc_Tier_Trespassing_2_1 a lspu:Sanction ;
    lspu:sanctionType "ParentNotification" ;
    lspu:durationText "parents informed" .

lspu:Sanc_Tier_Trespassing_2_2 a lspu:Sanction ;
    lspu:sanctionType "Suspension" ;
    lspu:durationText "one (1) week" .

lspu:Sanc_Tier_Trespassing_2_3 a lspu:Sanction ;
    lspu:sanctionType "CommunityService" ;
    lspu:durationText "40 hours service to be rendered in the institution" .

lspu:Tier_Trespassing_2 a lspu:SanctionTier ;
    lspu:occurrenceOrdinal "2nd Offense" ;
    lspu:imposesSanction lspu:Sanc_Tier_Trespassing_2_1, lspu:Sanc_Tier_Trespassing_2_2, lspu:Sanc_Tier_Trespassing_2_3 .

lspu:Sanc_Tier_Trespassing_3_1 a lspu:Sanction ;
    lspu:sanctionType "Suspension" ;
    lspu:durationText "one (1) month" .

lspu:Tier_Trespassing_3 a lspu:SanctionTier ;
    lspu:occurrenceOrdinal "3rd Offense" ;
    lspu:imposesSanction lspu:Sanc_Tier_Trespassing_3_1 .


lspu:ViolationOtherDeptPolicies a lspu:MinorOffense ;
    rdfs:label "Violation of Rules/Regulations/Policies from Other Departments or Units" ;
    lspu:definition "Every student must observe the rules, regulations and policies promulgated by the College/Department Head, instructors, or organization advisers, provided such rules conform with the LSPU Code of Conduct." ;
    lspu:sourceArticle "Ch.6 Art.3 Sec.8" ;
    lspu:hasSanctionTier lspu:Tier_ViolationOtherDeptPolicies_1, lspu:Tier_ViolationOtherDeptPolicies_2, lspu:Tier_ViolationOtherDeptPolicies_3 .

lspu:Sanc_Tier_ViolationOtherDeptPolicies_1_1 a lspu:Sanction ;
    lspu:sanctionType "Suspension" ;
    lspu:durationText "three (3) days" .

lspu:Sanc_Tier_ViolationOtherDeptPolicies_1_2 a lspu:Sanction ;
    lspu:sanctionType "CommunityService" ;
    lspu:durationText "with community service" .

lspu:Tier_ViolationOtherDeptPolicies_1 a lspu:SanctionTier ;
    lspu:occurrenceOrdinal "1st Offense" ;
    lspu:imposesSanction lspu:Sanc_Tier_ViolationOtherDeptPolicies_1_1, lspu:Sanc_Tier_ViolationOtherDeptPolicies_1_2 .

lspu:Sanc_Tier_ViolationOtherDeptPolicies_2_1 a lspu:Sanction ;
    lspu:sanctionType "Suspension" ;
    lspu:durationText "one (1) week" .

lspu:Sanc_Tier_ViolationOtherDeptPolicies_2_2 a lspu:Sanction ;
    lspu:sanctionType "CommunityService" ;
    lspu:durationText "40 hours service to be rendered in the institution" .

lspu:Tier_ViolationOtherDeptPolicies_2 a lspu:SanctionTier ;
    lspu:occurrenceOrdinal "2nd Offense" ;
    lspu:imposesSanction lspu:Sanc_Tier_ViolationOtherDeptPolicies_2_1, lspu:Sanc_Tier_ViolationOtherDeptPolicies_2_2 .

lspu:Sanc_Tier_ViolationOtherDeptPolicies_3_1 a lspu:Sanction ;
    lspu:sanctionType "Suspension" ;
    lspu:durationText "two (2) weeks to one (1) semester" .

lspu:Sanc_Tier_ViolationOtherDeptPolicies_3_2 a lspu:Sanction ;
    lspu:sanctionType "PaymentOfDamages" ;
    lspu:durationText "if any" .

lspu:Tier_ViolationOtherDeptPolicies_3 a lspu:SanctionTier ;
    lspu:occurrenceOrdinal "3rd Offense" ;
    lspu:imposesSanction lspu:Sanc_Tier_ViolationOtherDeptPolicies_3_1, lspu:Sanc_Tier_ViolationOtherDeptPolicies_3_2 .


#  NOTE: Ch.6 Art.3 Sec.9 explicitly treats these on a case-to-case basis
#  rather than specifying a fixed penalty, so no hasSanctionTier is
#  asserted — this is discretionary by design, not a data gap.
lspu:OtherMinorOffenses a lspu:MinorOffense ;
    rdfs:label "Other Minor Offenses" ;
    lspu:definition "Other offenses not stated herein shall be treated on a case-to-case basis." ;
    lspu:sourceArticle "Ch.6 Art.3 Sec.9" .


lspu:OverspeedingVehicles a lspu:MinorOffense ;
    rdfs:label "Overspeeding of Motorized Vehicles" ;
    lspu:definition "Over-speeding of motorized vehicles within University premises that causes disturbances to classes; driving more than 20 kph / faster than walking speed." ;
    lspu:sourceArticle "Ch.6 Art.3 Sec.9.1" ;
    lspu:hasSanctionTier lspu:Tier_OverspeedingVehicles_1, lspu:Tier_OverspeedingVehicles_2, lspu:Tier_OverspeedingVehicles_3 .

lspu:Sanc_Tier_OverspeedingVehicles_1_1 a lspu:Sanction ;
    lspu:sanctionType "Reprimand" ;
    lspu:durationText "" .

lspu:Tier_OverspeedingVehicles_1 a lspu:SanctionTier ;
    lspu:occurrenceOrdinal "1st Offense" ;
    lspu:imposesSanction lspu:Sanc_Tier_OverspeedingVehicles_1_1 .

lspu:Sanc_Tier_OverspeedingVehicles_2_1 a lspu:Sanction ;
    lspu:sanctionType "Suspension" ;
    lspu:durationText "one (1) week" .

lspu:Sanc_Tier_OverspeedingVehicles_2_2 a lspu:Sanction ;
    lspu:sanctionType "CommunityService" ;
    lspu:durationText "40 hours service to be rendered in the institution" .

lspu:Tier_OverspeedingVehicles_2 a lspu:SanctionTier ;
    lspu:occurrenceOrdinal "2nd Offense" ;
    lspu:imposesSanction lspu:Sanc_Tier_OverspeedingVehicles_2_1, lspu:Sanc_Tier_OverspeedingVehicles_2_2 .

lspu:Sanc_Tier_OverspeedingVehicles_3_1 a lspu:Sanction ;
    lspu:sanctionType "Suspension" ;
    lspu:durationText "one (1) semester" .

lspu:Tier_OverspeedingVehicles_3 a lspu:SanctionTier ;
    lspu:occurrenceOrdinal "3rd Offense" ;
    lspu:imposesSanction lspu:Sanc_Tier_OverspeedingVehicles_3_1 .


lspu:ClimbingPerimeterFence a lspu:MinorOffense ;
    rdfs:label "Unauthorized Climbing or Jumping Over the Perimeter Fence" ;
    lspu:definition "Unauthorized climbing or jumping over the perimeter fence of the University." ;
    lspu:sourceArticle "Ch.6 Art.3 Sec.9.2" ;
    lspu:hasSanctionTier lspu:Tier_ClimbingPerimeterFence_1, lspu:Tier_ClimbingPerimeterFence_2, lspu:Tier_ClimbingPerimeterFence_3 .

lspu:Sanc_Tier_ClimbingPerimeterFence_1_1 a lspu:Sanction ;
    lspu:sanctionType "Reprimand" ;
    lspu:durationText "and community service to be rendered in the institution" .

lspu:Tier_ClimbingPerimeterFence_1 a lspu:SanctionTier ;
    lspu:occurrenceOrdinal "1st Offense" ;
    lspu:imposesSanction lspu:Sanc_Tier_ClimbingPerimeterFence_1_1 .

lspu:Sanc_Tier_ClimbingPerimeterFence_2_1 a lspu:Sanction ;
    lspu:sanctionType "Suspension" ;
    lspu:durationText "one (1) week" .

lspu:Sanc_Tier_ClimbingPerimeterFence_2_2 a lspu:Sanction ;
    lspu:sanctionType "CommunityService" ;
    lspu:durationText "40 hours service to be rendered in the institution" .

lspu:Tier_ClimbingPerimeterFence_2 a lspu:SanctionTier ;
    lspu:occurrenceOrdinal "2nd Offense" ;
    lspu:imposesSanction lspu:Sanc_Tier_ClimbingPerimeterFence_2_1, lspu:Sanc_Tier_ClimbingPerimeterFence_2_2 .

lspu:Sanc_Tier_ClimbingPerimeterFence_3_1 a lspu:Sanction ;
    lspu:sanctionType "Suspension" ;
    lspu:durationText "one (1) semester" .

lspu:Tier_ClimbingPerimeterFence_3 a lspu:SanctionTier ;
    lspu:occurrenceOrdinal "3rd Offense" ;
    lspu:imposesSanction lspu:Sanc_Tier_ClimbingPerimeterFence_3_1 .


#  NOTE: Ch.6 Art.4 Sec.1.3 states this "shall be considered a minor
#  offense" but never specifies a sanction/tier for it (unlike the
#  ID/uniform offenses nearby), so none is asserted here — a genuine
#  gap in the source, not a data-entry omission.
lspu:InappropriateAttireWashdays a lspu:MinorOffense ;
    rdfs:label "Wearing of Inappropriate Student Campus Attire" ;
    lspu:definition "University t-shirt is worn every Wednesday and department shirt every Friday; blue jeans/maong trousers following the dress code are acceptable on these days. Wearing of inappropriate campus attire on washdays (Wednesday) and inter-semester classes is classified as a minor offense (Art. 4, Sec. 1.3), but the handbook publishes no sanction tier for it — verified against the source text, this is a genuine gap, not a data-entry omission. On non-washdays, uniform violations are handled under lspu:NonWearingIDUniform." ;
    lspu:sourceArticle "Ch.6 Art.4 Sec.1.3" .


#################################################################
#  PROCEDURE: Major Disciplinary Actions
#  (Code of Conduct, Chapter 6, Article 6)
#################################################################

lspu:Proc_MajorDisciplinaryAction a lspu:Procedure ;
    rdfs:label "Procedure for Major Disciplinary Actions" ;
    lspu:definition "The five-step process followed when a student is alleged to have committed a major offense under the Code of Conduct." ;
    lspu:sourceArticle "Chapter 6, Article 6" ;
    lspu:handledByCommittee lspu:StudentDisciplineCommittee ;
    lspu:requiresDocument lspu:Doc_PromissoryNote ;
    lspu:relatedRight lspu:Right_DueProcess ;
    lspu:hasStep lspu:Step1_FirstAction .

lspu:Step1_FirstAction a lspu:ProcedureStep ;
    rdfs:label "Step 1: First Action \u2014 File Written Complaint" ;
    lspu:definition "All complaints must be reported in writing to OSAS through the Coordinator of Student Discipline and must be signed by the complainant." ;
    lspu:performedBy lspu:Role_StudentDisciplineCoordinator ;
    lspu:nextStep lspu:Step2_SecondAction .

lspu:Step2_SecondAction a lspu:ProcedureStep ;
    rdfs:label "Step 2: Second Action \u2014 Investigation" ;
    lspu:definition "OSAS conducts an investigation through the Student Discipline Committee and submits its findings and recommendation." ;
    lspu:performedBy lspu:OSAS, lspu:StudentDisciplineCommittee ;
    lspu:nextStep lspu:Step3_ThirdAction .

lspu:Step3_ThirdAction a lspu:ProcedureStep ;
    rdfs:label "Step 3: Third Action \u2014 Due Process" ;
    lspu:definition "All parties concerned shall be afforded due process." ;
    lspu:nextStep lspu:Step4_FourthAction .

lspu:Step4_FourthAction a lspu:ProcedureStep ;
    rdfs:label "Step 4: Fourth Action \u2014 Presidential Review" ;
    lspu:definition "The final investigation report is presented to the University President, who may or may not issue the necessary disciplinary action." ;
    lspu:performedBy lspu:Role_UniversityPresident ;
    lspu:nextStep lspu:Step5_FifthAction .

lspu:Step5_FifthAction a lspu:ProcedureStep ;
    rdfs:label "Step 5: Fifth Action \u2014 Guidance Follow-up" ;
    lspu:definition "The Guidance Counselor follows up with the student who violated the rule to discuss the reasons for the incident, except in cases resulting in expulsion." ;
    lspu:performedBy lspu:Role_GuidanceCounselor .

#################################################################
#  JURISDICTION NOTE (Code of Conduct, Chapter 6, Article 7, Sec. 5)
#################################################################

lspu:Policy_OffCampusJurisdiction a lspu:Policy ;
    rdfs:label "Off-Campus Jurisdiction of the Code of Conduct" ;
    lspu:definition "Violations committed outside University premises are treated as if committed within the University when a student is representing the University at conferences, conventions, competitions, presentations, On-the-Job Training (OJT), or the Student Internship Program (SIP)." ;
    lspu:sourceArticle "Chapter 6, Article 7, Sec. 5" .

#################################################################
#  KEY STUDENT-FACING POLICIES
#################################################################

lspu:Policy_DressCode a lspu:Policy ;
    rdfs:label "School Uniform and Dress Code Policy" ;
    lspu:definition "Prescribed uniform must be worn in classroom sessions; P.E. uniform only during P.E. classes; University t-shirt every Wednesday, department shirt every Friday. Prohibited campus attire includes: shorts/walking shorts/cycling shorts, pedal pushers, capri pants, cargo shorts, mutilated/jazzed pants, faded/torn/wrinkled shirts, jogging pants, miniskirts, sleeveless/backless/halter/spaghetti-strap tops, sandos, plunging necklines, leggings, and slippers. A student violating the uniform provision is not allowed to enter the University gates unless a promissory note/communication letter from OSAS is presented." ;
    lspu:sourceArticle "Chapter 6, Article 4, Sec. 1" ;
    lspu:administeredBy lspu:OSAS ;
    lspu:requiresDocument lspu:Doc_PromissoryNote .

lspu:Policy_HairstylePolicy a lspu:Policy ;
    rdfs:label "Hairstyle/Haircut Policy" ;
    lspu:definition "Colored/tinted/dyed or out-of-the-ordinary styled hair, and funky short or fixie-crop hairstyles for male students, are prohibited unless minimal aesthetic coloring is approved by OSAS and the Campus Director. Male Freshmen/Senior High School students follow a 2x3 cut; 2nd-4th year college students follow a clean-cut/1x2 barber's cut, inspected monthly." ;
    lspu:sourceArticle "Chapter 6, Article 4, Sec. 2" ;
    lspu:administeredBy lspu:OSAS .

lspu:Policy_GenderInclusiveDressCode a lspu:Policy ;
    rdfs:label "Clothing and Gender Representation Policy (LGBT/Gender Nonconforming Students)" ;
    lspu:definition "Transgender students have the right to dress and groom in accordance with their gender identity within the constraints of the adopted dress code. Transwomen wear the male uniform (pants/polo) with female-cut blouses of the same color; transmen wear pants/polo in the female uniform color. Grooming rules apply the same standard to male and female units; transgender girls are not required to have a male haircut or masculine clothing, and transgender boys are not required to maintain a female hairstyle, wear make-up, or feminine clothing." ;
    lspu:sourceArticle "Chapter 6, Article 4, Sec. 6" ;
    lspu:administeredBy lspu:OSAS .

lspu:Policy_ScholasticDelinquency a lspu:Policy ;
    rdfs:label "Scholastic Delinquency Policy" ;
    lspu:definition "Governs Warning, Probation, and Dismissal based on the percentage of academic units failed in a semester (25%-49% Warning; 50%-74% Probation; more than 75% Dismissal, with stated exceptions)." ;
    lspu:sourceArticle "Article on Retention/Scholastic Policy, Sec. 4" ;
    lspu:resultsInStatus lspu:Status_Warning, lspu:Status_Probation, lspu:Status_Dismissal ;
    lspu:administeredBy lspu:OfficeOfTheRegistrar .

lspu:Policy_AttendanceDropping a lspu:Policy ;
    rdfs:label "Attendance / Dropping Policy" ;
    lspu:definition "Undergraduate students accumulating absences equal to at least 25% of total class hours in a semester shall be dropped; withdrawing before mid-term exams permits dropping without prejudice." ;
    lspu:sourceArticle "Article 9, Sec. 4.1" ;
    lspu:administeredBy lspu:OfficeOfTheRegistrar ;
    lspu:requiresDocument lspu:Doc_ExcuseSlip .

lspu:Policy_HonorableDismissal a lspu:Policy ;
    rdfs:label "Honorable Dismissal Policy" ;
    lspu:definition "Voluntary withdrawal from the college/university with the Registrar's consent; requires a written petition signed by parent/guardian and settlement of all indebtedness. Not granted to a student who leaves due to suspension, dropping, or expulsion from disciplinary action." ;
    lspu:sourceArticle "Article 12" ;
    lspu:administeredBy lspu:OfficeOfTheRegistrar .

lspu:Policy_LeaveOfAbsence a lspu:Policy ;
    rdfs:label "Leave of Absence (LOA) Policy" ;
    lspu:definition "A graduate student intending to take a leave of absence must file an LOA form stating reason and length (max 2 years, counted as part of residency). Extensions beyond maximum residency require one penalty subject per year of extension. Failure to file an LOA results in Absence Without Official Leave (AWOL)." ;
    lspu:sourceArticle "Article 18" ;
    lspu:administeredBy lspu:OfficeOfTheRegistrar ;
    lspu:requiresDocument lspu:Doc_LOAForm .

lspu:Policy_GradeRectification a lspu:Policy ;
    rdfs:label "Change/Rectification of Grades Policy" ;
    lspu:definition "A student who receives a grade believed incorrect may request in writing for change/rectification within ten (10) days after the official release of grades." ;
    lspu:sourceArticle "Sec. 3.2" ;
    lspu:administeredBy lspu:OfficeOfTheRegistrar .

lspu:Policy_Plagiarism a lspu:Policy ;
    rdfs:label "Plagiarism Policy" ;
    lspu:definition "Failure to acknowledge sources through clear citation and referencing constitutes plagiarism. The University reserves the right to use software applications to screen submitted work for matches to published or other submitted sources; this applies equally to digital and printed material." ;
    lspu:sourceArticle "Article 17" .

#################################################################
#  STUDENT TYPES
#################################################################

lspu:StudentType_Undergraduate a lspu:StudentType ; rdfs:label "Undergraduate Student" .
lspu:StudentType_Graduate a lspu:StudentType ; rdfs:label "Graduate Student" .
lspu:StudentType_Transferee a lspu:StudentType ; rdfs:label "Student Transferee" .
lspu:StudentType_Special a lspu:StudentType ; rdfs:label "Special Student" ;
    lspu:definition "A mature student who does not fully satisfy entrance requirements but may be admitted to enroll in specific subjects at the dean's discretion; limited to nine (9) units unless given special permission." .
lspu:StudentType_NonDegree a lspu:StudentType ; rdfs:label "Non-degree Student" .


#################################################################
#  ADDITIONS TO: LSPU-LB STUDENT HANDBOOK ONTOLOGY (2021 Edition)
#  New scope: Academic/Non-academic Awards (Ch.6-Awards Art.1-3),
#  Scholarships (Ch.3 Art.10), Student Welfare/Development/
#  Mental Health Services (Ch.5), and Admission/Retention/
#  Graduation Requirements (Ch.3 Art.2,5,14).
#  All additions remain scoped to student-facing knowledge only.
#################################################################

#################################################################
#  NEW CLASSES
#################################################################

lspu:Award a owl:Class ;
    rdfs:label "Award" ;
    rdfs:comment "A form of institutional recognition given to a student for academic or non-academic achievement." .

lspu:AcademicAward a owl:Class ;
    rdfs:subClassOf lspu:Award ;
    rdfs:label "Academic Award" ;
    rdfs:comment "An award recognizing scholastic proficiency and excellence, e.g. Latin Honors (Ch. on Awards, Art. 1)." .

lspu:NonAcademicAward a owl:Class ;
    rdfs:subClassOf lspu:Award ;
    rdfs:label "Non-academic Award" ;
    rdfs:comment "An award recognizing leadership, service, or other non-scholastic achievement (Ch. on Awards, Art. 2-4)." .

lspu:Scholarship a owl:Class ;
    rdfs:label "Scholarship" ;
    rdfs:comment "A grant of financial assistance or incentive awarded to a qualified student (Chapter 3, Article 10)." .

lspu:AcademicScholarship a owl:Class ;
    rdfs:subClassOf lspu:Scholarship ;
    rdfs:label "Academic Scholarship" ;
    rdfs:comment "A scholarship awarded on the basis of scholastic performance or funded by government/private grants." .

lspu:NonAcademicScholarship a owl:Class ;
    rdfs:subClassOf lspu:Scholarship ;
    rdfs:label "Non-academic Scholarship" ;
    rdfs:comment "A scholarship awarded for athletics, ROTC, arts, or student-leadership roles, independent of academic grades." .

lspu:StudentService a owl:Class ;
    rdfs:label "Student Service" ;
    rdfs:comment "A program, service, or activity the University provides to support student welfare and development (Chapter 5)." .

lspu:MentalHealthService a owl:Class ;
    rdfs:subClassOf lspu:StudentService ;
    rdfs:label "Mental Health Service" ;
    rdfs:comment "A service under the LSPU Mental Health Services Unit addressing psychological, emotional, or behavioral student concerns." .

lspu:Requirement a owl:Class ;
    rdfs:label "Requirement" ;
    rdfs:comment "A specific condition a student must satisfy at a defined academic milestone (admission, retention, or graduation)." .

lspu:AdmissionRequirement a owl:Class ;
    rdfs:subClassOf lspu:Requirement ;
    rdfs:label "Admission Requirement" ;
    rdfs:comment "A condition an applicant must satisfy to be admitted to the University (Chapter 3, Article 2)." .

lspu:RetentionRequirement a owl:Class ;
    rdfs:subClassOf lspu:Requirement ;
    rdfs:label "Retention Requirement" ;
    rdfs:comment "A condition a currently-enrolled student must maintain to remain in their program (Chapter 3, Article 5)." .

lspu:GraduationRequirement a owl:Class ;
    rdfs:subClassOf lspu:Requirement ;
    rdfs:label "Graduation Requirement" ;
    rdfs:comment "A condition a student must satisfy before being recommended for graduation (Chapter 3, Article 14)." .

#################################################################
#  NEW OBJECT PROPERTIES
#################################################################

lspu:awardedBy a owl:ObjectProperty ;
    rdfs:domain lspu:Award ; rdfs:range [ a owl:Class ; owl:unionOf (lspu:Office lspu:UniversityRole lspu:Committee) ] ;
    rdfs:label "awardedBy" ;
    rdfs:comment "The office, role, or committee that confers or finalizes this award." .

lspu:providedBy a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf (lspu:StudentService lspu:Scholarship) ] ; rdfs:range lspu:Office ;
    rdfs:label "providedBy" ;
    rdfs:comment "The office responsible for delivering this service or administering this scholarship." .

lspu:mustSatisfy a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf (lspu:StudentType) ] ; rdfs:range lspu:Requirement ;
    rdfs:label "mustSatisfy" ;
    rdfs:comment "Links a StudentType to a Requirement that applies to it (e.g. Transferee -> a transferee-specific admission requirement)." .

#################################################################
#  NEW DATA PROPERTIES
#################################################################

lspu:gradeRangeText a owl:DatatypeProperty ; rdfs:domain lspu:AcademicAward ; rdfs:range xsd:string ;
    rdfs:label "gradeRangeText" ; rdfs:comment "The final-grade range required for this honor, e.g. '1.00 to 1.20'." .

lspu:eligibilityCriteria a owl:DatatypeProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf (lspu:Award lspu:Scholarship lspu:Requirement) ] ; rdfs:range xsd:string ;
    rdfs:label "eligibilityCriteria" ; rdfs:comment "Free-text statement of who qualifies or what must be satisfied." .

lspu:benefitDescription a owl:DatatypeProperty ; rdfs:domain lspu:Scholarship ; rdfs:range xsd:string ;
    rdfs:label "benefitDescription" ; rdfs:comment "What the scholarship provides, e.g. 'Full Scholarship/Training Allowance'." .

#################################################################
#  DOMAIN-WIDENED PROPERTIES
#  appliesToStudentType, isBasedOn, and requiresDocument were
#  originally declared with a narrower domain earlier in this file;
#  those earlier declarations have been removed (Turtle has no
#  "replace" semantics — restating a subject only adds triples, it
#  doesn't overwrite), so the wider domain below is now each
#  property's only declaration.
#################################################################

lspu:appliesToStudentType a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf (lspu:Policy lspu:Offense lspu:Right lspu:Duty
                  lspu:Award lspu:Scholarship lspu:Requirement) ] ;
    rdfs:range lspu:StudentType ;
    rdfs:label "appliesToStudentType" .

lspu:isBasedOn a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf (lspu:Offense lspu:Policy lspu:Requirement) ] ;
    rdfs:range lspu:LegalBasis ;
    rdfs:label "isBasedOn" ;
    rdfs:comment "Links an Offense, Policy, or Requirement to the external law/memorandum/resolution that authorizes it." .

lspu:requiresDocument a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf (lspu:Policy lspu:Procedure lspu:Offense lspu:Requirement) ] ;
    rdfs:range lspu:Document ;
    rdfs:label "requiresDocument" ;
    rdfs:comment "A document/form a student must obtain, file, or sign in connection with this policy, procedure, offense, or requirement." .

#################################################################
#  SAMPLE INSTANCES — Awards
#################################################################

lspu:Award_SummaCumLaude a lspu:AcademicAward ; rdfs:label "Summa Cum Laude" ;
    lspu:gradeRangeText "1.00 to 1.20" ;
    lspu:eligibilityCriteria "Degree-course student with normal academic load, at least 75% of units completed in residence, at least 2 years residence, no grade below 2.0 in PE/NSTP/Euthenics/similar subjects, good moral character." ;
    lspu:sourceArticle "Chapter on Awards, Article 1, Sec. 2-3" .

lspu:Award_MagnaCumLaude a lspu:AcademicAward ; rdfs:label "Magna Cum Laude" ;
    lspu:gradeRangeText "1.21 to 1.45" ;
    lspu:sourceArticle "Chapter on Awards, Article 1, Sec. 3.1" .

lspu:Award_CumLaude a lspu:AcademicAward ; rdfs:label "Cum Laude" ;
    lspu:gradeRangeText "1.46 to 1.75" ;
    lspu:sourceArticle "Chapter on Awards, Article 1, Sec. 3.1" .

lspu:Award_PresidentsAwardLeadership a lspu:NonAcademicAward ;
    rdfs:label "President's Award for Leadership Excellence" ;
    lspu:definition "One of the highest non-academic awards in leadership, given to a Supreme Student Council officer upon recommendation of their organization's adviser." ;
    lspu:awardedBy lspu:Role_UniversityPresident ;
    lspu:sourceArticle "Chapter on Awards, Article 3, Sec. 1" .

lspu:Award_Major a lspu:AcademicAward ; rdfs:label "Major Award" ;
    lspu:definition "One of the highest awards recognized by the University President, given automatically to the graduating student with honors who obtains the highest academic final average among those meeting the graduation-with-honors requirements." ;
    lspu:eligibilityCriteria "Must be a graduating student with honors who meets all graduation-with-honors requirements; recipient is the one with the single highest final average." ;
    lspu:awardedBy lspu:Committee_AwardsAndRecognition, lspu:Role_UniversityRegistrar ;
    lspu:sourceArticle "Appendix B, Article 2, Sec. 1-2" .

lspu:Award_AthleteOfTheYear a lspu:NonAcademicAward ; rdfs:label "Athlete of the Year Award" ;
    lspu:definition "Given to a student who excels in sports, whose representation and performance for the University in competitions brought recognition to and strengthened the external relations of the institution." ;
    lspu:eligibilityCriteria "No derogatory records with OSAS or the Guidance and Counseling Office; represented the university and won in various competitions; evaluated 70% on technical/competition-based points and 30% on student-achievement impact." ;
    lspu:awardedBy lspu:Committee_AwardsAndRecognition ;
    lspu:sourceArticle "Appendix B, Article 3, Sec. 2" .

lspu:Award_StudentJournalistOfTheYear a lspu:NonAcademicAward ; rdfs:label "Student Journalist of the Year Award" ;
    lspu:definition "Given to a student journalist who excels in campus journalism, whose active participation in the campus publication and/or representation in press conferences and contests brought recognition to the University. Requires active participation plus exemplary representation in competitions, including three or more awards in university-wide, regional, or national/luzon-wide press conferences." ;
    lspu:eligibilityCriteria "No derogatory records with OSAS or the Guidance and Counseling Office; active participation in publication production; three or more press-conference competition awards." ;
    lspu:awardedBy lspu:Committee_AwardsAndRecognition ;
    lspu:sourceArticle "Appendix B, Article 3, Sec. 3" .

lspu:Award_ServiceAwardee a lspu:NonAcademicAward ; rdfs:label "Service Awardee (Publication)" ;
    lspu:definition "Given to a student publication staff member who actively participates in producing campus publications and covering/documenting events, but without the additional competition-award record required for Student Journalist of the Year." ;
    lspu:eligibilityCriteria "No derogatory records with OSAS or the Guidance and Counseling Office; active participation in publication production, evidenced by at least five credited works for the year and inclusion in the editorial board." ;
    lspu:awardedBy lspu:Committee_AwardsAndRecognition ;
    lspu:sourceArticle "Appendix B, Article 3, Sec. 3" .

lspu:Award_Proficiency a lspu:NonAcademicAward ; rdfs:label "Proficiency Award" ;
    lspu:definition "Given per department/program to students who excel academically and show active participation that uplifts the academic and application-based morale of their program." ;
    lspu:eligibilityCriteria "No derogatory record; no failing grade, INC mark, or dropped subject; evaluated 70% on academic performance and 30% on extracurricular involvement." ;
    lspu:awardedBy lspu:Committee_AwardsAndRecognition, lspu:Role_CollegeDean ;
    lspu:sourceArticle "Appendix B, Article 4, Sec. 1" .

lspu:Award_Service a lspu:NonAcademicAward ; rdfs:label "Service Award" ;
    lspu:definition "Given to a student who excels in public service and renders dedicated service to their department, college, or office for a minimum of two semesters or one year." ;
    lspu:eligibilityCriteria "Minimum two semesters or one year of service; evaluated 60% on length of service and 40% on work attitude." ;
    lspu:awardedBy lspu:Committee_AwardsAndRecognition ;
    lspu:sourceArticle "Appendix B, Article 4, Sec. 2" .

lspu:Award_OJTPerformance a lspu:NonAcademicAward ; rdfs:label "Performance in Award for On-the-Job Training" ;
    lspu:definition "Given to a student who shows remarkable and exemplary performance applying theoretical knowledge in On-the-Job Training (OJT), recognized for maintaining the University's image with industries through positive feedback and high recommendation." ;
    lspu:eligibilityCriteria "Fulfilled academic requirements for OJT; obtained a certificate of OJT completion; no derogatory records." ;
    lspu:awardedBy lspu:Role_CollegeDean ;
    lspu:sourceArticle "Appendix B, Article 4, Sec. 3" .

#################################################################
#  SAMPLE INSTANCES — Scholarships
#################################################################

lspu:Schol_GovernmentPrivate a lspu:AcademicScholarship ;
    rdfs:label "Government and Private Company Scholarship" ;
    lspu:definition "Scholarship and study grants by government or private companies/individuals, available to needy and deserving students. Only one government/public office scholarship allowed per qualified scholar." ;
    lspu:sourceArticle "Chapter 3, Article 10, Sec. 1" .

lspu:Schol_VarsityFull a lspu:NonAcademicScholarship ;
    rdfs:label "Varsity Scholarship — Full Scholarship/Training Allowance" ;
    lspu:eligibilityCriteria "SCUAA medalist (gold, silver, or bronze); grade average of 2.0 for the preceding semester; good moral character." ;
    lspu:benefitDescription "Full Scholarship/Training Allowance" ;
    lspu:sourceArticle "Chapter 3, Article 10, Sec. 2.1.1" .

lspu:Schol_VarsityHalf a lspu:NonAcademicScholarship ;
    rdfs:label "Varsity Scholarship — Half Scholarship/Training Allowance" ;
    lspu:eligibilityCriteria "SCUAA point contributor or finalist; average grade of 2.5, maximum grade of 2.0." ;
    lspu:benefitDescription "Half Scholarship/Training Allowance" ;
    lspu:sourceArticle "Chapter 3, Article 10, Sec. 2.1.2" .

lspu:Schol_AdvancedROTC a lspu:NonAcademicScholarship ;
    rdfs:label "Advanced ROTC Scholarship" ;
    lspu:definition "A non-academic scholarship category for students in the Advanced Reserve Officers' Training Corps program. The handbook names this category without specifying further eligibility or benefit detail." ;
    lspu:sourceArticle "Chapter 3, Article 10, Sec. 2.2" .

lspu:Schol_CulturalPerformingArts a lspu:NonAcademicScholarship ;
    rdfs:label "Cultural and the Performing Arts Scholarship" ;
    lspu:definition "A non-academic scholarship category for students involved in cultural and performing arts. The handbook names this category without specifying further eligibility or benefit detail." ;
    lspu:sourceArticle "Chapter 3, Article 10, Sec. 2.3" .

lspu:Schol_BandMember a lspu:NonAcademicScholarship ;
    rdfs:label "Band Member Scholarship" ;
    lspu:definition "A non-academic scholarship category for members of the university band. The handbook names this category without specifying further eligibility or benefit detail." ;
    lspu:sourceArticle "Chapter 3, Article 10, Sec. 2.4" .

lspu:Schol_StudentGovernmentPresident a lspu:NonAcademicScholarship ;
    rdfs:label "Student Government (President) Scholarship" ;
    lspu:definition "A non-academic scholarship category for the President of the student government/Supreme Student Council. The handbook names this category without specifying further eligibility or benefit detail." ;
    lspu:sourceArticle "Chapter 3, Article 10, Sec. 2.5" .

lspu:Schol_PublicationEIC a lspu:NonAcademicScholarship ;
    rdfs:label "Publication (Editor-in-Chief) Scholarship" ;
    lspu:definition "A non-academic scholarship category for the Editor-in-Chief of the student publication. The handbook names this category without specifying further eligibility or benefit detail." ;
    lspu:sourceArticle "Chapter 3, Article 10, Sec. 2.6" .

#################################################################
#  SAMPLE INSTANCES — Student Services
#################################################################

lspu:Svc_GuidanceCounseling a lspu:StudentService ;
    rdfs:label "Guidance and Counseling Services" ;
    lspu:definition "Individual and group counseling, case conferences with parents/students, and follow-up/referral for students with cases to a multidisciplinary team." ;
    lspu:providedBy lspu:GuidanceOffice ;
    lspu:sourceArticle "Chapter 5, Article 1, Sec. 2" .

lspu:Svc_AlumniJobPlacement a lspu:StudentService ;
    rdfs:label "Alumni and Job Placement Services" ;
    lspu:definition "Career counseling and coaching, job-placement follow-up, networking with industries, and organizing job fairs/career days." ;
    lspu:sourceArticle "Chapter 5, Article 1, Sec. 3" .

lspu:Svc_MentalHealthCounseling a lspu:MentalHealthService ;
    rdfs:label "Mental Health Counseling and Referral" ;
    lspu:definition "Assessment, counseling, and referral for students with mental health concerns; university health service personnel may assess students aged 15-17 with consent/assent." ;
    lspu:eligibilityCriteria "All enrolled students; assessment of minors aged 15-17 requires consent and assent." ;
    lspu:requiresDocument lspu:Doc_InformedConsentMinor, lspu:Doc_InformedConsentAdult ;
    lspu:sourceArticle "Chapter on Mental Health Services, Article 6-8" .

lspu:Svc_InformationOrientation a lspu:StudentService ;
    rdfs:label "Information and Orientation Services" ;
    lspu:definition "Publicizes the university's vision, mission, quality policy, academic rules, and student conduct/discipline information; conducts a regular comprehensive orientation program for new and continuing students; maintains materials on student rights, drug abuse prevention, bullying, sexual harassment, and healthy lifestyle." ;
    lspu:sourceArticle "Chapter 5, Article 1, Sec. 1" .

lspu:Svc_StudentHandbookDevelopment a lspu:StudentService ;
    rdfs:label "Student Handbook Development Services" ;
    lspu:definition "Develops and updates the student handbook into accessible formats for dissemination to students and stakeholders, and archives previous editions for improvement." ;
    lspu:sourceArticle "Chapter 5, Article 1, Sec. 4" .

lspu:Svc_StudentDevelopment a lspu:StudentService ;
    rdfs:label "Student Development Services (SDS)" ;
    lspu:definition "Programs and activities for the enhancement and deepening of students' leadership and soft skills, covering student organization recognition/monitoring, leadership training programs, the Student Council/Government, student discipline coordination, and student publication support." ;
    lspu:sourceArticle "Chapter 5, Article 2" .

lspu:Svc_StudentDiscipline a lspu:StudentService ;
    rdfs:label "Student Discipline Services" ;
    lspu:definition "Strictly imposes university rules and regulations, coordinates with teachers and parents on student discipline, deals impartially with students on disciplinary problems, and follows up on students with offenses for proper guidance." ;
    lspu:sourceArticle "Chapter 5, Article 2, Sec. 4" .

lspu:Svc_AdmissionTesting a lspu:StudentService ;
    rdfs:label "Admission and Testing Services" ;
    lspu:definition "Administers the college entrance test and intake interview for incoming students and transferees, prepares and updates testing materials, interprets and posts entrance test results, and assists incoming students with admission requirements." ;
    lspu:providedBy lspu:GuidanceOffice ;
    lspu:sourceArticle "Chapter 5, Article 3, Sec. 1" .

lspu:Svc_ScholarshipFinancialAssistance a lspu:StudentService ;
    rdfs:label "Scholarship and Financial Assistance Services" ;
    lspu:definition "Disseminates information on scholarship requirements, monitors the academic performance of student-scholars, facilitates processing of scholar allowances and benefits, and conducts testing/interviews to select student-scholars." ;
    lspu:sourceArticle "Chapter 5, Article 3, Sec. 2" .

lspu:Svc_Food a lspu:StudentService ;
    rdfs:label "Food Services" ;
    lspu:definition "Sets safety and sanitary criteria for food outlets within university premises, coordinates with local health authorities, and periodically inspects food outlets to ensure healthy meals are served." ;
    lspu:sourceArticle "Chapter 5, Article 3, Sec. 3" .

lspu:Svc_Health a lspu:StudentService ;
    rdfs:label "Health Services" ;
    lspu:definition "Provides medical/dental services information to faculty and students, ensures sufficient emergency medicines and equipment, and conducts regular first-aid training." ;
    lspu:sourceArticle "Chapter 5, Article 3, Sec. 4" .

lspu:Svc_SafetyAndSecurity a lspu:StudentService ;
    rdfs:label "Safety and Security Services" ;
    lspu:definition "Ensures the safety and security of students on university premises, assists in evaluating emergency/crisis plans and safety drills, and supervises security forces in implementing university policy." ;
    lspu:providedBy lspu:SafetyAndSecurityManagementOffice ;
    lspu:sourceArticle "Chapter 5, Article 3, Sec. 5" .

lspu:Svc_HousingResidential a lspu:StudentService ;
    rdfs:label "Student Housing and Residential Services" ;
    lspu:definition "Provides assistance and a list of acceptable student dormitories, and monitors that housing facilities are safe, clean, affordable, and conducive to learning." ;
    lspu:sourceArticle "Chapter 5, Article 3, Sec. 6" .

lspu:Svc_MultiFaith a lspu:StudentService ;
    rdfs:label "Multi-Faith Services (Spiritual Development Program)" ;
    lspu:definition "Ensures students' right to freedom of religion is respected, cultivates spiritual understanding, and assures equal access to education regardless of religious status or affiliation." ;
    lspu:sourceArticle "Chapter 5, Article 3, Sec. 7" .

lspu:Svc_InternationalStudent a lspu:StudentService ;
    rdfs:label "International Student Services" ;
    lspu:definition "Fosters international student exchange and academic programs, assists foreign students in coordinating with government agencies (CHED, DFA, Bureau of Immigration), and monitors international students' activities including visa application assistance." ;
    lspu:sourceArticle "Chapter 5, Article 3, Sec. 8" .

lspu:Svc_SpecialNeedsPWD a lspu:StudentService ;
    rdfs:label "Services for Students with Special Needs and Persons with Disabilities" ;
    lspu:definition "Provides equal educational opportunities to Persons with Disabilities (PWDs), indigenous peoples, solo parents, and other students with special needs, including conflict management, counseling, and testing referrals when necessary." ;
    lspu:sourceArticle "Chapter 5, Article 3, Sec. 9" .

#################################################################
#  SAMPLE INSTANCES — Requirements
#################################################################

lspu:Req_NonDiscriminatoryAdmission a lspu:AdmissionRequirement ;
    rdfs:label "Non-discriminatory Admission" ;
    lspu:definition "No student shall be denied admission by reason of age, sex, gender, nationality, belief, or political affiliation; equal opportunity extends to PWDs, differently-abled, indigenous people, solo parents, and people with special concerns." ;
    lspu:sourceArticle "Chapter 3, Article 2, Sec. 2.1" .

lspu:Req_AdmissionExamination a lspu:AdmissionRequirement ;
    rdfs:label "Admission Examination" ;
    lspu:definition "Applicants must pass the Admission Test and University Qualifying Examination administered by the Guidance Office, and complete an interview." ;
    lspu:providedBy lspu:GuidanceOffice ;
    lspu:sourceArticle "Chapter 3, Article 2, Sec. 2.4" .

lspu:Req_MinimumGPA a lspu:RetentionRequirement ;
    rdfs:label "Minimum Grade Point Average" ;
    lspu:definition "Minimum GPA of 2.00 every semester or summer; board programs require 2.00 in major/professional subjects (1.00-1.75 for general education); non-board programs require 2.25 in major/professional subjects (1.00-2.00 for general education)." ;
    lspu:resultsInStatus lspu:Status_Warning, lspu:Status_Probation, lspu:Status_Dismissal ;
    lspu:sourceArticle "Chapter 3, Article 5, Sec. 3.2" .

lspu:Req_GoodMoralCharacter a lspu:RetentionRequirement ;
    rdfs:label "Good Moral Character" ;
    lspu:definition "After admission, the student must maintain good moral character at all times regardless of year level." ;
    lspu:sourceArticle "Chapter 3, Article 5, Sec. 1" .

lspu:Req_TreePlanting a lspu:GraduationRequirement ;
    rdfs:label "Tree Planting" ;
    lspu:definition "A student must have individually planted a minimum of ten (10) seedlings per year in areas determined by their college (National Greening Program, EO No. 26)." ;
    lspu:isBasedOn lspu:RA_EO26 ;
    lspu:sourceArticle "Chapter 3, Article 14, Sec. 2" .

lspu:Req_ClearanceForGraduation a lspu:GraduationRequirement ;
    rdfs:label "Clearance for Graduation" ;
    lspu:definition "No student shall be recommended for graduation if with property and financial accountabilities." ;
    lspu:sourceArticle "Chapter 3, Article 14, Sec. 3" .

lspu:Req_ResidencyForGraduation a lspu:GraduationRequirement ;
    rdfs:label "Residency Requirement for Graduation" ;
    lspu:definition "Completion of at least 50% of total academic units/hours in residence, with at least 2 years of residence, one of which must be senior year." ;
    lspu:sourceArticle "Chapter 3, Article 14, Sec. 4" .

#  Note: RA_EO26 (National Greening Program, Executive Order No. 26) is a new
#  LegalBasis instance needed to support Req_TreePlanting above:
lspu:RA_EO26 a lspu:LegalBasis ; rdfs:label "Executive Order No. 26" ;
    lspu:actName "National Greening Program (NGP)" .

#################################################################
#  NEW CLASSES (round 2) — Student Organizations
#  Scope: Chapter 5, Article 2, Sec. 1 & 3 (recognition/accreditation
#  of student organizations; the Student Council/Government). Closes
#  a gap where lspu:Offense already assumes organizations exist as
#  entities (sanctionType "OrganizationBan"; the offenses
#  UnauthorizedOrgLeadingParticipating and UnrecognizedOrgOperating,
#  Ch.6 Art.2 Sec.14.1-14.2) but no class modeled what an
#  "organization" actually is.
#################################################################

lspu:StudentOrganization a owl:Class ;
    rdfs:label "Student Organization" ;
    rdfs:comment "A student-formed group (club, council, publication staff, etc.) subject to University recognition/accreditation (Chapter 5, Article 2, Sec. 1)." .

lspu:StudentCouncil a owl:Class ;
    rdfs:subClassOf lspu:StudentOrganization ;
    rdfs:label "Student Council" ;
    rdfs:comment "The elected, self-governing student body recognized by the University, e.g. the Supreme Student Council (Chapter 5, Article 2, Sec. 3)." .

#################################################################
#  NEW PROPERTIES (round 2)
#################################################################

lspu:accreditationStatus a owl:DatatypeProperty ;
    rdfs:domain lspu:StudentOrganization ; rdfs:range xsd:string ;
    rdfs:label "accreditationStatus" ;
    rdfs:comment "Free-text recognition status of the organization, e.g. 'Recognized', 'Pending application', 'Unrecognized'." .

lspu:recognizedBy a owl:ObjectProperty ;
    rdfs:domain lspu:StudentOrganization ;
    rdfs:range [ a owl:Class ; owl:unionOf (lspu:Office lspu:Committee) ] ;
    rdfs:label "recognizedBy" ;
    rdfs:comment "The office or committee responsible for accrediting/recognizing this organization." .

lspu:hasAdviser a owl:ObjectProperty ;
    rdfs:domain lspu:StudentOrganization ; rdfs:range lspu:UniversityRole ;
    rdfs:label "hasAdviser" ;
    rdfs:comment "The faculty/staff adviser assigned to this organization." .

lspu:associatedOrganization a owl:ObjectProperty ;
    rdfs:domain lspu:Award ; rdfs:range lspu:StudentOrganization ;
    rdfs:label "associatedOrganization" ;
    rdfs:comment "Links an Award to the student organization its recipient must belong to or hold office in." .

#################################################################
#  SAMPLE INSTANCES — Student Organizations
#################################################################

lspu:Org_SupremeStudentCouncil a lspu:StudentCouncil ;
    rdfs:label "Supreme Student Council" ;
    lspu:definition "The student body duly managed and elected at large by the students themselves; its President sits on the Student Discipline Committee and its Federated President sits on the Board." ;
    lspu:sourceArticle "Chapter 5, Article 2, Sec. 3" .

#  Links the existing President's Award for Leadership Excellence (given to
#  an SSC officer) to the SSC as a formal organization, connecting Chapter 5
#  (organizations) to Chapter 6/Awards (recognition) for multi-hop queries.
lspu:Award_PresidentsAwardLeadership lspu:associatedOrganization lspu:Org_SupremeStudentCouncil .

#  Note: the offenses UnauthorizedOrgLeadingParticipating and
#  UnrecognizedOrgOperating (base ontology, Ch.6 Art.2 Sec.14.1-14.2) concern
#  organizations generically rather than a named instance, so they are not
#  linked to a specific lspu:StudentOrganization individual here — the class
#  existing is what makes them resolvable to the same entity type as this
#  section for retrieval purposes.

#################################################################
#  NEW DOCUMENTS
#################################################################

lspu:Doc_COG a lspu:Document ; rdfs:label "Copy of Grades (COG)" ;
    lspu:definition "Official record of a student's grades for a given semester issued by the Office of the Registrar at the end of each semester. Also indicates enrollment status flags such as Warning, Probation, Dismissal, Disqualification, or INC. Used by the College Dean for retention evaluation and by the student to monitor academic standing via the LSPU Portal." ;
    lspu:issuedBy lspu:OfficeOfTheRegistrar ;
    lspu:sourceArticle "Chapter 3, Article 5, Sec. 8.1.1" .

lspu:Doc_TransferCredential a lspu:Document ; rdfs:label "Transfer Credential / Honorable Dismissal" ;
    lspu:definition "Document issued by the Office of the Registrar to a student who voluntarily withdraws from the university in good standing. Required by transferee applicants from their previous institution. Not issued to students dismissed, suspended, or expelled for disciplinary reasons." ;
    lspu:issuedBy lspu:OfficeOfTheRegistrar ;
    lspu:sourceArticle "Chapter 3, Article 12" .

lspu:Doc_CertificateOfRegistration a lspu:Document ; rdfs:label "Certificate of Registration (COR)" ;
    lspu:definition "Document certifying that a student is officially enrolled for a given semester. Required for admission to classes. Signed by authorized university officials." ;
    lspu:issuedBy lspu:OfficeOfTheRegistrar ;
    lspu:sourceArticle "Chapter 3, Article 2, Sec. 2.8" .

lspu:Doc_DrugTestingConsentForm a lspu:Document ; rdfs:label "Drug Testing Consent Form" ;
    lspu:definition "Form accomplished by all students before undergoing the LSPU Mandatory Drug Testing Program (MDTP). Students must also declare any prescription medicines, vitamins, or food supplements taken within the past five (5) days." ;
    lspu:issuedBy lspu:SafetyAndSecurityManagementOffice ;
    lspu:sourceArticle "Appendix C, Sec. 6.1" .

#################################################################
#  NEW OFFICE — LSPU Portal (student-facing digital service)
#################################################################

lspu:LSPUPortal a lspu:Office ; rdfs:label "LSPU Student Portal (myaccount.lspu.edu.ph)" ;
    lspu:contactNote "Online portal where students can access their academic records, grades, and enrollment status. Reflects the same information shown in the COG, subject to data privacy policy. Accessible at myaccount.lspu.edu.ph." ;
    lspu:sourceArticle "Chapter 3, Article 5, Sec. 8.1.2" .

#################################################################
#  NEW POLICIES — Grading System
#################################################################

lspu:Policy_GradingSystem a lspu:Policy ; rdfs:label "Undergraduate Grading System" ;
    lspu:definition "Grades are expressed in Arabic numerals. Scale: 1.00 (Excellent, 99–100%), 1.25 (96–98%), 1.50 (Very Satisfactory, 93–95%), 1.75 (90–92%), 2.00 (Satisfactory, 87–89%), 2.25 (84–86%), 2.50 (Fairly Satisfactory, 81–83%), 2.75 (78–80%), 3.00 (75–77%), 4.00 (Conditional Failure, 70–74%), 5.00 (Failed, 69% and below), INC (Incomplete), DRP (Officially Dropped). A grade of 4.00 must be removed within one (1) academic year by re-examination; highest removal grade is 3.00. An INC mark automatically becomes 5.00 if not completed within one (1) academic year. A student with a passing grade may not re-examine to improve it." ;
    lspu:sourceArticle "Chapter 3, Article 7" ;
    lspu:administeredBy lspu:OfficeOfTheRegistrar ;
    lspu:appliesToStudentType lspu:StudentType_Undergraduate .

lspu:Policy_GradingSystemGraduate a lspu:Policy ; rdfs:label "Graduate Studies Grading System" ;
    lspu:definition "Scale: 1.00 (Excellent, 99–100%), 1.25 (Outstanding, 96–98%), 1.50 (Very Satisfactory, 93–95%), 1.75 (Satisfactory, 90–92%), 2.00 (Passing, 87–89%), W (Withdrawn). Minimum passing GPA is 2.00. An INC mark automatically becomes 5.00 if not completed within one (1) academic year. No provisional or temporary final grade is allowed. Dropping a subject without the GSAR Dean's written consent results in a grade of F." ;
    lspu:sourceArticle "Chapter 4, Article 8" ;
    lspu:administeredBy lspu:OfficeOfTheRegistrar ;
    lspu:appliesToStudentType lspu:StudentType_Graduate .

#################################################################
#  NEW POLICIES — Academic Load, Overload, Prerequisites
#################################################################

lspu:Policy_AcademicLoad a lspu:Policy ; rdfs:label "Academic Load Policy" ;
    lspu:definition "A student's academic load is determined by their curricular program. Normal load is the number of units required per semester as prescribed in the curriculum. Overload (more than normal load) is not allowed except for graduating students with above-average academic records, who may apply to the VPAA for an overload of not more than six (6) units or two (2) subjects. No change of registration involving a new subject is allowed after 12% of regular class meetings have been held." ;
    lspu:sourceArticle "Chapter 3, Article 6, Sec. 1–2" ;
    lspu:administeredBy lspu:OfficeOfTheRegistrar .

lspu:Policy_CrossRegistration a lspu:Policy ; rdfs:label "Cross-Registration Policy" ;
    lspu:definition "Simultaneous registration for a semester or midyear class in more than one college within LSPU, or at another institution. Within LSPU: requires permission from the campus registrar of the primary campus; total units across campuses must not exceed the normal load. From another institution: requires a written permit from that institution's registrar specifying authorized subjects and units. To another institution: requires approval from the College Dean and campus registrar. Cross-registration may be allowed when there is a schedule conflict or the subject is not offered at the home campus." ;
    lspu:sourceArticle "Chapter 3, Article 3, Sec. 4" ;
    lspu:administeredBy lspu:OfficeOfTheRegistrar .

lspu:Policy_SubstitutionOfSubjects a lspu:Policy ; rdfs:label "Substitution of Subjects Policy" ;
    lspu:definition "Substitution of a subject is allowed only when: (1) a student is pursuing a curriculum superseded by a new one and substitution aligns the old curriculum with the new, or (2) the required subject is no longer offered. Substitution must be between courses carrying the same number of units. No substitution is allowed for a subject in which the student received a failing grade (5.0) unless the Adviser, Dean, and VPAA agree it is essential. Requests must be submitted to the Office of the Registrar upon enrollment." ;
    lspu:sourceArticle "Chapter 3, Article 6, Sec. 6" ;
    lspu:administeredBy lspu:OfficeOfTheRegistrar .

lspu:Policy_INCAndRemovalGrades a lspu:Policy ; rdfs:label "INC Mark and Grade Removal Policy" ;
    lspu:definition "An INC (Incomplete) is given when a student with a passing class standing fails to take the final examination due to illness or other valid reason, or when some course requirements are incomplete due to sickness. INC is not given to students with failing grades. INC automatically becomes 5.00 if not completed within one (1) academic year. Removal of a grade of 4.00 may be done by re-examination; the highest removal grade is 3.00; if failed, the grade becomes 5.00. A student is allowed only one (1) removal examination, which must be taken within one (1) academic year. Removal fee: P20 per unit. Special removal examination (via Dean petition): P100 per unit." ;
    lspu:sourceArticle "Chapter 3, Article 7, Sec. 5" ;
    lspu:administeredBy lspu:OfficeOfTheRegistrar ;
    lspu:requiresDocument lspu:Doc_ExcuseSlip .

lspu:Policy_MaximumResidenceRule a lspu:Policy ; rdfs:label "Maximum Residence Rule" ;
    lspu:definition "A student must finish all requirements of their course within a period of actual residence equivalent to 1.5 times the normal length prescribed for the course. Failure to do so bars further registration at the university. For graduate students: master's degree requirements must be completed within five (5) years from first enrollment; doctorate requirements within seven (7) years." ;
    lspu:sourceArticle "Chapter 3, Article 11; Chapter 4, Article 9" ;
    lspu:administeredBy lspu:OfficeOfTheRegistrar .

lspu:Policy_LateRegistration a lspu:Policy ; rdfs:label "Late Registration Policy" ;
    lspu:definition "Students may register up to one (1) week after the last day of regular registration. Late registrants are charged a fine of P500.00 (BOR Resolution 1046, s.2012). Time lost due to late enrollment is counted as absence." ;
    lspu:sourceArticle "Chapter 3, Article 3, Sec. 1" ;
    lspu:administeredBy lspu:OfficeOfTheRegistrar .

lspu:Policy_RefundOfFees a lspu:Policy ; rdfs:label "Refund of Enrollment Fees Policy" ;
    lspu:definition "A student who has paid enrollment fees and is granted Honorable Dismissal, Transfer Credentials, or Leave of Absence is entitled to a refund of fees (excluding matriculation/registration fee) on this schedule: 75% refund within the first week from opening of classes; 50% refund within weeks 2–4; no refund after the 4th week. Laboratory fees are not refunded after one week. No refund for registration, library, or miscellaneous fees." ;
    lspu:sourceArticle "Chapter 3, Article 3, Sec. 3" ;
    lspu:administeredBy lspu:OfficeOfTheRegistrar .

#################################################################
#  NEW POLICIES — Flag Ceremony, Graduation Ceremony
#################################################################

lspu:Policy_FlagCeremonyAttendance a lspu:Policy ; rdfs:label "Flag Ceremony Attendance Policy" ;
    lspu:definition "All students are required to attend flag-raising and flag-lowering ceremonies regularly and on time, as mandated by RA 8491 (Philippine Flag Law, Sec. 18 & 50). Exemption may be granted only by the University President or a duly authorized representative. Non-attendance is treated as an absence under the Tardiness/Attendance minor offense rules." ;
    lspu:sourceArticle "Chapter 6, Article 3, Sec. 1.1" ;
    lspu:isBasedOn lspu:RA8491 ;
    lspu:administeredBy lspu:OSAS .

lspu:Policy_GraduationCeremony a lspu:Policy ; rdfs:label "Graduation Ceremony Policy" ;
    lspu:definition "All candidates for graduation must attend the commencement exercises. Students who cannot attend due to serious illness or equally serious reasons may petition the University President for Graduacion in Absencia before the ceremony. Approved petitioners must obtain their diploma and Transcript of Records from the Office of the Registrar upon presenting the approved request, payment of graduation fees, and submission of clearance." ;
    lspu:sourceArticle "Chapter 3, Article 14, Sec. 5–6" ;
    lspu:administeredBy lspu:OfficeOfTheRegistrar ;
    lspu:requiresDocument lspu:Doc_ClearanceForGraduation .

lspu:Doc_ClearanceForGraduation a lspu:Document ; rdfs:label "Clearance for Graduation" ;
    lspu:definition "A clearance certifying that the student has no outstanding property or financial accountabilities to the university. Required before a student can be recommended for graduation and before release of diploma and Transcript of Records." ;
    lspu:issuedBy lspu:OfficeOfTheRegistrar .

#################################################################
#  NEW PROCEDURE — Mandatory Drug Testing (MDTP)
#################################################################

lspu:Proc_MDTP a lspu:Procedure ; rdfs:label "Mandatory Drug Testing Program (MDTP) Procedure" ;
    lspu:definition "All LSPU students undergo mandatory drug testing as part of the university's admission and retention policy (BOR Resolution 1362, s.2017; CHED Memo No. 64, s.2017). Results are strictly confidential and may not be used as grounds for administrative, civil, or criminal liability. Students who test positive undergo counseling (40 hours with Guidance Counselor) and repeat drug testing for six (6) consecutive weeks at a DOH-accredited facility. Students who refuse testing are dealt with under university rules; refusal alone does not create a presumption of drug use." ;
    lspu:sourceArticle "Appendix C" ;
    lspu:handledByCommittee lspu:DrugFreeCommittee ;
    lspu:requiresDocument lspu:Doc_DrugTestingConsentForm ;
    lspu:hasStep lspu:MDTP_Step1 .

lspu:DrugFreeCommittee a lspu:Committee ; rdfs:label "LSPU Drug-Free Committee (DFC) Selection Board" ;
    lspu:definition "Committee overseeing the Mandatory Drug Testing Program. Chaired by the Campus Director (Drug Testing Coordinator). Members include the OSAS Director/Chairperson, Guidance Counselors, Medical Services staff, and the Supreme Student Council President/Representative." ;
    lspu:sourceArticle "Appendix C, Sec. 5.2" ;
    lspu:hasCommitteeRole lspu:Role_CampusDirector, lspu:Role_OSASDirector, lspu:Role_GuidanceCounselor, lspu:Role_SSCPresident .

lspu:MDTP_Step1 a lspu:ProcedureStep ;
    rdfs:label "MDTP Step 1: Notification and Consent" ;
    lspu:definition "All incoming freshmen and old students are secured a Drug Testing Consent Form before testing. A general announcement and schedule is posted by college and on social media (SSC channels)." ;
    lspu:nextStep lspu:MDTP_Step2 .

lspu:MDTP_Step2 a lspu:ProcedureStep ;
    rdfs:label "MDTP Step 2: Urine Specimen Collection" ;
    lspu:definition "Students select a specimen bottle, are accompanied by a same-gender collector, empty pockets, wash hands, provide specimen. Student and collector both sign the sealing tape and drug testing form." ;
    lspu:nextStep lspu:MDTP_Step3 .

lspu:MDTP_Step3 a lspu:ProcedureStep ;
    rdfs:label "MDTP Step 3: Screening Test Result" ;
    lspu:definition "Negative results: student receives individual copy. Presumptive positive: same specimen submitted for confirmatory test; DTC informs student and parent/guardian in writing." ;
    lspu:nextStep lspu:MDTP_Step4 .

lspu:MDTP_Step4 a lspu:ProcedureStep ;
    rdfs:label "MDTP Step 4: Confirmatory Test and Intervention" ;
    lspu:definition "If confirmed negative: Medical Services informs student. If confirmed positive: DTC informs student and parent in writing; conference held; student undergoes 40-hour counseling and 6-week repeat testing. Positive result does NOT appear on academic records and cannot be used for disciplinary action." ;
    lspu:performedBy lspu:GuidanceOffice, lspu:Role_CampusDirector .

#################################################################
#  NEW POLICIES — Shifting, Transferring
#################################################################

lspu:Policy_ShiftingOfCourse a lspu:Policy ; rdfs:label "Shifting of Course Policy" ;
    lspu:definition "A student may shift to any BS Program within the university provided: (1) no failure of more than six (6) units in any semester; (2) no failure in course-related/major subjects as defined by the retention policy of the target program; (3) a filled-out shifting form from the Office of the Registrar is submitted." ;
    lspu:sourceArticle "Chapter 3, Article 2, Sec. 2.10" ;
    lspu:administeredBy lspu:OfficeOfTheRegistrar ;
    lspu:requiresDocument lspu:Doc_CertificateOfRegistration .

lspu:Policy_Transferring a lspu:Policy ; rdfs:label "Transferring to Another College/Program Policy" ;
    lspu:definition "Students intending to transfer to another college must satisfy grade requirements of the target college. The prescribed transfer form must state a valid reason, with an attached copy of grades and a recommendation letter from the previous Dean (CC to Registrar). Approval from the College Dean and Registrar must be obtained before 12% of regular class meetings have been held. The student must complete at least 60% of program units at LSPU (75% if running for honors)." ;
    lspu:sourceArticle "Chapter 3, Article 2, Sec. 2.9" ;
    lspu:administeredBy lspu:OfficeOfTheRegistrar .

#################################################################
#  NEW POLICY — Dropping Procedure (more detailed than existing)
#################################################################

lspu:Policy_DroppingProcedure a lspu:Policy ; rdfs:label "Dropping of Subject Procedure" ;
    lspu:definition "A student may be dropped from a subject if unexcused absences reach 25% of total class hours. Dropping before the midterm examination is done without prejudice (no failing grade). Dropping after the midterm: the instructor may give a grade of 5.0 if the student's class standing is below 3.0. Dropping without the Dean's approval results in an automatic grade of 5.0. Dropping fee: P20 per unit." ;
    lspu:sourceArticle "Chapter 3, Article 6, Sec. 4" ;
    lspu:administeredBy lspu:OfficeOfTheRegistrar ;
    lspu:requiresDocument lspu:Doc_ExcuseSlip .

#################################################################
#  THESIS / RESEARCH REQUIREMENT (student-facing)
#################################################################

lspu:Req_UndergraduateThesis a lspu:GraduationRequirement ; rdfs:label "Undergraduate Thesis Requirement" ;
    lspu:definition "A thesis is required in certain curricula. The thesis outline must be approved by a panel (Chairman, Statistician, English Critic, Subject Specialist, College Dean, Research Director) and filed with the Registrar within the semester the student first registers for thesis work. After panel approval of the full manuscript, five (5) typewritten copies are submitted to the Registrar at least two (2) weeks before the faculty acts on graduation candidacy." ;
    lspu:sourceArticle "Chapter 3, Article 13" ;
    lspu:appliesToStudentType lspu:StudentType_Undergraduate .

lspu:Req_GraduateResearchPublication a lspu:GraduationRequirement ; rdfs:label "Graduate Research Publication Requirement" ;
    lspu:definition "As a requirement for graduation, a GSAR student must produce one published paper and one presented paper outside the university, in a local or international publication, conference, or presentation." ;
    lspu:sourceArticle "Chapter 4, Article 16" ;
    lspu:appliesToStudentType lspu:StudentType_Graduate .

#################################################################
#  ADDITIONAL STUDENT TYPES
#################################################################

lspu:StudentType_Freshman a lspu:StudentType ; rdfs:label "Freshman Student" ;
    lspu:definition "A student who has earned fewer than 25% of the total units required for their entire course." ;
    lspu:sourceArticle "Chapter 3, Article 1, Sec. 2.1" .

lspu:StudentType_Sophomore a lspu:StudentType ; rdfs:label "Sophomore Student" ;
    lspu:definition "A student who has earned 25%–50% of the total units required for their entire course." ;
    lspu:sourceArticle "Chapter 3, Article 1, Sec. 2.2" .

lspu:StudentType_Junior a lspu:StudentType ; rdfs:label "Junior Student" ;
    lspu:definition "A student who has earned 50%–75% of the total units required for their entire course." ;
    lspu:sourceArticle "Chapter 3, Article 1, Sec. 2.3" .

lspu:StudentType_Senior a lspu:StudentType ; rdfs:label "Senior Student" ;
    lspu:definition "A student who has earned 75% or more of the total units required for their entire course." ;
    lspu:sourceArticle "Chapter 3, Article 1, Sec. 2.4" .

lspu:StudentType_Regular a lspu:StudentType ; rdfs:label "Regular/Full-Time Student" ;
    lspu:definition "A student who carries the full load prescribed in the curriculum for a given semester." ;
    lspu:sourceArticle "Chapter 3, Article 1, Sec. 3.1" .

lspu:StudentType_Irregular a lspu:StudentType ; rdfs:label "Irregular Student" ;
    lspu:definition "A student who carries less than the full load prescribed in the curriculum for a given semester." ;
    lspu:sourceArticle "Chapter 3, Article 1, Sec. 3.2" .

lspu:StudentType_CrossEnrollee a lspu:StudentType ; rdfs:label "Cross-Enrollee" ;
    lspu:definition "A student currently enrolled in another campus or school who is permitted to enroll in specific subjects at LSPU to earn credit units, or vice versa." ;
    lspu:sourceArticle "Chapter 3, Article 1, Sec. 1.3" .

lspu:StudentType_Foreign a lspu:StudentType ; rdfs:label "Foreign/International Student" ;
    lspu:definition "A student whose citizenship is not Filipino who enrolls in any degree program at the university. Governed by CHED, Bureau of Immigration, and DFA guidelines. Must meet English proficiency requirements (TOEFL minimum 500 or IELTS equivalent) if not a native English speaker." ;
    lspu:sourceArticle "Chapter 3, Article 1, Sec. 1.4; Article 2, Sec. 2.2" .

#################################################################
#  ADDITIONAL RIGHT — Disability Accommodation
#################################################################

lspu:Right_EqualAccessPWD a lspu:Right ; rdfs:label "Right to Equal Access — PWDs and Students with Special Needs" ;
    lspu:definition "No student shall be denied admission by reason of disability. Persons with Disabilities (PWDs), indigenous peoples, solo parents, and students with other special concerns are admitted and provided equal educational opportunities. The university provides dedicated services including conflict management, counseling, and testing referrals." ;
    lspu:sourceArticle "Chapter 3, Article 2, Sec. 2.1; Chapter 5, Article 3, Sec. 9" .

lspu:Right_FreeHigherEducation a lspu:Right ; rdfs:label "Right to Free Higher Education (UniFAST / RA 10687)" ;
    lspu:definition "Students enrolled or enrolling in a bachelor's degree program at LSPU are exempt from tuition and other school fees for enrolled units under the Universal Access to Quality Tertiary Education Act of 2017 (RA 10687 / UniFAST), provided they meet institutional admission and retention qualifications." ;
    lspu:sourceArticle "Chapter 3, Article 2, Sec. 1.2–1.3" .

#################################################################
#  ADDITIONAL DUTIES
#################################################################

lspu:Duty_WearIDAndUniform a lspu:Duty ; rdfs:label "Wear School ID and Uniform at All Times" ;
    lspu:definition "Every student must wear the University ID with lace and the prescribed school uniform at all times within campus, with exceptions for field activities. Failure to do so is a minor offense subject to sanctions under lspu:NonWearingIDUniform." ;
    lspu:sourceArticle "Chapter 6, Article 3, Sec. 4" .

lspu:Duty_ProperWaste a lspu:Duty ; rdfs:label "Proper Disposal of Waste" ;
    lspu:definition "Every student must properly dispose of waste, trash, and garbage using the comfort rooms, trash cans, containers, and garbage pit-piles provided. Failure is a minor offense under lspu:LitteringScattering." ;
    lspu:sourceArticle "Chapter 6, Article 3, Sec. 3" .

lspu:Duty_SignPledgeOfCompliance a lspu:Duty ; rdfs:label "Sign Pledge of Compliance upon Admission" ;
    lspu:definition "Every student and their parent/guardian must sign the Pledge of Compliance at admission, pledging to abide by all university rules and regulations. Refusal to sign or subsequent violation of its terms is sufficient for summary dismissal or denial of admission." ;
    lspu:sourceArticle "Chapter 3, Article 2, Sec. 2.7" ;
    lspu:requiresDocument lspu:Doc_PledgeOfCompliance .



#################################################################
#  PILLAR 2 — ADMISSION & TRANSACTION PROCEDURES / CITIZEN'S CHARTER
#  (source: LSPU_Citizens_Charter_2026_CLEANED.txt, University-Wide
#  Citizen's Charter, 2026 1st Edition)
#
#  Namespace: lspuadm: (new — Service Catalog / RA 11032 concepts).
#  Cross-references classes/properties already defined under lspu:
#  (Pillar 3 namespace) rather than duplicating them:
#    lspu:Office              -- offices this pillar's services run through
#    lspu:Document            -- requirement/document instances
#    lspu:requiresDocument    -- Service -> Document
#    lspu:hasStep / lspu:nextStep / lspu:performedBy -- step sequencing
#    lspu:definition          -- short free-text description
#  The four offices Pillar 3 already instantiated (Registrar, OSAS,
#  Guidance Office, Security Management Office) are REUSED by URI
#  here rather than redefined.
#################################################################

@prefix lspuadm:  <http://lspu.edu.ph/ontology/admission#> .
@prefix lspu:     <http://lspu.edu.ph/ontology/handbook#> .
@prefix lspuprog: <http://lspu.edu.ph/ontology/program#> .
@prefix owl:      <http://www.w3.org/2002/07/owl#> .
@prefix rdf:      <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:     <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:      <http://www.w3.org/2001/XMLSchema#> .

<http://lspu.edu.ph/ontology/admission> a owl:Ontology ;
    rdfs:label "LSPU-LB Admission & Transaction Procedures / Citizen's Charter Ontology" ;
    rdfs:comment "Domain ontology for a student-facing RAG knowledge graph covering LSPU's RA 11032 Citizen's Charter: the university-wide catalog of frontline and non-frontline services, their classification, fees, requirements, and step-by-step procedures." .

#################################################################
#  CLASSES
#################################################################

lspuadm:Service a owl:Class ;
    rdfs:label "Service" ;
    rdfs:comment "A single transaction a client (student, applicant, employee, or external party) can avail from an LSPU office, as published in the Citizen's Charter (e.g. 'Enrollment', 'Issuance of Transcript of Records')." .

lspuadm:ServiceCategory a owl:Class ;
    rdfs:label "Service Category" ;
    rdfs:comment "RA 11032's own service classification -- Simple, Complex, or Highly Technical -- which legally determines the maximum processing time." .

lspuadm:TransactionType a owl:Class ;
    rdfs:label "Transaction Type" ;
    rdfs:comment "The client-government relationship for a service: G2C (Government to Citizen), G2G (Government to Government), G2B (Government to Business), or Internal." .

lspuadm:ServiceStep a owl:Class ;
    rdfs:subClassOf lspu:ProcedureStep ;
    rdfs:label "Service Step" ;
    rdfs:comment "One ordered step in availing a Service, following the same hasStep/nextStep chain pattern as lspu:Procedure, but additionally carrying the client action, agency action, fee, and processing time recorded on the Charter's step table." .

lspuadm:Channel a owl:Class ;
    rdfs:label "Channel" ;
    rdfs:comment "How a service is availed: walk-in, online portal/app, or email, where the Charter specifies this explicitly." .

lspuadm:EntranceExam a owl:Class ;
    rdfs:subClassOf lspuadm:Service ;
    rdfs:comment "A standardized admission test a student-applicant must take as part of an admission Service (e.g. the LSPU Entrance Examination administered by the Guidance Office). Links a Pillar 2 transaction to the Pillar 1 lspuprog:AdmissionRequirement it feeds." .

#################################################################
#  OBJECT PROPERTIES
#################################################################

lspuadm:availedAt a owl:ObjectProperty ;
    rdfs:domain lspuadm:Service ; rdfs:range lspu:Office ;
    rdfs:label "availedAt" ;
    rdfs:comment "The office or division that administers this Service." .

lspuadm:hasCategory a owl:ObjectProperty ;
    rdfs:domain lspuadm:Service ; rdfs:range lspuadm:ServiceCategory ;
    rdfs:label "hasCategory" .

lspuadm:hasTransactionType a owl:ObjectProperty ;
    rdfs:domain lspuadm:Service ; rdfs:range lspuadm:TransactionType ;
    rdfs:label "hasTransactionType" .

lspuadm:hasChannel a owl:ObjectProperty ;
    rdfs:domain lspuadm:Service ; rdfs:range lspuadm:Channel ;
    rdfs:label "hasChannel" .

lspuadm:feedsAdmissionRequirement a owl:ObjectProperty ;
    rdfs:domain lspuadm:EntranceExam ; rdfs:range lspuprog:AdmissionRequirement ;
    rdfs:label "feedsAdmissionRequirement" ;
    rdfs:comment "Links an entrance-exam Service (Pillar 2) to the program-specific cutoff/requirement it is used to evaluate (Pillar 1). Not yet populated with real per-program cutoffs -- see lspuprog:AdmissionRequirement's own note." .

#################################################################
#  DATATYPE PROPERTIES
#################################################################

lspuadm:classificationText a owl:DatatypeProperty ;
    rdfs:domain lspuadm:Service ; rdfs:range xsd:string ;
    rdfs:comment "Verbatim classification text as printed in the Charter, kept alongside the normalized lspuadm:hasCategory link(s) in case of compound/conditional classifications (e.g. 'Simple for active employees, Complex for inactive')." .

lspuadm:whoMayAvail a owl:DatatypeProperty ;
    rdfs:domain lspuadm:Service ; rdfs:range xsd:string ;
    rdfs:comment "Verbatim 'Who may avail' text from the Charter. Kept as free text rather than forced into lspu:StudentType, since many services are also open to faculty, employees, alumni, or external parties." .

lspuadm:clientAction a owl:DatatypeProperty ;
    rdfs:domain lspuadm:ServiceStep ; rdfs:range xsd:string ;
    rdfs:comment "What the client does at this step (the Charter's 'Client Steps' column)." .

lspuadm:agencyAction a owl:DatatypeProperty ;
    rdfs:domain lspuadm:ServiceStep ; rdfs:range xsd:string ;
    rdfs:comment "What the office does at this step (the Charter's 'Agency Actions' column)." .

lspuadm:hasFeeText a owl:DatatypeProperty ;
    rdfs:domain lspuadm:ServiceStep ; rdfs:range xsd:string ;
    rdfs:comment "Fee charged at this step, verbatim (e.g. 'P75.00/page', 'None')." .

lspuadm:hasProcessingTime a owl:DatatypeProperty ;
    rdfs:domain lspuadm:ServiceStep ; rdfs:range xsd:string ;
    rdfs:comment "Processing time for this step, verbatim (e.g. '5 minutes', '1-3 days')." .

lspuadm:totalProcessingTime a owl:DatatypeProperty ;
    rdfs:domain lspuadm:Service ; rdfs:range xsd:string ;
    rdfs:comment "The Charter's stated TOTAL processing time across all steps of the Service." .

lspuadm:totalFeeText a owl:DatatypeProperty ;
    rdfs:domain lspuadm:Service ; rdfs:range xsd:string ;
    rdfs:comment "The Charter's stated TOTAL fee across all steps of the Service." .

lspuadm:formCode a owl:DatatypeProperty ;
    rdfs:domain lspu:Document ; rdfs:range xsd:string ;
    rdfs:comment "Internal LSPU form code for a requirement document, where the Charter gives one (e.g. 'LSPU-REG-SF-011')." .

lspuadm:sourceDocument a owl:DatatypeProperty ;
    rdfs:domain lspuadm:Service ; rdfs:range xsd:string ;
    rdfs:comment "Which edition of the Citizen's Charter this Service was transcribed from. Mirrors lspuprog:sourceDocument (Pillar 1) and lspu:sourceArticle (Pillar 3) so a RAG answer can always cite which source document a fact came from." .

lspuadm:sourceSection a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:comment "The office/division section (and page number, where captured during extraction) within the Citizen's Charter where this Service -- or, for the flagship fully-populated services, this individual ServiceStep -- is printed, e.g. 'I. Office of the Registrar, p. 2' or 'I. Office of the Registrar, Service 1: Enrollment, Step 2, p. 3'." .

#################################################################
#  INDIVIDUALS -- SERVICE CATEGORY (RA 11032 classification tiers)
#################################################################

lspuadm:Cat_Simple a lspuadm:ServiceCategory ; rdfs:label "Simple" .
lspuadm:Cat_Complex a lspuadm:ServiceCategory ; rdfs:label "Complex" .
lspuadm:Cat_HighlyTechnical a lspuadm:ServiceCategory ; rdfs:label "Highly Technical" .
lspuadm:Cat_External a lspuadm:ServiceCategory ;
    rdfs:label "External" ;
    rdfs:comment "As printed for the Library's three services in the source Charter. RA 11032 itself only defines Simple/Complex/Highly Technical; 'External' appears to describe the client type rather than a processing-time tier. Preserved verbatim pending clarification against the source document; do not treat as a fourth RA 11032 tier." .
lspuadm:Cat_Unspecified a lspuadm:ServiceCategory ; rdfs:label "Unspecified" .

#################################################################
#  INDIVIDUALS -- TRANSACTION TYPE
#################################################################

lspuadm:TT_G2C a lspuadm:TransactionType ; rdfs:label "G2C -- Government to Citizen" .
lspuadm:TT_G2G a lspuadm:TransactionType ; rdfs:label "G2G -- Government to Government" .
lspuadm:TT_G2B a lspuadm:TransactionType ; rdfs:label "G2B -- Government to Business" .
lspuadm:TT_Internal a lspuadm:TransactionType ; rdfs:label "Internal" .
lspuadm:TT_Unspecified a lspuadm:TransactionType ; rdfs:label "Unspecified" .

#################################################################
#  INDIVIDUALS -- CHANNEL
#################################################################

lspuadm:Channel_WalkIn a lspuadm:Channel ; rdfs:label "Walk-in" .
lspuadm:Channel_Online a lspuadm:Channel ; rdfs:label "Online" .
lspuadm:Channel_Email a lspuadm:Channel ; rdfs:label "Email" .

#################################################################
#  OFFICE INSTANCES (new offices introduced by Pillar 2; offices
#  already defined in Pillar 3 -- Registrar, Guidance, OSAS,
#  Security Management -- are REUSED by URI, not redefined here)
#################################################################

lspuadm:Office_Accounting a lspu:Office ; rdfs:label "Accounting" .
lspuadm:Office_AlumniAffairsAndPlacementServices a lspu:Office ; rdfs:label "Alumni Affairs and Placement Services" .
lspuadm:Office_BidsAndAwardsCommitteeSecretariat a lspu:Office ; rdfs:label "Bids and Awards Committee Secretariat" .
lspuadm:Office_BudgetOffice a lspu:Office ; rdfs:label "Budget Office" .
lspuadm:Office_BusinessAffairsOffice a lspu:Office ; rdfs:label "Business Affairs Office" .
lspuadm:Office_CIET a lspu:Office ; rdfs:label "CIET" .
lspuadm:Office_CIETITSO a lspu:Office ; rdfs:label "CIET & ITSO" .
lspuadm:Office_Cashier a lspu:Office ; rdfs:label "Cashier" .
lspuadm:Office_Colleges a lspu:Office ; rdfs:label "Colleges" .
lspuadm:Office_GenderAndDevelopment a lspu:Office ; rdfs:label "Gender and Development" .
lspuadm:Office_GeneralServicesUnit a lspu:Office ; rdfs:label "General Services Unit" .
lspuadm:Office_HumanResourceManagementOffice a lspu:Office ; rdfs:label "Human Resource Management Office" .
lspuadm:Office_InformationAndCommunicationsTechnologyServicesICTS a lspu:Office ; rdfs:label "Information and Communications Technology Services (ICTS)" .
lspuadm:Office_IntellectualPropertyTechnologyBusinessManagement a lspu:Office ; rdfs:label "Intellectual Property Technology Business Management" .
lspuadm:Office_InternalAuditUnit a lspu:Office ; rdfs:label "Internal Audit Unit" .
lspuadm:Office_InternationalAffairsOffice a lspu:Office ; rdfs:label "International Affairs Office" .
lspuadm:Office_LSPUInformationOffice a lspu:Office ; rdfs:label "LSPU Information Office" .
lspuadm:Office_LegalServicesUnit a lspu:Office ; rdfs:label "Legal Services Unit" .
lspuadm:Office_Library a lspu:Office ; rdfs:label "Library" .
lspuadm:Office_ManagementInformationSystem a lspu:Office ; rdfs:label "Management information system" .
lspuadm:Office_NationalServiceTrainingProgram a lspu:Office ; rdfs:label "National Service Training Program" .
lspuadm:Office_OfficeOfTheCampusDirector a lspu:Office ; rdfs:label "Office of the Campus Director" .
lspuadm:Office_OfficeOfTheUniversityBoardSecretary a lspu:Office ; rdfs:label "Office of the University Board Secretary" .
lspuadm:Office_OfficeOfTheUniversityPresident a lspu:Office ; rdfs:label "Office of the University President" .
lspuadm:Office_PlanningAndDevelopmentOfficePDO a lspu:Office ; rdfs:label "Planning and Development Office (PDO)" .
lspuadm:Office_ProcurementUnit a lspu:Office ; rdfs:label "Procurement Unit" .
lspuadm:Office_ProjectManagementOffice a lspu:Office ; rdfs:label "Project Management Office" .
lspuadm:Office_QualityAssuranceOffice a lspu:Office ; rdfs:label "Quality Assurance Office" .
lspuadm:Office_RDCIETATBI a lspu:Office ; rdfs:label "RD/CIET/ATBI" .
lspuadm:Office_RecordsManagementOffice a lspu:Office ; rdfs:label "Records Management Office" .
lspuadm:Office_ResearchAndDevelopment a lspu:Office ; rdfs:label "Research and Development" .
lspuadm:Office_SCO a lspu:Office ; rdfs:label "SCO" .
lspuadm:Office_ScholarshipAndFinancialAssistanceUnit a lspu:Office ; rdfs:label "Scholarship and Financial Assistance Unit" .
lspuadm:Office_SupplyAndPropertyManagementUnit a lspu:Office ; rdfs:label "Supply and Property Management Unit" .
lspuadm:Office_UDRRMO a lspu:Office ; rdfs:label "UDRRMO" .
lspuadm:Office_UniversityHealthService a lspu:Office ; rdfs:label "University Health Service" .
#################################################################
#  FLAGSHIP SERVICES -- FULLY POPULATED (office, classification,
#  transaction type, who-may-avail, requirement documents, and the
#  complete client-step / agency-action / fee / processing-time /
#  person-responsible chain from the Charter's tables)
#################################################################

#-----------------------------------------------------------------
#  I. OFFICE OF THE REGISTRAR -- 1. Enrollment
#-----------------------------------------------------------------

lspuadm:Serv_Enrollment a lspuadm:Service ;
    rdfs:label "Enrollment" ;
    lspu:definition "Assists the public in the enrollment procedures each semester." ;
    lspuadm:availedAt lspu:OfficeOfTheRegistrar ;
    lspuadm:hasCategory lspuadm:Cat_Simple ;
    lspuadm:classificationText "Simple" ;
    lspuadm:hasTransactionType lspuadm:TT_G2C, lspuadm:TT_G2G ;
    lspuadm:whoMayAvail "All" ;
    lspu:requiresDocument lspuadm:Doc_EnrolmentSlip, lspuadm:Doc_GoodMoralCharacter,
        lspuadm:Doc_ReportCard, lspuadm:Doc_PSABirthCertificate, lspuadm:Doc_Form137,
        lspuadm:Doc_MedicalSlip, lspuadm:Doc_TORForEvaluation, lspuadm:Doc_2x2Picture,
        lspuadm:Doc_CertificateOfTransfer, lspuadm:Doc_LongBrownEnvelope,
        lspuadm:Doc_Clearance, lspuadm:Doc_StudentID ;
    lspu:hasStep lspuadm:Enroll_Step1 ;
    lspuadm:totalProcessingTime "20 minutes (fees vary per assessment form)" ;
    lspuadm:sourceDocument "LSPU Citizen's Charter, 2026 1st Edition (University-Wide)" ;
    lspuadm:sourceSection "I. Office of the Registrar, Service 1: Enrollment, p. 2" .

lspuadm:Doc_EnrolmentSlip a lspu:Document ; rdfs:label "Enrolment Slip from Admission Office (new students/transferees)" ; lspu:definition "Secured from the Admission Office." .
lspuadm:Doc_GoodMoralCharacter a lspu:Document ; rdfs:label "Original Certificate of Good Moral Character" ; lspu:definition "Secured from the school previously attended/graduated from." .
lspuadm:Doc_ReportCard a lspu:Document ; rdfs:label "Original Report Card (new students only)" ; lspu:definition "Secured from the school previously attended/graduated from." .
lspuadm:Doc_PSABirthCertificate a lspu:Document ; rdfs:label "Photocopy of PSA Birth Certificate / Marriage Contract (for married female students)" ; lspu:definition "Secured from the PSA office." .
lspuadm:Doc_Form137 a lspu:Document ; rdfs:label "Original/authenticated Form 137 (new students only)" ; lspu:definition "Secured from the school previously attended/graduated from." .
lspuadm:Doc_MedicalSlip a lspu:Document ; rdfs:label "Medical slip/Certificate from LSPU Medical Clinic" ; lspu:definition "Secured from an accredited DOH facility." .
lspuadm:Doc_TORForEvaluation a lspu:Document ; rdfs:label "Transcript of Records/Copy of Grades for evaluation purposes (transferees only)" ; lspu:definition "Secured from the school previously attended/graduated from." .
lspuadm:Doc_2x2Picture a lspu:Document ; rdfs:label "2 pcs 2x2 ID picture" ; lspu:definition "Supplied by the client." .
lspuadm:Doc_CertificateOfTransfer a lspu:Document ; rdfs:label "Original Certificate of Transfer (transferees only)" .
lspuadm:Doc_LongBrownEnvelope a lspu:Document ; rdfs:label "1 pc. long brown envelope" .
lspuadm:Doc_Clearance a lspu:Document ; rdfs:label "Clearance (old students)" ; lspu:definition "Secured from the Accounting Office." .
lspuadm:Doc_StudentID a lspu:Document ; rdfs:label "Student ID (old students)" ; lspu:definition "Secured from OSAS." .

lspuadm:Enroll_Step1 a lspuadm:ServiceStep ;
    rdfs:label "Step 1: Submission of enrolment requirements / subject enlistment" ;
    lspuadm:clientAction "New college students and transferees proceed to the Office of the Registrar on the scheduled appointment date to submit the hard copy of enrolment requirements. New GSAR students likewise submit requirements plus a Pre-Enrolment Form from the Dean's Office. All old college students and old GSAR students log in to the Student Web Portal and enlist the subjects to be enrolled." ;
    lspuadm:agencyAction "Validates the authenticity of the submitted hard-copy enrolment requirements; enlists subjects to the system and issues a request for SF10/F137 (new students), or evaluates and credits subjects for GSAR students, or evaluates and finalizes the enlisted subjects for old students on the Student Web Portal." ;
    lspuadm:hasFeeText "None" ;
    lspuadm:hasProcessingTime "8 minutes (new/transferee/GSAR); 3 minutes (old students, web portal)" ;
    lspu:performedBy lspuadm:Role_RegistrarStaff ;
    lspu:nextStep lspuadm:Enroll_Step2 ;
    lspuadm:sourceSection "I. Office of the Registrar, Service 1: Enrollment, Step 1, p. 2" .

lspuadm:Enroll_Step2 a lspuadm:ServiceStep ;
    rdfs:label "Step 2: Assessment of fees" ;
    lspuadm:clientAction "Students not qualified for Free Higher Education, students with enrolled RLE subjects, Opt-out, CTP/Foreign, or GSAR students proceed to the Accounting Office on the scheduled appointment for assessment of fees." ;
    lspuadm:agencyAction "Assesses tuition and other school fees." ;
    lspuadm:hasFeeText "None" ;
    lspuadm:hasProcessingTime "3 minutes" ;
    lspu:performedBy lspuadm:Role_AccountingStaff ;
    lspu:nextStep lspuadm:Enroll_Step3 ;
    lspuadm:sourceSection "I. Office of the Registrar, Service 1: Enrollment, Step 2, p. 3" .

lspuadm:Enroll_Step3 a lspuadm:ServiceStep ;
    rdfs:label "Step 3: Payment of fees" ;
    lspuadm:clientAction "Proceeds to the Cashier's Office to pay fees." ;
    lspuadm:agencyAction "Receives payment and issues official receipt." ;
    lspuadm:hasFeeText "Fees reflected on the assessment form" ;
    lspuadm:hasProcessingTime "3 minutes" ;
    lspu:nextStep lspuadm:Enroll_Step4 ;
    lspuadm:sourceSection "I. Office of the Registrar, Service 1: Enrollment, Step 3, p. 3" .

lspuadm:Enroll_Step4 a lspuadm:ServiceStep ;
    rdfs:label "Step 4: Issuance of Certificate of Registration (COR)" ;
    lspuadm:clientAction "New/old college students log in to the student portal to view the Certificate of Registration (COR); students who paid at the Cashier proceed to the Office of the Registrar to claim the printed COR." ;
    lspuadm:agencyAction "Issues Certificate of Registration (COR)." ;
    lspuadm:hasFeeText "None" ;
    lspuadm:hasProcessingTime "3 minutes (view online) / 20 minutes (claim printed copy)" ;
    lspu:performedBy lspuadm:Role_RegistrarStaff ;
    lspuadm:sourceSection "I. Office of the Registrar, Service 1: Enrollment, Step 4, p. 3" .

#-----------------------------------------------------------------
#  I. OFFICE OF THE REGISTRAR -- 2. Issuance of Transcript of
#     Records/Transfer Credentials/Certifications/CAV/Authenticated
#     Documents
#-----------------------------------------------------------------

lspuadm:Serv_IssuanceOfTORAndCredentials a lspuadm:Service ;
    rdfs:label "Issuance of Transcript of Records/Transfer Credentials/Certifications/CAV/Authenticated Documents" ;
    lspu:definition "Assists the public in requesting and claiming a transcript of records, transfer credentials, certifications, CAV, and authenticated documents." ;
    lspuadm:availedAt lspu:OfficeOfTheRegistrar ;
    lspuadm:hasCategory lspuadm:Cat_Simple ;
    lspuadm:classificationText "Simple" ;
    lspuadm:hasTransactionType lspuadm:TT_G2C, lspuadm:TT_G2G ;
    lspuadm:whoMayAvail "All (Walk-in students & Graduates)" ;
    lspu:requiresDocument lspuadm:Doc_ClearanceRequestForm ;
    lspu:hasStep lspuadm:TOR_Step1 ;
    lspuadm:totalProcessingTime "Active files: 59 minutes. Inactive files: 1 day, 44 minutes." ;
    lspuadm:sourceDocument "LSPU Citizen's Charter, 2026 1st Edition (University-Wide)" ;
    lspuadm:sourceSection "I. Office of the Registrar, Service 2: Issuance of TOR/Transfer Credentials/Certifications/CAV/Authenticated Documents, p. 4" .

lspuadm:Doc_ClearanceRequestForm a lspu:Document ;
    rdfs:label "Clearance and Request Form (LSPU-REG-SF-011)" ;
    lspuadm:formCode "LSPU-REG-SF-011" ;
    lspu:definition "Secured from the Accounting Office/Office of the Registrar; requires signatures of heads of responsible offices for undergraduates." .

lspuadm:TOR_Step1 a lspuadm:ServiceStep ;
    rdfs:label "Step 1: Fill out and endorse request slip" ;
    lspuadm:clientAction "Undergraduate students fill out the request slip (LSPU-REG-SF-011) with clearance and secure signatures of heads of responsible offices; graduates fill out the same request slip." ;
    lspuadm:agencyAction "Issues request slip (LSPU-REG-SF-011); reviews and checks the accomplished request against the student's clearance; assesses the corresponding fees of the requested documents." ;
    lspuadm:hasFeeText "None" ;
    lspuadm:hasProcessingTime "5 minutes" ;
    lspu:performedBy lspuadm:Role_RegistrarStaff ;
    lspu:nextStep lspuadm:TOR_Step2 ;
    lspuadm:sourceSection "I. Office of the Registrar, Service 2: Issuance of TOR/Transfer Credentials/Certifications/CAV/Authenticated Documents, Step 1, p. 4" .

lspuadm:TOR_Step2 a lspuadm:ServiceStep ;
    rdfs:label "Step 2: Pay required fees" ;
    lspuadm:clientAction "Proceeds to the Cashier's Office to pay the required fees." ;
    lspuadm:agencyAction "Receives payment and issues official receipt." ;
    lspuadm:hasFeeText "Transcript of Records: P75.00/page (undergraduate), P150.00/page (graduate). Certifications: P30.00/page (Copy of Grades, F137, CAV, Certificate of Transfer, General Weighted Average, Subject Description, SPES, Permit to Study). Authentication: P30.00/page. 2nd copy of Diploma: P100.00." ;
    lspuadm:hasProcessingTime "2 minutes" ;
    lspu:nextStep lspuadm:TOR_Step3 ;
    lspuadm:sourceSection "I. Office of the Registrar, Service 2: Issuance of TOR/Transfer Credentials/Certifications/CAV/Authenticated Documents, Step 2, p. 4" .

lspuadm:TOR_Step3 a lspuadm:ServiceStep ;
    rdfs:label "Step 3: Submit receipt and request slip; receive claim stub; document preparation" ;
    lspuadm:clientAction "Submits the filled-out request slip and official receipt of payment and gets the claim stub with date of release." ;
    lspuadm:agencyAction "Receives and reviews the presented receipt and request slip; schedules the date of release; issues claim stub; locates the permanent record of the student concerned; prepares and encodes the requested document; reviews and countercheck entries on the prepared draft; prints the final document; affixes the college seal; signs the document." ;
    lspuadm:hasFeeText "None" ;
    lspuadm:hasProcessingTime "Inactive files: 1 day. Active files: 15 minutes (locate record) + 25 minutes (prepare/encode) + 5 minutes (review) + 1 minute (final printing) + 1 minute (affix seal) + 1 minute (sign) = 25 minutes typical / up to 59 minutes total service time" ;
    lspu:performedBy lspuadm:Role_RegistrarStaff ;
    lspu:nextStep lspuadm:TOR_Step4 ;
    lspuadm:sourceSection "I. Office of the Registrar, Service 2: Issuance of TOR/Transfer Credentials/Certifications/CAV/Authenticated Documents, Step 3, p. 5" .

lspuadm:TOR_Step4 a lspuadm:ServiceStep ;
    rdfs:label "Step 4: Claim requested document" ;
    lspuadm:clientAction "Claims the requested document on the scheduled date indicated on the claim stub." ;
    lspuadm:agencyAction "Records and releases the document." ;
    lspuadm:hasFeeText "None" ;
    lspuadm:hasProcessingTime "2 minutes" ;
    lspu:performedBy lspuadm:Role_RegistrarStaff ;
    lspuadm:sourceSection "I. Office of the Registrar, Service 2: Issuance of TOR/Transfer Credentials/Certifications/CAV/Authenticated Documents, Step 4, p. 6" .

#-----------------------------------------------------------------
#  II. OFFICE OF THE CASHIER -- 1. Collection of Fees (Online basis)
#-----------------------------------------------------------------

lspuadm:Serv_CollectionOfFeesOnlineBasis a lspuadm:Service ;
    rdfs:label "Collection of Fees Online basis" ;
    lspu:definition "Process for the online collection of student and other fees via the LandBank LinkBiz Portal." ;
    lspuadm:availedAt lspuadm:Office_Cashier ;
    lspuadm:hasCategory lspuadm:Cat_Simple ;
    lspuadm:classificationText "Simple" ;
    lspuadm:hasTransactionType lspuadm:TT_G2C ;
    lspuadm:hasChannel lspuadm:Channel_Online ;
    lspuadm:whoMayAvail "All" ;
    lspu:requiresDocument lspuadm:Doc_SchoolIDOrAssessment ;
    lspu:hasStep lspuadm:CashierOnline_Step1 ;
    lspuadm:totalFeeText "Php 7.00 (LandBank LinkBiz convenience fee)" ;
    lspuadm:totalProcessingTime "2 days, 5 minutes, 10 seconds (dominated by 1-2 banking days for payment verification)" ;
    lspuadm:sourceDocument "LSPU Citizen's Charter, 2026 1st Edition (University-Wide)" ;
    lspuadm:sourceSection "II. Office of the Cashier, Service 1: Collection of Fees Online basis, p. 7" .

lspuadm:Doc_SchoolIDOrAssessment a lspu:Document ;
    rdfs:label "School ID or Registration Card / Assessment of Fees (students)" ;
    lspu:definition "Secured from the client (students), Registrar, or Accounting Office." .

lspuadm:CashierOnline_Step1 a lspuadm:ServiceStep ;
    rdfs:label "Step 1: Access the LandBank LinkBiz Portal" ;
    lspuadm:clientAction "Client (student or outsider) visits the LandBank LinkBiz Portal via mobile phone or PC." ;
    lspuadm:hasFeeText "None" ;
    lspuadm:hasProcessingTime "None specified" ;
    lspu:nextStep lspuadm:CashierOnline_Step2 ;
    lspuadm:sourceSection "II. Office of the Cashier, Service 1: Collection of Fees Online basis, Step 1, p. 7" .

lspuadm:CashierOnline_Step2 a lspuadm:ServiceStep ;
    rdfs:label "Step 2: Fill out payment form" ;
    lspuadm:clientAction "Client fills out the given form with complete and correct data." ;
    lspuadm:hasFeeText "None" ;
    lspuadm:hasProcessingTime "1 minute" ;
    lspu:nextStep lspuadm:CashierOnline_Step3 ;
    lspuadm:sourceSection "II. Office of the Cashier, Service 1: Collection of Fees Online basis, Step 2, p. 7" .

lspuadm:CashierOnline_Step3 a lspuadm:ServiceStep ;
    rdfs:label "Step 3: Select account and pay" ;
    lspuadm:clientAction "Client selects the account for debit and completes payment." ;
    lspuadm:hasFeeText "Php 7.00 per transaction" ;
    lspuadm:hasProcessingTime "1 minute" ;
    lspu:nextStep lspuadm:CashierOnline_Step4 ;
    lspuadm:sourceSection "II. Office of the Cashier, Service 1: Collection of Fees Online basis, Step 3, p. 7" .

lspuadm:CashierOnline_Step4 a lspuadm:ServiceStep ;
    rdfs:label "Step 4: Receive confirmation receipt" ;
    lspuadm:clientAction "Client receives a confirmation receipt and secures a copy to send to the collecting officer in charge." ;
    lspuadm:hasFeeText "None" ;
    lspuadm:hasProcessingTime "1 minute" ;
    lspu:nextStep lspuadm:CashierOnline_Step5 ;
    lspuadm:sourceSection "II. Office of the Cashier, Service 1: Collection of Fees Online basis, Step 4, p. 8" .

lspuadm:CashierOnline_Step5 a lspuadm:ServiceStep ;
    rdfs:label "Step 5: Send transaction receipt by email" ;
    lspuadm:clientAction "Client sends the transaction receipt through email." ;
    lspuadm:hasFeeText "None" ;
    lspuadm:hasProcessingTime "10 seconds" ;
    lspu:nextStep lspuadm:CashierOnline_Step6 ;
    lspuadm:sourceSection "II. Office of the Cashier, Service 1: Collection of Fees Online basis, Step 5, p. 8" .

lspuadm:CashierOnline_Step6 a lspuadm:ServiceStep ;
    rdfs:label "Step 6: Verify payment" ;
    lspuadm:agencyAction "Servicing bank verifies the validity and credit of payment." ;
    lspuadm:hasFeeText "None" ;
    lspuadm:hasProcessingTime "1-2 banking days; 1 minute once payment is received by the Cashier" ;
    lspu:performedBy lspuadm:Role_CollectionOfficer ;
    lspu:nextStep lspuadm:CashierOnline_Step7 ;
    lspuadm:sourceSection "II. Office of the Cashier, Service 1: Collection of Fees Online basis, Step 6, p. 8" .

lspuadm:CashierOnline_Step7 a lspuadm:ServiceStep ;
    rdfs:label "Step 7: Receive e-copy of official receipt" ;
    lspuadm:agencyAction "Collection Officer issues an e-copy of the LSPU official receipt to the client via email." ;
    lspuadm:hasFeeText "None" ;
    lspuadm:hasProcessingTime "1 minute" ;
    lspu:performedBy lspuadm:Role_CollectionOfficer ;
    lspuadm:sourceSection "II. Office of the Cashier, Service 1: Collection of Fees Online basis, Step 7, p. 8" .

lspuadm:Role_CollectionOfficer a lspu:UniversityRole ; rdfs:label "Collection Officer (Cashier)" .

#-----------------------------------------------------------------
#  XXIV. GUIDANCE OFFICE -- 1. LSPU Entrance Examination
#  (feeds lspuprog:AdmissionRequirement / lspuprog:Program admission)
#-----------------------------------------------------------------

lspuadm:Serv_LSPUEntranceExamination a lspuadm:Service, lspuadm:EntranceExam ;
    rdfs:label "LSPU Entrance Examination (LSPUCET)" ;
    lspu:definition "Testing service for student admission: orientation, administration, and release of results of the college entrance examination." ;
    lspuadm:availedAt lspu:GuidanceOffice ;
    lspuadm:hasCategory lspuadm:Cat_Simple ;
    lspuadm:classificationText "Simple" ;
    lspuadm:hasTransactionType lspuadm:TT_G2C ;
    lspuadm:whoMayAvail "Student-applicants" ;
    lspu:requiresDocument lspuadm:Doc_OnlineApplicationForm, lspuadm:Doc_CTCReportCardOrTOR ;
    lspu:hasStep lspuadm:LSPUCET_Step1 ;
    lspuadm:totalFeeText "None (N/A)" ;
    lspuadm:totalProcessingTime "1-3 days, 1 hour and 45 minutes" ;
    lspuadm:sourceDocument "LSPU Citizen's Charter, 2026 1st Edition (University-Wide)" ;
    lspuadm:sourceSection "B.XXIV. Guidance Office, Service 1: LSPU Entrance Examination, p. 72" ;
    lspuadm:feedsAdmissionRequirement lspuprog:AdmissionRequirement,
        lspuprog:AdmReq_BEEd, lspuprog:AdmReq_BPE, lspuprog:AdmReq_BSA,
        lspuprog:AdmReq_BSBA_FM, lspuprog:AdmReq_BSBA_MM, lspuprog:AdmReq_BSCS_IS,
        lspuprog:AdmReq_BSCrim, lspuprog:AdmReq_BSEd_English, lspuprog:AdmReq_BSEd_Filipino,
        lspuprog:AdmReq_BSEd_Math, lspuprog:AdmReq_BSEd_Sciences, lspuprog:AdmReq_BSEd_SocialStudies,
        lspuprog:AdmReq_BSFisheries, lspuprog:AdmReq_BSFoodTech, lspuprog:AdmReq_BSHospitalityManagement,
        lspuprog:AdmReq_BSIT_AMG, lspuprog:AdmReq_BSIT_SM, lspuprog:AdmReq_BSIT_WMAD,
        lspuprog:AdmReq_BSNutritionDietetics, lspuprog:AdmReq_BSPsych, lspuprog:AdmReq_BSTourismManagement,
        lspuprog:AdmReq_BTLE_HE, lspuprog:AdmReq_BTVTE_FSM ;
    rdfs:comment "The Charter describes one entrance-exam PROCESS shared by all programs; the per-program pass/cutoff VALUE for each of these 23 lspuprog:AdmReq_* instances lives in Pillar 1 (LSPU Admission Guidelines, Annex A), not in the Charter." .

lspuadm:Doc_OnlineApplicationForm a lspu:Document ; rdfs:label "Online application form" ; lspu:definition "Submitted via LSPU Online Admission." .
lspuadm:Doc_CTCReportCardOrTOR a lspu:Document ; rdfs:label "Certified True Copy of Report Card and/or Transcript of Records" ; lspu:definition "Supplied by the client." .

lspuadm:LSPUCET_Step1 a lspuadm:ServiceStep ;
    rdfs:label "Step 1: Orientation" ;
    lspuadm:agencyAction "Informs clients about the college entrance examination (flow, timing)." ;
    lspuadm:hasFeeText "N/A" ;
    lspuadm:hasProcessingTime "15 minutes" ;
    lspu:performedBy lspuadm:Role_GuidanceStaff ;
    lspu:nextStep lspuadm:LSPUCET_Step2 ;
    lspuadm:sourceSection "B.XXIV. Guidance Office, Service 1: LSPU Entrance Examination, Step 1, p. 72" .

lspuadm:LSPUCET_Step2 a lspuadm:ServiceStep ;
    rdfs:label "Step 2: Examination proper" ;
    lspuadm:agencyAction "Monitoring of the desktop/testing area during the examination." ;
    lspuadm:hasFeeText "N/A" ;
    lspuadm:hasProcessingTime "1 and 1/2 hours" ;
    lspu:performedBy lspuadm:Role_GuidanceStaff ;
    lspu:nextStep lspuadm:LSPUCET_Step3 ;
    lspuadm:sourceSection "B.XXIV. Guidance Office, Service 1: LSPU Entrance Examination, Step 2, p. 72" .

lspuadm:LSPUCET_Step3 a lspuadm:ServiceStep ;
    rdfs:label "Step 3: Release of examination result" ;
    lspuadm:agencyAction "Issuance of the official result to examinees." ;
    lspuadm:hasFeeText "N/A" ;
    lspuadm:hasProcessingTime "1-3 days" ;
    lspu:performedBy lspuadm:Role_GuidanceStaff ;
    lspuadm:sourceSection "B.XXIV. Guidance Office, Service 1: LSPU Entrance Examination, Step 3, p. 73" .

lspuadm:Role_GuidanceStaff a lspu:UniversityRole ; rdfs:label "Guidance Staff" .

#-----------------------------------------------------------------
#  XXIV. GUIDANCE OFFICE -- 2. Appraisal
#-----------------------------------------------------------------

lspuadm:Serv_Appraisal a lspuadm:Service ;
    rdfs:label "Appraisal" ;
    lspu:definition "Administration and interpretation of psychological/aptitude appraisal instruments." ;
    lspuadm:availedAt lspu:GuidanceOffice ;
    lspuadm:hasCategory lspuadm:Cat_Simple ;
    lspuadm:classificationText "Simple" ;
    lspuadm:hasTransactionType lspuadm:TT_G2G, lspuadm:TT_G2C ;
    lspuadm:whoMayAvail "Students, Faculty, Non-Teaching, Job Applicants" ;
    lspu:requiresDocument lspuadm:Doc_DataPrivacyConsent, lspuadm:Doc_GuidanceIDCard ;
    lspu:hasStep lspuadm:Appraisal_Step1 ;
    lspuadm:totalFeeText "None" ;
    lspuadm:totalProcessingTime "3 days, 4 hours and 5 minutes" ;
    lspuadm:sourceDocument "LSPU Citizen's Charter, 2026 1st Edition (University-Wide)" ;
    lspuadm:sourceSection "B.XXIV. Guidance Office, Service 2: Appraisal, p. 73" .

lspuadm:Doc_DataPrivacyConsent a lspu:Document ; rdfs:label "Data Privacy Consent" ; lspu:definition "Supplied by the client." .
lspuadm:Doc_GuidanceIDCard a lspu:Document ; rdfs:label "Identification Card" ; lspu:definition "Secured from Guidance and Counseling." .

lspuadm:Appraisal_Step1 a lspuadm:ServiceStep ;
    rdfs:label "Step 1: Endorsement, referral, or walk-in" ;
    lspuadm:agencyAction "Receives the endorsement, referral, or walk-in client; schedules the client." ;
    lspuadm:hasFeeText "n/a" ;
    lspuadm:hasProcessingTime "5 minutes" ;
    lspu:performedBy lspuadm:Role_GuidancePersonnel ;
    lspu:nextStep lspuadm:Appraisal_Step2 ;
    lspuadm:sourceSection "B.XXIV. Guidance Office, Service 2: Appraisal, Step 1, p. 73" .

lspuadm:Appraisal_Step2 a lspuadm:ServiceStep ;
    rdfs:label "Step 2: Administration of appraisal (examination proper)" ;
    lspuadm:agencyAction "Prepares testing materials (test booklet and answer sheet); conducts appraisal briefing including discussion of data privacy consent and test instructions." ;
    lspuadm:hasFeeText "n/a" ;
    lspuadm:hasProcessingTime "4 hours" ;
    lspu:performedBy lspuadm:Role_GuidancePersonnel ;
    lspu:nextStep lspuadm:Appraisal_Step3 ;
    lspuadm:sourceSection "B.XXIV. Guidance Office, Service 2: Appraisal, Step 2, p. 73" .

lspuadm:Appraisal_Step3 a lspuadm:ServiceStep ;
    rdfs:label "Step 3: Appraisal interpretation" ;
    lspuadm:agencyAction "Interpretation of tests and preparation of report." ;
    lspuadm:hasFeeText "n/a" ;
    lspuadm:hasProcessingTime "1-3 days" ;
    lspu:performedBy lspuadm:Role_GuidancePersonnel, lspu:Role_GuidanceCounselor ;
    lspuadm:sourceSection "B.XXIV. Guidance Office, Service 2: Appraisal, Step 3, p. 74" .

lspuadm:Role_GuidancePersonnel a lspu:UniversityRole ; rdfs:label "Guidance Personnel" .
lspuadm:Role_RegistrarStaff a lspu:UniversityRole ; rdfs:label "Registrar's Staff" .
lspuadm:Role_AccountingStaff a lspu:UniversityRole ; rdfs:label "Accounting Staff" .


#################################################################
#  FLAGSHIP SERVICES -- BATCH 2 (fully populated: office, category,
#  transaction type, who-may-avail, requirement documents, and the
#  complete client-step / agency-action / fee / processing-time /
#  person-responsible chain). This batch completes ALL remaining
#  Section A -- Frontline Services of the Citizen's Charter (Cashier,
#  Accounting, Security Management, Business Affairs/BAMPO, Health,
#  Library, OSAS, Scholarship & FA) except Research & Development and
#  Extension, which remain catalog-level.
#################################################################

#-----------------------------------------------------------------
#  II. OFFICE OF THE CASHIER -- 2. Releasing of Check
#-----------------------------------------------------------------

lspuadm:Serv_ReleasingOfCheck a lspuadm:Service ;
    rdfs:label "Releasing of Check" ;
    lspu:definition "Process for the releasing of checks to students, faculty, staff, suppliers, and other clients." ;
    lspuadm:availedAt lspuadm:Office_Cashier ;
    lspuadm:hasCategory lspuadm:Cat_Simple ; lspuadm:classificationText "Simple" ;
    lspuadm:hasTransactionType lspuadm:TT_G2C ;
    lspuadm:whoMayAvail "All" ;
    lspu:requiresDocument lspuadm:Doc_SchoolIDOrAssessment ;
    lspu:hasStep lspuadm:ReleaseCheck_Step1 ;
    lspuadm:totalFeeText "None" ; lspuadm:totalProcessingTime "3 minutes" ;
    lspuadm:sourceDocument "LSPU Citizen's Charter, 2026 1st Edition (University-Wide)" ;
    lspuadm:sourceSection "II. Office of the Cashier, Service 2: Releasing of Check, p. 8" .

lspuadm:ReleaseCheck_Step1 a lspuadm:ServiceStep ;
    rdfs:label "Step 1: Present ID for verification" ;
    lspuadm:clientAction "Needs to present School ID/Registration Card for students, faculty and staff." ;
    lspuadm:agencyAction "Cashier verifies if the claimant is the same payee." ;
    lspuadm:hasFeeText "None" ; lspuadm:hasProcessingTime "1 minute" ;
    lspu:performedBy lspuadm:Role_DisbursingOfficerClerk ;
    lspu:nextStep lspuadm:ReleaseCheck_Step2 ;
    lspuadm:sourceSection "II. Office of the Cashier, Service 2: Releasing of Check, Step 1, p. 8" .

lspuadm:ReleaseCheck_Step2 a lspuadm:ServiceStep ;
    rdfs:label "Step 2: Present official receipt (suppliers/other clients)" ;
    lspuadm:clientAction "Prepares official receipt for suppliers and other clients." ;
    lspuadm:agencyAction "Checks if the amount in the official receipt matches the amount in the check." ;
    lspuadm:hasFeeText "None" ; lspuadm:hasProcessingTime "1 minute" ;
    lspu:performedBy lspuadm:Role_DisbursingOfficerClerk ;
    lspu:nextStep lspuadm:ReleaseCheck_Step3 ;
    lspuadm:sourceSection "II. Office of the Cashier, Service 2: Releasing of Check, Step 2, p. 8" .

lspuadm:ReleaseCheck_Step3 a lspuadm:ServiceStep ;
    rdfs:label "Step 3: Receive check" ;
    lspuadm:clientAction "Client/Supplier is required to sign the disbursement voucher, ITR, and monitoring logbook presented." ;
    lspuadm:agencyAction "Receives checks." ;
    lspuadm:hasFeeText "None" ; lspuadm:hasProcessingTime "1 minute" ;
    lspu:performedBy lspuadm:Role_DisbursingOfficerClerk ;
    lspuadm:sourceSection "II. Office of the Cashier, Service 2: Releasing of Check, Step 3, p. 8" .

#-----------------------------------------------------------------
#  II. OFFICE OF THE CASHIER -- 3. Releasing of Cash
#-----------------------------------------------------------------

lspuadm:Serv_ReleasingOfCash a lspuadm:Service ;
    rdfs:label "Releasing of Cash" ;
    lspu:definition "Process for the releasing of cash to students, faculty, staff, and other clients." ;
    lspuadm:availedAt lspuadm:Office_Cashier ;
    lspuadm:hasCategory lspuadm:Cat_Simple ; lspuadm:classificationText "Simple" ;
    lspuadm:hasTransactionType lspuadm:TT_G2C ;
    lspuadm:whoMayAvail "All" ;
    lspu:requiresDocument lspuadm:Doc_SchoolIDOrAssessment ;
    lspu:hasStep lspuadm:ReleaseCash_Step1 ;
    lspuadm:totalFeeText "None" ; lspuadm:totalProcessingTime "2 minutes" ;
    lspuadm:sourceDocument "LSPU Citizen's Charter, 2026 1st Edition (University-Wide)" ;
    lspuadm:sourceSection "II. Office of the Cashier, Service 3: Releasing of Cash, p. 8" .

lspuadm:ReleaseCash_Step1 a lspuadm:ServiceStep ;
    rdfs:label "Step 1: Present ID for verification" ;
    lspuadm:clientAction "Needs to present School ID/Registration Card for students, faculty and staff; at least two (2) valid IDs required for non-employee clients." ;
    lspuadm:agencyAction "Clients are required to sign in the payroll; checks and counts the money before paying/releasing." ;
    lspuadm:hasFeeText "None" ; lspuadm:hasProcessingTime "1 minute" ;
    lspu:performedBy lspuadm:Role_DisbursingOfficerClerk ;
    lspu:nextStep lspuadm:ReleaseCash_Step2 ;
    lspuadm:sourceSection "II. Office of the Cashier, Service 3: Releasing of Cash, Step 1, p. 8" .

lspuadm:ReleaseCash_Step2 a lspuadm:ServiceStep ;
    rdfs:label "Step 2: Receive cash" ;
    lspuadm:clientAction "Receives the cash and counts it before leaving, as asked by the Cashier." ;
    lspuadm:agencyAction "Cashier asks the client to count the money before leaving." ;
    lspuadm:hasFeeText "None" ; lspuadm:hasProcessingTime "1 minute" ;
    lspu:performedBy lspuadm:Role_DisbursingOfficerClerk ;
    lspuadm:sourceSection "II. Office of the Cashier, Service 3: Releasing of Cash, Step 2, p. 8" .

lspuadm:Role_DisbursingOfficerClerk a lspu:UniversityRole ; rdfs:label "Disbursing Officer/Clerk" .

#-----------------------------------------------------------------
#  III. ACCOUNTING OFFICE -- 1. Request for Refund Payment
#-----------------------------------------------------------------

lspuadm:Serv_RequestForRefundPayment a lspuadm:Service ;
    rdfs:label "Request for Refund Payment" ;
    lspu:definition "Process for refund of payment." ;
    lspuadm:availedAt lspuadm:Office_Accounting ;
    lspuadm:hasCategory lspuadm:Cat_Simple ; lspuadm:classificationText "Simple" ;
    lspuadm:hasTransactionType lspuadm:TT_G2C ;
    lspuadm:whoMayAvail "All" ;
    lspu:requiresDocument lspuadm:Doc_IDRegFormOR ;
    lspu:hasStep lspuadm:Refund_Step1 ;
    lspuadm:totalFeeText "None" ; lspuadm:totalProcessingTime "2 minutes" ;
    lspuadm:sourceDocument "LSPU Citizen's Charter, 2026 1st Edition (University-Wide)" ;
    lspuadm:sourceSection "III. Accounting Office, Service 1: Request for Refund Payment, p. 9" .

lspuadm:Doc_IDRegFormOR a lspu:Document ; rdfs:label "ID, Registration Form, and Official Receipt" ; lspu:definition "Secured from the client/student, Registrar, and Cashier." .

lspuadm:Refund_Step1 a lspuadm:ServiceStep ;
    rdfs:label "Step 1: Present original OR, ID, registration form" ;
    lspuadm:clientAction "Presents the original OR, School ID, Registration Form, and 2 sets (photocopy) of the required documents." ;
    lspuadm:agencyAction "Verifies the correctness of the requirement; directs the student to submit." ;
    lspuadm:hasFeeText "None" ; lspuadm:hasProcessingTime "1 minute" ;
    lspu:performedBy lspuadm:Role_AdministrativeAideVI ;
    lspu:nextStep lspuadm:Refund_Step2 ;
    lspuadm:sourceSection "III. Accounting Office, Service 1: Request for Refund Payment, Step 1, p. 9" .

lspuadm:Refund_Step2 a lspuadm:ServiceStep ;
    rdfs:label "Step 2: Submit verified documents" ;
    lspuadm:clientAction "Submits the verified documents." ;
    lspuadm:agencyAction "Stamps the documents as 'certified true copy' by the Record Officer or authorized representative; prepares voucher for payment of refund; informs the student to claim the refund after 2 days." ;
    lspuadm:hasFeeText "None" ; lspuadm:hasProcessingTime "1 minute" ;
    lspu:performedBy lspuadm:Role_AdministrativeAideVI ;
    lspuadm:sourceSection "III. Accounting Office, Service 1: Request for Refund Payment, Step 2, p. 9" .

lspuadm:Role_AdministrativeAideVI a lspu:UniversityRole ; rdfs:label "Administrative Aide VI" .

#-----------------------------------------------------------------
#  III. ACCOUNTING OFFICE -- 2. Assessment of Fees
#-----------------------------------------------------------------

lspuadm:Serv_AssessmentOfFees a lspuadm:Service ;
    rdfs:label "Assessment of Fees" ;
    lspu:definition "Covers the procedure from checking the completeness of entry in the registration form up to the assessment of fees." ;
    lspuadm:availedAt lspuadm:Office_Accounting ;
    lspuadm:hasCategory lspuadm:Cat_Simple ; lspuadm:classificationText "Simple" ;
    lspuadm:hasTransactionType lspuadm:TT_G2C ;
    lspuadm:whoMayAvail "All" ;
    lspu:requiresDocument lspuadm:Doc_EnrolmentStubRegForm, lspuadm:Doc_AccountingClearanceForm ;
    lspu:hasStep lspuadm:AssessFees_Step1 ;
    lspuadm:totalFeeText "None" ; lspuadm:totalProcessingTime "3 minutes" ;
    lspuadm:sourceDocument "LSPU Citizen's Charter, 2026 1st Edition (University-Wide)" ;
    lspuadm:sourceSection "III. Accounting Office, Service 2: Assessment of Fees, p. 9" .

lspuadm:Doc_EnrolmentStubRegForm a lspu:Document ; rdfs:label "Enrolment Stub and Registration Form" ; lspu:definition "Secured from the Registrar." .
lspuadm:Doc_AccountingClearanceForm a lspu:Document ; rdfs:label "Clearance Form" ; lspu:definition "Secured from the Accounting Office." .

lspuadm:AssessFees_Step1 a lspuadm:ServiceStep ;
    rdfs:label "Step 1: Present required documents (verification of student status/entries)" ;
    lspuadm:clientAction "Presents required documents: undergraduates via Registrar's online registration; graduate students; senior high school students (represented by parent/authorized rep); or students with adding/dropping/cancellation of subjects." ;
    lspuadm:agencyAction "Verifies if the student is qualified to avail RA No. 10931 (Free Higher Education) / checks the Registration Form or Clearance for completeness of entry, as applicable." ;
    lspuadm:hasFeeText "None" ; lspuadm:hasProcessingTime "15 seconds per client type" ;
    lspu:performedBy lspuadm:Role_AdministrativeAideVI ;
    lspu:nextStep lspuadm:AssessFees_Step2 ;
    lspuadm:sourceSection "III. Accounting Office, Service 2: Assessment of Fees, Step 1, p. 9-10" .

lspuadm:AssessFees_Step2 a lspuadm:ServiceStep ;
    rdfs:label "Step 2: Assessment of fees" ;
    lspuadm:clientAction "Students qualified to avail RA No. 10931 (Free Higher Education) or graduate students submit for assessment." ;
    lspuadm:agencyAction "Assesses school fees based on enrolled units reflected in the LSPU Enrolment System (or based on submitted requirements for graduate students)." ;
    lspuadm:hasFeeText "None" ; lspuadm:hasProcessingTime "1 minute per client type" ;
    lspu:performedBy lspuadm:Role_AdministrativeAideVI ;
    lspuadm:sourceSection "III. Accounting Office, Service 2: Assessment of Fees, Step 2, p. 10" .

#-----------------------------------------------------------------
#  III. ACCOUNTING OFFICE -- 3. Releasing of Clearance
#-----------------------------------------------------------------

lspuadm:Serv_ReleasingOfClearance a lspuadm:Service ;
    rdfs:label "Releasing of Clearance" ;
    lspuadm:availedAt lspuadm:Office_Accounting ;
    lspuadm:hasCategory lspuadm:Cat_Simple ; lspuadm:classificationText "Simple" ;
    lspuadm:hasTransactionType lspuadm:TT_G2C ;
    lspuadm:whoMayAvail "All" ;
    lspu:requiresDocument lspuadm:Doc_StudentIDForVerification ;
    lspu:hasStep lspuadm:AcctgClearance_Step1 ;
    lspuadm:totalFeeText "None" ; lspuadm:totalProcessingTime "1 minute" ;
    lspuadm:sourceDocument "LSPU Citizen's Charter, 2026 1st Edition (University-Wide)" ;
    lspuadm:sourceSection "III. Accounting Office, Service 3: Releasing of Clearance, p. 10" .

lspuadm:Doc_StudentIDForVerification a lspu:Document ; rdfs:label "Student ID (for student number verification)" ; lspu:definition "Supplied by the client/student." .

lspuadm:AcctgClearance_Step1 a lspuadm:ServiceStep ;
    rdfs:label "Step 1: Present ID for verification and clearance issuance" ;
    lspuadm:clientAction "Presents ID for verification of student number in the system." ;
    lspuadm:agencyAction "Checks if the student has unsettled accounts in the system (if so, requires them to settle accounts at the Cashier's Office first); if the student has no outstanding balance, clearance is issued." ;
    lspuadm:hasFeeText "None" ; lspuadm:hasProcessingTime "1 minute" ;
    lspu:performedBy lspuadm:Role_AdministrativeAideVI ;
    lspuadm:sourceSection "III. Accounting Office, Service 3: Releasing of Clearance, Step 1, p. 10-11" .

#-----------------------------------------------------------------
#  III. ACCOUNTING OFFICE -- 4. Releasing of Statement of Accounts/Balances/Payment History
#-----------------------------------------------------------------

lspuadm:Serv_ReleasingOfStatementOfAccountsBalancesPaymentHistory a lspuadm:Service ;
    rdfs:label "Releasing of Statement of Accounts/Balances/Payment History" ;
    lspu:definition "Process for how the statement of accounts/balances/payment history is released." ;
    lspuadm:availedAt lspuadm:Office_Accounting ;
    lspuadm:hasCategory lspuadm:Cat_Simple ; lspuadm:classificationText "Simple" ;
    lspuadm:hasTransactionType lspuadm:TT_G2C ;
    lspuadm:whoMayAvail "All" ;
    lspu:requiresDocument lspuadm:Doc_StudentIDForVerification ;
    lspu:hasStep lspuadm:AcctgStatement_Step1 ;
    lspuadm:totalFeeText "None" ; lspuadm:totalProcessingTime "1 minute" ;
    lspuadm:sourceDocument "LSPU Citizen's Charter, 2026 1st Edition (University-Wide)" ;
    lspuadm:sourceSection "III. Accounting Office, Service 4: Releasing of Statement of Accounts/Balances/Payment History, p. 11" .

lspuadm:AcctgStatement_Step1 a lspuadm:ServiceStep ;
    rdfs:label "Step 1: Present school ID" ;
    lspuadm:clientAction "Presents school ID." ;
    lspuadm:agencyAction "Checks the student's record in the system and directs him/her to pay at the Cashier if applicable." ;
    lspuadm:hasFeeText "None" ; lspuadm:hasProcessingTime "1 minute" ;
    lspu:performedBy lspuadm:Role_AdministrativeAideVI ;
    lspuadm:sourceSection "III. Accounting Office, Service 4: Releasing of Statement of Accounts/Balances/Payment History, Step 1, p. 11" .

#-----------------------------------------------------------------
#  IV. SECURITY MANAGEMENT OFFICE -- 1. Public Assistance (w/o vehicle)
#-----------------------------------------------------------------

lspuadm:Serv_PublicAssistanceWoVehicle a lspuadm:Service ;
    rdfs:label "Public Assistance (w/o vehicle)" ;
    lspu:definition "Public assistance to LSPU visitors without a vehicle." ;
    lspuadm:availedAt lspu:SafetyAndSecurityManagementOffice ;
    lspuadm:hasCategory lspuadm:Cat_Simple ; lspuadm:classificationText "Simple" ;
    lspuadm:hasTransactionType lspuadm:TT_G2C, lspuadm:TT_G2G, lspuadm:TT_G2B ;
    lspuadm:whoMayAvail "Students, and other visitors" ;
    lspu:requiresDocument lspuadm:Doc_ValidIDAnyAgency, lspuadm:Doc_VisitorsPass ;
    lspu:hasStep lspuadm:PubAssistNoVeh_Step1 ;
    lspuadm:totalFeeText "None" ; lspuadm:totalProcessingTime "19 seconds" ;
    lspuadm:sourceDocument "LSPU Citizen's Charter, 2026 1st Edition (University-Wide)" ;
    lspuadm:sourceSection "IV. Security Management Office, Service 1: Public Assistance (w/o vehicle), p. 12" .

lspuadm:Doc_ValidIDAnyAgency a lspu:Document ; rdfs:label "Valid ID" ; lspu:definition "Issued by any government agency." .
lspuadm:Doc_VisitorsPass a lspu:Document ; rdfs:label "Visitor's Pass" ; lspu:definition "Secured from the Security Management Office (SMO)." .

lspuadm:PubAssistNoVeh_Step1 a lspuadm:ServiceStep ;
    rdfs:label "Step 1: State service needed to Guard on Duty" ;
    lspuadm:agencyAction "Accepts inquiry; coordinates with the requested office/personnel." ;
    lspuadm:hasFeeText "n/a" ; lspuadm:hasProcessingTime "15 seconds" ;
    lspu:performedBy lspuadm:Role_GuardOnDuty ;
    lspu:nextStep lspuadm:PubAssistNoVeh_Step2 ;
    lspuadm:sourceSection "IV. Security Management Office, Service 1: Public Assistance (w/o vehicle), Step 1, p. 12" .

lspuadm:PubAssistNoVeh_Step2 a lspuadm:ServiceStep ;
    rdfs:label "Step 2: Present legal identification" ;
    lspuadm:agencyAction "Issues visitor's pass." ;
    lspuadm:hasFeeText "n/a" ; lspuadm:hasProcessingTime "3 seconds" ;
    lspu:performedBy lspuadm:Role_GuardOnDuty ;
    lspu:nextStep lspuadm:PubAssistNoVeh_Step3 ;
    lspuadm:sourceSection "IV. Security Management Office, Service 1: Public Assistance (w/o vehicle), Step 2, p. 12" .

lspuadm:PubAssistNoVeh_Step3 a lspuadm:ServiceStep ;
    rdfs:label "Step 3: Collection of visitor's pass upon exit" ;
    lspuadm:agencyAction "Inspects and accepts visitor's pass." ;
    lspuadm:hasFeeText "n/a" ; lspuadm:hasProcessingTime "1 second" ;
    lspu:performedBy lspuadm:Role_GuardOnDuty ;
    lspuadm:sourceSection "IV. Security Management Office, Service 1: Public Assistance (w/o vehicle), Step 3, p. 12" .

lspuadm:Role_GuardOnDuty a lspu:UniversityRole ; rdfs:label "Guard on Duty" .

#-----------------------------------------------------------------
#  IV. SECURITY MANAGEMENT OFFICE -- 2. Public Assistance (w/ vehicle)
#-----------------------------------------------------------------

lspuadm:Serv_PublicAssistanceWVehicle a lspuadm:Service ;
    rdfs:label "Public Assistance (w/ vehicle)" ;
    lspu:definition "Public assistance to clients with a vehicle." ;
    lspuadm:availedAt lspu:SafetyAndSecurityManagementOffice ;
    lspuadm:hasCategory lspuadm:Cat_Simple ; lspuadm:classificationText "Simple" ;
    lspuadm:hasTransactionType lspuadm:TT_G2C, lspuadm:TT_G2G, lspuadm:TT_G2B ;
    lspuadm:whoMayAvail "External Client" ;
    lspu:requiresDocument lspuadm:Doc_ValidIDAnyAgency, lspuadm:Doc_VisitorsPass ;
    lspu:hasStep lspuadm:PubAssistVeh_Step1 ;
    lspuadm:totalFeeText "None" ; lspuadm:totalProcessingTime "25 seconds" ;
    lspuadm:sourceDocument "LSPU Citizen's Charter, 2026 1st Edition (University-Wide)" ;
    lspuadm:sourceSection "IV. Security Management Office, Service 2: Public Assistance (w/ vehicle), p. 12" .

lspuadm:PubAssistVeh_Step1 a lspuadm:ServiceStep ;
    rdfs:label "Step 1: State service needed to Guard on Duty" ;
    lspuadm:agencyAction "Accepts inquiry; coordinates with the requested office/personnel." ;
    lspuadm:hasFeeText "n/a" ; lspuadm:hasProcessingTime "15 seconds" ;
    lspu:performedBy lspuadm:Role_GuardOnDuty ;
    lspu:nextStep lspuadm:PubAssistVeh_Step2 ;
    lspuadm:sourceSection "IV. Security Management Office, Service 2: Public Assistance (w/ vehicle), Step 1, p. 12" .

lspuadm:PubAssistVeh_Step2 a lspuadm:ServiceStep ;
    rdfs:label "Step 2: Present legal identification; vehicle inspected on entry" ;
    lspuadm:agencyAction "Issues visitor's pass; vehicle is subject to inspection upon entry." ;
    lspuadm:hasFeeText "n/a" ; lspuadm:hasProcessingTime "5 seconds" ;
    lspu:performedBy lspuadm:Role_GuardOnDuty ;
    lspu:nextStep lspuadm:PubAssistVeh_Step3 ;
    lspuadm:sourceSection "IV. Security Management Office, Service 2: Public Assistance (w/ vehicle), Step 2, p. 12" .

lspuadm:PubAssistVeh_Step3 a lspuadm:ServiceStep ;
    rdfs:label "Step 3: Vehicle inspected and visitor's pass returned on exit" ;
    lspuadm:agencyAction "Inspects vehicle and accepts visitor's pass on exit." ;
    lspuadm:hasFeeText "n/a" ; lspuadm:hasProcessingTime "5 seconds" ;
    lspu:performedBy lspuadm:Role_GuardOnDuty ;
    lspuadm:sourceSection "IV. Security Management Office, Service 2: Public Assistance (w/ vehicle), Step 3, p. 12" .

#-----------------------------------------------------------------
#  V. BUSINESS AFFAIRS, MARKETING AND PRODUCTION OFFICE -- 1. Processing of Student ID
#-----------------------------------------------------------------

lspuadm:Serv_ProcessingOfStudentID a lspuadm:Service ;
    rdfs:label "Processing of Student ID" ;
    lspu:definition "ID processing for students, employees, and alumni." ;
    lspuadm:availedAt lspuadm:Office_BusinessAffairsOffice ;
    lspuadm:hasCategory lspuadm:Cat_Simple ; lspuadm:classificationText "Simple" ;
    lspuadm:hasTransactionType lspuadm:TT_G2C ;
    lspuadm:whoMayAvail "Students, Employees and Alumni" ;
    lspu:requiresDocument lspuadm:Doc_CORForID ;
    lspu:hasStep lspuadm:StudentID_Step1 ;
    lspuadm:totalFeeText "Php 100.00" ; lspuadm:totalProcessingTime "4 minutes" ;
    lspuadm:sourceDocument "LSPU Citizen's Charter, 2026 1st Edition (University-Wide)" ;
    lspuadm:sourceSection "V. Business Affairs, Marketing and Production Office, Service 1: Processing of Student ID, p. 13" .

lspuadm:Doc_CORForID a lspu:Document ; rdfs:label "Certificate of Registration (COR)" ; lspu:definition "Secured from the Registrar." .

lspuadm:StudentID_Step1 a lspuadm:ServiceStep ;
    rdfs:label "Step 1: Scan QR code / fill out Google form" ;
    lspuadm:clientAction "Scans QR code / fills out the Google form." ;
    lspuadm:hasFeeText "N/A" ; lspuadm:hasProcessingTime "1 minute" ;
    lspu:nextStep lspuadm:StudentID_Step2 ;
    lspuadm:sourceSection "V. Business Affairs, Marketing and Production Office, Service 1: Processing of Student ID, Step 1, p. 13" .

lspuadm:StudentID_Step2 a lspuadm:ServiceStep ;
    rdfs:label "Step 2: Verification of information" ;
    lspuadm:agencyAction "Encodes the student's data." ;
    lspuadm:hasFeeText "N/A" ; lspuadm:hasProcessingTime "1 minute" ;
    lspu:performedBy lspuadm:Role_BAPMStaff ;
    lspu:nextStep lspuadm:StudentID_Step3 ;
    lspuadm:sourceSection "V. Business Affairs, Marketing and Production Office, Service 1: Processing of Student ID, Step 2, p. 13" .

lspuadm:StudentID_Step3 a lspuadm:ServiceStep ;
    rdfs:label "Step 3: Printing of ID card" ;
    lspuadm:agencyAction "Prints the ID card." ;
    lspuadm:hasFeeText "Php 100.00" ; lspuadm:hasProcessingTime "1 minute" ;
    lspu:performedBy lspuadm:Role_BAPMStaff ;
    lspu:nextStep lspuadm:StudentID_Step4 ;
    lspuadm:sourceSection "V. Business Affairs, Marketing and Production Office, Service 1: Processing of Student ID, Step 3, p. 13" .

lspuadm:StudentID_Step4 a lspuadm:ServiceStep ;
    rdfs:label "Step 4: Sign the logbook" ;
    lspuadm:clientAction "Signs the logbook." ;
    lspuadm:hasFeeText "N/A" ; lspuadm:hasProcessingTime "1 minute" ;
    lspuadm:sourceSection "V. Business Affairs, Marketing and Production Office, Service 1: Processing of Student ID, Step 4, p. 13" .

lspuadm:Role_BAPMStaff a lspu:UniversityRole ; rdfs:label "BAPM Staff" .

#-----------------------------------------------------------------
#  VI. UNIVERSITY HEALTH SERVICE -- 1. Routine Medical and Dental Services
#-----------------------------------------------------------------

lspuadm:Serv_RoutineMedicalAndDentalServices a lspuadm:Service ;
    rdfs:label "Routine Medical and Dental Services" ;
    lspuadm:availedAt lspuadm:Office_UniversityHealthService ;
    lspuadm:hasCategory lspuadm:Cat_Simple ; lspuadm:classificationText "Simple" ;
    lspuadm:hasTransactionType lspuadm:TT_G2G, lspuadm:TT_G2C ;
    lspuadm:whoMayAvail "All" ;
    lspu:hasStep lspuadm:HealthService_Step1 ;
    lspuadm:totalFeeText "None" ; lspuadm:totalProcessingTime "10-38 minutes" ;
    lspuadm:sourceDocument "LSPU Citizen's Charter, 2026 1st Edition (University-Wide)" ;
    lspuadm:sourceSection "VI. University Health Service, Service 1: Routine Medical and Dental Services, p. 14" .

lspuadm:HealthService_Step1 a lspuadm:ServiceStep ;
    rdfs:label "Step 1: Log name, course, year, and section" ;
    lspuadm:clientAction "Writes name, course, year, and section." ;
    lspuadm:agencyAction "Initial assessment of the patient." ;
    lspuadm:hasFeeText "N/A" ; lspuadm:hasProcessingTime "3-5 minutes" ;
    lspu:performedBy lspuadm:Role_UniversityNurseClinicAide ;
    lspu:nextStep lspuadm:HealthService_Step2 ;
    lspuadm:sourceSection "VI. University Health Service, Service 1: Routine Medical and Dental Services, Step 1, p. 14" .

lspuadm:HealthService_Step2 a lspuadm:ServiceStep ;
    rdfs:label "Step 2: Consultation (medical or dental)" ;
    lspuadm:agencyAction "Medical: examines and explains procedures to the patient. Dental: oral examination, diagnosis and etiology, recommendation and treatment." ;
    lspuadm:hasFeeText "N/A" ; lspuadm:hasProcessingTime "5-30 minutes" ;
    lspu:performedBy lspuadm:Role_VisitingPhysicianDentist ;
    lspu:nextStep lspuadm:HealthService_Step3 ;
    lspuadm:sourceSection "VI. University Health Service, Service 1: Routine Medical and Dental Services, Step 2, p. 14" .

lspuadm:HealthService_Step3 a lspuadm:ServiceStep ;
    rdfs:label "Step 3: Sign in logbook; receive medicines/instructions" ;
    lspuadm:clientAction "Signs in logbook." ;
    lspuadm:agencyAction "Gives medicines and instructions to the patient." ;
    lspuadm:hasFeeText "N/A" ; lspuadm:hasProcessingTime "2-3 minutes" ;
    lspu:performedBy lspuadm:Role_UniversityNurseClinicAide ;
    lspuadm:sourceSection "VI. University Health Service, Service 1: Routine Medical and Dental Services, Step 3, p. 14" .

lspuadm:Role_UniversityNurseClinicAide a lspu:UniversityRole ; rdfs:label "University Nurse/Clinic Aide/Dental Staff" .
lspuadm:Role_VisitingPhysicianDentist a lspu:UniversityRole ; rdfs:label "Visiting Physician/University Dentist" .

#-----------------------------------------------------------------
#  VII. UNIVERSITY LIBRARY -- 1. Library Reference Assistance
#-----------------------------------------------------------------

lspuadm:Serv_LibraryReferenceAssistance a lspuadm:Service ;
    rdfs:label "Library Reference Assistance" ;
    lspu:definition "Validation and provision of reference needs (books, databases, other sources)." ;
    lspuadm:availedAt lspuadm:Office_Library ;
    lspuadm:hasCategory lspuadm:Cat_External ; lspuadm:classificationText "External" ;
    lspuadm:hasTransactionType lspuadm:TT_G2G, lspuadm:TT_G2C ;
    lspuadm:whoMayAvail "Students, Faculty, Outside Researchers" ;
    lspu:requiresDocument lspuadm:Doc_LSPUID ;
    lspu:hasStep lspuadm:LibraryRef_Step1 ;
    lspuadm:totalFeeText "None" ; lspuadm:totalProcessingTime "10 minutes" ;
    lspuadm:sourceDocument "LSPU Citizen's Charter, 2026 1st Edition (University-Wide)" ;
    lspuadm:sourceSection "VII. University Library, Service 1: Library Reference Assistance, p. 15" .

lspuadm:Doc_LSPUID a lspu:Document ; rdfs:label "LSPU ID" ; lspu:definition "Secured from the Business Affairs Office (BAO)." .

lspuadm:LibraryRef_Step1 a lspuadm:ServiceStep ;
    rdfs:label "Step 1: Query, interview, search, resolve, and end transaction" ;
    lspuadm:clientAction "States query; is interviewed by the reference librarian to ascertain subject and information question; receives relevant sources; provides feedback at the end of the transaction." ;
    lspuadm:agencyAction "Checks the library account of the client; logs the transaction; searches and provides relevant sources; resolves the reference issue and provides information." ;
    lspuadm:hasFeeText "None" ; lspuadm:hasProcessingTime "10 minutes total (1 min account check, 5 min interview, 3 min search, 1 min log)" ;
    lspu:performedBy lspuadm:Role_ReferenceLibrarian ;
    lspuadm:sourceSection "VII. University Library, Service 1: Library Reference Assistance, Step 1, p. 15" .

lspuadm:Role_ReferenceLibrarian a lspu:UniversityRole ; rdfs:label "Reference Librarian" .

#-----------------------------------------------------------------
#  VII. UNIVERSITY LIBRARY -- 2. Library Circulation Service
#-----------------------------------------------------------------

lspuadm:Serv_LibraryCirculationService a lspuadm:Service ;
    rdfs:label "Library Circulation Service" ;
    lspu:definition "Book borrowing and returns, materials borrowing, and printing/photocopying of information sources." ;
    lspuadm:availedAt lspuadm:Office_Library ;
    lspuadm:hasCategory lspuadm:Cat_External ; lspuadm:classificationText "External" ;
    lspuadm:hasTransactionType lspuadm:TT_G2G, lspuadm:TT_G2C ;
    lspuadm:whoMayAvail "Students, Faculty, Outside Researchers" ;
    lspu:requiresDocument lspuadm:Doc_LSPUID, lspuadm:Doc_BorrowersCard ;
    lspu:hasStep lspuadm:LibraryCirc_Step1 ;
    lspuadm:totalFeeText "Php 2.00 per day overdue" ; lspuadm:totalProcessingTime "12 minutes" ;
    lspuadm:sourceDocument "LSPU Citizen's Charter, 2026 1st Edition (University-Wide)" ;
    lspuadm:sourceSection "VII. University Library, Service 2: Library Circulation Service, p. 15" .

lspuadm:Doc_BorrowersCard a lspu:Document ; rdfs:label "Borrower's Card" ; lspu:definition "Secured from the Library." .

lspuadm:LibraryCirc_Step1 a lspuadm:ServiceStep ;
    rdfs:label "Step 1: Search, retrieve, record, and give feedback" ;
    lspuadm:clientAction "Searches the database/catalog for sources; retrieves articles, books, or material; records the borrowing or return; gives feedback." ;
    lspuadm:agencyAction "Searches the catalog and sources; processes actual material to be borrowed or returned; provides due dates or date of actual return; records the transaction." ;
    lspuadm:hasFeeText "Php 2.00 per day overdue" ; lspuadm:hasProcessingTime "12 minutes total (5 min search, 5 min process, 2 min record)" ;
    lspu:performedBy lspuadm:Role_CirculationLibrarian ;
    lspuadm:sourceSection "VII. University Library, Service 2: Library Circulation Service, Step 1, p. 15-16" .

lspuadm:Role_CirculationLibrarian a lspu:UniversityRole ; rdfs:label "Circulation Librarian" .

