    lspu:definition "Intentional or reckless alteration, damaging, deletion or deterioration of computer data, electronic document or electronic message, without right, including introduction or transmission of viruses." ;
    lspu:sourceArticle "Ch.6 Art.2 Sec.1.4" ;
    lspu:isBasedOn lspu:RA10175 ;
    lspu:hasSanctionTier lspu:Tier_DataInterference_1, lspu:Tier_DataInterference_2, lspu:Tier_DataInterference_3 .

