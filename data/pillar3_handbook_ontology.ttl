    lspuadm:sourceDocument "LSPU Citizen's Charter, 2026 1st Edition (University-Wide)" ;
    lspuadm:sourceSection "XXXI. Colleges, Service 9: Enrollment Advising, p. 90" .

lspuadm:Serv_EnrollmentAdvising_S1 a lspuadm:ServiceStep ;
    rdfs:label "Step 1: Pay for grades evaluation" ;
    lspuadm:clientAction "Secures payment for grades evaluation from the Cashier's Office." ;
    lspuadm:agencyAction "Processes the transaction fee and provides the client with the Official Receipt." ;
    lspuadm:hasFeeText "P60.00" ; lspuadm:hasProcessingTime "1 minute" ;
    lspu:performedBy lspuadm:Role_CashiersOfficeStaff ;
    lspu:nextStep lspuadm:Serv_EnrollmentAdvising_S2 ;
