    lspuadm:agencyAction "Announces call for research proposal." ;
    lspuadm:hasFeeText "None" ; lspuadm:hasProcessingTime "1 day" ;
    lspu:performedBy lspuadm:Role_DirectorChairpersonofResearchandDevelopment ;
